<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Istasyon etiketi yalniz okunur (297 a); NFC olmayan saatte menu satiri gorunmez. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Yedekleme kapali: belirtec bulut yedegine ya da baska cihaza gecmez. -->
    <application
        android:allowBackup="false"
        android:label="@string/uygulama_adi"
        android:networkSecurityConfig="${agGuvenligi}"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Telefonsuz calisir: Wear OS'ta telefon uygulamasi gerekmez. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".AnaEtkinlik"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Karolar (ornekteki "karo"): uygulamayi acmadan istasyonlar ve uyarilar. -->
        <service
            android:name=".karo.IstasyonKarosu"
            android:exported="true"
            android:label="@string/karo_istasyonlar"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>
        <service
            android:name=".karo.UyariKarosu"
            android:exported="true"
            android:label="@string/karo_uyarilar"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>
        <!-- TMI kadraninin (saat/kadran, Watch Face Format) veri kutucuklari; baska kadranlarda da secilebilir.
             Sistem en sik 5 dakikada bir ister (pil); logo saatte bir. Dokununca Tezgahlar 3B acilir. -->
        <service
            android:name=".kadran.EmirHalkasi"
            android:exported="true"
            android:label="@string/kutucuk_emirler"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>
        <service
            android:name=".kadran.IstasyonOzeti"
            android:exported="true"
            android:label="@string/kutucuk_istasyonlar"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>
        <service
            android:name=".kadran.KurumLogosu"
            android:exported="true"
            android:label="@string/kutucuk_logo"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="3600" />
        </service>
    </application>
</manifest>

/* ---------- Plan girdisi: Reçete ve Rota kaydından motorun durumuna (st) ----------
   Planlama çerçevesi ve sunucu (plan-girdisi.ts) aynı kodla kurar: aynı kayıt, aynı çalışma ve aynı kaynak okuması aynı st'yi verir.
   Bu dosya sayfa nesnesi (pencere, depo, ekran) kullanmaz; çalışmayı (S) parametre alır. Duvar saati çerçevede tarayıcının saatidir,
   sunucuda GIRDI_SAAT_DILIMI tanımlanır (tesisin saat dilimi). Çerçevenin kendi akışı (kayıt okuma, yazma, çizim) zz27 ve zz31'dedir. */
const GUNLER = ['pzt', 'sal', 'car', 'per', 'cum', 'cmt', 'paz'];
const RR_WC = 'w-atolye';
const RR_GUN = { paz: 0, pzt: 1, sal: 2, car: 3, per: 4, cum: 5, cmt: 6 };
const RR_GUN_SIRA = ['pzt', 'sal', 'car', 'per', 'cum', 'cmt', 'paz'];
/* D'nin bu dizileri çerçeve kayıtlarına dağılır; kalan üst düzey alanlar st.plan'da durur */
const RR_DAGILAN = ['urunler', 'malzemeler', 'tezgahlar', 'personel', 'siparisler'];
const rrKopya = x => x === undefined ? undefined : JSON.parse(JSON.stringify(x));
/* Nesne anahtarlarının sırası değer farkı sayılmaz: çalışma PostgreSQL'de jsonb durur ve jsonb anahtarları kendi sırasına dizer. Sıraya bakan
   karşılaştırma yazılıp okunan veriyi her okumada değişmiş sayar; veri sürümü boşuna artar, plan bayatlar. Dizilerin sırası anlamlıdır. */
const rrDuzle = x => Array.isArray(x) ? x.map(rrDuzle)
  : x !== null && typeof x === 'object' ? Object.keys(x).sort().reduce((o, k) => { o[k] = rrDuzle(x[k]); return o; }, {}) : x;
const rrEsit = (a, b) => JSON.stringify(rrDuzle(a)) === JSON.stringify(rrDuzle(b));
const rrTarih = s => (typeof s === 'string' && /^\d{4}-\d{2}-\d{2}/.test(s)) ? s.slice(0, 10) : '';
const rrSaat = s => (typeof s === 'string' && /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}/.test(s)) ? s.slice(11, 16) : '';
/* 1401 a: termin günün sonudur; sunucuyla tek tanım (plan/kurallar.ts TERMIN_SAATI, plan-girdisi testi aynılığını denetler) */
const TERMIN_SAATI = '23:59';
const rrSayi = x => x == null || x === '' || !isFinite(+x) ? null : +x;
const rrSeq = (o, i) => /^\d+$/.test(String(o.k)) ? +o.k : (i + 1) * 10;

/* rota adımının çerçevedeki karşılığı: istasyon = ilk makinenin grubu, alternatif = öteki gruplar, süre = grubun ilk makinesi */
/* fason adım çerçevede istasyonsuz, fasonId'li adımdır; termin günü fasoncunun süresidir */
function rrAdimYerli(o, grupOf, opId, fasonGun) {
  if (o.fason) return { opId, stationId: null, machineId: null, fasonId: o.fason, terminGun: fasonGun ? fasonGun(o.fason) : null, setup: 0, proc: 0, chg: null, cycle: 0, alts: [], altTimes: {},
    dep: o.ortusebilir ? 'ortulu' : 'bagimli', depQty: +o.transfer > 0 ? +o.transfer : 1, minLot: +o.minParti > 0 ? +o.minParti : 0, split: 'tek' };
  const tz = o.tezgahlar || [];
  const gruplar = [...new Set(tz.map(t => grupOf(t.id)).filter(Boolean))];
  const ilk = g => tz.find(t => grupOf(t.id) === g) || {};
  const g1 = gruplar[0] || '', t1 = ilk(g1);
  const altTimes = {}; for (const g of gruplar.slice(1)) { const t = ilk(g); altTimes[g] = { setup: +t.ayar || 0, cycle: +t.cevrim || 0 }; }
  const cyc = +t1.cevrim || 0;
  return { opId, stationId: g1, setup: +t1.ayar || 0, proc: cyc, chg: null, cycle: cyc, alts: gruplar.slice(1), altTimes,
    dep: o.ortusebilir ? 'ortulu' : 'bagimli', depQty: +o.transfer > 0 ? +o.transfer : 1, minLot: +o.minParti > 0 ? +o.minParti : 0,
    split: tz.filter(t => grupOf(t.id) === g1).length > 1 ? 'bol' : 'tek' };
}
const RR_ADIM_SURE = ['stationId', 'setup', 'cycle', 'alts', 'altTimes'];

/* plan kopyasındaki anahtar sırasıyla kurar; yerli alan değişmişse onun değeri, değişmemişse asıl değer yazılır */
function rrKur(asil, yeni) {
  const o = {};
  for (const k of Object.keys(asil || {})) { if (k in yeni) { if (yeni[k] !== undefined) o[k] = yeni[k]; } else o[k] = asil[k]; }
  for (const k of Object.keys(yeni)) if (!(k in o) && yeni[k] !== undefined && !(asil && k in asil)) o[k] = yeni[k];
  return o;
}
/* 815 (699/3 a): emrin önceliği (1-4; 195 a: 1 ve 2 Yüksek, 3 Normal, 4 Düşük) motorun sınıfına (1-3) çevrilir; önceliği olmayan 0. */
function oncSinifi(p) { p = +p; return p === 1 || p === 2 ? 1 : p === 3 ? 2 : p === 4 ? 3 : 0; }
function rrCevir(st) {
  const P = rrKopya(st.plan || {});
  const items = st.items || [], item = id => items.find(x => x.id === id);
  const urunMu = it => it && (it.type === 'mamul' || it.type === 'yari');
  const grupOf = id => { const m = (st.machines || []).find(x => x.id === id); return m ? m.stationId : ''; };
  const opAd = id => { const d = (st.opdefs || []).find(x => x.id === id); return d ? d.name : ''; };
  const ilkVardiya = (st.cal && st.cal.shifts && st.cal.shifts[0] && st.cal.shifts[0].start) || '08:00';
  /* 650 a: tezgâhın haftası istasyonunun iş merkezinden (gün adı -> vardiyalar); merkez haftaları okunmadıysa yok, tezgâh atölyenin takvimiyle */
  const merkezHaftasi = m => {
    const s = (st.stations || []).find(x => x.id === m.stationId), w = s && st.merkezHaftalari && st.merkezHaftalari[s.wcId];
    return w ? Object.fromEntries(RR_GUN_SIRA.map(g => [g, (w[RR_GUN[g]] || []).slice()])) : undefined;
  };
  /* makineler önce: adımların makine listesi grubu buradan bulur */
  const tezgahlar = (st.machines || []).map(m => {
    const a = m.plan || null; const y = {};
    if (!a || a.id !== m.id) y.id = m.id;
    if (!a || a.ad !== m.name) y.ad = m.name;
    if (!a || a.grup !== m.stationId) y.grup = m.stationId;
    /* 69 a: istasyonun maliyeti okunamazsa (satır yok, yetki yok) saat ücreti boştur; motor o tezgâhın tutarını bilinmez sayar, sıfır uydurulmaz */
    if (!a) { const s = (st.stations || []).find(x => x.id === m.stationId) || {}; Object.assign(y, { ucret: rrSayi(s.cost), ucretIst: rrSayi(s.cost), verim: (+s.eff || 100) / 100, vardiyalar: ((st.cal && st.cal.shifts) || []).map(x => x.id), opOran: 0 }); }
    const hafta = merkezHaftasi(m);
    if (!rrEsit(a && a.hafta, hafta)) y.hafta = hafta;
    return rrKur(a, y);
  });
  const grupMak = g => tezgahlar.filter(m => m.grup === g).map(m => m.id);
  const urunler = [];
  /* 1473 a: ürünün rota adımı sırası (seq) -> motorun adım anahtarı (k); siparişin malzeme satırı tükettiği adımı bu anahtarla taşır */
  const adimAnahtari = {};
  for (const it of items.filter(urunMu)) {
    const a = it.plan || null; const y = {};
    if (!a || a.id !== it.id) y.id = it.id;
    if (!a || a.ad !== it.name) y.ad = it.name;
    const r = st.routes && st.routes[it.id];
    const steps = r ? (r.steps || []).slice().sort((p, q) => p.seq - q.seq) : [];
    const kHarita = {};
    /* 982 a: bağ rotanın bağımlılık türündendir (Reçete ve Rota'nın akışıyla aynı): bekleyen öncülün bitişini, akışlı (ortulu) devrini
       bekler, bağımsız beklemez. Bağımsız adımdan sonraki adım hem onu hem ondan önceki ana adımı bekler. Anahtar önceki adımın kayıttaki
       k'sidir (aşağıda kHarita ile yenisine çevrilir). */
    let onde = [];
    /* 1248 a: adımın çözülmüş öncül listesi (Reçete ve Rota; dal ya da birleştirme olan rotada) varsa bağ ondandır, her öncül kendi
       türüyle; boş liste dalın ilk adımıdır, hiçbir şeyi beklemez. Liste yoksa (null) bugünkü kural. */
    const refOf = q => { const x = steps.find(t => t.seq === q); return x ? (x.plan ? x.plan.k : String(x.seq)) : null; };
    const bagOf = (s, i) => {
      if (Array.isArray(s.onculler)) {
        onde = [s.plan ? s.plan.k : String(s.seq)];
        return s.onculler.flatMap(o => { const r = refOf(o.seq); return r === null ? [] : [[r, o.tur === 'akisli' ? 'o' : 'b']]; });
      }
      const dep = i === 0 ? 'bagimli' : s.dep || 'bagimli', son = onde[onde.length - 1];
      const bag = dep === 'bagimsiz' ? [] : onde.map(r => [r, r === son && dep === 'ortulu' ? 'o' : 'b']);
      const ref = s.plan ? s.plan.k : String(s.seq);
      onde = dep === 'bagimsiz' ? [...onde, ref] : [ref];
      return bag;
    };
    const rota = steps.map((s, i) => {
      const o0 = s.plan || null; const z = {};
      const k = o0 && rrSeq(o0, ((a && a.rota) || []).findIndex(x => x.k === o0.k)) === s.seq ? o0.k : String(s.seq);
      if (o0) kHarita[o0.k] = k;
      if (!o0 || o0.k !== k) z.k = k;
      const ad = opAd(s.opId) || (o0 && o0.ad) || ('OP ' + s.seq); if (!o0 || o0.ad !== ad) z.ad = ad;
      const ref = o0 ? rrAdimYerli(o0, grupOf, s.opId) : null;
      if (!o0 || RR_ADIM_SURE.some(f => !rrEsit(ref[f], s[f]))) {
        const izin = [s.stationId, ...(s.alts || [])].filter(Boolean);
        const eski = (o0 && o0.tezgahlar) || [];
        const sure = g => g === s.stationId ? { ayar: +s.setup || 0, cevrim: +s.cycle || 0 } : { ayar: +((s.altTimes || {})[g] || {}).setup || 0, cevrim: +((s.altTimes || {})[g] || {}).cycle || 0 };
        const degisti = g => !ref || (g === s.stationId ? (ref.stationId !== g || ref.setup !== s.setup || ref.cycle !== s.cycle) : !rrEsit(ref.altTimes[g], (s.altTimes || {})[g]));
        const tz = [];
        for (const g of izin) {
          const varolan = eski.filter(t => grupOf(t.id) === g);
          if (varolan.length && !degisti(g)) tz.push(...varolan);
          else if (varolan.length) tz.push(...varolan.map(t => Object.assign({}, t, sure(g))));
          else tz.push(...grupMak(g).map(id => Object.assign({ id }, sure(g))));
        }
        z.tezgahlar = tz;
      }
      const sFason = s.fasonId && !s.stationId ? s.fasonId : null;
      if (!o0 || (ref.fasonId || null) !== sFason) { if (sFason) z.fason = sFason; else if (o0 && 'fason' in o0) z.fason = undefined; }
      if (!o0 || ref.dep !== s.dep) { if (s.dep === 'ortulu') z.ortusebilir = true; else if (o0 && 'ortusebilir' in o0) z.ortusebilir = false; }
      /* 982 a: akışlı adımın devir adedi rotadandır (1 de); yoksa motor adedin dörtte birini devreder */
      if (!o0 || ref.depQty !== s.depQty || (s.dep === 'ortulu' && !('transfer' in o0))) { if (+s.depQty > 1 || s.dep === 'ortulu' || (o0 && 'transfer' in o0)) z.transfer = Math.max(1, +s.depQty || 1); }
      /* 1310 a: rotada ayarı işaretsiz adımda hazırlık sayılır, ayarcı aranmaz (engine ayarciIster); alanı olmayan eski kayıt ayarlıdır */
      if (s.ayarli === false) { if (!o0 || o0.ayarci !== false) z.ayarci = false; } else if (o0 && 'ayarci' in o0) z.ayarci = undefined;
      if (!o0 || ref.minLot !== s.minLot) { if (+s.minLot > 0 || (o0 && 'minParti' in o0)) z.minParti = +s.minLot; }
      const bag = bagOf(s, i).map(([r, t]) => { const e = ((o0 && o0.bag) || []).find(([q]) => q === r); return e ? [r, t, ...e.slice(2)] : [r, t]; });
      if (!o0 || !rrEsit(o0.bag || [], bag)) z.bag = bag;
      if (!o0) z.aile = '';
      return rrKur(o0, z);
    });
    adimAnahtari[it.id] = Object.fromEntries(steps.map((s, i) => [s.seq, rota[i].k]));
    for (const o of rota) if (Array.isArray(o.bag)) { const yeni = o.bag.filter(([k]) => k in kHarita || rota.some(x => x.k === k)).map(([k, t, ...e]) => [kHarita[k] || k, t, ...e]); if (!rrEsit(yeni, o.bag)) o.bag = yeni; }
    if (!a || 'rota' in a || rota.length) y.rota = (a && rrEsit(a.rota, rota)) ? a.rota : rota;
    const bil = [];
    for (const s of steps) { const k = rota[steps.indexOf(s)].k; for (const x of s.ins || []) if (!x.tmiSiparis && urunMu(item(x.itemId))) bil.push({ urun: x.itemId, miktar: x.qty, adim: k }); }
    const anah = b => b.urun + '|' + b.miktar + '|' + b.adim;
    const asilB = (a && a.bilesenler) || [];
    if (rrEsit(asilB.map(anah).sort(), bil.map(anah).sort())) { if (a && 'bilesenler' in a) y.bilesenler = a.bilesenler; }
    else y.bilesenler = bil.map(b => asilB.find(x => anah(x) === anah(b)) || b);
    urunler.push(rrKur(a, y));
  }
  const malzemeler = items.filter(it => it.type === 'ham').map(it => {
    const a = it.plan || null; const y = {};
    if (!a || a.kod !== it.id) y.kod = it.id;
    if (!a || a.ad !== it.name) y.ad = it.name;
    if (!a || (a.birim || '') !== it.unit) y.birim = it.unit;
    /* 1459 a: stok satırı olmayan malzemenin stoku bilinmez (null); 0 sayılmaz. Motor dağıtımda 0 gibi kullanır ve uyarır (engine evaluate) */
    const stok = it.stock == null || it.stock === '' || !isFinite(+it.stock) ? null : +it.stock;
    if (!a || (a.stok ?? null) !== stok) y.stok = stok;
    if (!a || (+a.birimFiyat || 0) !== it.cost) y.birimFiyat = +it.cost || 0;
    if (!a) Object.assign(y, { tedarikGun: 0, muayeneGun: 0 });
    return rrKur(a, y);
  });
  const personel = (st.people || []).map(p => {
    const a = p.plan || null; const y = {};
    if (!a || a.id !== p.id) y.id = p.id;
    if (!a || a.ad !== p.name) y.ad = p.name;
    if (!a || a.vardiya !== p.shiftId) y.vardiya = p.shiftId;
    if (!a || !rrEsit(a.gruplar || [], p.skills || [])) y.gruplar = (p.skills || []).slice();
    /* 563 c, 563 2 a: baktığı makineler ve aynı anda en çok tezgâh istasyonlardan gelir; sayfada değiştirilmez */
    if (!a || !rrEsit(a.makineler || [], p.machines || [])) y.makineler = (p.machines || []).slice();
    if (!a || (a.enCok ?? null) !== (p.maxMachines ?? null)) y.enCok = p.maxMachines ?? null;
    if (!a) y.ayar = p.role === 'Ayarcı';
    return rrKur(a, y);
  });
  const bas = rrTarih(P.meta && P.meta.baslangic);
  const siparisler = (st.orders || []).map(o => {
    const a = o.plan || null; const y = {};
    if (!a || a.id !== o.id) y.id = o.id;
    if (!a || a.urun !== o.itemId) y.urun = o.itemId;
    if (!a || a.adet !== o.qty) y.adet = +o.qty;
    /* teslim yoksa termin de yoktur (kural 5): uydurma tarih yazılmaz. Termin saati her zaman TERMIN_SAATI: kayıtta başka saat kalmışsa düzelir */
    const due = rrTarih(o.due) || null;
    if (!a || (rrTarih(a.termin) || null) !== due || (due && rrSaat(a.termin) !== TERMIN_SAATI)) y.termin = due ? due + ' ' + TERMIN_SAATI : null;
    if (!a || (rrTarih(a.serbest) || bas) !== o.start) y.serbest = o.start && o.start !== bas ? o.start + ' ' + (o.serbestSaat || rrSaat(a && a.serbest) || ilkVardiya) : (a ? a.serbest : null);
    else if (o.serbestSaat && a.serbest && rrSaat(a.serbest) !== o.serbestSaat) y.serbest = o.start !== bas ? o.start + ' ' + o.serbestSaat : null;
    if (!a || a.oncelik !== oncSinifi(o.priority)) y.oncelik = oncSinifi(o.priority);
    if (!a || !!a.havuz !== (o.status === 'taslak')) { if (o.status === 'taslak') y.havuz = true; else if (a && 'havuz' in a) y.havuz = false; }
    if (!a || (a.ad || '') !== (o.note || '')) y.ad = o.note || o.no || o.id;
    if (!a) Object.assign(y, { gelir: null, cezaGun: null });
    /* 1473 a: siparişin malzemesi rotanın bütün adımlarının hammaddesidir (yalnız ilk adımınki değil); her satır tükettiği adımın anahtarını
       (adim) taşır, motor malzemeyi o adımın başlangıcında bekler. Rota değişince kayıttaki liste de yenilenir. */
    { const r = st.routes && st.routes[o.itemId], ak = adimAnahtari[o.itemId] || {};
      const mal = (r ? (r.steps || []).slice().sort((p, q) => p.seq - q.seq) : []).flatMap(s => (s.ins || [])
        .filter(x => (item(x.itemId) || {}).type === 'ham').map(x => ({ kod: x.itemId, miktar: x.qty, adim: ak[s.seq] ?? String(s.seq) })));
      if (!a || !rrEsit(a.malzeme || [], mal)) y.malzeme = mal; }
    return rrKur(a, y);
  });
  /* takvim: vardiya, çalışma günü ve tatil değişmemişse asıl kayıt */
  /* 168 b: vardiyanın molaları (Vardiya modülü) motora geçer; motor molada tezgâhı çalıştırmaz */
  const vref = (P.vardiyalar || []).map(v => ({ id: v.id, start: v.bas, end: v.bit, molalar: v.molalar || [] }));
  const vrr = ((st.cal && st.cal.shifts) || []).map(v => ({ id: v.id, start: v.start, end: v.end, molalar: (v.breaks || []).map(b => ({ bas: b.start, bit: b.end })) }));
  if (!rrEsit(vref, vrr)) P.vardiyalar = vrr.map(v => Object.assign({}, (P.vardiyalar || []).find(x => x.id === v.id) || {}, { id: v.id, bas: v.start, bit: v.end, molalar: v.molalar }));
  const wc = (st.wcs || []).find(w => w.id === RR_WC) || (st.wcs || [])[0];
  if (wc && wc.week) {
    const cg0 = P.calismaGunleri || {}; const cg = {};
    for (const g of [...Object.keys(cg0), ...RR_GUN_SIRA.filter(g => !(g in cg0))]) cg[g] = (wc.week[RR_GUN[g]] || []).slice();
    if (!rrEsit(Object.keys(cg0).map(g => [g, cg0[g]]), Object.keys(cg0).map(g => [g, cg[g]])) || RR_GUN_SIRA.some(g => !(g in cg0) && cg[g].length)) P.calismaGunleri = cg;
  }
  if (st.cal && Array.isArray(st.cal.holidays) && !rrEsit(P.tatiller || [], st.cal.holidays)) P.tatiller = st.cal.holidays.slice();
  const dag = { urunler, malzemeler, tezgahlar, personel, siparisler };
  const D = {}; const sira = P._sira || [...Object.keys(P), ...RR_DAGILAN];
  for (const k of sira) { if (k === '_sira') continue; if (k in dag) D[k] = dag[k]; else if (k in P) D[k] = P[k]; }
  for (const k of Object.keys(P)) if (k !== '_sira' && !(k in D)) D[k] = P[k];
  for (const k of RR_DAGILAN) if (!(k in D)) D[k] = dag[k];
  return D;
}

const TMI_BOS_KAYIT = { items: [], routes: {}, machines: [], stations: [], opdefs: [], orders: [], people: [] };
/* An -> tesis duvar saati 'GGGG-AA-GG SS:DD'; okunamazsa null. */
function duvarSaati(an) {
  const d = new Date(an); if (isNaN(d.getTime())) return null; const p = n => String(n).padStart(2, '0');
  if (typeof GIRDI_SAAT_DILIMI !== 'string') return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  const k = {}; for (const x of new Intl.DateTimeFormat('en-CA', { timeZone: GIRDI_SAAT_DILIMI, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).formatToParts(d)) k[x.type] = x.value;
  return `${k.year}-${k.month}-${k.day} ${k.hour}:${k.minute}`;
}
/* Kayda planlama sayfası hiç yazmadıysa (yeni kurulum, ya da kaydı yalnız Reçete ve Rota yazdı) planın başlangıcı ve takvimi yoktur,
   açılış durur. Plan bugünden başlar; takvim boş kalır (vardiya ve çalışma günü uydurulmaz, sayfa kapasite yok der). İlk değişiklikle
   kayda yazılır; bunlarsız saklanmış çalışma da açılışta onarılır. */
function tmiTabanKur(D, bugun = duvarSaati(Date.now()).slice(0, 10)) {
  if (!D.meta) D.meta = { ad: 'Reçete ve Rota kaydı', baslangic: bugun };
  if (!Array.isArray(D.vardiyalar)) D.vardiyalar = [];
  if (!D.calismaGunleri || typeof D.calismaGunleri !== 'object') D.calismaGunleri = {};
  if (!Array.isArray(D.tatiller)) D.tatiller = [];
}

/* Tezgâh, istasyon, kişi ve takvimin sahibi İstasyonlar, Kişiler ve Vardiya'dır; sunucu bunları ana kayda yazmaz (bagliDilimleriAyikla),
   Reçete ve Rota çerçevesi kaynak okumasından birleştirir (kaynakUygula). Bu sayfa da aynı okumayla kaydı tamamlar; biçim o çerçevenin
   kaydıyla aynıdır, rrDenemeyeCevir değişmeden okur. Pasif kaynak plana girmez. Sayfanın tek takvimi vardır: çalışma günü aktif iş
   merkezlerinin haftalarının birleşimidir. D: açık çalışma; tezgâh ve kişinin motor ayarları (plan alt nesnesi) aynı kimlikte korunur.
   Okunamayan dilim (yetki yok) kayıttaki gibi kalır; maliyet satırı yoksa null, sıfır uydurulmaz. */
/* 71 b: elle değiştirilmemiş tezgâhın saat ücreti istasyon maliyetini izler; ucretIst istasyondan alınan son ücrettir, ücret ondan farklıysa
   elle girilmiştir ve korunur. İşareti olmayan eski tezgâh ücreti maliyete eşitse izlemeye girer. Maliyet okunamazsa (satır yok, yetki yok)
   son ücret kalır: okuyamayan kullanıcının açılışı ücreti silmesin. */
function ucretIzle(a, maliyet) {
  if (maliyet == null) return;
  const izler = a.ucretIst !== undefined ? a.ucret === a.ucretIst : a.ucret === maliyet;
  if (izler) { a.ucret = maliyet; a.ucretIst = maliyet; }
}
function tmiKaynakIle(st, kaynak, D) {
  const d = kaynak.durum, ek = kaynak.ek || {}, tk = ek.takvim || null;
  const o = Object.assign({}, st);
  const eski = (dizi, id) => { const x = D && (D[dizi] || []).find(y => String(y.id) === id); return x ? rrKopya(x) : null; };
  const maliyet = (tur, id) => { const g = d.maliyet && d.maliyet[tur] && d.maliyet[tur][id]; return g && g.paraBirimi === 'TRY' ? Number(g.birimMaliyet) : null; };
  if (d.cal) {
    o.cal = Object.assign({}, st.cal || {}, {
      shifts: d.cal.shifts.map(v => ({ id: v.id, name: v.name, start: v.start, end: v.end, breaks: v.breaks.map((b, i) => ({ id: v.id + '~' + i, name: 'Mola', start: b.start, end: b.end })) })),
      holidays: d.cal.holidays.slice(),
    });
  }
  if (Array.isArray(d.wcs)) {
    const merkezler = d.wcs.filter(w => w.aktif !== false);
    const sira = id => ((d.cal && d.cal.shifts) || []).findIndex(v => v.id === id);
    let week = null;
    if (tk) {
      week = {};
      for (let g = 0; g < 7; g++) {
        const v = new Set(); for (const w of merkezler) for (const id of ((tk.hafta[w.id] || {})[g] || [])) if (sira(id) >= 0) v.add(id);
        week[g] = [...v].sort((a, b) => sira(a) - sira(b));
      }
    }
    o.wcs = [{ id: RR_WC, code: '', name: 'Atölye', week }, ...merkezler.map(w => ({ id: w.id, code: w.code, name: w.name, week: null }))];
    /* 650 a: tezgâh kendi iş merkezinin haftasıyla çalışır (rrCevir tezgâha yazar); atölyenin tek takvimi sayfanın gün görünümüdür */
    if (tk) o.merkezHaftalari = Object.fromEntries(merkezler.map(w => [w.id, Object.fromEntries(Array.from({ length: 7 }, (_, g) =>
      [g, ((tk.hafta[w.id] || {})[g] || []).filter(id => sira(id) >= 0).sort((a, b) => sira(a) - sira(b))]))]));
  }
  const istasyonlar = Array.isArray(d.stations) ? d.stations.filter(x => x.aktif !== false) : null;
  if (istasyonlar) o.stations = istasyonlar.map(x => ({ id: x.id, code: x.code, name: x.name, wcId: x.wcId, cost: maliyet('istasyon', x.id), eff: x.eff, opPer: x.opPer, count: x.count }));
  if (Array.isArray(d.machines) && istasyonlar) {
    const ist = new Set(istasyonlar.map(x => x.id));
    o.machines = d.machines.filter(m => m.aktif !== false && ist.has(m.stationId)).map(m => {
      const y = { id: m.id, code: m.code, name: m.name, stationId: m.stationId, status: m.status, note: (ek.makineNotu && ek.makineNotu[m.id]) || '' };
      const a = eski('tezgahlar', m.id); if (a) { y.plan = a; ucretIzle(a, maliyet('istasyon', m.stationId)); }
      return y;
    });
  }
  if (Array.isArray(d.people)) {
    o.people = d.people.filter(k => k.active !== false).map(k => {
      const y = { id: k.id, name: k.name, code: k.code || '', role: (ek.kisiGorevi && ek.kisiGorevi[k.id]) || '', wcId: k.wcId || '', stationId: k.stationId || '',
        shiftId: (tk && tk.kisiVardiyasi[k.id]) || '', cost: maliyet('kisi', k.id), skills: k.skills.slice(), active: true,
        machines: (k.machines || []).slice(), maxMachines: k.maxMachines ?? null };
      const a = eski('personel', k.id); if (a) y.plan = a;
      return y;
    });
  }
  return o;
}
/* Fason firmanın sahibi Müşteri ve Tedarikçi'dir; durum okuması aktif fason firmaları verir (fasonFirms). Motor fason adımı yalnız
   fasoncular listesindeki firmaya yerleştirir; liste boşken her fason adımı yerleşmez. Firma başına süre rota adımlarının termin gününün
   en büyüğüdür (yoksa motorun 1 günü); çıkış günleri takvimin çalışma günleridir; aynı anda iş sınırı yoktur (firmanın kapasitesi bilinmez).
   Sayfada değiştirilen süre, kapasite ve çıkış ayarı aynı kimlikte korunur; ad sahibinden gelir. */
function tmiFasoncular(st, firmalar, D, onceki) {
  const sure = {};
  for (const r of Object.values(st.routes || {})) for (const a of (r && r.steps) || []) {
    if (a.fasonId && +a.terminGun > 0) sure[a.fasonId] = Math.max(sure[a.fasonId] || 0, +a.terminGun);
  }
  const cg = D.calismaGunleri || {};
  const gunler = GUNLER.filter(g => (cg[g] || []).length);
  const eski = id => ((onceki && onceki.fasoncular) || D.fasoncular || []).find(f => String(f.id) === id) || null;
  return firmalar.map(f => {
    const a = eski(String(f.id));
    const y = { id: String(f.id), ad: f.name, kapasite: 999, sureGun: sure[f.id] || 1, cikisGunleri: gunler.length ? gunler : GUNLER.slice(0, 5), cikisSaat: 16 };
    return a ? Object.assign({}, y, rrKopya(a), { id: y.id, ad: y.ad }) : y;
  });
}
/* Gerçek an -> planın saat ekseni (başlangıç günü 00:00'dan saat); okunamazsa null. */
function tmiSaat(D, an) {
  if (an == null) return null; const s = duvarSaati(an); return s == null ? null : parseT(D, s);
}
function tmiIslemler(st, D) {
  const opOf = {};
  for (const o of (st && st.orders) || []) {
    const u = (D.urunler || []).find(x => x.id === o.itemId); if (!u) continue;
    const adimlar = (((st.routes || {})[o.itemId] || {}).steps || []).slice().sort((p, q) => p.seq - q.seq);
    adimlar.forEach((a, i) => { const k = u.rota[i] && u.rota[i].k; if (k != null) opOf[`${o.no}|${a.opNo > 0 ? a.opNo : a.seq}`] = `${o.id}.${k}`; });
  }
  return opOf;
}
/* Adımın işleyeceği adet (24 a): tek kaynak uretim-emirleri (durum.adimAdetleri, yalnız emir adedinden farklı olan). Motor D.opAdet'i okur. */
function tmiAdimAdetleri(durum, st, D) {
  const a = durum && durum.adimAdetleri && typeof durum.adimAdetleri === 'object' ? durum.adimAdetleri : null; if (!a) return undefined;
  const opOf = tmiIslemler(st, D); const y = {};
  for (const [k, n] of Object.entries(a)) if (opOf[k]) y[opOf[k]] = n;
  return y;
}
/* Biten iş (inceleme 1): biten ve iptal emir plana girmez; biten adım motorda st.bitti ile düşer (ardılı onu beklemez). Kaynak sunucunun iş
   emri durumu (durum.emirler) ya da kayıttaki kopyası: { orders: [{ id, status }], opStatus: { "emir|root|sıra": durum } }. Sıra adımın
   rotadaki yeridir (1'den, seq sırasıyla; iş emirleri rotadan bu sırayla açılır). Bütün adımı biten emir de düşer. */
function tmiBitenler(emirler, D) {
  const y = { siparis: {}, adim: {} };
  if (!emirler || typeof emirler !== 'object') return y;
  for (const o of emirler.orders || []) if (o && (o.status === 'tamam' || o.status === 'iptal')) y.siparis[String(o.id)] = 1;
  const durum = emirler.opStatus || {};
  const urun = Object.fromEntries(((D && D.urunler) || []).map(u => [u.id, u]));
  for (const s of (D && D.siparisler) || []) {
    const rota = (urun[s.urun] || {}).rota || [];
    if (y.siparis[s.id] || !rota.length) continue;
    const biten = rota.filter((a, i) => durum[`${s.id}|root|${i + 1}`] === 'tamam');
    if (biten.length === rota.length) y.siparis[s.id] = 1;
    else for (const a of biten) y.adim[`${s.id}.${a.k}`] = 1;
  }
  return y;
}
/* Planın girdisinden biten işi düşürür (st yerinde değişir); biten yoksa st olduğu gibi kalır. Biten siparişin malzemesi tahmini eksik
   satırından da düşer (tmEksikYaz). */
function bitenUygula(st, b) {
  if (!b || !st || !st.D) return st;
  if (Object.keys(b.siparis).length) { st.D.siparisler = (st.D.siparisler || []).filter(s => !b.siparis[s.id]); tmEksikYaz(st); }
  /* 1473 a: biten adımın malzemesi tüketilmiştir; siparişi verilmemiş eksik onsuz yeniden yazılır */
  if (Object.keys(b.adim).length) { st.bitti = Object.assign({}, st.bitti || {}, b.adim); tmEksikYaz(st); }
  return st;
}
/* Başlamış adımlar (391 a): kalanın tek kaynağı sunucudur (durum.calisanAdimlar, anahtar "emir no|OP no"). Anahtar planın işlem kimliğine
   (sipariş.adım) kayıttaki emir ve rota adımından çevrilir; karşılığı olmayan adım (rotasız emir, emirde değişen adım) gelmez. Saatler
   terminalin gerçek saatleridir: sayfanın "şimdi"si (stOf now) planın başlangıç günü 07:00'de sabit kalır, ona bağlanan kalan gerçek
   kullanımda yanlış bitiş verirdi. Kalan sunucunun sayım anından (yoksa başlamadan) yürür (motor kalanBitis ile aynı anlam).
   Dönen: işlem kimliği -> { m, S, kalan (saat, verimli), sayim, n (sağlam), A (adım adedi) }. */
function tmiCalisanlar(durum, st, D, now) {
  const liste = durum && Array.isArray(durum.calisanAdimlar) ? durum.calisanAdimlar : null; if (!liste) return null;
  const opOf = tmiIslemler(st, D);
  const saat = an => tmiSaat(D, an);
  const y = {};
  for (const c of liste) {
    const id = opOf[c.anahtar]; if (!id) continue;
    const S0 = saat(c.baslangic);
    const S = S0 == null ? now : S0; const sayim = saat(c.sayimAni);
    y[id] = { m: c.makineId, S, kalan: Math.max(0, +c.kalanVerimliDk || 0) / 60, sayim: sayim == null ? S : Math.max(S, sayim), n: c.saglam, A: c.adet, sayimAni: c.sayimAni };
  }
  return y;
}
/* Ürün, malzeme, rota ve emrin sahibi Malzemeler, Rota ve Üretim Emirleri'dir. Reçete ve Rota çerçevesi bunları kayda yazmaz (kayıtta
   bağlanmadan önceki yerel emirler kalır, kart #1185); planlama sayfası da sunucu çözücüsü de kaynak okumasındaki güncel dilimleri kaydın
   üstüne koyar (13.1: sonradan açılan emir plana girer). Okunamayan dilim (yetki yok) kayıttaki gibi kalır. Biten ve iptal edilen emir
   çalışmada kalır, motorun girdisinden düşer (tmiBitenler). Tezgâh, ürün ve emrin motor ayarları (plan alt nesnesi) önce açık çalışmadan (planlama sayfasının düzenlediği), yoksa
   kayıttan alınır. */
function sunucuKaydi(kayit, durum, D0, bugun) {
  const k = rrKopya(kayit && kayit.items ? kayit : TMI_BOS_KAYIT);
  const d = durum || {};
  const urun0 = id => ((D0 && D0.urunler) || []).find(u => String(u.id) === id) || null;
  const maliyet = id => { const g = d.maliyet && d.maliyet.malzeme && d.maliyet.malzeme[id]; return g && g.paraBirimi === 'TRY' ? Number(g.birimMaliyet) : null; };
  if (Array.isArray(d.items)) {
    const eski = new Map((k.items || []).map(x => [String(x.id), x]));
    k.items = d.items.map(s => {
      const o = eski.get(s.id) || {};
      const plan = urun0(s.id) || o.plan;
      return Object.assign({}, o, { id: s.id, code: s.code, name: s.name, type: s.type, unit: s.unit || '', cost: maliyet(s.id), stock: s.stock == null ? null : s.stock }, plan ? { plan } : {});
    });
  }
  if (Array.isArray(d.opdefs)) k.opdefs = d.opdefs.map(s => ({ id: s.id, code: s.code, name: s.name }));
  if (d.routes && Array.isArray(d.routeRevs)) {
    k.routes = Object.assign({}, k.routes || {});
    const eskiAdim = (id, s) => ((((kayit && kayit.routes) || {})[id] || {}).steps || []).find(x => x.id === s.id) || null;
    for (const id of new Set(d.routeRevs.map(r => r.itemId))) {
      const r = d.routes[id]; if (!r) { delete k.routes[id]; continue; }
      const u = urun0(id);
      const steps = (r.steps || []).slice().sort((p, q) => p.seq - q.seq).map(s => {
        /* çerçevenin süre kuralı (sureNormalle): çevrim işlem + değişim; işlem yoksa birim süre */
        const sayi = v => typeof v === 'number' && isFinite(v) && v >= 0 ? v : null;
        const proc = s.proc === undefined ? (sayi(s.cycle) || 0) : sayi(s.proc), chg = s.proc === undefined ? null : sayi(s.chg);
        const plan = (u && (u.rota || []).find((x, j) => rrSeq(x, j) === s.seq)) || (eskiAdim(id, s) || {}).plan;
        return Object.assign({}, s, { proc, chg, cycle: (proc || 0) + (chg || 0), depQty: s.depQty > 0 ? s.depQty : 1, minLot: s.minLot || 0, alts: (s.alts || []).slice(), altTimes: Object.assign({}, s.altTimes || {}), ins: (s.ins || []).map(x => ({ itemId: x.itemId, qty: x.qty })) }, plan ? { plan } : {});
      });
      k.routes[id] = { base: (k.routes[id] && k.routes[id].base) || 1, steps };
    }
  }
  const e = d.emirler;
  if (e && Array.isArray(e.orders)) {
    /* başlangıcı olmayan emir bugünden başlar; teslimi olmayanın termini yoktur (kural 5): bugüne bitmiş sayılıp "gecikiyor" görünmez */
    const sip0 = id => ((D0 && D0.siparisler) || []).find(s => String(s.id) === id) || null;
    const eskiEmir = new Map((k.orders || []).map(x => [String(x.id), x]));
    k.orders = e.orders.map(x => {
      const plan = sip0(x.id) || (eskiEmir.get(x.id) || {}).plan;
      /* 678 a: başlangıcı olmayan emir bugünün başından serbesttir; ilk vardiyanın saati (kayıtta takvim yokken 08:00) beklenmez */
      return Object.assign({ id: x.id, no: x.no, itemId: x.itemId, qty: x.qty, start: x.start || bugun, due: x.due || null, priority: x.priority, status: x.status, note: x.note || '', sunucu: true }, x.start ? {} : { serbestSaat: '00:00' }, plan ? { plan } : {});
    });
  }
  return k;
}

/* Kayıttan çalışma verisi (D): kaynak okuması varsa tezgâh, kişi, takvim, fason firma ve adım adedi ondan; yoksa kayıttaki gibi.
   D0 açık çalışmanın verisidir: başlangıç ve motor ayarları (plan alt nesnesi) aynı kimlikte korunur. */
function tmiCevir(st, kaynak, D0, bugun) {
  const k = kaynak && kaynak.durum ? kaynak : null;
  /* rota ve emir no'su sunucunun kaydındandır: kayıttaki emirler bağlanmadan önceki yerel emirler olabilir, "emir no|OP" eşlenmez */
  const sk = k ? sunucuKaydi(st, k.durum, D0, bugun || duvarSaati(Date.now()).slice(0, 10)) : st;
  const D = rrCevir(k ? tmiKaynakIle(sk, k, D0) : st);
  if (!D.meta && D0 && D0.meta) D.meta = rrKopya(D0.meta);
  tmiTabanKur(D, bugun);
  const firmalar = k && k.durum.fasonFirms;
  if (Array.isArray(firmalar)) D.fasoncular = tmiFasoncular(sk, firmalar, D, D0);
  const adet = tmiAdimAdetleri(k && k.durum, sk, D); if (adet) D.opAdet = adet;
  if (k && Array.isArray(k.durum.stations)) tmiOperatorOrani(D.tezgahlar, k.durum.stations);
  const kp = k && k.ek && k.ek.kapasite;
  if (kp && Array.isArray(kp.kisiler)) D.devamsizlik = tmiDevamsizlik(D0 ? D0.devamsizlik : D.devamsizlik, kp.kisiler);
  const sa = k && k.ek && k.ek.acikSiparisler;
  if (Array.isArray(sa)) { const y = tmiSatinalma(D0 ? D0.satinalma : D.satinalma, sa); if (y) D.satinalma = y; }
  if (Array.isArray(D.malzemeler)) tmiTerminler(D.malzemeler, k && k.ek ? k.ek.tedarikTerminleri : null, D0 ? D0.malzemeler : null);
  if (k && k.ek && 'malzemeFiyatlari' in k.ek && Array.isArray(D.malzemeler)) tmiFiyatlar(D.malzemeler, k.ek.malzemeFiyatlari);
  if (k && k.ek && 'siparisBedelleri' in k.ek && Array.isArray(D.siparisler)) tmiSiparisBedelleri(D.siparisler, k.ek.siparisBedelleri);
  return D;
}
/* 1280 a, 1329: ham malzemenin birim fiyatı Satın Alma'dandır: alış ortalaması, yoksa kg fiyatından tahmini (fiyatTahmini), yoksa null
   (bilinmez; sıfır sayılmaz). kgRef Satın Alma'nın geçerli kg fiyatı ve tarihidir, yalnız başvuru. Her okumada yeniden kurulur; okunamadıysa
   (null: maliyeti görmeyen) önceki kayıttaki fiyat da taşınmaz, alanlar boştur. Alanı hiç taşımayan ek (fiyatı okumayan eski çağıran)
   malzemenin kaynaktan gelen fiyatını değiştirmez. */
function tmiFiyatlar(malzemeler, l) {
  const F = new Map((Array.isArray(l) ? l : []).map(x => [String(x.kod), x]));
  for (const m of malzemeler) {
    delete m.fiyatTahmini; delete m.kgRef;
    const x = F.get(m.kod), kg = x && x.kg;
    const tahmini = !x || x.alisFiyati != null ? null : kg && kg.tlBirimFiyati != null ? kg.tlBirimFiyati : null;
    m.birimFiyat = x && x.alisFiyati != null ? x.alisFiyati : tahmini;
    if (tahmini != null) m.fiyatTahmini = true;
    if (kg) m.kgRef = { kalite: kg.kaliteKodu, form: kg.form, tarih: kg.gecerlilik, tlKg: kg.tlKgFiyati, kgFiyati: kg.kgFiyati, paraBirimi: kg.paraBirimi };
  }
}
/* 1460 a, 1461 a: emrin geliri (TL) ve gecikme cezası (günlük oran ve tavan, tutarın yüzdesi) siparişindendir; sayfada elle girilen gelir
   ve günlük TL ceza (cezaGun) bunlara yer verir. l emir kimliğinden değerlere: listedeki emrin değeri yazılır (bilinmeyen null), listede
   olmayan sipariş (sayfanın kendi denemesi) dokunulmaz. l null ise emirler okunamamıştır: önceki kayıttaki değer taşınmaz, alanlar boştur.
   Alanı hiç taşımayan ek (eski çağıran) dokunmaz. */
function tmiSiparisBedelleri(siparisler, l) {
  const sayi = v => (v == null || !isFinite(+v) ? null : +v);
  for (const s of siparisler) {
    if (l && !Object.prototype.hasOwnProperty.call(l, s.id)) continue;
    const x = l ? l[s.id] : null;
    s.gelir = sayi(x && x.gelir); s.cezaOran = sayi(x && x.cezaOran); s.cezaTavan = sayi(x && x.cezaTavan); s.cezaGun = null;
  }
}
/* 561 1 b: TMI'de tezgâhın operatör oranı istasyonun plan ayarıdır (çalışan bir makinenin istediği operatör; "bir operatör en çok N
   tezgâh" 1/N yazar). Planlamada girilmez: kaynak okundukça istasyonunkiyle yazılır; istasyonu okunmayan tezgâhta oran 1 sayılır. */
function tmiOperatorOrani(tezgahlar, istasyonlar) {
  const O = new Map(istasyonlar.map(x => [String(x.id), x.opPer]));
  for (const m of tezgahlar || []) { const v = O.get(String(m.grup)); m.opOran = v == null || !isFinite(+v) ? 1 : +v; }
}
/* 533 a: Satın Alma'nın tedarik termini malzemede durur (saTermin 'GGGG-AA-GG' ya da null; saSurum yazma ucunun sürümü). Okunamadıysa
   (null) açık çalışmadaki değer kalır; satırı olmayan malzemede alan yoktur (termin bekleniyor). */
function tmiTerminler(malzemeler, l, eski) {
  const T = Array.isArray(l) ? new Map(l.map(x => [String(x.kod), x])) : null;
  const E = new Map((eski || []).map(m => [m.kod, m]));
  for (const m of malzemeler) {
    delete m.saTermin; delete m.saSurum; delete m.saAciklama;
    const x = T ? T.get(m.kod) : E.get(m.kod);
    if (!x) continue;
    const termin = T ? x.termin : x.saTermin, surum = T ? x.surum : x.saSurum, aciklama = T ? x.aciklama : x.saAciklama;
    if (surum == null) continue;
    Object.assign(m, { saTermin: termin || null, saSurum: surum }, aciklama ? { saAciklama: aciklama } : {});
  }
}
/* 525 1 a: satın almanın açık siparişi (kalan miktar, beklenen teslim) motorda satın alma satırıdır. Sunucudan gelen satır işaretlidir ve
   her okumada yeniden kurulur; planlamacının sayfada verdiği sipariş satırı kalır. Teslim günü yoksa geliş boştur: durum.betik tmUygula
   termini olmayan satır gibi tahmin eder. Sunucu satırı hiç yoksa ve gelmediyse alan değişmez (null). */
function tmiSatinalma(eski, l) {
  const elle = (eski || []).filter(p => !p.sunucu);
  if (!l.length && elle.length === (eski || []).length) return null;
  return [...elle, ...l.map(x => ({ kod: String(x.kod), miktar: +x.miktar, gelis: x.tarih ? x.tarih + ' 08:00' : null, tedarikci: '', no: x.siparisNo, sunucu: true }))];
}
/* 13.4: kişinin onaylı izni (İK, Vardiya'nın kişi takvimiyle; /recete-rota/kapasite izinli günleri) motorda devamsızlıktır. Sunucudan
   gelen gün işaretlidir ve her okumada yeniden kurulur; planlamacının elle girdiği devamsızlık kalır. */
function tmiDevamsizlik(eski, kisiler) {
  const elle = (eski || []).filter(d => !d.sunucu);
  const elleGun = new Set(elle.map(d => (d.personel || d.kisi) + '@' + d.gun));
  const yeni = [];
  for (const p of kisiler) for (const gun of p.izinli || []) if (!elleGun.has(p.id + '@' + gun)) yeni.push({ personel: String(p.id), gun, sunucu: true });
  return [...elle, ...yeni];
}

/* ürünler de: rota adımının tezgâh listesi makinelerden kurulur (rrCevir grupMak), makine gelince adımlar yeniden kurulmalı. Malzeme ve
   sipariş kaynak okumasındaki sunucu kayıtlarındandır (sunucuKaydi). */
const TMI_KAYNAK_ALANLARI = ['tezgahlar', 'personel', 'vardiyalar', 'calismaGunleri', 'tatiller', 'urunler', 'malzemeler', 'siparisler', 'fasoncular', 'opAdet', 'devamsizlik', 'satinalma'];
/* Kaynaklar açık çalışmaya (D0) yalnız bu alanlarla girer: kaydın geri kalanı ve kaydedilmemiş plan ayarları olduğu gibi kalır. Dönen: değişen alanlar. */
function kaynakBirlestir(D0, kayit, kaynak, bugun) {
  const D = tmiCevir(kayit && kayit.items ? kayit : TMI_BOS_KAYIT, kaynak, D0, bugun);
  /* sipariş önceliği sayfada ağırlıktan hesaplanır (durum.betik agHazirla, her st kurulumunda S.D'ye yazar): iki taraf aynı hesaptan
     geçmeden karşılaştırılırsa sunucunun önceliği her açılışta değişmiş görünür, sayfa ortak kayda yazar (aynı anda açana çakışma) */
  let D0k = D0;
  if (typeof agHazirla === 'function' && Array.isArray(D.siparisler)) {
    agHazirla(Object.assign({}, D0, ...TMI_KAYNAK_ALANLARI.filter(a => D[a] !== undefined).map(a => ({ [a]: D[a] }))));
    D0k = rrKopya(D0); agHazirla(D0k);
  }
  const alanlar = TMI_KAYNAK_ALANLARI.filter(a => D[a] !== undefined && !rrEsit(D[a], D0k[a]));
  for (const a of alanlar) D0[a] = D[a];
  if (alanlar.length) tmiTabanKur(D0, bugun);
  return alanlar;
}
/* Sayım yalnız o adımın çubuğunu günceller, başka iş yerinden oynamaz (prototip zz34); plan eskimez. Planlamacının elle girdiği gerçekleşen
   sunucunun başlamış dediği adımda sunucununkiyle değişir; sunucunun artık başlamış demediği adımın sunucu kaydı silinir. y: tmiCalisanlar,
   cx: çalışmanın derlenmiş hâli (tezgâh pencereleri). S.gercek ve S.plan yerinde güncellenir. */
function calisanBirlestir(S, y, cx) {
  const g = clone(S.gercek || {}); let degisti = false; const yeniSapma = [];
  for (const id of Object.keys(g)) if (g[id] && g[id].sunucu && !y[id]) { delete g[id]; degisti = true; }
  for (const [id, a] of Object.entries(y)) {
    const r = S.plan && S.plan.ops[id]; const m = a.m && cx && cx.M[a.m] ? a.m : r ? r.m : a.m;
    /* 878 a: makinesi planda olmayan (pasif, kapsam dışı ya da tanımsız) çalışan adım plana girmez; motor onu tezgâhsız yerleştiremez.
       Ekran onu "çalışıyor, planda yok" diye gösterir (487/2 b). */
    if (cx && !cx.M[m]) { if (g[id]) { delete g[id]; degisti = true; } continue; }
    const yeni = { ...a, m, sunucu: 1, planC: g[id] && g[id].planC != null ? g[id].planC : r ? r.C : null };
    if (rrEsit(g[id], yeni)) continue;
    g[id] = yeni; degisti = true;
    const M = cx && cx.M[m]; if (!r || !M) continue;
    const C = kalanBitis(M, yeni); const o = cx.byId[id]; const c = o && (o.c.find(x => x.m === m) || o.c[0]);
    const Su = Math.min(adv(M.sw, yeni.S, (c && c.su) || 0), C);
    S.plan = { ...S.plan, ops: { ...S.plan.ops, [id]: { ...r, m, S: yeni.S, Su, C, lot1: Math.min(C, Math.max(Su, r.lot1 || Su)), act: 1, pin: 1, adetN: yeni.n } } };
    yeniSapma.push(id);
  }
  if (degisti) S.gercek = g;
  return { degisti, yeniSapma };
}

/* Kısıt gevşetmeleri motoru değiştirmez; veriyi değiştirir. Böylece "bu kısıt olmasaydı" sorusu aynı motorla ölçülür. */
const GEVSEK = {
  tvardiya: st => { for (const m of st.D.tezgahlar) delete m.vardiyalar; },
  tatil: st => { st.D.tatiller = []; },
  ariza: st => { st.down = []; },
  tampon: st => { st.w.tampon = false; },
  /* oran yalnız kapasiteden düşer; operatör ücreti (durum.betik ymUygula) asıl oranla sayılır */
  personel: st => { for (const m of st.D.tezgahlar) { m.opMaliyet = m.opOran == null ? 1 : +m.opOran; m.opOran = 0; } },
  yetkin: st => { const g = [...new Set(st.D.tezgahlar.map(m => m.grup))]; for (const p of st.D.personel) { p.gruplar = g.slice(); delete p.makineler; delete p.enCok; } },
  devam: st => { st.D.devamsizlik = []; },
  ayarci: st => { for (const v of st.D.vardiyalar) for (let i = 0; i < 40; i++) st.D.personel.push({ id: `~A${v.id}${i}`, ad: 'sanal ayarcı', vardiya: v.id, gruplar: [], ayar: true }); },
  aparat: st => { for (const a of st.D.aparatlar || []) a.adet = 999; },
  program: st => { st.D.ayarlar.programSaat = 0; },
  fai: st => { for (const u of st.D.urunler) for (const o of u.rota) o.fai = false; },
  serbest: st => { for (const s of st.D.siparisler) s.serbest = null; },
  tasima: st => { st.D.ayarlar.tasimaSaat = 0; },
  fasonGun: st => { for (const f of st.D.fasoncular || []) f.cikisGunleri = GUNLER.slice(); },
  fasonKap: st => { for (const f of st.D.fasoncular || []) f.kapasite = 999; },
  ayar: st => { for (const u of st.D.urunler) for (const o of u.rota) for (const t of o.tezgahlar || []) t.ayar = 0; st.D.ayarMatrisi = []; },
  malzeme: st => { st.w.mat = 'uyari'; },
};
/* 561 2 a: personel kısıtı (operatör oranı) kullanıcı Kısıtlar sayfasından açana kadar kapalıdır. kisitSurum 2 olan çalışmada
   kapali listesi kullanıcının kararıdır; daha eski çalışmada listeye personel eklenir. */
const KISIT_SURUM = 2;
function kapaliKisitlar(S) {
  const k = Array.isArray(S.kapali) ? S.kapali : [];
  return (+S.kisitSurum || 0) >= KISIT_SURUM || k.includes('personel') ? k.slice() : [...k, 'personel'];
}
/* 776 b: kural motor ayarındandır (sunucu çalışmaya yazar, motor-ayari-kurallar.ts); tanınmayan ya da eski kayıttaki değer ATCS'ye düşer */
const MOTOR_KURALI = new Set(['atcs', 'oncelik', 'edd', 'cr', 'spt', 'fifo']);
function stKur(S, ek = [], gevset = true) {
  const D = clone(S.D);
  D.ayarlar = D.ayarlar || {};
  /* havuzdaki sipariş plana henüz alınmamıştır; motor onu görmez */
  D.siparisler = D.siparisler.filter(s => !s.havuz);
  const st = {
    D, now: 7, down: S.down.map((d, i) => ({ ...d, id: 'd' + i })), ekMesai: clone(S.ekMesai), eksik: [],
    locks: clone(S.locks), pref: {}, boost: {}, gercek: clone(S.gercek || {}), sapma: {}, saGecik: {}, ogren: {},
    w: { ...clone(W0), rule: MOTOR_KURALI.has(S.w.rule) ? S.w.rule : W0.rule, famK: +S.w.famK, mat: S.w.mat, dondurma: +S.w.dondurma, tampon: !!S.param.tampon, tamponZ: +S.param.tamponZ, acilPay: +S.param.acilPay, mesaiHafta: +(S.param.mesaiHafta ?? W0.mesaiHafta),
      /* 1477 a: motor ölçeği (sistem ayarı); yoksa motor varsayılanı (engine olcekKur) */
      ufukGun: S.w.ufukGun ?? null, dilimDk: S.w.dilimDk ?? null },
  };
  const kapali = new Set([...(gevset ? kapaliKisitlar(S) : []), ...ek]);
  for (const k of kapali) if (GEVSEK[k]) GEVSEK[k](st);
  /* Soru 159 b: vardiyası olan ayarcı yoksa ayarcı sınırı uygulanmaz (yoksa ayarlı hiçbir adım yerleşmez); motor bunu uyarıyla söyler */
  if (!kapali.has('ayarci') && ayarciYok(D)) { GEVSEK.ayarci(st); st.ayarciYok = true; }
  for (const ev of S.olaylar || []) applyEvent(st, ev);
  return st;
}
function ayarciYok(D) {
  const v = new Set((D.vardiyalar || []).map(x => x.id));
  return !(D.personel || []).some(p => p.ayar && v.has(p.vardiya));
}
/* 31 a: sayfanın "şimdi"si yeniden planlamada gerçek saate geçer (S.simdi). Gerçek saat yoksa başlangıç günü 07:00'dir; 741 a: gerçek
   saat 07:00'den önce de geçerlidir (gece önceki günün vardiyasının devamıdır, iş takvimdeki vardiyayla yerleşir). */
function simdiUygula(st, S) { if (S && S.simdi != null && isFinite(+S.simdi) && +S.simdi >= 0) st.now = +S.simdi; return st; }
/* 36 a: motorun ufku başlangıçtan HDAYS gündür; başlangıç sabit kalırsa ufuk biter. Kayıtlı bütün plan saatleri başlangıç günü 00:00'dan
   sayıdır: başlangıç g gün ileri alınınca her saat 24g, her gün sırası g azalır. Tarih metinleri (termin, tatil) ve gerçek anlar (canlı
   yerleşim) olduğu gibi kalır. Geçmişte kalan plan işi düşmez (taban planda olmayan iş yeniden yerleşirdi), eksi saatte tamamlanmış sayılır;
   yalnız yeni günden önce bitmiş arıza ve fazla mesai düşer. Gece vardiyası ertesi güne taştığı için önceki günün mesaisi kalır. */
const BASLANGIC_ESIGI = 7;
const kaydirSayi = (x, k, h) => { if (x && typeof x[k] === 'number') x[k] -= h; };
const kaydirAlan = (x, alanlar, h) => { if (x) for (const k of alanlar) kaydirSayi(x, k, h); };
function gunFarki(a, b) {
  const t = s => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(typeof s === 'string' ? s : ''); return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) : NaN; };
  const f = Math.round((t(b) - t(a)) / 86400000); return isFinite(f) ? f : null;
}
function planKaydir(p, h) {
  if (!p || typeof p !== 'object') return;
  for (const r of Object.values(p.ops || {})) kaydirAlan(r, ['S', 'Su', 'C', 'lot1'], h);
  for (const j of Object.values(p.J || {})) kaydirSayi(j, 'C', h);
  kaydirSayi(p.ozet, 'Cmax', h); kaydirSayi(p.oncekiOzet, 'Cmax', h);
  for (const k in p.lbC || {}) kaydirSayi(p.lbC, k, h);
}
/* nabız ve sabit referansın kısa kayıtları: işlem [tezgâh, başlangıç], sipariş [bitiş, gecikme] */
function kisaKaydir(l, i, h) { for (const k in l || {}) if (Array.isArray(l[k]) && typeof l[k][i] === 'number') l[k][i] -= h; }
const OLAY_SAATI = { ariza: 'bas', acil: 'termin' };
const OLAY_GUNU = { eksik: 'gun', mesai: 'gun' };
/* x: çalışma ya da senaryo (her biri kendi D'siyle). Dönen: kayan gün; başlangıç yoksa ya da yeni gün ileride değilse 0, hiçbir şey değişmez. */
function durumKaydir(x, yeni) {
  const g = x && x.D && x.D.meta ? gunFarki(x.D.meta.baslangic, yeni) : null; if (!(g > 0)) return 0;
  const h = g * 24;
  x.D.meta.baslangic = yeni;
  for (const s of x.D.siparisler || []) kaydirAlan(s, ['termin', 'serbest'], h);
  for (const s of x.D.satinalma || []) kaydirSayi(s, 'gelis', h);
  if (Array.isArray(x.down)) { for (const d of x.down) kaydirAlan(d, ['from', 'to'], h); x.down = x.down.filter(d => !(typeof d.to === 'number' && d.to <= 0)); }
  if (Array.isArray(x.ekMesai)) { for (const e of x.ekMesai) kaydirSayi(e, 'gun', g); x.ekMesai = x.ekMesai.filter(e => !(typeof e.gun === 'number' && e.gun < -1)); }
  for (const l of Object.values(x.locks || {})) kaydirSayi(l, 'S', h);
  for (const a of Object.values(x.gercek || {})) kaydirAlan(a, ['S', 'C', 'sayim'], h);
  for (const ev of x.olaylar || []) { if (OLAY_SAATI[ev.tip]) kaydirSayi(ev, OLAY_SAATI[ev.tip], h); if (OLAY_GUNU[ev.tip]) kaydirSayi(ev, OLAY_GUNU[ev.tip], g); }
  planKaydir(x.plan, h);
  /* senaryo planın özetini ve sipariş bitişlerini ayrıca da tutar */
  planKaydir({ J: x.J, ozet: x.ozet }, h);
  return g;
}
/* Çalışmanın başlangıcı yeni güne (GGGG-AA-GG) alınır; senaryolar kendi başlangıçlarından kayar. Dönen: çalışmanın kayan günü. */
function baslangicKaydir(S, yeni) {
  const g = durumKaydir(S, yeni); if (!g) return 0;
  const h = g * 24;
  for (const s of S.senaryolar || []) durumKaydir(s, yeni);
  for (const n of [S.nbSabit, ...(S.nabiz || [])]) if (n) { kaydirSayi(n.o, 'cmax', h); kisaKaydir(n.ops, 1, h); kisaKaydir(n.J, 0, h); }
  for (const l of Object.values(S.sevkIz || {})) for (const k of l || []) kaydirAlan(k, ['C', 'due'], h);
  for (const k of S.paGecmis || []) kaydirSayi(k.ozet, 'Cmax', h);
  kaydirSayi(S, 'simdi', h);
  return g;
}
/* Gerçek gün başlangıçtan BASLANGIC_ESIGI gün ya da daha ilerideyse başlangıç o güne alınır (eşik her gün kaydırıp bütün kaydı yeniden
   yazmamak için). an: gerçek an (ms). Dönen: kayan gün, kaymadıysa 0. */
function baslangicTazele(S, an) {
  const s = duvarSaati(an); if (!s || !S || !S.D || !S.D.meta) return 0;
  const bugun = s.slice(0, 10), g = gunFarki(S.D.meta.baslangic, bugun);
  return g != null && g >= BASLANGIC_ESIGI ? baslangicKaydir(S, bugun) : 0;
}
/* 651 a: arızadaki ya da bakımdaki makine (kaynak okumasının makine durumu) kendiliğinden bir duruş satırı alır: şimdiden tezgâhın
   şimdiki (yoksa sıradaki) vardiyasının sonuna. Satır S.down'dadır ve oto işaretlidir; planlamacı onu silebilir ya da değiştirebilir.
   S.arizaOto o duruş için satırın açıldığını tutar: silinen satır makine yeniden çalışana kadar geri gelmez. Makine çalışır olunca
   açık oto satırı şimdide kapanır (henüz başlamamışsa düşer). makineler: durum.machines, cx: çalışmanın derlenmiş hâli. Dönen: değişti mi. */
const ARIZA_OTO_NEDEN = { ariza: 'arıza', bakim: 'bakım' };
function otoVardiyaSonu(cx, m, now) {
  const M = cx.M[m]; if (!M) return null;
  let en = null;
  for (let d = Math.floor(now / 24) - 1; d <= Math.floor(now / 24) + 7; d++) for (const v of cx.D.vardiyalar || []) {
    const a = d * 24 + hm(v.bas); let b = d * 24 + hm(v.bit); if (b <= a) b += 24;
    if (b <= now || !M.sw.some(([x, y]) => x < b && y > a)) continue;
    const k = [a > now ? 1 : 0, a > now ? a : b];
    if (!en || k[0] < en.k[0] || (k[0] === en.k[0] && k[1] < en.k[1])) en = { k, b };
  }
  return en ? en.b : null;
}
/* derleme yalnız arızadaki makine ya da açık oto duruş varken yapılır (stTamKur çalışmaya ilk kurulum ayarlarını yazar) */
const otoArizaGerekli = (S, makineler) => Array.isArray(makineler) && (makineler.some(x => ARIZA_OTO_NEDEN[x.status]) || Object.keys(S.arizaOto || {}).length > 0);
function otoArizaUygula(S, makineler, cx) {
  if (!Array.isArray(makineler) || !cx) return false;
  const now = cx.st.now; let degisti = false;
  const oto = Object.assign({}, S.arizaOto || {});
  for (const x of makineler) {
    const m = String(x.id);
    if (ARIZA_OTO_NEDEN[x.status]) {
      if (oto[m] || !cx.M[m]) continue;
      const to = otoVardiyaSonu(cx, m, now);
      S.down = [...(S.down || []), { m, from: now, to: to == null ? now + 8 : to, neden: ARIZA_OTO_NEDEN[x.status], oto: 1 }].sort((a, b) => a.from - b.from);
      oto[m] = x.status; degisti = true;
    } else if (oto[m]) {
      S.down = (S.down || []).filter(d => !(d.oto && d.m === m && d.from >= now)).map(d => d.oto && d.m === m && d.to > now ? { ...d, to: now } : d);
      delete oto[m]; degisti = true;
    }
  }
  if (degisti) S.arizaOto = oto;
  return degisti;
}
/* Çalışmanın açılışı, çerçevenin sırasıyla: kayıttan yükleme (zz31 yukle), kayıt çalışmadan sonra değiştiyse yeniden çeviri (zz27 rrCek,
   ilk çizimde), eski kayıtta 1650 kararlarının taşınması (zz-karar-1650, çizimden sonra), kaynak okuması (zz31 kaynakUygula) ve başlamış adımlar (zz31 calisanUygula);
   st sayfanın stOf'uyla aynı yoldan (durum.betik stTamKur). calisma: ortak çalışma kaydı (S), kayit: Reçete ve Rota
   kaydı, kaynak: { durum, ek } (çerçevenin kaynakOku cevabı) ya da null. Girdiler değişmez. Dönen: { S, st }; çalışma yoksa null. */
function girdiKur(calisma, kayit, kaynak, bugun) {
  if (!calisma || !calisma.D) return null;
  const S = clone(calisma); tmiTabanKur(S.D, bugun);
  const k = kayit && kayit.items ? kayit : null;
  /* veri değişince plan eskir (S.dataVer), çerçevedeki gibi (zz27 rrCek, zz31 kaynakUygula); başlamış adım planı eskitmez. Kayıt okunmuş
     sayılır (rrSavedAt): sayfa çalışmayı yazınca aynı kayıt yeniden çevrilip planı her açılışta yeniden eskitmez. */
  if (k && S.rrSavedAt != null && (k.savedAt || 0) !== S.rrSavedAt) {
    const D = tmiCevir(k, null, S.D, bugun); S.rrSavedAt = k.savedAt || 0;
    if (!rrEsit(D, S.D)) { S.D = D; S.dataVer = (+S.dataVer || 0) + 1; }
  }
  karar1650Goc(S);
  const kn = kaynak && kaynak.durum ? kaynak : null;
  /* biten iş motorun girdisinden düşer, sayfanın stOf'u gibi (zz31): sunucunun iş emri durumu, okunamadıysa kayıttaki kopyası */
  const stBitenle = () => bitenUygula(stTamKur(S), tmiBitenler((kn && kn.durum.emirler) || k, S.D));
  if (kn) {
    if (kaynakBirlestir(S.D, k, kn, bugun).length) S.dataVer = (+S.dataVer || 0) + 1;
    if (otoArizaGerekli(S, kn.durum.machines) && otoArizaUygula(S, kn.durum.machines, compile(stBitenle()))) S.dataVer = (+S.dataVer || 0) + 1;
    if (Array.isArray(kn.durum.calisanAdimlar)) {
      const cx = compile(stBitenle());
      /* çerçevede tmiCalisanlar sunucunun emirleriyle sarılıdır (zz40 sunucuyla); burada aynı kayıt doğrudan verilir */
      const y = tmiCalisanlar(kn.durum, sunucuKaydi(k, kn.durum, S.D, bugun), S.D, cx.st.now); if (y) calisanBirlestir(S, y, cx);
    }
  }
  return { S, st: stBitenle() };
}

/* 657 a: kayıt yoksa yeni Planlama sayfası boş çalışmayı sunucuya kurdurur. Değerler çerçevenin yeniCalisma'sıyla aynıdır (a-durum.betik ve
   zz31-tmi.betik): veri Reçete ve Rota kaydından (kayıt yoksa boş kayıttan), kayıt okunmuş sayılır, 1650 kararının varsayılanı konur. */
const BOS_KAYIT = { items: [], routes: {}, machines: [], stations: [], opdefs: [], orders: [], people: [] };
function yeniCalismaKur(kayit, kaynak, bugun) {
  const k = kayit && kayit.items ? kayit : null;
  const D = tmiCevir(k || BOS_KAYIT, kaynak && kaynak.durum ? kaynak : null, null, bugun);
  if (D.planDenge == null) D.planDenge = 25;
  tmiTabanKur(D, bugun);
  return {
    surum: 2, setId: 'tmi', D, down: [], ekMesai: [], locks: {}, pref: {},
    w: { dondurma: 4, famK: 0.3, mat: 'karma', sure: 10 },
    param: { tampon: true, tamponZ: 1.28, acilPay: 0.05, maxChg: 15, chgTL: 50, bolmeKip: 'otomatik', bolmeMin: 5, bolmeMaks: 3, bolmeEsik: 1000 }, kapali: ['personel'], kisitSurum: 2, bedel: null,
    olaylar: [], plan: null, dataVer: 1, senaryolar: [], canli: null, canliSurum: 0, tabanSurum: 0, iz: [], rrSavedAt: k && k.savedAt ? k.savedAt : 0,
  };
}

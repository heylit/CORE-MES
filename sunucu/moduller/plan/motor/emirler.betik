/* ---------- Sunucu çözücüsünün girdisi (ADR 0018 karar 3 ve 5) ----------
   Asıl plana yazan komutta plan modülü işleri kendi kimlikleriyle verir (anahtar "emir no|OP no", makine kimliği, gerçek an). Bu dosya
   onları motorun diline çevirir; girdi.betik ve durum.betik ile aynı bağlamda yüklenir (plan-girdisi.ts), sayfa nesnesi kullanmaz.
   Reçete ve Rota çerçevesi sunucunun emir, malzeme ve rotasını kayda yazmaz (kayıtta bağlanmadan önceki yerel emirler kalır, kart #1185);
   sunucu bu yüzden kaynak okumasındaki güncel dilimleri kaydın üstüne koyar (çerçevenin baglaUygula'sının ekransız karşılığı). */

/* Kaydın planlama alanları (P) açık çalışmanındır: başlangıç, takvim ve ayarlar sayfada değişir. Dağılan diziler kayıttan kurulur. */
function sunucuPlani(D0) {
  const P = {};
  for (const x of Object.keys(D0 || {})) if (!RR_DAGILAN.includes(x)) P[x] = rrKopya(D0[x]);
  return P;
}

/* Dönen: { S, st, baslangic, yerlesmeyen, kimlik } ya da çalışma yoksa null. istek: plan modülünün PlanMotoruIstegi'si, anlar ISO metin.
   - Yalnız istekte geçen emirler plana girer; havuzdaki (taslak) emir de, istekte geçiyorsa.
   - Vardiyası tanımsız tezgâhtaki kuyruk işi vardiyasiz'dadır, dizilmez (168 b).
   - Kuyruktaki işler taban plana tezgâh sırasıyla girer; sıra anahtarı dondurma sınırının ötesindedir (dondurulmaz, sabit kipte dizilir).
   - Sabit iş gerçek saatiyle bağlanır; motorda karşılığı yoksa tezgâhı o aralıkta kapalı sayılır (başka iş üstüne yerleşmez).
   - Çalışan adım çerçevedeki gibi sunucunun kalanıyla (calisanBirlestir).
   - Emrin istekte geçmeyen adımı (bitmiş, fason ya da kişi kaynaklı) şimdi bitmiş sayılır: ardılını bekletmez.
   Açık çalışmanın denemeye ait parçaları (kilit, olay, elle gerçekleşen) asıl plana girmez; arıza, fazla mesai ve kısıt gevşetmeleri
   (S.kapali: atölyenin planlama modeli, örneğin ayarcı tutulmuyorsa ayarcı kısıtı kapalı) girer. */
function sunucuCozumGirdisi(calisma, kayit, kaynak, istek, bugun) {
  if (!calisma || !calisma.D) return null;
  const S0 = clone(calisma);
  tmiTabanKur(S0.D, bugun);
  baslangicTazele(S0, Date.parse(istek.simdi));
  Object.assign(S0, { locks: {}, olaylar: [], gercek: {}, rrSavedAt: -1 });
  const nolar = new Set();
  for (const a of [...istek.kuyruklar.flatMap(q => q.anahtarlar), ...istek.sabitler.map(x => x.anahtar), ...istek.calisanlar.map(x => x.anahtar)]) nolar.add(a.slice(0, a.lastIndexOf('|')));
  /* 1408: taslağın denemesi (P6) ve emir önizlemesi girdiye uygulanır, sahibi modülün verisi değişmez. Sanal emir (acil sipariş, önizlenen
     emir) sunucunun emirlerine ürünün yürürlükteki rotasıyla eklenir; öncelik ve teslim denemesi emrin kendisine. */
  const sanal = (istek.sanalEmirler || []).map(x => ({ id: 'sanal-' + x.no, no: x.no, itemId: String(x.malzemeId), qty: x.adet, start: x.baslangic || null, due: x.teslim || null, priority: x.oncelik, status: 'serbest' }));
  const degisen = new Map((istek.emirDegisiklikleri || []).map(x => [x.emirNo, x]));
  const denemeli = o => { const d = degisen.get(o.no); return d ? Object.assign({}, o, d.oncelik != null ? { priority: d.oncelik } : {}, d.teslim != null ? { due: d.teslim } : {}) : o; };
  const asil = o => denemeli(o.status === 'taslak' ? Object.assign({}, o, { status: 'serbest' }) : o);
  /* girdiKur kaynak okumasını kaydın üstüne yeniden koyar (sunucuKaydi): emir süzgeci okumanın kendisine de uygulanır */
  const durum0 = kaynak && kaynak.durum ? kaynak.durum : {};
  const e0 = durum0.emirler;
  const durum = e0 && Array.isArray(e0.orders) ? Object.assign({}, durum0, { emirler: Object.assign({}, e0, { orders: [...e0.orders, ...sanal].filter(o => nolar.has(o.no)).map(asil) }) }) : durum0;
  const k = sunucuKaydi(kayit, durum, S0.D, bugun);
  k.plan = sunucuPlani(S0.D);
  k.orders = (k.orders || []).filter(o => nolar.has(o.no)).map(asil);
  k.savedAt = 0;
  S0.simdi = tmiSaat(S0.D, istek.simdi);
  /* çalışan adım plan modülünün verdiğidir; sağlam ve adım adedi kaynak okumasından */
  const okunan = new Map((Array.isArray(durum.calisanAdimlar) ? durum.calisanAdimlar : []).map(c => [c.anahtar, c]));
  /* 671 a (Motor A, A4 3b): planlamacı çalışan işin önüne iş koyduysa çalışan iş kuyruktadır: yeri sabit değildir, kalan adediyle
     (sayım varsa ayarsız) kuyruktaki sırasında yeniden dizilir. */
  const kuyruktaki = new Set(istek.kuyruklar.flatMap(q => q.anahtarlar));
  const calisanlar = istek.calisanlar.filter(c => c.makineId != null && !kuyruktaki.has(c.anahtar)).map(c => {
    const o = okunan.get(c.anahtar) || {};
    return { anahtar: c.anahtar, makineId: String(c.makineId), baslangic: c.baslangic, sayimAni: dakikaSonu(c.sayimAni), kalanVerimliDk: c.kalanVerimliDk, saglam: o.saglam, adet: o.adet };
  });
  const g = girdiKur(S0, k, { durum: Object.assign({}, durum, { calisanAdimlar: calisanlar }), ek: kaynak ? kaynak.ek : null }, bugun);
  if (!g) return null;
  const st = g.st, D = g.S.D;
  const simdi = tmiSaat(D, istek.simdi);
  if (simdi != null && simdi >= 0) st.now = simdi;
  /* 1408: arıza denemesindeki makine ufuk boyunca kapalı, kapalı gün denemesi tatil */
  for (const m of istek.kapaliMakineler || []) st.down.push({ id: 'ariza-' + m, m: String(m), from: st.now, to: st.now + HDAYS * 24, neden: 'ariza' });
  if ((istek.kapaliGunler || []).length) st.D.tatiller = [...new Set([...(st.D.tatiller || []), ...istek.kapaliGunler])];
  const opOf = tmiIslemler(k, D);
  for (const c of istek.calisanlar) {
    const id = opOf[c.anahtar], o = okunan.get(c.anahtar) || {};
    if (!id || !kuyruktaki.has(c.anahtar) || !isFinite(+o.adet)) continue;
    st.D.opAdet = Object.assign({}, st.D.opAdet, { [id]: Math.max(1, +o.adet - (+o.saglam || 0)) });
    if (+o.saglam > 0) st.ayarsiz = Object.assign({}, st.ayarsiz, { [id]: 1 });
  }
  fasonlariAdimaCevir(k, st.D);
  emirFasonlariniEkle(st.D, durum.emirler, k);
  ekAdimlariEkle(k, st.D, istek, opOf);
  kuyrukMakineleriniEkle(k, st.D, istek, opOf);
  fasonBeklemeleriniEkle(st.D, istek, opOf);
  /* 690 b: emirler arası öncül (parti kolu, Motor A'nın B7 kuralı); motor öncülü yalnız rotadan, emrin içinde kurar */
  st.ekOncul = (istek.baglar || []).map(x => [opOf[x.anahtar], opOf[x.oncul]]).filter(([a, p]) => a && p && a !== p);
  const cx = compile(st);
  const kimlik = {};
  for (const [a, id] of Object.entries(opOf)) kimlik[id] = a;
  const yerlesmeyen = [];
  const ops = {};
  const frz = st.now + (st.w.dondurma || 0);
  const sira = new Set();
  /* 168 b: vardiyası tanımsız tezgâhın işi yerleşmez ama komutu durdurmaz; plan uyarıyla boş bırakır */
  const vardiyasiz = [];
  /* arıza denemesindeki makine vardiyasız değildir: 'yeni' kipte işi başka adaya gider, 'sabit' kipte yerleşmez */
  const arizali = new Set((istek.kapaliMakineler || []).map(String));
  const takvimsiz = m => { const M = cx.M[String(m)]; return !arizali.has(String(m)) && !!M && M.rw.length === 0; };
  istek.kuyruklar.forEach((q, mi) => q.anahtarlar.forEach((a, i) => {
    const id = opOf[a]; if (!id || !cx.byId[id]) { yerlesmeyen.push(a); return; }
    if (takvimsiz(q.makineId)) { vardiyasiz.push(a); return; }
    const S = frz + 1 + i * 1e-3 + mi * 1e-7;
    ops[id] = { id, job: cx.byId[id].job, m: String(q.makineId), S, C: S + 1e-7 };
    sira.add(id);
  }));
  const calisan = new Set(Object.keys(st.gercek || {}));
  /* 669 a (Motor A gibi): ileride yeri sabit iş (kilitli, dondurulmuş, bölünmüş parça) sabitYer'dedir: tezgâhın boş anını ilerletmez, önüne
     sığan kuyruk işi önce yapılır, ardılı onun bitişini bekler. Bölünmüş işin en geç biten parçası işin yeridir, öteki parçalar tezgâhı kapatır. */
  const sabitYer = {};
  for (const x of istek.sabitler) {
    const id = opOf[x.anahtar], m = String(x.makineId), S = tmiSaat(D, x.baslangic), C = tmiSaat(D, dakikaSonu(x.bitis));
    if (S == null || C == null || !cx.M[m]) continue;
    if (!id || !cx.byId[id] || sira.has(id) || calisan.has(id)) { st.down.push({ id: 'sabit-' + st.down.length, m, from: S, to: C, neden: 'sabit' }); continue; }
    if (S < st.now - 1e-9) { st.gercek[id] = { m, S, C }; continue; }
    const o = sabitYer[id];
    if (o && o.C >= C) { st.down.push({ id: 'sabit-' + st.down.length, m, from: S, to: C, neden: 'sabit' }); continue; }
    if (o) st.down.push({ id: 'sabit-' + st.down.length, m: o.m, from: o.S, to: o.C, neden: 'sabit' });
    sabitYer[id] = { m, S, C };
  }
  st.sabitYer = sabitYer;
  /* istekte geçmeyen adım: şimdi bitmiş; motor onu yalnız ardılının öncülü olarak görür. Fason adım ise (CA-2) öncülünden sonra döner:
     kuyruktaki ardılı onu bekler. */
  for (const o of cx.ops) {
    if (sira.has(o.id) || st.gercek[o.id] || sabitYer[o.id] || !o.c.length) continue;
    if (o.c.every(x => x.fas) && (cx.FS[o.c[0].m.slice(1)] || {}).hemen) {
      const S = Math.max(frz + 1, ...o.pr.map(([p]) => (ops[p] ? ops[p].S : -Infinity))) + 1e-9;
      ops[o.id] = { id: o.id, job: o.job, m: o.c[0].m, S, C: S + 1e-7, fas: 1 };
      continue;
    }
    const c = o.c.find(x => !x.fas) || o.c[0];
    ops[o.id] = { id: o.id, job: o.job, m: c.m, S: st.now, Su: st.now, C: st.now, lot1: st.now, su: 0, run: 0, fas: c.fas ? 1 : undefined };
  }
  /* 981 a-1: yerleşmeyen işin nedeni öncülünden okunur (öncül yerleşmediyse ardılı da yerleşmez) */
  const oncul = {};
  for (const id of sira) oncul[id] = cx.byId[id].pr.map(([p]) => p);
  return { st, baslangic: D.meta.baslangic, taban: { ops }, yerlesmeyen, vardiyasiz, kimlik, sira: [...sira], oncul };
}

/* 669 a, Motor A'nın kuralı (CA-2, #1424): fason adım önceki iç adımın bitişinden rotadaki termin günü kadar sonra döner (termini girilmemiş
   fason uretim-emirleri'nin FASON_VARSAYILAN_GUN'ü, 7 gün); çıkış günü, saati ve kapasitesi beklenmez. Süre firmanın değil adımındır: her
   fason adıma ayrı, hemen çıkan bir fasoncu kurulur. Yalnız sunucu çözümünde; sayfa motoru firmanın çıkış ayarıyla çözmeyi sürdürür. */
const FASON_VARSAYILAN_GUN = 7;
function fasonlariAdimaCevir(k, D) {
  D.fasoncular = (D.fasoncular || []).slice();
  for (const u of D.urunler || []) {
    const adimlar = ((((k && k.routes) || {})[u.id] || {}).steps || []).slice().sort((p, q) => p.seq - q.seq);
    (u.rota || []).forEach((r, i) => {
      if (!r.fason) return;
      const a = adimlar[i], gun = a && +a.terminGun > 0 ? +a.terminGun : FASON_VARSAYILAN_GUN, id = '~' + u.id + '.' + r.k;
      D.fasoncular.push({ id, ad: 'fason', hemen: true, sureGun: gun, kapasite: 999, cikisGunleri: GUNLER.slice() });
      r.fason = id;
    });
  }
}
/* 988 a (983 b'nin istisnası): emirde sonradan fasona alınan adım (uretim-emirleri, emrin adım kaydı; durum.emirler.opYer, anahtar
   "emir|root|rotadaki sıra") rotadaki fason adım gibi döner: önceki iç adımın bitişinden emrin termin günü kadar sonra (girilmemişse
   FASON_VARSAYILAN_GUN). Emre özel ürün kopyası kurulur; adımın tezgâhı yoktur, kuyruğa girmez.
   1559 a: çok katmanlı emrin alt düğüm adımı opYer'de değil, düğümün adım listesindedir (fasonId, terminGun); düğüm siparişinin ürün
   rotasındaki yeri kaynakOpNo'dan bulunur (tmiIslemler ile aynı eşleme). */
function emirFasonlariniEkle(D, emirler, k) {
  const yer = Object.entries((emirler && emirler.opYer) || {}).map(([anahtar, y]) => { const [sid, , sira] = anahtar.split('|'); return [sid, +sira - 1, y]; });
  for (const o of (emirler && emirler.orders) || []) for (const d of o.dugumler || []) {
    const da = rotaAdimlari(k, d.itemId);
    for (const x of d.adimlar || []) if (x.fasonId != null) yer.push([dugumSipId(o, d.dugum), da.findIndex(t => rotaOpNo(t) === x.kaynakOpNo), x]);
  }
  const urun = new Map((D.urunler || []).map(u => [u.id, u]));
  const sip = new Map((D.siparisler || []).map(s => [String(s.id), s]));
  for (const [sid, i, y] of yer) {
    if (!y || y.fasonId == null || !(i >= 0)) continue;
    const s = sip.get(sid);
    let u = s && urun.get(s.urun);
    if (!u || !u.rota || !u.rota[i] || u.rota[i].fason) continue;
    if (!u.emreOzel) {
      u = Object.assign({}, u, { id: u.id + '#' + sid, emreOzel: true, rota: u.rota.map(r => Object.assign({}, r)) });
      D.urunler = [...D.urunler, u]; urun.set(u.id, u); s.urun = u.id;
    }
    const id = '~' + u.id + '.' + u.rota[i].k, gun = +y.terminGun > 0 ? +y.terminGun : FASON_VARSAYILAN_GUN;
    D.fasoncular = [...(D.fasoncular || []), { id, ad: 'fason', hemen: true, sureGun: gun, kapasite: 999, cikisGunleri: GUNLER.slice() }];
    u.rota[i] = Object.assign({}, u.rota[i], { fason: id, tezgahlar: [] });
  }
}
/* 671 a (Motor A, H3): planlamacı işi rota dışı makineye elle koyabilir. O makine adımın adayları arasına rotadaki ilk tezgâhın
   süreleriyle girer (verim tezgâhındır); yalnız bu çözümde. */
/* 686 a: rotada olmayan ek adım (rework, tamir, ek) emrin kendi adımıdır; motor onu rotadan tanımaz. Plan modülü adımı, süresini (ayar ve
   parça başı dakika), adedini ve emrin içindeki öncül ve ardılını verir. Emre özel ürün kopyası kurulur: adım öncülünden sonra girer, ardılı
   onu bekler, makinesi kuyruğundaki tezgâhtır. Kuyrukta olmayan ek adım eklenmez (yerleşmeyen kalır). Ekler emirdeki sırayla gelir: önceki ek
   adım sonrakinin öncülü olabilir. */
function ekAdimlariEkle(k, D, istek, opOf) {
  const ekler = istek.ekAdimlar || []; if (!ekler.length) return;
  const makine = {}; for (const q of istek.kuyruklar) for (const a of q.anahtarlar) makine[a] = String(q.makineId);
  const urun = new Map((D.urunler || []).map(u => [u.id, u]));
  const sip = new Map((D.siparisler || []).map(s => [String(s.id), s]));
  const emirId = new Map(((k && k.orders) || []).map(o => [o.no, String(o.id)]));
  const kOf = a => { const id = a && opOf[a]; return id ? id.slice(id.lastIndexOf('.') + 1) : null; };
  for (const e of ekler) {
    const n = e.anahtar.lastIndexOf('|'), sid = emirId.get(e.anahtar.slice(0, n)), s = sid && sip.get(sid), m = makine[e.anahtar];
    if (opOf[e.anahtar] || !s || !m || !urun.get(s.urun)) continue;
    let u = urun.get(s.urun);
    if (!u.emreOzel) {
      u = Object.assign({}, u, { id: u.id + '#' + sid, emreOzel: true, rota: u.rota.map(r => Object.assign({}, r)) });
      D.urunler = [...D.urunler, u]; urun.set(u.id, u); s.urun = u.id;
    }
    const yeni = 'e' + e.anahtar.slice(n + 1), on = kOf(e.oncul), ar = kOf(e.ardil);
    const i = ar == null ? -1 : u.rota.findIndex(r => String(r.k) === ar);
    u.rota.splice(i < 0 ? u.rota.length : i, 0, { k: yeni, ad: e.ad || yeni, bag: on == null ? [] : [[on, 'b']], aile: '', tezgahlar: [{ id: m, ayar: +e.ayarDk || 0, cevrim: +e.birimDk || 0 }] });
    if (i >= 0) u.rota[i + 1] = Object.assign({}, u.rota[i + 1], { bag: [...(u.rota[i + 1].bag || []).filter(([q]) => String(q) !== on), [yeni, 'b']] });
    const id = sid + '.' + yeni;
    opOf[e.anahtar] = id;
    if (isFinite(+e.adet) && +e.adet > 0) D.opAdet = Object.assign({}, D.opAdet, { [id]: +e.adet });
  }
}
/* 1202: Üretim Emirleri fason adımı plana iş olarak vermez; sonraki adım fasonun kalan süresini (gün) taşır. Motor rotadaki ve emirdeki
   fasonu kendisi bilir, ek adımın (rework, tamir, ek) fasonunu bilmez. Öncülü motorda fason olmayan kuyruk işinin önüne o kadar süren, hemen
   çıkan bir fason adımı konur (emirFasonlariniEkle gibi): iş öncülünün bitişinden, öncülü yoksa şimdiden o süre sonra başlar. */
function fasonBeklemeleriniEkle(D, istek, opOf) {
  const bekle = istek.fasonBekleme || []; if (!bekle.length) return;
  const urun = new Map((D.urunler || []).map(u => [u.id, u]));
  const sip = new Map((D.siparisler || []).map(s => [String(s.id), s]));
  for (const x of bekle) {
    const id = opOf[x.anahtar], gun = +x.gun; if (!id || !(gun > 0)) continue;
    const n = id.lastIndexOf('.'), sid = id.slice(0, n), k = id.slice(n + 1), s = sip.get(sid);
    let u = s && urun.get(s.urun);
    const r = u && (u.rota || []).find(y => String(y.k) === k);
    if (!r || r.fason) continue;
    const fasonMu = q => !!(u.rota.find(y => String(y.k) === String(q)) || {}).fason;
    if ((r.bag || []).some(([q]) => fasonMu(q))) continue;
    if (!u.emreOzel) {
      u = Object.assign({}, u, { id: u.id + '#' + sid, emreOzel: true, rota: u.rota.map(y => Object.assign({}, y)) });
      D.urunler = [...D.urunler, u]; urun.set(u.id, u); s.urun = u.id;
    }
    const i = u.rota.findIndex(y => String(y.k) === k), fk = 'f' + k, fid = '~' + u.id + '.' + fk;
    D.fasoncular = [...(D.fasoncular || []), { id: fid, ad: 'fason', hemen: true, sureGun: gun, kapasite: 999, cikisGunleri: GUNLER.slice() }];
    u.rota.splice(i, 0, { k: fk, ad: 'fason', bag: (u.rota[i].bag || []).map(b => b.slice()), aile: '', fason: fid, tezgahlar: [] });
    u.rota[i + 1] = Object.assign({}, u.rota[i + 1], { bag: [[fk, 'b']] });
  }
}
function kuyrukMakineleriniEkle(k, D, istek, opOf) {
  const emir = new Map(((k && k.orders) || []).map(o => [String(o.id), o]));
  const urun = new Map((D.urunler || []).map(u => [u.id, u]));
  /* 1476-D: alt düğüm siparişi emir listesinde yoktur; ürünü siparişindendir */
  const sip = new Map((D.siparisler || []).filter(s => s.dugum).map(s => [String(s.id), s]));
  for (const q of istek.kuyruklar) for (const a of q.anahtarlar) {
    const id = opOf[a]; if (!id) continue;
    const n = id.lastIndexOf('.'), o = emir.get(id.slice(0, n)), ds = sip.get(id.slice(0, n)), u = o ? urun.get(o.itemId) : ds && urun.get(ds.urun), key = id.slice(n + 1);
    const r = u && (u.rota || []).find(x => String(x.k) === key);
    if (!r || r.fason || !(r.tezgahlar || []).length) continue;
    const m = String(q.makineId);
    if (!r.tezgahlar.some(t => String(t.id) === m)) r.tezgahlar = [...r.tezgahlar, Object.assign({}, r.tezgahlar[0], { id: m })];
  }
}
/* Motorun saat ekseni dakikadır, plan modülünün anları saniyelidir. Sabit işin bitişi ve çalışan adımın sayım anı dakikanın sonuna
   yuvarlanır: ardılı, plan modülünün gördüğü bitişten önce başlamaz (sıra denetimi saniyeyle yapılır). */
function dakikaSonu(an) {
  const t = Date.parse(an); if (!isFinite(t)) return an;
  return new Date(Math.ceil(t / 60000) * 60000).toISOString();
}

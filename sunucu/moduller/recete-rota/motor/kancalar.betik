    const k = cx.st.D.fasonTermin && cx.st.D.fasonTermin[o.id]; const T = k ? parseT(cx.st.D, k) : null;
    const C = T != null ? Math.max(r.S + 1, T) : r.S + tmSureFas(cx.FS[c.m.slice(1)], o.adet, A);

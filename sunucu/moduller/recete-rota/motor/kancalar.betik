  /* talaşlı fason fiyatı işin tezgâh süresinden çıkar; fasona zorlanan işte tezgâh seçenekleri kaldırıldığı için süre tam listeden alınır */
  const f0 = tFason;
  tFason = function (o, c, cx, ctx, b) { const r = f0(o, c, cx, ctx, b); if (r && r.cost == null && o.cTum && o.cTum.some(x => x.opt && x.m === c.m)) { const f = cx.FS[c.m.slice(1)]; const h = Math.min(...o.cTum.filter(x => !x.fas).map(x => x.run), Infinity); if (f && isFinite(h) && f.saatFiyat != null) r.cost = h * f.saatFiyat; } return r; };
}
tlAmacUygula();
const tmSureFas = (f, adet, A) => ((+(f && f.sureGun) || 1) * (f && f.terminKat != null ? +f.terminKat : A.katFas) + (f && f.terminEk != null ? +f.terminEk : A.ekFas) * adet / 100) * 24;
/* motora bağlanan kısım (ana iş parçacığı ve işçi): genel gider her tezgâh saatine yük olarak, termin uyarıları, fason dönüşü */
function terminUygula() {
  if (self.__tmU) return; self.__tmU = 1;
  const e0 = evaluate;
  evaluate = function (plan, st, ref, fast) {
    const e = e0(plan, st, ref, fast); if (!st) return e;
    if (st.ggP > 0) { let h = 0; for (const id in plan.ops) { const r = plan.ops[id]; if (!r.fas) h += (+r.run || 0) + (+r.su || 0); } const g = h * st.ggP; e.gg = g; e.tl += g; e.lex[4] += g; }
    if (!fast && e.warn) {
      /* 554 a: termini beklenen satırdan malzeme alan her işe uyarı; plan işi kaydırmaz */
      const cx = plan.cx || compile(st); const D = st.D;
      for (const x of cx.mat.po) { const p = D.satinalma[x.i]; if (!p || !p.tb || x.soz == null) continue;
        for (const j of new Set(x.jobs.map(u => u.j))) e.warn.push({ t: 'Termin bekleniyor', j, gelis: x.soz, kod: p.kod, txt: `${j}: ${p.kod} için Satın Alma termini bekleniyor; malzeme olması gereken ${fmtDT(D, x.soz)} tarihinde gelmiş sayıldı.` }); }
      for (const w of st.tmUyari || []) e.warn.push(w); }
    return e;
  };
  const f0 = tFason;
  tFason = function (o, c, cx, ctx, b) {

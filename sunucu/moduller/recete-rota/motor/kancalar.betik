    if (L) { const i = L.lastIndexOf('.'), lj = L.slice(0, i);
      if (L.slice(i + 1) === o.k && lj !== o.job && lj.split('/')[0] === o.job.split('/')[0]) return eski({ ...o, aile: '', fai: false }, { ...c, su: 0 }, cx, ctx, b, fast); }

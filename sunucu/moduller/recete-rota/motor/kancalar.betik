/* ---------- Planlama sayfasının motor kancaları (Soru 357 a) ----------
   Planlama sayfası motoru yalın koşturmaz: plan TL amacı, fason kararı, bekleme maliyeti, malzeme ve fason terminleri, belli olmayan
   malzeme (1650 4 c), yıllık hedef, montaj bağı, partide ayar sıfırlama, ayarı parça gelmeden yapma ve örtüşme motorun işlevlerini sarar;
   aynı kod sayfanın işçisine de verilir (cerceve/planlama/parca: zu-yan-sayfalar TL_ISCI, zv-termin, zz-karar-1650, zz3, zz9, zz12, zz13,
   zz15, zz16, zz18, zz20; sıra işçidekidir). Değerlendirme ucu bu dosyayı motorun ardından yükler; parçalar burada olduğu gibidir.
   Aramanın sabit adımlı saati (zz-karar-1650 saatSabitle, zz8 saatAdimi) değerlendirme betiğindedir (457 1-3 b). */

function tlToplam(e) { const k = TL_AMAC.kT || 1; return (e.lex[0] * TL_AMAC.birim + e.lex[1] * TL_AMAC.birim * TL_AMAC.risk) * k + e.lex[4] + (e.lex[2] || 0) * (TL_AMAC.chgTL || 0); }
/* müdürün fason kararı: kabul edilen iş yalnız talaş fasonunda, reddedilen yalnız tezgâhta yapılabilir */
function fasonKararUygula(cx, st) {
  const k = st && st.D && st.D.fasonKarar; if (!k) return;
  for (const o of cx.ops) { const x = k[o.id]; if (!x || !o.c.some(c => c.opt)) continue;
    fasonZorla(o, x.karar === 'kabul');
    /* sonraki karar önceki kilidi ve tezgâh isteğini geçersiz kılar: kilit eski tezgâhı gösteriyorsa iş hiç yerleşemezdi */
    for (const t of [st.locks, st.pref]) { const y = t && t[o.id]; if (y && !o.c.some(c => c.m === (y.m || y))) delete t[o.id]; } }
}
/* zorlanan talaş fasonu rotadaki fason adımı gibi tek seçenek olur: motor isteğe bağlı fasonu ancak tezgâh seçeneğinin yanında yerleştirir */
function fasonZorla(o, disari) {
  const l = disari ? o.c.filter(c => c.opt).map(c => ({ m: c.m, fas: 1 })) : o.c.filter(c => !c.opt); if (!l.length) return;
  o.cTum = o.cTum || o.c; o.c = l;
}
/* ---------- Erken sevk kabul eden sipariş (değerlendirme 16:55, 1D) ----------

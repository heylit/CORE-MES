  const k = kayit && kayit.items ? kayit : null;
  if (k && S.rrSavedAt != null && (k.savedAt || 0) !== S.rrSavedAt) { const D = tmiCevir(k, null, S.D, bugun); if (!rrEsit(D, S.D)) S.D = D; }
  karar1650Goc(S);
  const kn = kaynak && kaynak.durum ? kaynak : null;
  if (kn) {
    kaynakBirlestir(S.D, k, kn, bugun);
    if (Array.isArray(kn.durum.calisanAdimlar)) {

{
  "name": "tmi-core-v2",
  "version": "0.0.0-gelistirme",
  "private": true,
  "type": "module",
  "description": "TMI CORE V2 - CNC atolyesi uretim planlama ve izlenebilirlik (kurum ici)",
  "engines": {
    "node": ">=24.22.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "imports": {
    "#paylasilan/*": "./paylasilan/*",
    "#cekirdek/*": "./sunucu/cekirdek/*"
  },
  "scripts": {
    "sunucu": "node --import ./araclar/ortam-yukle.ts sunucu/ana.ts",
    "gelistir:sunucu": "node --import ./araclar/ortam-yukle.ts --watch sunucu/ana.ts",
    "gelistir:istemci": "vite --config istemci/vite.config.ts",
    "derle:istemci": "npm run derle:arkon && vite build --config istemci/vite.config.ts",
    "baslat": "node araclar/baslat.ts",
    "bekci": "node araclar/bekci.ts",
    "otomatik-baslat": "node araclar/bekci.ts otomatik-baslat",
    "derle:arkon": "vite build --config arkon/vite.config.ts",
    "goc": "node --import ./araclar/ortam-yukle-goc.ts sunucu/cekirdek/goc-calistir.ts",
    "yonetici": "node --import ./araclar/ortam-yukle.ts araclar/yonetici-olustur.ts",
    "yedek": "node --import ./araclar/ortam-yukle-goc.ts araclar/yedek.ts al",
    "yedek-anahtari": "node araclar/yedek.ts anahtar",
    "yedek-coz": "node --import ./araclar/ortam-yukle-goc.ts araclar/yedek.ts coz",
    "yavas-sorgular": "node --import ./araclar/ortam-yukle-goc.ts araclar/yavas-sorgular.ts",
    "yetki-matrisi": "node --import ./araclar/ortam-yukle-goc.ts araclar/yetki-matrisi-oku.ts",
    "geri-yukle": "node --import ./araclar/ortam-yukle-goc.ts araclar/yedek.ts geri-yukle",
    "geri-yukle-medya": "node --import ./araclar/ortam-yukle-goc.ts araclar/yedek.ts medya-geri-yukle",
    "ornek-veri": "node --import ./araclar/ortam-yukle.ts araclar/ornek-veri.ts",
    "tip": "node node_modules/typescript7/bin/tsc -p sunucu --singleThreaded && node node_modules/typescript7/bin/tsc -p istemci --singleThreaded && node node_modules/typescript7/bin/tsc -p arkon/web --singleThreaded && node node_modules/typescript7/bin/tsc -p arkon/web/tsconfig.core.json --singleThreaded && node node_modules/typescript7/bin/tsc -p ekran-testleri --singleThreaded",
    "sinir": "node araclar/sinir-denetimi.ts",
    "harita": "node araclar/harita.ts",
    "dizin": "node araclar/harita.ts",
    "durum": "node araclar/durum.ts",
    "teslim": "node araclar/teslim.ts",
    "paket": "node araclar/paket-yap.ts",
    "test:sunucu": "node --import ./araclar/ortam-yukle-goc.ts araclar/test-sunucu.ts",
    "test:istemci": "vitest run --config istemci/vite.config.ts",
    "test:modul": "node araclar/test-modul.ts",
    "test": "npm run test:sunucu && npm run test:istemci",
    "lint:ts": "node araclar/lint-parcala.ts",
    "lint:css": "stylelint \"istemci/**/*.css\"",
    "lint": "npm run lint:ts && npm run lint:css",
    "kontrol": "npm run tip && npm run sinir && npm run lint && npm run test",
    "ekran:hazirla": "node --import ./araclar/ortam-yukle.ts ekran-testleri/hazirla.ts",
    "ekran": "playwright test -c ekran-testleri --grep-invert @degisecek",
    "ekran:degisecek": "playwright test -c ekran-testleri --grep @degisecek",
    "robot": "playwright test -c ekran-testleri/benzetim/playwright.config.ts",
    "robot:test": "node --test \"ekran-testleri/benzetim/**/*.test.ts\"",
    "robot:izle": "node test-robotu/izleme/sunucu.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "chart.js": "4.4.1",
    "fastify": "^5.2.1",
    "highs": "1.15.3",
    "htm": "3.1.1",
    "occt-import-js": "0.0.23",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.13.1",
    "qrcode-generator": "1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "three": "0.186.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "exceljs": "4.4.0",
    "jsdom": "^25.0.1",
    "jsqr": "1.4.0",
    "stylelint": "^17.16.0",
    "tesseract.js-core": "6.1.2",
    "three-147": "npm:three@0.147.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.1",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  }
}

/* ---------- Bugün: planlamacının günlük akışı ----------
   Hesap aynı motordan gelir; bu ekran yalnız sırayı ve dili değiştirir:
   önce gelenler, sonra karar bekleyenler, sonra yapılan değişikliklerin dökümü, en son yayın.
   Her öneri hemen uygulanır ve sepete düşer; kart sonucu düz cümleyle söyler ve geri alınabilir. */
const BG_ADIM = [['gelen', 'Gelenler', 'box'], ['karar', 'Kararlar', 'flag'], ['gozden', 'Gözden geçir', 'eye'], ['yayin', 'Yayınla', 'check']];
const BG_YARDIM = {
  gelen: 'Plana henüz girmemiş siparişler, arızalar ve veri uyarıları. Önce bunlar plana alınır ya da kapatılır.',
  karar: 'Termine yetişmeyen siparişler. Her kart bir öneri sunar; öneri hemen denenir, beğenmezseniz geri alırsınız.',
  gozden: 'Bu oturumda planda neyin nereye gittiği. Gün planında eski yerler kesik çizgiyle görünür.',
  yayin: 'Atölyenin göreceği plan. Yayından sonra yapılan değişiklikler yeniden yayınlanana kadar taslakta kalır.',
};

function gecMetin(h) { if (h == null || !isFinite(h)) return 'belirsiz süre'; return h >= 24 ? `${sayi(h / 24, 1)} gün` : `${sayi(Math.max(h, 0.1), 1)} saat`; }
function bgKarar() { if (!S.bkKarar || S.bkKarar.dv !== S.dataVer) S.bkKarar = { dv: S.dataVer, m: {} }; return S.bkKarar.m; }
function bgTezAd(m) { return m && m[0] === '@' ? m.slice(1) + ' (fason)' : m || '—'; }

function bgGelenler(p) {
  const out = [];
  if (!planGuncel()) out.push({ id: 'eski', ton: 'uyari', simge: 'alert', baslik: 'Veri değişti, plan eski', metin: 'Plan kurulduktan sonra veri ya da olay değişti. Saatler gerçeği yansıtmayabilir.', eylem: [['Planı güncelle', 'ekip', '', true]] });
  for (const s of S.D.siparisler.filter(x => x.havuz))
    out.push({ id: 'h' + s.id, ton: 'bilgi', simge: 'box', baslik: `${s.id} plana alınmadı`, metin: `${urunAd(s.urun)}, ${sayi(s.adet, 0)} adet, termin ${(s.termin || '—').slice(5)}. Plana almadan önce söz tarihine bakabilirsiniz.`, eylem: [['Plana al', 'havuz-al', s.id, true], ['Söz tarihi', 'soz-ver', s.id], ['Planda göster', 'bg-goster', s.id]] });
  S.down.forEach((d, i) => { if (d.to <= cxAl().st.now) return;
    out.push({ id: 'd' + i, ton: 'bilgi', simge: 'wrench', baslik: `${bgTezAd(d.m)} duruşta`, metin: `${fmtDT(S.D, d.from)} → ${fmtDT(S.D, d.to)}. Plan bunu hesaba kattı; yakındaki işler başka saate ya da tezgâha kaydı.`, eylem: [['Duruşu kaldır', 'durus-kaldir', String(i)]] }); });
  if (S.kapali.length) out.push({ id: 'kapali', ton: 'hata', simge: 'alert', baslik: `${S.kapali.length} kural kapalı`, metin: `${kapaliAdlar().join(', ')}. Plan bu kuralları saymadan kuruldu.`, eylem: [['Hepsini aç', 'kisit-hepsi', '', true]] });
  const den = denetimBulgulari();
  if (den.length) out.push({ id: 'den', ton: 'uyari', simge: 'search', baslik: `${den.length} eksik ya da çelişkili veri`, metin: 'Süre, tezgâh ya da rota bilgisi eksikse plan o işi tahminle yerleştirir.', eylem: [['Veriyi gör', 'git', 'denetim']] });
  return out;
}

function bgKararlar(p) {
  const kay = gecikmeKaynaklari(p); const km = bgKarar(); const out = [];
  const gec = S.D.siparisler.filter(s => !s.havuz).map(s => ({ s, j: p.J[s.id] })).filter(x => x.j && (x.j.T == null || x.j.T > 0.05))
    .sort((a, b) => ((b.j.T ?? 1e4) * isAgirligi(b.s)) - ((a.j.T ?? 1e4) * isAgirligi(a.s)));
  for (const { s, j } of gec) {
    const en = kay.is[s.id];
    const neden = en ? ` En çok <b>${esc(en.ad)}</b> yüzünden bekliyor (${esc(gecMetin(en.v))}).` : '';
    out.push({ id: s.id, job: s.id, ton: 'hata', simge: 'flag', karar: km[s.id], html: true,
      baslik: j.T == null ? `${s.id} planlanamadı` : `${s.id} termine ${gecMetin(j.T)} geç kalıyor`,
      metin: `${esc(urunAd(s.urun))}, ${sayi(s.adet, 0)} adet, ${esc(ONCELIK[s.oncelik] || '')} öncelik. Termin ${esc((s.termin || '—').slice(5))}, planda bitiş ${j.C != null ? esc(fmtDT(S.D, j.C)) : '—'}.${neden}`,
      eylem: [['Öne almayı dene', 'bg-onal', s.id, true], ['Gecikmeyi kabul et', 'bg-kabul', s.id], ['Planda göster', 'bg-goster', s.id]] });
  }
  const fail = p.fail || [];
  if (fail.length) out.push({ id: 'fail', ton: 'hata', simge: 'alert', baslik: `${fail.length} iş yerleştirilemedi`, metin: `${fail.slice(0, 3).join(', ')}${fail.length > 3 ? '…' : ''}. Uygun tezgâh, süre ya da önceki adım eksik olabilir.`, eylem: [['Veriyi gör', 'git', 'denetim']] });
  const mal = [...new Set((p.warn || []).filter(w => w.t === 'malzeme').map(w => w.j))];
  if (mal.length) out.push({ id: 'mal', ton: 'uyari', simge: 'box', baslik: `${mal.length} siparişin malzemesi gelmemiş`, metin: `${mal.slice(0, 4).join(', ')}${mal.length > 4 ? '…' : ''}. İş planda başlar; malzeme gelmezse kayar.`, eylem: [['Malzeme', 'git', 'malzeme']] });
  return out;
}

/* Sepetin başındaki plana göre neyin nereye gittiği: sipariş başına tek satır, adım başına tezgâh ve saat farkı */
function bgDokum() {
  const t = U.taslak; if (!t || !t.adimlar.length) return [];
  const a = t.adimlar[0].once.plan, b = S.plan; const cx = cxAl(); const isler = {};
  for (const [id, r] of Object.entries(b.ops)) {
    const e = a.ops[id]; if (!isFinite(r.C)) continue;
    if (e && e.m === r.m && Math.abs(e.S - r.S) < 0.25) continue;
    (isler[r.job] = isler[r.job] || []).push({ id, ad: (cx.byId[id] || {}).ad || id.split('.').pop(), e, r });
  }
  return Object.entries(isler).map(([job, l]) => {
    const T0 = (a.J[job] || {}).T || 0, T1 = (b.J[job] || {}).T || 0;
    return { job, T0, T1, l: l.sort((x, y) => x.r.S - y.r.S) };
  }).sort((x, y) => Math.abs(y.T1 - y.T0) - Math.abs(x.T1 - x.T0) || x.job.localeCompare(y.job));
}

function bgDokumOzet(dok) {
  const iyi = dok.filter(d => d.T0 - d.T1 > 0.05).length, kotu = dok.filter(d => d.T1 - d.T0 > 0.05).length;
  return `<p class="pm-bg-yardim"><b>${dok.length} siparişin işleri yer değiştirdi.</b> ${iyi ? `${iyi} sipariş daha erken bitiyor` : 'Hiçbiri daha erken bitmiyor'}${kotu ? `, ${kotu} sipariş daha geç bitiyor` : ''}; geri kalanların yalnız saati kaydı, termini etkilenmedi.</p>`;
}
function bgDokumDiger(dok) {
  const l = dok.filter(d => !(Math.abs(d.T1 - d.T0) > 0.05) && U.secJob !== d.job); if (!l.length) return '';
  return `<details class="pm-bg-diger"><summary>Termini etkilenmeyen ${l.length} sipariş</summary><ul>${l.map(d => `<li><button type="button" class="pm-bg-dokum-bas" data-act="bg-goster" data-v="${esc(d.job)}"><b class="mono">${esc(d.job)}</b></button> ${d.l.length} adım, ${esc([...new Set(d.l.map(x => bgTezAd(x.r.m)))].join(', '))}</li>`).join('')}</ul></details>`;
}
function bgKart(x, son) {
  const sonuc = son && son.id === x.id ? bgSonuc(son) : '';
  const durum = x.karar === 'kabul' ? rozet('Gecikme kabul edildi', 'pasif') : '';
  const kapali = x.karar === 'kabul' && !sonuc;
  return `<li class="pm-bg-kart" data-ton="${x.ton}" ${kapali ? 'data-kapali' : ''} ${U.secJob && x.job === U.secJob ? 'data-secili' : ''}>
    <span class="pm-bg-simge">${ic(x.simge, 'k')}</span>
    <div class="pm-bg-govde"><b class="pm-bg-baslik">${esc(x.baslik)}</b>${durum}<p>${x.html ? x.metin : esc(x.metin)}</p>${sonuc}
      ${kapali ? `<div class="pm-dugmeler">${dugme('Yeniden aç', 'bg-ac', { kucuk: true, hayalet: true, veri: `data-v="${esc(x.id)}"` })}</div>`
        : sonuc ? '' : `<div class="pm-dugmeler">${x.eylem.map(([ad, act, v, bir]) => dugme(ad, act, { kucuk: true, birincil: !!bir, veri: `data-v="${esc(v)}"`, yetki: ['bg-onal', 'havuz-al', 'bg-kabul', 'ekip', 'durus-kaldir', 'kisit-hepsi'].includes(act) ? 'plan.yaz' : undefined })).join('')}</div>`}</div></li>`;
}
function bgSonuc(son) {
  const t = U.taslak; const a = t && t.adimlar[son.i]; if (!a) return '';
  const j0 = (a.once.plan.J[son.id] || {}), j1 = (S.plan.J[son.id] || {});
  const kazanc = (j0.T || 0) - (j1.T || 0);
  const dusen = a.dusen || [];
  const cumle = kazanc > 0.05 ? (j1.T > 0.05 ? `${son.id} artık ${gecMetin(j1.T)} geç (önce ${gecMetin(j0.T)}).` : `${son.id} artık termine yetişiyor.`) : `${son.id} için daha iyi yer bulunamadı.`;
  const yan = dusen.length ? ` Bunun için ${dusen.slice(0, 3).join(', ')}${dusen.length > 3 ? ' …' : ''} gecikmeye düştü.` : a.deg > 1 ? ` ${a.deg - 1} siparişin saati de değişti, hiçbiri gecikmeye düşmedi.` : '';
  const iyi = kazanc > 0.05 && !dusen.length;
  const kalsin = dugme('Tamam, kalsın', 'bg-kalsin', { kucuk: true, birincil: iyi, simge: 'check' }), geri = dugme('Geri al', 'taslak-don', { kucuk: true, birincil: !iyi, simge: 'rotate', veri: `data-v="${son.i}"` });
  return `<div class="pm-bg-sonuc" data-ton="${iyi ? 'tamam' : kazanc > 0.05 ? 'uyari' : 'pasif'}"><p><b>Denendi.</b> ${esc(cumle + yan)}${iyi ? '' : ' Önerim geri almak.'}</p><div class="pm-dugmeler">${iyi ? kalsin + geri : geri + kalsin}</div></div>`;
}

function bgDurumCumle(p, nK) {
  const o = p.ozet; const ilk = S.D.siparisler.filter(s => !s.havuz).map(s => ({ s, j: p.J[s.id] })).filter(x => x.j && x.j.T > 0.05).sort((a, b) => b.j.T - a.j.T)[0];
  const plan = o.late ? `Plan ${o.n} siparişin ${o.late} tanesinde terminin gerisinde${ilk ? `; en çok ${ilk.s.id}, ${gecMetin(ilk.j.T)}` : ''}.` : 'Bütün siparişler termine yetişiyor.';
  return `${plan} ${nK ? `${nK} karar bekliyor.` : 'Bekleyen karar yok.'}`;
}

function bgOnayda() { return S.senaryolar.filter(x => x.durum === 'onay').slice(-1)[0] || null; }
function bgOnayHtml(yaz) {
  const o = bgOnayda();
  if (yaz) return o ? `<div class="pm-bg-kart" data-ton="uyari"><span class="pm-bg-simge">${ic('flag', 'k')}</span><div class="pm-bg-govde"><b class="pm-bg-baslik">Onay bekleyen plan</b><p>${esc(o.yazar)} gönderdi: ${o.ozet.late} geciken sipariş, toplam gecikme ${saat(o.ozet.wT)}.</p><div class="pm-dugmeler">${dugme('Onayla ve yayınla', 'sen-canli', { kucuk: true, birincil: true, simge: 'check', veri: `data-v="${esc(o.id)}"` })}${dugme('Geri gönder', 'bg-reddet', { kucuk: true, veri: `data-v="${esc(o.id)}"` })}</div></div></div>` : '';
  return `<div class="pm-dugmeler">${dugme(o ? 'Yeniden onaya gönder' : 'Müdür onayına gönder', 'bg-onaya', { birincil: true, simge: 'flag', yetki: 'plan.yaz' })}</div><p class="pm-kucuk">Planı üretim müdürü yayınlar.${o ? ` Onayda bekleyen: ${esc(o.ad)}.` : ''} Denemede sağ üstten rol değiştirip müdür olarak onaylayabilirsiniz.</p>`;
}
function bgYayin(p) {
  const c = canliSen(); const yaz = yetkili('plan.canliya-al');
  if (!c || !c.plan) return `<div class="pm-bg-yayin"><p>Henüz yayınlanmış plan yok. Yayınlanınca atölye ekranları ve operatör kuyrukları bu planı gösterir.</p>
    ${yaz ? (bgOnayda() ? bgOnayHtml(true) : `<div class="pm-dugmeler">${dugme('Planı yayınla', 'bg-yayinla', { birincil: true, simge: 'check' })}</div>`) : bgOnayHtml(false)}</div>`;
  let deg = 0; const isl = new Set();
  for (const [id, r] of Object.entries(p.ops)) { const e = c.plan.ops[id]; if (!e || e.m !== r.m || Math.abs(e.S - r.S) > 0.25) { deg++; isl.add(r.job); } }
  const o0 = c.plan.ozet, o1 = p.ozet;
  return `<div class="pm-bg-yayin"><p>Yayındaki plan: <b>${esc(c.ad)}</b>, ${esc(c.canliKim || '')}.</p>
    <ul class="pm-bg-kiyas"><li><small>Yeri değişen iş</small><b class="mono">${deg}</b><span class="pm-kucuk">${isl.size} sipariş</span></li><li><small>Geciken sipariş</small><b class="mono">${o0.late} → ${o1.late}</b></li><li><small>Ağırlıklı gecikme</small><b class="mono">${saat(o0.wT)} → ${saat(o1.wT)}</b></li></ul>
    ${yaz ? bgOnayHtml(true) : ''}${deg ? (yaz ? (bgOnayda() ? '' : `<div class="pm-dugmeler">${dugme('Yeni planı yayınla', 'bg-yayinla', { birincil: true, simge: 'check' })}</div>`) : bgOnayHtml(false)) : '<p class="pm-kucuk">Taslak yayındaki planla aynı.</p>'}</div>`;
}

function sBugun() {
  sepetHazirla(); if (U.gyIstisna == null) U.gyIstisna = true;
  const p = S.plan;
  if (!p) return `<div class="pm-bos">${ic('gantt', 'b')}<strong>Henüz plan yok</strong><span>Motor siparişleri tezgâhlara yerleştirir; sonra kararları buradan verirsiniz.</span>${dugme('Planı kur', 'coz', { birincil: true, simge: 'play', yetki: 'plan.yaz', veri: 'data-v="sifir"' })}</div>`;
  const gel = bgGelenler(p), kar = bgKararlar(p), dok = bgDokum();
  const acik = kar.filter(x => !x.karar).length;
  const say = { gelen: gel.length, karar: acik, gozden: dok.length, yayin: null };
  const adim = U.bAdim || (gel.length ? 'gelen' : 'karar');
  const sekme = `<ol class="pm-bg-adimlar" role="tablist" aria-label="Günlük plan adımları">${BG_ADIM.map(([id, ad, sm], i) => `<li><button type="button" role="tab" data-act="bg-adim" data-v="${id}" aria-selected="${adim === id}"><span class="pm-bg-no">${i + 1}</span>${ic(sm, 'k')}<span class="pm-bg-ad">${ad}</span>${say[id] ? `<span class="pm-bg-say mono">${say[id]}</span>` : ''}</button></li>`).join('')}</ol>`;
  const son = U.bgSon && U.taslak && U.taslak.adimlar[U.bgSon.i] ? U.bgSon : null;
  let govde = '';
  if (adim === 'gelen') govde = gel.length ? `<ul class="pm-bg-liste">${gel.map(x => bgKart(x)).join('')}</ul>` : '<p class="pm-bg-bos">Gelen yok: bütün siparişler planda, açık arıza ya da veri uyarısı yok.</p>';
  if (adim === 'karar') govde = kar.length ? `<ul class="pm-bg-liste">${kar.map(x => bgKart(x, son)).join('')}</ul>` : '<p class="pm-bg-bos">Karar bekleyen yok: bütün siparişler termine yetişiyor.</p>';
  if (adim === 'gozden') govde = dok.length ? `${bgDokumOzet(dok)}<ul class="pm-bg-dokum">${dok.filter(d => Math.abs(d.T1 - d.T0) > 0.05 || U.secJob === d.job).map(d => `<li ${U.secJob === d.job ? 'data-secili' : ''}><button type="button" class="pm-bg-dokum-bas" data-act="bg-goster" data-v="${esc(d.job)}"><b class="mono">${esc(d.job)}</b>${d.T0 - d.T1 > 0.05 ? rozet(d.T1 > 0.05 ? `${gecMetin(d.T0 - d.T1)} erken` : 'artık yetişiyor', 'tamam') : d.T1 - d.T0 > 0.05 ? rozet(`${gecMetin(d.T1 - d.T0)} geç`, 'uyari') : rozet('termin etkisi yok', 'pasif')}</button>
      <ul>${d.l.slice(0, 4).map(x => `<li>${esc(x.ad)}: ${x.e ? (x.e.m !== x.r.m ? `<b>${esc(bgTezAd(x.e.m))} → ${esc(bgTezAd(x.r.m))}</b>, ` : `${esc(bgTezAd(x.r.m))}, `) : `<b>yeni, ${esc(bgTezAd(x.r.m))}</b>, `}<span class="mono">${x.e ? `${esc(fmtDT(S.D, x.e.S))} → ` : ''}${esc(fmtDT(S.D, x.r.S))}</span></li>`).join('')}${d.l.length > 4 ? `<li class="pm-kucuk">ve ${d.l.length - 4} adım daha</li>` : ''}</ul></li>`).join('')}</ul>${bgDokumDiger(dok)}
      <details class="pm-bg-adim-l"><summary>Yapılan ${U.taslak.adimlar.length} değişiklik</summary><ol>${U.taslak.adimlar.map((a, i) => `<li><span>${esc(a.ad)}</span>${dugme('', 'taslak-don', { kucuk: true, hayalet: true, simge: 'rotate', ad: 'Bu değişiklikten öncesine dön', veri: `data-v="${i}"` })}</li>`).join('')}</ol></details>`
    : '<p class="pm-bg-bos">Bu oturumda planda değişiklik yapılmadı.</p>';
  if (adim === 'yayin') govde = bgYayin(p);
  const i = BG_ADIM.findIndex(x => x[0] === adim); const sonraki = BG_ADIM[i + 1];
  const alt = sonraki ? `<div class="pm-bg-alt">${dugme(`Sonraki: ${sonraki[1]}`, 'bg-adim', { simge: 'next', veri: `data-v="${sonraki[0]}"` })}</div>` : '';
  if (adim === 'gozden' && dok.length && U.taslak && U.taslak.adimlar.length) U.gyKarsi = true;
  if (typeof turKendiliginden === 'function') turKendiliginden();
  return `<div class="pm-bg">
    <header class="pm-bg-ust"><div class="pm-bg-ust-satir"><p class="pm-bg-durum" ${p.ozet.late ? 'data-ton="hata"' : 'data-ton="tamam"'}>${ic(p.ozet.late ? 'flag' : 'check', 'k')}<span>${esc(bgDurumCumle(p, acik))}</span></p>${dugme('Tur', 'tur', { kucuk: true, hayalet: true, simge: 'help', ad: 'Bu ekranı adım adım tanıt' })}</div>${sekme}</header>
    <div class="pm-bg-govde">
      <section class="pm-bg-sol" aria-label="${esc(BG_ADIM[i][1])}"><p class="pm-bg-yardim">${BG_YARDIM[adim]}</p>${U.soz ? cozumKarti() : ''}${govde}${alt}</section>
      <section class="pm-bg-plan" aria-label="Gün planı">${sGunYuzey()}</section>
    </div></div>`;
}

function bgEylem(act, v) {
  switch (act) {
    case 'bg-adim': U.bAdim = v; U.bgSon = null; if (v !== 'gozden') U.gyKarsi = false; render(); return true;
    case 'bg-onal': { const n = U.taslak ? U.taslak.adimlar.length : 0; oneAl(v); if (U.taslak && U.taslak.adimlar.length > n) U.bgSon = { id: v, i: n }; render(); return true; }
    case 'tur': turBaslat(); return true;
    case 'bg-kalsin': U.bgSon = null; render(); return true;
    case 'bg-kabul': bgKarar()[v] = 'kabul'; iz('Gecikme kabul edildi', v); kaydet(); render(); return true;
    case 'bg-ac': delete bgKarar()[v]; kaydet(); render(); return true;
    case 'bg-goster': { U.secJob = v; U.secili = null; U.gySec = null; const r = Object.values(S.plan.ops).filter(x => x.job === v && isFinite(x.S) && !x.done).sort((a, b) => a.S - b.S)[0];
      if (r) U.agGun = Math.max(0, Math.floor(r.S / 24) - Math.floor(cxAl().st.now / 24)); render();
      const el = document.querySelector('.pm-bg-plan .pm-gy-blok[data-v^="' + v + '."]'); if (el) el.scrollIntoView({ block: 'nearest', inline: 'center' }); return true; }
    case 'bg-onaya': {
      if (!yetkili('plan.yaz') || !S.plan) return true;
      if (!planGuncel()) { bildir('Önce planı güncelleyin.', 'hata'); return true; }
      for (const x of S.senaryolar) if (x.durum === 'onay') x.durum = 'acik';
      const s = { id: 's' + Date.now().toString(36), ad: `Onay ${fmtDT(S.D, cxAl().st.now).slice(0, 9)} · ${kim().ad}`, durum: 'onay', yazar: kim().ad, zaman: Date.now(), tabanSurum: S.canliSurum, D: clone(S.D), down: clone(S.down), ekMesai: clone(S.ekMesai), locks: clone(S.locks), pref: clone(S.pref), w: clone(S.w), plan: clone(S.plan), ozet: clone(S.plan.ozet), J: clone(S.plan.J) };
      S.senaryolar.push(s); senKirp(10, s);
      iz('Plan onaya gönderildi', s.ad); kaydet(); render(); bildir('Plan müdür onayına gönderildi.', 'tamam'); return true; }
    case 'bg-reddet': { const s = S.senaryolar.find(x => x.id === v); if (s) { s.durum = 'acik'; iz('Plan geri gönderildi', s.ad); kaydet(); render(); } return true; }
    case 'bg-yayinla': {
      if (!yetkili('plan.canliya-al') || !S.plan) return true;
      if (!planGuncel()) { bildir('Önce planı güncelleyin.', 'hata'); return true; }
      const ad = `Yayın ${fmtDT(S.D, cxAl().st.now).slice(0, 9)} · ${S.canliSurum + 1}`;
      const s = { id: 's' + Date.now().toString(36), ad, durum: 'canli', yazar: kim().ad, zaman: Date.now(), tabanSurum: S.canliSurum, D: clone(S.D), down: clone(S.down), ekMesai: clone(S.ekMesai), locks: clone(S.locks), pref: clone(S.pref), w: clone(S.w), plan: clone(S.plan), ozet: clone(S.plan.ozet), J: clone(S.plan.J), canliKim: kim().ad, canliZaman: Date.now() };
      for (const x of S.senaryolar) if (x.durum === 'canli') x.durum = 'arsiv';
      S.senaryolar.push(s); senKirp(10, s);
      S.canli = s.id; S.canliSurum++; iz('Plan yayınlandı', `${ad}`); taslakBitir(); kaydet(); render(); bildir('Plan yayınlandı. Atölye bu planı görür.', 'tamam'); return true; }
  }
  return false;
}

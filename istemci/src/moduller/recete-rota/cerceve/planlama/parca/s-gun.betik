/* ---------- Taslak: değişiklikler üst üste birikir ----------
   Taslak açıkken her önizleme kendiliğinden plana yazılır ve bir adım olarak listelenir; herhangi bir adımdan öncesine dönülebilir.
   Her adımın öncesi saklanır: plan, kilitler, ek mesai, arızalar, olaylar ve siparişler. */
function taslakAnlik() {
  return { plan: S.plan, locks: S.locks, ekMesai: S.ekMesai, down: clone(S.down), sip: S.D.siparisler.slice(), olaylar: (S.olaylar || []).slice(), gercek: S.gercek || {}, dataVer: S.dataVer };
}
function taslakGeriYukle(a) {
  if (calisan && U.ilerleme && U.ilerleme.olay) calisan.bitir();
  Object.assign(S, { plan: a.plan, locks: a.locks, ekMesai: a.ekMesai, down: a.down, olaylar: a.olaylar, gercek: a.gercek || {}, dataVer: a.dataVer }); S.D.siparisler = a.sip;
  U.hamle = null; U.kriz = null; kaydet();
}
/* render'dan çağrılır: taslak açıkken bekleyen önizleme adım olur; true dönerse çizim zaten yapılmıştır */
function taslakIsle() {
  if (U.araniyor || !U.taslak || !U.hamle || U.hamle.dv !== S.dataVer) return false;
  const once = taslakAnlik(); const o0 = S.plan.ozet; const ad = U.hamle.ad; const deg = U.hamle.degisen.length; const bir = U.hamle.birlestir || null;
  const yeni = new Set(U.hamle.degisen.filter(x => x.gec === 'gecikmeye düştü').map(x => x.j));
  hamleUygula(true);
  /* klavyeyle ya da düğmeyle art arda yapılan aynı taşıma tek satırda toplanır; öncesi ilk adımın öncesidir */
  const a = U.taslak.adimlar; const son = a[a.length - 1];
  if (bir && son && son.birlestir === bir && Date.now() - son.t < 8000) Object.assign(son, { ad, o1: S.plan.ozet, deg: Math.max(son.deg, deg), t: Date.now(), dusen: [...new Set([...son.dusen, ...yeni])] });
  else a.push({ ad, once, o0, o1: S.plan.ozet, deg, birlestir: bir, t: Date.now(), dusen: [...yeni] });
  if (U.sol == null && !U.solElle && innerWidth >= 1280) U.sol = 'sepet';
  return false;
}
function taslakBaslat() { U.taslak = { adimlar: [], bas: Date.now() }; U.hamle = null; render(); bildir('Taslak açık: her değişiklik birikir, istediğiniz adıma geri dönebilirsiniz.', 'tamam'); }
function taslakDon(i) {
  const t = U.taslak; if (!t || !t.adimlar[i]) return;
  taslakGeriYukle(t.adimlar[i].once); t.adimlar = t.adimlar.slice(0, i); render();
}
function taslakBitir() { const n = U.taslak ? U.taslak.adimlar.length : 0; U.taslak = { adimlar: [], bas: Date.now() }; render(); if (n) bildir(`Sepet boşaltıldı: ${n} değişiklik planda kaldı.`, 'tamam'); }
function taslakPaneli(kisa) {
  const t = U.taslak; if (!t) return '';
  const a = t.adimlar; const o0 = a.length ? a[0].o0 : S.plan.ozet, o = S.plan.ozet;
  const satir = a.map((x, i) => `<li><b class="mono">${i + 1}</b><span><span>${esc(x.ad)}</span><small class="mono">gecikme ${fark(x.o1.wT, x.o0.wT) || 'değişmedi'} · ${x.deg} siparişin bitişi</small></span>${dugme('', 'taslak-don', { simge: 'rotate', kucuk: true, hayalet: true, ad: `${i + 1}. adımdan öncesine dön`, veri: `data-v="${i}"` })}</li>`).reverse().join('');
  return `<section class="pm-taslak" aria-label="Taslak"><header>${ic('layers', 'k')}<b>Sepet</b><span class="mono">${a.length} değişiklik</span></header>
    <div class="pm-taslak-ozet mono"><span>gecikme ${saat(o0.wT)} → <b>${saat(o.wT)}</b> ${fark(o.wT, o0.wT)}</span><span>geciken ${o0.late} → <b>${o.late}</b></span></div>
    ${a.length ? `<ol class="pm-taslak-liste">${kisa ? satir.split('</li>').slice(0, 4).join('</li>') + (a.length > 4 ? '</li>' : '') : satir}</ol>` : '<p class="pm-kucuk">İşleri taşıyın, sıralayın ya da bir olay deneyin; her biri burada bir adım olur.</p>'}
    <div class="pm-dugmeler">${a.length ? dugme('Hepsini geri al', 'taslak-don', { kucuk: true, simge: 'rotate', veri: 'data-v="0"' }) : ''}${a.length ? dugme('Sepeti boşalt', 'taslak-bitir', { kucuk: true, simge: 'check' }) : ''}</div></section>`;
}

/* ---------- Gün katmanı: bir gün tezgâh satırları ve saatlerden oluşan bir çalışma yüzeyine döner ----------
   İş seçilir, yapabilen tezgâhların satırları belirir; satırda bir saate tıklamak ya da işi oraya bırakmak hamledir.
   Taşınan iş o saate sabitlenir; motor sonraki hesaplarda ona dokunmaz. Aynı yüzeyde çoklu seçim, saat kapatma,
   havuzdan sipariş alma, günü dondurma ve sepetin başındaki planla karşılaştırma yapılır. */
// Gecikmiyor ama termin tamponunu aşmış sipariş: risk altında.
function gyRisk(J) { return !!(J && J.dueB != null && J.C > J.dueB + 0.05 && !(J.T > 0.05)); }
function gyGun() { return Math.max(0, U.agGun || 0); }
function gyGir(g) { U.tbAg = true; U.agGun = Math.max(0, +g || 0); U.tbCekmece = false; render(); }
function gyCik() { U.mercek = 'tahta'; U.agGun = null; U.gySec = null; U.gyCoklu = []; U.havuzSec = null; U.gyBoya = false; U.tbAg = false; render(); }
const gyGunNo = g => Math.floor(cxAl().st.now / 24) + g;
function gyTasi(id, m, t, bir) {
  const r = S.plan.ops[id]; const cx = cxAl(); const o = cx.byId[id]; if (!r || !o) return;
  if (!o.c.some(c => c.m === m)) { bildir(`${m} bu adımı yapamaz; rotada uygun tezgâh değil.`, 'hata'); return; }
  t = Math.round(Math.max(cx.st.now, t) * 4) / 4;
  hamleDene([[id, m, t]], `${id} → ${m[0] === '@' ? m.slice(1) : m} ${fmtDT(S.D, t)}`, [[id, m, t]], [], { birlestir: bir || null });
  /* motor işi istenen saatten sonraya koyduysa nedeni söylenir */
  const q = (U.hamle ? U.hamle.plan.ops : S.plan.ops)[id];
  if (q && q.S > t + 0.5) { const e = gyErken(id); bildir(`${id} en erken ${fmtDT(S.D, q.S)} başlayabiliyor: ${e && e.t > t + 0.25 ? e.ad.toLocaleLowerCase('tr-TR') : 'tezgâhın açık saatini ya da sıradaki işi bekliyor'}.`); }
}
/* İşin en erken başlayabileceği an ve nedeni: serbest bırakma, önceki adım, fasondan dönüş; malzeme ayrıca verilir,
   çünkü malzeme kısıtı uyarı kipindeyken iş malzeme gelmeden de başlar (K3). */
function gyErken(id) {
  const cx = cxAl(); const p = gosterilen(); const o = cx && cx.byId[id]; if (!o) return null;
  const tas = +cx.A.tasimaSaat || 0; let t = cx.st.now, ad = 'Hemen başlayabilir';
  const j = cx.jobs[o.job]; if (j.rel != null && j.rel > t) { t = j.rel; ad = 'Sipariş serbest bırakılır'; }
  for (const [pid, ty] of o.pr) { const q = p.ops[pid]; if (!q || !isFinite(q.C)) continue; const x = (ty === 'o' && !q.fas ? q.lot1 : q.C) + (q.fas ? 0 : tas); if (x > t) { t = x; ad = q.fas ? `Fasondan döner (${q.m.slice(1)})` : `Önceki adım ${ty === 'o' ? 'ilk partiyi verir' : 'biter'} (${pid.split('.').pop()})`; } }
  const mr = cx.mat.res[o.job]; const mat = mr && mr.ready > cx.st.now ? mr.ready : null; const sert = S.w.mat === 'sert';
  if (sert && mat != null && mat > t) { t = mat; ad = isFinite(mat) ? 'Malzeme gelir' : 'Malzeme eksik'; }
  return { t, ad, mat, sert };
}
function gyDondu(d) { return Object.values(S.locks).some(l => l.gun === d); }
function gyDondur(g) {
  const d = gyGunNo(g); const a = d * 24, b = a + 24; const p = S.plan;
  if (gyDondu(d)) { degistir('Gün çözüldü', fmtDT(S.D, a).slice(0, 9), () => { for (const id in S.locks) if (S.locks[id].gun === d) delete S.locks[id]; }, 'plan.kilitle', { planKoru: true }); return; }
  const l = Object.values(p.ops).filter(r => isFinite(r.S) && r.S >= a && r.S < b && !S.locks[r.id] && !r.done);
  if (!l.length) { bildir('Bu günde dondurulacak iş yok.'); return; }
  degistir('Gün donduruldu', `${fmtDT(S.D, a).slice(0, 9)} · ${l.length} iş yerinde sabit`, () => { for (const r of l) S.locks[r.id] = { m: r.m, S: r.S, gun: d }; }, 'plan.kilitle', { planKoru: true });
}
function gyKaydir(dh) {
  const ids = (U.gyCoklu && U.gyCoklu.length ? U.gyCoklu : [U.gySec]).filter(id => id && S.plan.ops[id]); if (!ids.length) return;
  const now = cxAl().st.now;
  const mods = ids.map(id => { const r = S.plan.ops[id]; return [id, r.m, Math.round(Math.max(now, r.S + dh) * 4) / 4]; });
  hamleDene(mods, `${ids.length === 1 ? ids[0] : ids.length + ' iş'} ${dh > 0 ? '+' : '−'}${saat(Math.abs(dh))} kaydı`, mods, [], { birlestir: 'kay:' + ids.join(',') });
}
function gyCokluSabit(ac) {
  const ids = (U.gyCoklu || []).filter(id => S.plan.ops[id]); if (!ids.length) return;
  degistir(ac ? 'İşler sabitlendi' : 'Sabitlik kaldırıldı', ids.join(', '), () => { for (const id of ids) { const r = S.plan.ops[id]; if (ac) S.locks[id] = { m: r.m, S: r.S }; else delete S.locks[id]; } }, 'plan.kilitle', { planKoru: true });
}
/* Havuzdaki sipariş tezgâh satırına bırakılınca, o tezgâhın yapabildiği ilk adımı o saate konur */
function havuzMakineleri(jid) {
  const s = S.D.siparisler.find(x => x.id === jid); const u = s && S.D.urunler.find(x => x.id === s.urun); if (!u) return new Set();
  return new Set(u.rota.flatMap(o => o.fason ? ['@' + o.fason] : (o.tezgahlar || []).map(t => t.id)));
}
function sGunYuzey() {
  const p = gosterilen(); const cx = cxAl(); const D = S.D; const Y = TB.son || tbYerlesim(p); const now = cx.st.now;
  const d0 = Math.floor(now / 24) * 24; const g = gyGun(); const a = d0 + g * 24, b = a + 24; const yz = t => ((t - a) / 24 * 100).toFixed(3) + '%';
  const yaz = yetkili('plan.yaz'); const sec = U.gySec && p.ops[U.gySec] ? p.ops[U.gySec] : null; const secO = sec ? cx.byId[sec.id] : null;
  const coklu = (U.gyCoklu || []).filter(id => p.ops[id]); const hs = U.havuzSec && S.D.siparisler.some(x => x.id === U.havuzSec && x.havuz) ? U.havuzSec : null;
  const uygun = hs ? havuzMakineleri(hs) : new Set(secO && !coklu.length ? secO.c.map(c => c.m) : []); const secJ = sec ? sec.job : U.secJob;
  const yanan = !!(hs || (sec && !coklu.length)) && !U.gyBoya;
  const eski = U.hamle ? S.plan.ops : null;
  const erken = sec && !coklu.length && !hs ? gyErken(sec.id) : null;
  const once = U.gyKarsi && U.taslak && U.taslak.adimlar.length ? U.taslak.adimlar[0].once.plan : null;
  const satirlar = Object.values(Y.kart).map(k => {
    const m = k.id; const M = cx.M[m];
    let kapali = '', t = a; if (M) { for (const [x, y] of M.rw) { if (y <= a) continue; if (x >= b) break; if (x > t) kapali += `<i class="pm-gy-kapali" style="left:${yz(t)};width:${yz(a + Math.min(x, b) - t)}"></i>`; t = Math.max(t, y); } if (t < b) kapali += `<i class="pm-gy-kapali" style="left:${yz(t)};width:${yz(a + b - t)}"></i>`; }
    const ariza = S.down.filter(d => d.m === m && d.to > a && d.from < b).map(d => `<i class="pm-gy-ariza" style="left:${yz(Math.max(a, d.from))};width:${yz(a + Math.min(b, d.to) - Math.max(a, d.from))}" title="Arıza ya da bakım"></i>`).join('');
    let dolu = 0;
    const bloklar = Object.values(p.ops).filter(r => r.m === m && isFinite(r.C) && r.C > a && r.S < b).sort((x, y) => x.S - y.S).map(r => {
      const s = Math.max(a, r.S), e = Math.min(b, r.C); dolu += M ? workIn(M.rw, s, e) : e - s; const o = cx.byId[r.id] || {}; const kl = S.locks[r.id];
      const ee = eski && eski[r.id]; const deg = eski && (!ee || ee.m !== r.m || Math.abs(ee.S - r.S) > 0.25);
      const secili = (sec && sec.id === r.id) || coklu.includes(r.id);
      return `<button type="button" class="pm-gy-blok" data-act="gy-sec" data-v="${esc(r.id)}" draggable="false" style="left:${yz(s)};width:${yz(a + e - s)};--c:${durumRenk(r.job)}" ${r.S < a ? 'data-sol' : ''} ${r.C > b ? 'data-sag' : ''} ${secili ? 'data-secili' : ''} ${secJ && r.job !== secJ && !coklu.length ? 'data-soluk' : ''} ${deg ? 'data-degisti' : ''} ${(p.J[r.job] || {}).T > 0.05 ? 'data-gec' : gyRisk(p.J[r.job]) ? 'data-risk' : ''} ${kl && kl.gun != null ? 'data-dondu' : ''} title="${esc(r.id)} · ${esc(o.ad || '')} · ${esc(fmtDT(D, r.S))} → ${esc(fmtDT(D, r.C))}${kl ? (kl.gun != null ? ' · dondurulmuş gün' : ' · sabit') : ''}">${kl ? ic('lock', 'k') : ''}<b class="mono">${esc(r.job)}</b><small>${esc(o.ad || '')}</small></button>`; }).join('');
    /* sepetin başındaki plan: yeri değişen işin eski yeri kesik çizgiyle */
    const hayalet = once ? Object.values(once.ops).filter(x => x.m === m && isFinite(x.C) && x.C > a && x.S < b).filter(x => { const r = p.ops[x.id]; return !r || r.m !== x.m || Math.abs(r.S - x.S) > 0.25; }).map(x => `<i class="pm-gy-hayalet" style="left:${yz(Math.max(a, x.S))};width:${yz(a + Math.min(b, x.C) - Math.max(a, x.S))}" title="${esc(x.id)} sepetten önce burada: ${esc(fmtDT(D, x.S))}"><span class="mono">${esc(x.job)}</span></i>`).join('') : '';
    const uy = yanan && uygun.has(m);
    const erk = uy && erken && erken.t > a ? `<i class="pm-gy-erken" style="left:0;width:${yz(Math.min(b, erken.t))}" title="${esc(erken.ad)}: ${esc(fmtDT(D, erken.t))}"></i>${erken.t < b ? `<i class="pm-gy-cizgi-im" style="left:${yz(erken.t)}"><span>${esc(erken.ad)}</span></i>` : ''}` : '';
    const mat = uy && erken && !erken.sert && erken.mat != null && isFinite(erken.mat) && erken.mat > a && erken.mat < b ? `<i class="pm-gy-cizgi-im" data-tur="malzeme" style="left:${yz(erken.mat)}"><span>Malzeme gelir</span></i>` : '';
    const acik = M ? M.rw.reduce((s, [x, y]) => s + Math.max(0, Math.min(y, b) - Math.max(x, a)), 0) : 24;
    const oran = acik ? dolu / acik : null;
    return `<div class="pm-gy-satir" data-m="${esc(m)}" ${yanan ? (uy ? 'data-uygun' : 'data-uygunsuz') : ''}><button type="button" class="pm-gy-ad" data-act="gy-tez" data-v="${esc(m)}" title="${esc(tezgahAd(cx, m))}: tezgâh ayrıntısı"><b class="mono">${esc(m[0] === '@' ? m.slice(1) : m)}</b><small class="mono" data-isi="${isiSeviye(oran)}">${oran == null ? 'kapalı' : '%' + Math.round(oran * 100)}</small></button>
      <div class="pm-gy-cizgi" data-m="${esc(m)}">${kapali}${ariza}${erk}${hayalet}${bloklar}${mat}</div></div>`; }).join('');
  const saatler = Array.from({ length: 12 }, (_, i) => `<span style="left:${(i * 2 / 24 * 100).toFixed(2)}%">${String(i * 2).padStart(2, '0')}</span>`).join('');
  const simdi = now > a && now < b ? `<i class="pm-gy-simdi" style="left:${yz(now)}"></i>` : '';
  const citU = typeof DENGE === 'object' ? DENGE[dengeAl()].ufuk : 0, cit = now + citU;
  const citIm = citU && cit > a && cit < b ? `<i class="pm-gy-cit" style="left:${yz(cit)}" title="Dondurma bölgesi sonu: ${esc(fmtDT(D, cit))}"><span>dondurma sonu</span></i>` : '';
  const citBant = citU && now < b && cit > a ? `<i class="pm-gy-cit-bant" style="left:${yz(Math.max(a, now))};width:${yz(a + Math.min(b, cit) - Math.max(a, now))}"></i>` : '';
  const gunler = Array.from({ length: 7 }, (_, i) => `<button type="button" data-act="gy-gun" data-v="${i}" aria-pressed="${i === g}" ${gyDondu(gyGunNo(i)) ? 'data-dondu' : ''}>${esc(fmtDT(D, d0 + i * 24).slice(0, 9))}</button>`).join('');
  const dondu = gyDondu(gyGunNo(g));
  const yan = gyYan(p, cx, sec, secO, coklu, hs, erken);
  const o = p.ozet, on = U.hamle ? S.plan.ozet : null;
  const dg = (act, simge, ad, basili, ek = '') => `<button type="button" class="tc-dugme tc-dugme-kucuk" data-act="${act}" aria-pressed="${!!basili}" title="${esc(ad)}" ${ek}>${ic(simge, 'k')}<span>${ad}</span></button>`;
  return `<section class="pm-gy" aria-label="Gün katmanı: ${esc(fmtDT(D, a).slice(0, 9))}" ${U.gyBoya ? 'data-boya' : ''} ${U.gyIstisna ? 'data-istisna' : ''}>
    <header class="pm-gy-ust">${dugme('', 'gy-gun', { simge: 'chev-left', kucuk: true, ad: 'Önceki gün', veri: `data-v="${Math.max(0, g - 1)}"` })}<b class="mono">${esc(fmtDT(D, a).slice(0, 9))}</b>${dugme('', 'gy-gun', { simge: 'chev-right', kucuk: true, ad: 'Sonraki gün', veri: `data-v="${g + 1}"` })}
      <div class="pm-seg pm-gy-gunler" role="group" aria-label="Günler">${gunler}</div><span class="pm-sira-ara"></span>
      ${yaz ? dg('gy-coklu', 'check', 'Çoklu seç', U.gyCokluKip || coklu.length) + dg('gy-boya', 'wrench', 'Saat kapat', U.gyBoya) : ''}${dg('gy-istisna', 'alert', 'Yalnız istisna', U.gyIstisna)}${U.taslak && U.taslak.adimlar.length ? dg('gy-karsi', 'eye', 'Öncekiyle karşılaştır', U.gyKarsi) : ''}${yetkili('plan.kilitle') ? dg('gy-dondur', 'lock', dondu ? 'Dondurmayı kaldır' : 'Günü dondur', dondu, `data-v="${g}"`) : ''}
      <span class="pm-gy-oz mono" ${o.late ? 'data-ton="hata"' : ''}>gecikme ${saat(o.wT)}${on ? ' ' + fark(o.wT, on.wT) : ''} · geciken ${o.late}</span></header>
    <div class="pm-gy-govde"><div class="pm-gy-tablo"><div class="pm-gy-saat" aria-hidden="true"><span class="pm-gy-ad"></span><div>${saatler}</div></div>
      <div class="pm-gy-satirlar">${simdi || citIm || citBant ? `<div class="pm-gy-simdi-kat" aria-hidden="true"><span></span><div>${citBant}${simdi}${citIm}</div></div>` : ''}${satirlar}</div></div>
      <aside class="pm-gy-yan">${yan}${U.hamle && !U.taslak ? `<div class="pm-gy-hamle"><p class="pm-kucuk"><b>Önizleme:</b> ${esc(U.hamle.ad)} · gecikme ${saat(S.plan.ozet.wT)} → <b>${saat(U.hamle.plan.ozet.wT)}</b></p><div class="pm-dugmeler">${dugme('Vazgeç', 'hamle-vazgec', { kucuk: true })}${dugme('Uygula', 'hamle-uygula', { kucuk: true, birincil: true, simge: 'check' })}</div></div>` : ''}
        <p class="pm-kucuk pm-gy-lejant"><i class="pm-gy-l-kapali"></i>kapalı <i class="pm-gy-l-ariza"></i>arıza <i class="pm-gy-l-gec"></i>geciken ${ic('lock', 'k')}sabit${once ? ' <i class="pm-gy-l-hayalet"></i>sepetten önceki yer' : ''}</p></aside></div></section>`;
}
function gyYan(p, cx, sec, secO, coklu, hs, erken) {
  const D = S.D; const yaz = yetkili('plan.yaz');
  if (U.gyBoya) return `<div class="pm-gy-sec"><h4>${ic('wrench', 'k')} Saat kapat</h4><p class="pm-kucuk">Kapatmak istediğiniz saatleri bir tezgâh satırında soldan sağa sürükleyin. Aralık arıza ya da bakım olarak işlenir; motor içindeki işleri yeniden dağıtır ve değişiklik sepete düşer.</p><div class="pm-dugmeler">${dugme('Bitti', 'gy-boya', { kucuk: true, simge: 'check' })}</div></div>`;
  if (hs) { const s = D.siparisler.find(x => x.id === hs);
    return `<div class="pm-gy-sec"><h4><span class="mono">${esc(hs)}</span> havuzdan</h4><p class="pm-kucuk">${esc(urunAd(s.urun))} · ${s.adet} adet · termin ${esc(s.termin || '—')}</p><p class="pm-kucuk">${ic('target', 'k')} Yanan bir satırda saate tıklayın ya da siparişi oraya sürükleyin: o tezgâhın yapabildiği ilk adım o saate konur, motor kalan adımları yerleştirir.</p>
      <div class="pm-dugmeler">${dugme('Motor yerleştirsin', 'havuz-al', { kucuk: true, birincil: true, simge: 'play', veri: `data-v="${esc(hs)}"` })}${dugme('', 'havuz-sec', { kucuk: true, hayalet: true, simge: 'x', ad: 'Vazgeç', veri: `data-v="${esc(hs)}"` })}</div></div>`; }
  if (coklu.length) return `<div class="pm-gy-sec"><h4>${coklu.length} iş seçili</h4><p class="pm-kucuk">${esc(coklu.slice(0, 6).join(', '))}${coklu.length > 6 ? ' …' : ''}</p>
    <div class="pm-gy-kay" role="group" aria-label="Seçili işleri kaydır">${[[-4, '−4 sa'], [-1, '−1 sa'], [1, '+1 sa'], [4, '+4 sa']].map(([d, ad]) => `<button type="button" class="tc-dugme tc-dugme-kucuk" data-act="gy-kay" data-v="${d}">${ad}</button>`).join('')}</div>
    <div class="pm-dugmeler">${dugme('Sabitle', 'gy-coklu-sabit', { kucuk: true, simge: 'lock', veri: 'data-v="1"', yetki: 'plan.kilitle' })}${dugme('Sabitliği kaldır', 'gy-coklu-sabit', { kucuk: true, veri: 'data-v="0"', yetki: 'plan.kilitle' })}${dugme('Seçimi bırak', 'gy-coklu-bos', { kucuk: true, hayalet: true, simge: 'x' })}</div>
    <p class="pm-kucuk">Shift ya da Ctrl ile tıklayarak seçime iş ekleyin. Kaydırılan işler yeni saatlerinde sabitlenir.</p></div>`;
  if (sec) { const o = secO || {}; const kilit = S.locks[sec.id]; const alt = o.c ? o.c.filter(c => c.m !== sec.m && !c.fas) : []; const s = D.siparisler.find(x => x.id === sec.job) || {};
    return `<div class="pm-gy-sec"><h4><span class="mono" style="--c:${durumRenk(sec.job)}">${esc(sec.id)}</span></h4><p class="pm-kucuk">${esc(o.ad || '')} · ${esc(tezgahAd(cx, sec.m))}<br>${esc(fmtDT(D, sec.S))} → ${esc(fmtDT(D, sec.C))} · ${saat(sec.C - sec.S)}</p>
      ${erken ? `<p class="pm-gy-erken-not">${ic('clock', 'k')}<span>En erken <b class="mono">${esc(fmtDT(D, erken.t))}</b>: ${esc(erken.ad.toLocaleLowerCase('tr-TR'))}.${erken.mat != null && !erken.sert ? ` Malzeme ${isFinite(erken.mat) ? esc(fmtDT(D, erken.mat)) + ' gelir' : 'eksik'}; malzeme kısıtı uyarı kipinde, iş beklemeden başlar.` : ''}</span></p>` : ''}
      ${yaz ? `<p class="pm-kucuk">${ic('target', 'k')} Yanan satırda saate tıklayın, işi oraya sürükleyin ya da ok tuşlarıyla kaydırın (←/→ bir saat, Shift ile çeyrek saat, ↑/↓ başka tezgâh).${alt.length ? '' : ' Bu adımı yalnız bu tezgâh yapabiliyor.'}</p>
      <div class="pm-dugmeler">${kilit ? dugme('Sabitliği kaldır', 'kilit-ac', { kucuk: true, simge: 'lock', veri: `data-v="${esc(sec.id)}"`, yetki: 'plan.kilitle' }) : dugme('Burada sabitle', 'kilitle', { kucuk: true, simge: 'lock', veri: `data-v="${esc(sec.id)}"`, yetki: 'plan.kilitle' })}${dugme('Siparişin yolu', 'st-sip', { kucuk: true, simge: 'list', veri: `data-v="${esc(sec.job)}"` })}${dugme('', 'gy-sec', { kucuk: true, hayalet: true, simge: 'x', ad: 'Seçimi bırak', veri: `data-v="${esc(sec.id)}"` })}</div>
      ${s.adet > 1 && !sec.done && !sec.act ? `<details class="pm-gy-ac"><summary>${ic('ruler', 'k')} Partiyi böl</summary><form class="pm-dik" data-form="parti-bol" novalidate><input type="hidden" name="j" value="${esc(sec.job)}"><input type="hidden" name="op" value="${esc(sec.id)}">
        <label class="tc-alan"><span class="tc-alan-etiket">Birinci parti (toplam ${s.adet})</span><input class="tc-alan-kutu" type="number" name="adet" min="1" max="${s.adet - 1}" value="${Math.floor(s.adet / 2)}"></label>
        ${alt.length ? `<label class="tc-alan"><span class="tc-alan-etiket">İkinci parti bu adımda</span><select class="tc-alan-kutu" name="m"><option value="">Aynı tezgâh, sırada</option>${alt.map(c => `<option value="${esc(c.m)}">${esc(c.m)} · ${esc(tezgahAd(cx, c.m))}</option>`).join('')}</select></label>` : ''}
        <button type="submit" class="tc-dugme tc-dugme-kucuk tc-dugme-birincil">${ic('ruler', 'k')}Böl</button></form></details>` : ''}
      ${gercekFormu(sec)}${hedefFormu(sec.job)}` : ''}</div>`; }
  return `<div class="pm-gy-sec"><p class="pm-kucuk">Bir iş seçin: yapabilen tezgâhlar yanar, saatine tıklayınca oraya taşınır ve sabitlenir. Shift ile birden çok iş seçip birlikte kaydırabilirsiniz. Soldaki havuzdan sipariş sürükleyip bir satıra bırakmak onu plana alır. Tezgâh adına basınca ayrıntısı sağda açılır.</p></div>`;
}
function gyBagla() {
  const y = document.querySelector('.pm-gy'); if (!y || y.dataset.bagli) return; y.dataset.bagli = '1';
  const saatOf = (el, x) => { const r = el.getBoundingClientRect(); const d0 = Math.floor(cxAl().st.now / 24) * 24 + gyGun() * 24; return d0 + Math.max(0, Math.min(1, (x - r.left) / r.width)) * 24; };
  const yerlestir = (c, x) => { if (U.havuzSec) { havuzdanAl(U.havuzSec, c.dataset.m, saatOf(c, x)); return; } gyTasi(U.gySec, c.dataset.m, saatOf(c, x)); };
  /* Shift, Ctrl ya da çoklu seçim kipinde tıklamak işi seçime ekler; seçim varken yanan satırdaki başka işin üstüne tıklamak yerleştirmedir */
  y.addEventListener('click', e => {
    if (U.gyBoya) { if (e.target.closest('.pm-gy-cizgi')) { e.stopPropagation(); e.preventDefault(); } return; }
    const bl = e.target.closest('.pm-gy-blok'); if (!bl) return;
    if (e.shiftKey || e.ctrlKey || e.metaKey || U.gyCokluKip) { e.stopPropagation(); e.preventDefault(); const l = new Set(U.gyCoklu || []); if (!l.size && U.gySec) l.add(U.gySec); l.has(bl.dataset.v) ? l.delete(bl.dataset.v) : l.add(bl.dataset.v); U.gyCoklu = [...l]; U.gySec = null; render(); return; }
    if ((!U.gySec && !U.havuzSec) || bl.dataset.v === U.gySec || !yetkili('plan.yaz')) return; const c = bl.closest('.pm-gy-cizgi'); if (!c || !c.parentElement.hasAttribute('data-uygun')) return;
    e.stopPropagation(); e.preventDefault(); yerlestir(c, e.clientX); }, true);
  y.addEventListener('click', e => { if (U.gyBoya || e.target.closest('button')) return; const c = e.target.closest('.pm-gy-cizgi'); if (!c || (!U.gySec && !U.havuzSec) || !yetkili('plan.yaz')) return;
    if (!c.parentElement.hasAttribute('data-uygun')) { bildir(`${c.dataset.m} bu ${U.havuzSec ? 'siparişin hiçbir adımını' : 'adımı'} yapamaz.`, 'hata'); return; }
    yerlestir(c, e.clientX); });
  /* saat kapatma: satırda sürüklenen aralık arıza ya da bakım olayı olur */
  let boya = null;
  y.addEventListener('pointerdown', e => { if (!U.gyBoya || !yetkili('plan.yaz')) return; const c = e.target.closest('.pm-gy-cizgi'); if (!c) return; e.preventDefault();
    const iz_ = document.createElement('i'); iz_.className = 'pm-gy-boya-iz'; c.appendChild(iz_); boya = { c, x0: e.clientX, iz: iz_ }; c.setPointerCapture(e.pointerId); });
  y.addEventListener('pointermove', e => { if (!boya) return; const r = boya.c.getBoundingClientRect(); const a = Math.max(r.left, Math.min(boya.x0, e.clientX)), b = Math.min(r.right, Math.max(boya.x0, e.clientX)); boya.iz.style.left = ((a - r.left) / r.width * 100) + '%'; boya.iz.style.width = ((b - a) / r.width * 100) + '%'; });
  const boyaBitir = e => { if (!boya) return; const { c, x0 } = boya; boya.iz.remove(); boya = null; let t0 = saatOf(c, Math.min(x0, e.clientX)), t1 = saatOf(c, Math.max(x0, e.clientX));
    t0 = Math.floor(t0 * 2) / 2; t1 = Math.ceil(t1 * 2) / 2; if (t1 - t0 < 1) t1 = t0 + 1; t0 = Math.max(cxAl().st.now, t0); if (t1 <= t0) return;
    olayDene({ tip: 'ariza', m: c.dataset.m, bas: t0, saat: t1 - t0 }); };
  y.addEventListener('pointerup', boyaBitir); y.addEventListener('pointercancel', () => { if (boya) { boya.iz.remove(); boya = null; } });
  let tasi = null;
  const lit = ok => y.querySelectorAll('.pm-gy-satir').forEach(s => s.toggleAttribute('data-uygun', ok.has(s.dataset.m)));
  y.addEventListener('dragstart', e => { const bl = e.target.closest('.pm-gy-blok'); if (!bl || !yetkili('plan.yaz') || U.gyBoya) { e.preventDefault(); return; } tasi = bl.dataset.v; const o = cxAl().byId[tasi]; lit(new Set(o ? o.c.map(c => c.m) : [])); try { e.dataTransfer.setData('text/plain', tasi); } catch (x) { /* bazı tarayıcılar reddeder */ } e.dataTransfer.effectAllowed = 'move'; y.dataset.tasiniyor = ''; });
  y.addEventListener('dragenter', () => { if (HAVUZ_TAS && !tasi) lit(havuzMakineleri(HAVUZ_TAS)); });
  y.addEventListener('dragover', e => { if (!tasi && !HAVUZ_TAS) return; const c = e.target.closest('.pm-gy-satir[data-uygun] .pm-gy-cizgi'); y.querySelectorAll('[data-hedef]').forEach(x => delete x.dataset.hedef); if (c) { e.preventDefault(); c.dataset.hedef = ''; } });
  y.addEventListener('dragend', () => { tasi = null; delete y.dataset.tasiniyor; y.querySelectorAll('[data-hedef]').forEach(x => delete x.dataset.hedef); if (!U.gySec && !U.havuzSec) y.querySelectorAll('[data-uygun]').forEach(x => x.removeAttribute('data-uygun')); });
  y.addEventListener('drop', e => { const c = e.target.closest('.pm-gy-cizgi'); if (!c || (!tasi && !HAVUZ_TAS)) return; e.preventDefault();
    if (HAVUZ_TAS && !tasi) { const j = HAVUZ_TAS; HAVUZ_TAS = null; havuzdanAl(j, c.dataset.m, saatOf(c, e.clientX)); return; }
    const id = tasi; tasi = null; gyTasi(id, c.dataset.m, saatOf(c, e.clientX)); });
  const s = y.querySelector('.pm-gy-blok[data-secili]'); if (s) s.scrollIntoView({ block: 'nearest', inline: 'nearest' });
}
/* Klavye: seçili iş ←/→ ile bir saat (Shift ile çeyrek saat), ↑/↓ ile yapabilen bir önceki ya da sonraki tezgâha kayar.
   Art arda basışlar sepette tek satırda toplanır. */
document.addEventListener('keydown', e => {
  if (mercekAl() !== 'gun' || U.studyo || U.pencere || !yetkili('plan.yaz') || (e.target.closest && e.target.closest('input, textarea, select'))) return;
  if (e.key === 'Delete' || e.key === 'Escape') return;
  const yon = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -2, ArrowDown: 2 }[e.key]; if (!yon) return;
  if (U.gyCoklu && U.gyCoklu.length && Math.abs(yon) === 1) { e.preventDefault(); gyKaydir(yon * (e.shiftKey ? 0.25 : 1)); return; }
  const r = U.gySec && S.plan.ops[U.gySec]; if (!r) return; e.preventDefault();
  if (Math.abs(yon) === 1) { gyTasi(r.id, r.m, r.S + yon * (e.shiftKey ? 0.25 : 1), 'kb:' + r.id); return; }
  const o = cxAl().byId[r.id]; const sira = Object.keys((TB.son || tbYerlesim(S.plan)).kart).filter(m => o.c.some(c => c.m === m));
  const i = sira.indexOf(r.m); const m = sira[i + (yon > 0 ? 1 : -1)]; if (!m) { bildir('Bu yönde bu adımı yapabilen tezgâh yok.'); return; }
  gyTasi(r.id, m, r.S, 'kb:' + r.id);
});

/* ---------- Sepet: tahtanın solunda biriken değişiklikler ve etkileri ----------
   Taslak tahtada her zaman açıktır; her hamle sepete bir satır olarak düşer, istenen satırdan öncesine dönülür, sepet senaryo olarak saklanır. */
function sepetHazirla() { if (!U.taslak && S.plan && yetkili('plan.yaz') && !U.sepetYok) U.taslak = { adimlar: [], bas: Date.now() }; }
function sepetGovde() {
  const t = U.taslak; if (!t) return '<p class="pm-kucuk">Bu rolde plan değiştirilemez; sepet yalnız yazma yetkisiyle açılır.</p>';
  const a = t.adimlar; const n = a.length;
  const o0 = n ? a[0].o0 : S.plan.ozet, o = S.plan.ozet;
  const df = (x, y, k = 1) => { const d = x - y; if (Math.abs(d) < (k ? 0.05 : 0.5)) return '<span class="pm-kucuk">—</span>'; return `<span class="${d > 0 ? 'pm-fark-kotu' : 'pm-fark-iyi'}">${d > 0 ? '+' : '−'}${k ? saat(Math.abs(d)) : Math.abs(d)}</span>`; };
  const satir = a.map((x, i) => `<tr><td class="mono">${i + 1}</td><td><span class="pm-sepet-ad">${esc(x.ad)}</span></td><td class="mono pm-num">${df(x.o1.wT, x.o0.wT)}</td><td class="mono pm-num">${df(x.o1.late, x.o0.late, 0)}</td><td class="mono pm-num">${x.deg}</td><td>${dugme('', 'taslak-don', { simge: 'rotate', kucuk: true, hayalet: true, ad: `${i + 1}. değişiklikten öncesine dön`, veri: `data-v="${i}"` })}</td></tr>`).join('');
  return `<div class="pm-sepet-toplam"><div><small>Gecikme</small><b class="mono">${saat(o.wT)}</b>${df(o.wT, o0.wT)}</div><div><small>Geciken</small><b class="mono">${o.late}/${o.n}</b>${df(o.late, o0.late, 0)}</div><div><small>Başlangıç</small><b class="mono">${saat(o0.wT)}</b></div></div>
    ${n ? `<div class="pm-sepet-tablo"><table><thead><tr><th>#</th><th>Değişiklik</th><th class="pm-num">Gecikme</th><th class="pm-num">Geciken</th><th class="pm-num" title="Bitişi değişen sipariş">Sip.</th><th><span class="tc-gizli-etiket">Geri</span></th></tr></thead><tbody>${satir}</tbody></table></div>`
      : '<p class="pm-kucuk">Tahtada, gün katmanında, kuyrukta ya da stüdyolarda yaptığınız her değişiklik plana hemen yazılır ve burada bir satır olur. Beğenmediğiniz satırın geri düğmesi o değişiklikten öncesine döner.</p>'}
    ${n ? `<form class="pm-sira" data-form="senaryo-kaydet" data-sepet="1" novalidate><input class="tc-alan-kutu pm-sira-ara" name="ad" placeholder="Senaryo adı" aria-label="Senaryo adı"><button type="submit" class="tc-dugme tc-dugme-kucuk tc-dugme-birincil" ${planGuncel() ? '' : 'disabled'}>${ic('flag', 'k')}Senaryo yap</button></form>
    <div class="pm-dugmeler">${dugme('Hepsini geri al', 'taslak-don', { kucuk: true, simge: 'rotate', veri: 'data-v="0"' })}${dugme('Sepeti boşalt', 'taslak-bitir', { kucuk: true, simge: 'check', ad: 'Değişiklikler planda kalır, liste temizlenir' })}</div>` : ''}`;
}

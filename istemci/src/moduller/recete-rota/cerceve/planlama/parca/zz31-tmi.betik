/* ---------- TMI içinde ----------
   Uygulamada bu sayfa yalıtılmış çerçevededir (opak köken). Reçete ve Rota bu sayfanın içinde açılamaz: yalıtılmış çerçevenin içindeki
   çerçeve ayrı opak kökendir, birbirinin penceresine ve deposuna erişemez. Reçete ve Rota bölümleri kabuğun öteki çerçevesidir; iki
   çerçevenin ortak verisi aynı kayıttır (recete-rota-motoru-v1) ve kabuk çerçeve değişirken kaydı yeniden okur.
   Deneme verisi yoktur: çalışma o kayıttan kurulur. Kayıt yoksa boş kayıttan; uydurma veri ana tabloya yazılmaz. */
const TMI_ICINDE = typeof window.tmi === 'object' && window.tmi !== null && typeof window.tmiGorunum === 'object' && window.tmiGorunum !== null;
/* Aşama 1: işlemler yalnız yöneticidedir; denemenin rolü kabuğun yetkisinin yerine geçmez, sunucu yazmayı yine kendi yetkisiyle denetler. */
const TMI_KULLANICI = 'u5';
/* İkinci menü anahtarı -> sayfa; listede olmayan sayfa kendi adıyla bildirilir (kabuk menüde olmayanı yok sayar). */
const TMI_MENU = { plan: 'tahta', studio: 'patolye', kanban: 'tahta' };
const TMI_SAYFA_ANAHTAR = { tahta: 'plan', patolye: 'studio' };
/* Kayıt çevirisi, kaynak birleştirmesi, fason firma, adım adedi ve başlamış adımlar motor klasöründeki girdi.betik'tedir (tmiCevir,
   tmiKaynakIle, tmiFasoncular, tmiAdimAdetleri, tmiCalisanlar, kaynakBirlestir, calisanBirlestir): sunucu planın girdisini aynı kodla kurar. */
const TMI_KAYNAK = { durum: null, ek: null, bekliyor: false };

if (TMI_ICINDE) {
  /* Kaydı planlama sayfası hiç yazmadıysa plan dilimi, dolayısıyla başlangıç yoktur. Saklanmış çalışma açılırken kayıt değişmişse
     (rrCek) çalışma bu çeviriyle değişir: açık çalışmanın başlangıcı korunur, yoksa taban kurulur; başlangıçsız çalışma çizimi düşürür. */
  rrDenemeyeCevir = function (st) { return tmiCevir(st, TMI_KAYNAK.durum ? TMI_KAYNAK : null, S && S.D); };
  /* Kaynaklar açık çalışmaya yalnız bu alanlarla girer: kaydın geri kalanı ve kaydedilmemiş plan ayarları olduğu gibi kalır. Ana kayda
     yazılmaz (sunucu zaten ayıklar); değişiklik planı eskitir. */
  const kaynakUygula = () => {
    if (!kaynakBirlestir(S.D, rrOku(), TMI_KAYNAK.durum ? TMI_KAYNAK : null).length) return false;
    S.dataVer++; U.hamle = null;
    RRV.S = S; RRV.dj = JSON.stringify(S.D);
    if (S.plan) bildir('Tezgâh, personel ve takvim sunucudan alındı. Plan yeniden çözülünce güncellenir.', 'tamam');
    return true;
  };
  /* Sayım yalnız o adımın çubuğunu günceller, başka iş yerinden oynamaz (prototip zz34); plan eskimez. Planlamacının elle girdiği gerçekleşen
     sunucunun başlamış dediği adımda sunucununkiyle değişir; sunucunun artık başlamış demediği adımın sunucu kaydı silinir. */
  const calisanUygula = () => {
    if (!TMI_KAYNAK.durum || !Array.isArray(TMI_KAYNAK.durum.calisanAdimlar)) return false;
    const now = cxAl() ? cxAl().st.now : 7;
    const y = tmiCalisanlar(TMI_KAYNAK.durum, rrOku(), S.D, now); if (!y) return false;
    const { degisti, yeniSapma } = calisanBirlestir(S, y, cxAl());
    if (!degisti) return false;
    if (S.plan) ozetTazele();
    /* yazılmaz: her açılışta sunucudan yeniden kurulur; ortak çalışma kaydına açılışta yazmak aynı anda açana çakışma (409) verir */
    const l = yeniSapma.map(sapmaOf).filter(x => x && Math.abs(x.d) > sapmaEsik());
    if (l.length) bildir(l.map(sapmaMetni).join(' ') + ' Plan kendiliğinden değişmez.', 'uyari');
    return true;
  };
  const kaynakAl = () => {
    if (typeof window.tmi.kaynakOku !== 'function') return;
    window.tmi.kaynakOku().then(r => {
      if (!r || !r.durum) return;
      TMI_KAYNAK.durum = r.durum; TMI_KAYNAK.ek = r.ek || null;
      if (!S) { TMI_KAYNAK.bekliyor = true; return; }
      const k = kaynakUygula(); if (calisanUygula() || k) render();
    }, e => { console.error(e); bildir('Tezgâh, personel ve takvim sunucudan okunamadı; plan kapasitesiz kalabilir.', 'hata'); });
  };
  /* 31 a: sayfanın "şimdi"si yeniden planlamada gerçek saate geçer (S.simdi, planla birlikte yazılır); açılışta ve çizimde değişmez, açılışta
     yazılmaz. Gerçek saat başlangıç günü 07:00'den önceyse 07:00 kalır. */
  const st0 = stOf;
  stOf = function () { return simdiUygula(st0.apply(this, arguments), S); };
  const coz0 = coz;
  coz = function () {
    if (S && S.D && yetkili('plan.yaz') && !calisan) {
      /* 36 a: başlangıç günü yeniden planlamada bugüne kayar (girdi.betik baslangicTazele); kayıtlı saatler onunla birlikte kayar. Geri alma
         yığınları eski eksendedir, boşaltılır. Plan güncelse güncel kalır: yalnız eksen değişti. */
      const eski = S.D.meta && S.D.meta.baslangic; const guncel = planGuncel();
      const g = baslangicTazele(S, Date.now());
      if (g) {
        geriAl.length = 0; planGeri.length = 0; U.hamle = null;
        S.dataVer++; if (guncel) S.plan.dataVer = S.dataVer;
        iz('Planın başlangıç günü kaydı', `${eski} -> ${S.D.meta.baslangic} (${g} gün)`);
      }
      const n = tmiSaat(S.D, Date.now()); if (n != null && n > 7) S.simdi = Math.floor(n * 4) / 4;
    }
    return coz0.apply(this, arguments);
  };
  const yk0 = yukle;
  yukle = function () { const x = yk0(); if (x) tmiTabanKur(x.D); return x; };
  const yc0 = yeniCalisma;
  yeniCalisma = function () {
    const st = rrOku();
    let D;
    try { D = rrDenemeyeCevir(st && st.items ? st : TMI_BOS_KAYIT); } catch (e) { console.error(e); D = rrDenemeyeCevir(TMI_BOS_KAYIT); }
    /* 1650 kararının varsayılanı (zz-karar-1650) kurulurken konur: açılıştaki göç ana tabloya kullanıcı bir şey değiştirmeden yazmasın */
    if (D.planDenge == null) D.planDenge = 25;
    tmiTabanKur(D);
    VERI.tmi = { veri: D, ariza: [] };
    const s = yc0('tmi');
    delete VERI.tmi;
    s.kullanici = TMI_KULLANICI;
    /* kayıt okunmuş sayılır: ilk kayıtta çalışma kaydın üstüne yazılmaz, yalnız sonraki değişiklik yazılır */
    s.rrSavedAt = st && st.savedAt ? st.savedAt : 0;
    return s;
  };
  /* HiGHS'ı kabuk verir (highs paketi, 361 b): betik ve wasm ikilisi kabuktan gelir; çerçeve dışarıdan bir şey yüklemez */
  hsKaynak = typeof window.tmi.highs === 'function'
    ? () => window.tmi.highs()
    : () => Promise.reject(new Error('HiGHS bu çerçevede açık değil'));
  /* iç içe çerçeve kurulmaz; Reçete ve Rota sayfası istenince kabuğa bildirilir, kabuk öteki çerçeveyi açar */
  rrYerlestir = function () { if (RR.el) RR.el.hidden = true; };
  const g = window.tmiGorunum;
  let sonBildirilen = null;
  /* görünüm sayfanın betikleri arasında, açılıştan önce de gelebilir: açılış çizimine bırakılır (açılış kendi tercihini okumadan önce
     uygulanırsa tercih onu ezer) */
  let bekleyen = null;
  const uygula = ad => {
    sonBildirilen = ad;
    const sayfa = TMI_MENU[ad] || (SAYFA_AD[ad] && !rrMi(ad) ? ad : null);
    if (!sayfa || U.sayfa === sayfa) return false;
    U.sayfa = sayfa; return true;
  };
  g.kaydet(ad => { if (!S) bekleyen = ad; else if (uygula(ad)) render(); return ad; });
  const r0 = render;
  render = function () {
    if (S && bekleyen !== null) { const ad = bekleyen; bekleyen = null; uygula(ad); }
    if (S && TMI_KAYNAK.bekliyor) { TMI_KAYNAK.bekliyor = false; kaynakUygula(); calisanUygula(); }
    if (S && S.kullanici !== TMI_KULLANICI) S.kullanici = TMI_KULLANICI;
    const x = r0.apply(this, arguments);
    const ad = rrMi(U.sayfa) ? U.sayfa.slice(3) : (TMI_SAYFA_ANAHTAR[U.sayfa] || U.sayfa);
    if (ad !== sonBildirilen && !(TMI_MENU[sonBildirilen] === U.sayfa)) { sonBildirilen = ad; g.bildir(ad); }
    return x;
  };
  kaynakAl();
  /* başlamış adımların sayımı sayfa açıkken de ilerler: sayfaya dönülünce kaynaklar yeniden okunur */
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible' && S) kaynakAl(); });
}

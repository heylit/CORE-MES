/* ---------- Sade sayfa: Maliyetler ve Genel gider ----------
   Kullanıcı 20.10: iki sayfa 97 ve 218 giriş alanıyla açılıyordu. Özet önce ne eksik, ne yapmalı der; veri girişi adım adım formdur.
   Her form asıl sayfanın aynı alanı yazdığı degistir çağrısını aynı yetkiyle (plan.kilitle) ve aynı sınırlarla tekrarlar.
   Para bilgisi yalnız müdür ve yöneticide (agFiyatGorur); diğer rollerde özet kilidi düz dille söyler. */
const sdmPara = () => agFiyatGorur() && yetkili('plan.kilitle');
const sdmDegisti = (a, b) => (a == null ? null : +a) !== (b == null ? null : +b);
const sdmTezSecenek = f => () => S.D.tezgahlar.map(t => [t.id, `${t.id} · ${t.ad} · ${f(t)}`]);
function sdmPlanToplam() {
  const t = tmPlanMaliyet(); if (!t) return null;
  return { t, top: t.mal - (t.talas || 0) + t.isl + t.ayar + t.gg + t.fas + (t.mesTop || 0) + t.fin + t.tah + t.gec };
}
const sdmKilitKutu = () => ({ simge: 'lock', ad: 'Fiyat ve maliyet', deger: 'Kilitli', not: 'müdür ve yönetici görür ve girer' });
const sdmKilitIs = () => ({ simge: 'lock', metin: 'Bu sayfadaki tutarları müdür ya da yönetici girer', neden: 'Fiyat, maliyet ve kâr bilgisi yalnız müdür ve yöneticiye açıktır. Planlama sayfaları sizin için açık.', act: 'git', v: 'tahta', dugme: 'Planlama motoru', dsimge: 'gantt' });

/* ---------- Maliyetler ---------- */
SADE.maliyet = {
  ad: 'Maliyetler', simge: 'lira',
  ne: () => agFiyatGorur() ? 'Planın para hesabı buradan kurulur: tezgâh saat ücreti, malzeme kg fiyatı, işçilik ve fason fiyatı.' : 'Planın para hesabının girildiği sayfa. Tutarları müdür ve yönetici görür.',
  durum() {
    const Y = ymAyar(); const amac = { simge: 'target', ad: 'Plan neye bakar', deger: Y.amac === 'tl' ? 'Toplam TL' : 'Önce gecikme', not: Y.amac === 'tl' ? 'gecikme, ayar, fason ve mesai tek toplamda' : 'maliyete yalnız eşitlikte bakılır' };
    if (!agFiyatGorur()) return [amac, sdmKilitKutu(), { simge: 'gantt', ad: 'Plan', deger: S.plan ? (planGuncel() ? 'Güncel' : 'Eski') : null, not: S.plan ? '' : 'henüz plan yok', ton: S.plan && !planGuncel() ? 'uyari' : '' }];
    const D = S.D; const pt = sdmPlanToplam();
    const tz = D.tezgahlar.filter(t => t.ucret == null).length; const ml = (D.malzemeler || []).filter(m => m.birimFiyat == null).length;
    return [
      { simge: 'chart', ad: 'Bu planın maliyeti', deger: pt ? agTL(pt.top) : null, not: !pt ? 'plan yok' : pt.t.eksik ? `${pt.t.eksik} siparişte eksik veri var` : 'bütün siparişler dahil', ton: pt && pt.t.eksik ? 'uyari' : '' },
      { simge: 'cpu', ad: 'Saat ücreti olmayan tezgâh', deger: sayi(tz, 0), not: `${D.tezgahlar.length} tezgâhtan`, ton: tz ? 'hata' : 'tamam' },
      { simge: 'box', ad: 'Kg fiyatı olmayan malzeme', deger: sayi(ml, 0), not: `${(D.malzemeler || []).length} malzemeden`, ton: ml ? 'uyari' : 'tamam' },
      amac,
    ];
  },
  yapilacak() {
    const l = []; const D = S.D;
    if (!agFiyatGorur()) { l.push(sdmKilitIs()); return l; }
    const tz = D.tezgahlar.filter(t => t.ucret == null);
    if (tz.length) l.push({ simge: 'cpu', ton: 'hata', metin: `${tz.length} tezgâhın saat ücreti yok`, neden: `${tz.slice(0, 3).map(t => t.id).join(', ')}${tz.length > 3 ? '…' : ''}. Ücretsiz tezgâhta yapılan işin maliyeti hesaplanamaz.`, act: 'sd-form', v: 'maliyet:tezucret', dugme: 'Ücret gir', dsimge: 'lira', birincil: true });
    const ml = (D.malzemeler || []).filter(m => m.birimFiyat == null);
    if (ml.length) l.push({ simge: 'box', ton: 'uyari', metin: `${ml.length} malzemenin kg fiyatı yok`, neden: `${ml.slice(0, 3).map(m => `${m.kod} (${m.kalite || '—'})`).join(', ')}. Kalite için kg fiyatı girilince birim maliyet kendiliğinden hesaplanır.`, act: 'sd-form', v: 'maliyet:kgyeni', dugme: 'Kg fiyatı ekle', dsimge: 'plus' });
    const pt = sdmPlanToplam();
    if (pt && pt.t.eksik) l.push({ simge: 'flag', ton: 'uyari', metin: `${pt.t.eksik} siparişin maliyeti eksik`, neden: 'Fiyatı, malzeme fiyatı ya da tezgâh ücreti eksik siparişin kârı gösterilmez.', act: 'git', v: 'ysiparis', dugme: 'Siparişlere git', dsimge: 'list' });
    if (S.plan && !planGuncel() && yetkili('plan.yaz')) l.push({ simge: 'rotate', ton: 'uyari', metin: 'Fiyatlar plandan sonra değişti', neden: 'Planı iyileştir deyince yeni fiyatlarla hesaplanır.', act: 'ekip', dugme: 'Planı iyileştir', dsimge: 'play' });
    if (msSis().kip === 'kalem') l.push({ simge: 'layers', metin: 'Genel gider kalemlerden hesaplanıyor', neden: 'Kira, enerji, amortisman gibi giderler Genel gider sayfasında girilir.', act: 'git', v: 'giderler', dugme: 'Genel gider', dsimge: 'layers' });
    return l;
  },
  nasil: [
    'Bir işin maliyeti: tezgâhta geçen saat × tezgâhın saat ücreti, artı ayar süresi × (tezgâh + ayarcı ücreti), artı malzeme ve fason.',
    'Malzemenin birim maliyeti kalitesinin kg fiyatından gelir. Fire payı ihtiyacı büyütür; talaşın satış değeri maliyetten düşülür.',
    'Plan, gecikme bedeli ile ayar, fason ve ek mesai tutarının toplamını en aza indirmeye çalışır. Genel gider ve malzeme bu toplamı değiştirmez.',
    'Bir fiyatı değiştirmek planı hemen değiştirmez; plan yeniden kurulunca yeni fiyatla hesaplanır.',
    'Plan amacı, tampon riski, talaş fiyatı ve bekleme maliyeti ayarları Tüm ayrıntılar sekmesindedir.',
  ],
  formlar() {
    if (!sdmPara()) return [];
    const D = S.D; const A = () => S.D.ayarlar || {}; const Y = () => ymAyar();
    const sec = () => (U.sdForm && U.sdForm.deg) || {};
    return [
      { id: 'tezucret', ad: 'Tezgâh saat ücreti', simge: 'cpu', ne: 'Bir tezgâhın bir saatlik doğrudan maliyeti.', yetki: sdmPara,
        alanlar: () => [
          { k: 'tez', ad: 'Tezgâh', tur: 'secim', zorunlu: 1, secenek: sdmTezSecenek(t => t.ucret == null ? 'ücret yok' : sayi(t.ucret, 0) + ' TL/sa') },
          { k: 'ucret', ad: 'Saat ücreti (TL/sa)', tur: 'sayi', min: 0, zorunlu: 1, ipucu: 'Enerji, bakım, takım ve sarf. Kira ve amortisman genel giderdedir.' },
        ],
        adimlar: [{ ad: 'Hangi tezgâh', ne: 'Ücreti olmayanlar listede "ücret yok" yazar.', k: ['tez'] }, { ad: 'Saat ücreti', ne: 'Şimdiki değer dolu geldi.', k: ['ucret'] }],
        ilk: () => { const t = D.tezgahlar.find(z => z.ucret == null); return t ? { tez: t.id } : {}; },
        ileri: (d, i) => { if (i !== 0) return; const t = S.D.tezgahlar.find(z => z.id === d.tez); if (t) d.ucret = t.ucret == null ? '' : String(t.ucret); },
        kontrol: (x, i, d) => { if (i !== 1 && i !== -1) return null; const t = S.D.tezgahlar.find(z => z.id === (x.tez || d.tez)); return t && x.ucret != null && !sdmDegisti(t.ucret, x.ucret) ? 'Hiçbir şey değişmedi.' : null; },
        sonuc: 'bu tezgâhta yapılan işlerin maliyeti yeni ücretle hesaplanır.',
        kaydet: x => { const m = S.D.tezgahlar.find(z => z.id === x.tez); if (!m || x.ucret == null) return false;
          return degistir('Tezgâh saat maliyeti değişti', `${m.id}: ${m.ucret ?? '—'} → ${x.ucret} TL/sa`, () => { m.ucret = x.ucret; }, 'plan.kilitle'); },
        bitti: x => `${x.tez} saat ücreti ${sayi(x.ucret, 0)} TL/sa oldu` },
      { id: 'kgyeni', ad: 'Malzeme kg fiyatı ekle', simge: 'box', ne: 'Bir kalite için kg fiyatı; o kalitedeki bütün malzemeler bunu kullanır.', yetki: sdmPara,
        alanlar: () => [
          { k: 'kalite', ad: 'Kalite', tur: 'metin', zorunlu: 1, ipucu: 'Örnek: C45, 42CrMo4, 7075', liste: [...new Set(S.D.malzemeler.map(m => m.kalite).filter(Boolean))] },
          { k: 'cins', ad: 'Cins', tur: 'secim', zorunlu: 1, secenek: () => ML_CINS.map(c => [c, c]) },
          { k: 'form', ad: 'Form', tur: 'secim', secenek: () => ML_FORM.map(c => [c, c]), ipucu: 'Seçmezseniz kalitenin bütün formlarına geçer' },
          { k: 'fiyat', ad: 'Fiyat (TL/kg)', tur: 'sayi', min: 0, zorunlu: 1 },
        ],
        adimlar: [{ ad: 'Hangi malzeme', ne: 'Fiyatı olmayan malzemenin kalitesi önerildi.', k: ['kalite', 'cins', 'form'] }, { ad: 'Kg fiyatı', k: ['fiyat'] }],
        ilk: () => { const m = S.D.malzemeler.find(z => z.birimFiyat == null && z.kalite); return m ? { kalite: m.kalite, cins: m.cins || '', form: m.form || '' } : { cins: ML_CINS[0] }; },
        kontrol: (x, i, d) => {
          if (i === 0 || i === -1) { const kal = String(x.kalite || d.kalite || '').trim(); const fo = i === 0 ? x.form : d.form;
            if (kal && (S.D.kgFiyat || []).some(r => mlNorm(r.kalite) === mlNorm(kal) && mlNorm(r.form) === mlNorm(fo || ''))) return 'Bu kalite ve form için fiyat zaten var; Kg fiyatı değiştir formunu kullanın.'; }
          if ((i === 1 || i === -1) && x.fiyat != null && !(x.fiyat > 0)) return 'Kg fiyatı sıfırdan büyük olmalı.';
          return null; },
        sonuc: 'fiyat listeye eklenir; bu kalitedeki malzemelerin birim maliyeti hemen hesaplanır.',
        kaydet: x => { const kal = String(x.kalite).trim(); const fo = x.form || ''; const fi = +x.fiyat;
          const n = Math.max(0, ...(S.D.kgFiyat || []).map(r => +String(r.id).replace(/\D/g, '') || 0)) + 1;
          return degistir('Kg fiyatı eklendi', `${kal} ${fo || 'her form'}: ${fi} TL/kg`, () => { S.D.kgFiyat = [...(S.D.kgFiyat || []), { id: 'KG-' + n, cins: x.cins, kalite: kal, form: fo, fiyat: fi, fire: null, tarih: new Date().toISOString().slice(0, 10), kim: kim().ad }]; }, 'plan.kilitle'); },
        bitti: x => `${String(x.kalite).trim()} için ${sayi(x.fiyat, 2)} TL/kg eklendi` },
      ...((D.kgFiyat || []).length ? [{ id: 'kgdegis', ad: 'Kg fiyatı ya da fire değiştir', simge: 'edit', ne: 'Tedarikçi fiyatı değiştiğinde.', yetki: sdmPara,
        alanlar: () => [
          { k: 'r', ad: 'Fiyat satırı', tur: 'secim', zorunlu: 1, secenek: () => (S.D.kgFiyat || []).map(r => [r.id, `${r.kalite} · ${r.form || 'her form'} · ${r.fiyat == null ? 'fiyat yok' : sayi(r.fiyat, 2) + ' TL/kg'}`]) },
          { k: 'fiyat', ad: 'Fiyat (TL/kg)', tur: 'sayi', min: 0, zorunlu: 1 },
          { k: 'fire', ad: 'Fire payı (%)', tur: 'sayi', min: 0, max: 200, ipucu: 'Talaş ve hurda için eklenen pay; boş: yok' },
        ],
        adimlar: [{ ad: 'Hangi fiyat', k: ['r'] }, { ad: 'Yeni değer', ne: 'Şimdiki değerler dolu geldi; yalnız değişeni düzeltin.', k: ['fiyat', 'fire'] }],
        ileri: (d, i) => { if (i !== 0) return; const r = (S.D.kgFiyat || []).find(z => z.id === d.r); if (r) { d.fiyat = r.fiyat == null ? '' : String(r.fiyat); d.fire = r.fire == null ? '' : String(r.fire); } },
        kontrol: (x, i, d) => { if (i !== 1 && i !== -1) return null; const r = (S.D.kgFiyat || []).find(z => z.id === (x.r || d.r)); if (!r) return null;
          return !sdmDegisti(r.fiyat, x.fiyat) && !sdmDegisti(r.fire, x.fire) ? 'Hiçbir şey değişmedi.' : null; },
        sonuc: 'bu fiyatı kullanan malzemelerin birim maliyeti yeniden hesaplanır.',
        kaydet: x => { const r = (S.D.kgFiyat || []).find(z => z.id === x.r); if (!r) return false; let ok = false;
          for (const k of ['fiyat', 'fire']) { if (!sdmDegisti(r[k], x[k])) continue; const v = x[k];
            ok = degistir(k === 'fiyat' ? 'Kg fiyatı değişti' : 'Fire payı değişti', `${r.kalite} ${r.form || 'her form'}: ${r[k] ?? '—'} → ${v ?? '—'}`, () => { r[k] = v; r.tarih = new Date().toISOString().slice(0, 10); r.kim = kim().ad; }, 'plan.kilitle') || ok; }
          return ok; },
        bitti: x => { const r = (S.D.kgFiyat || []).find(z => z.id === x.r); return `${r ? r.kalite : x.r} fiyatı güncellendi`; } }] : []),
      { id: 'iscilik', ad: 'Ayarcı, operatör ücreti ve hedef kâr', simge: 'user', ne: 'Saat başı işçilik ücretleri ve teklif için kâr oranı.', yetki: sdmPara,
        alanlar: () => [
          { k: 'ayarciUcret', ad: 'Ayarcı ücreti (TL/sa)', tur: 'sayi', min: 0, max: 100000, zorunlu: 1, ipucu: 'Ayar süresince tezgâh ücretine eklenir' },
          { k: 'operatorUcret', ad: 'Operatör ücreti (TL/sa)', tur: 'sayi', min: 0, ipucu: 'Boş: tezgâh ücretine dahil' },
          { k: 'karHedef', ad: 'Hedef kâr oranı (%)', tur: 'sayi', min: 0, max: 300, zorunlu: 1, ipucu: 'Maliyetten fiyat önerirken kullanılır' },
        ],
        adimlar: [{ ad: 'Ücretler', ne: 'Şimdiki değerler dolu geldi.', k: ['ayarciUcret', 'operatorUcret'] }, { ad: 'Hedef kâr', k: ['karHedef'] }],
        ilk: () => ({ ayarciUcret: A().ayarciUcret == null ? '' : String(A().ayarciUcret), operatorUcret: Y().operatorUcret == null ? '' : String(Y().operatorUcret), karHedef: Y().karHedef == null ? '' : String(Y().karHedef) }),
        kontrol: (x, i, d) => i === -1 && !sdmDegisti(A().ayarciUcret, x.ayarciUcret) && !sdmDegisti(Y().operatorUcret, x.operatorUcret) && !sdmDegisti(Y().karHedef, x.karHedef) ? 'Hiçbir şey değişmedi.' : null,
        sonuc: 'ayar ve işleme maliyeti yeni ücretlerle hesaplanır.',
        kaydet: x => { let ok = false;
          if (sdmDegisti(A().ayarciUcret, x.ayarciUcret)) { const AA = S.D.ayarlar = S.D.ayarlar || {}; ok = degistir('Ücret değişti', `Ayarcı ücreti: ${AA.ayarciUcret ?? '—'} → ${x.ayarciUcret} TL/sa`, () => { AA.ayarciUcret = x.ayarciUcret; }, 'plan.kilitle') || ok; }
          for (const k of ['operatorUcret', 'karHedef']) { if (!sdmDegisti(Y()[k], x[k])) continue; const v = x[k]; const YY = { ...(S.D.planTL || {}) };
            ok = degistir('Maliyet ayarı değişti', `${k}: ${ymAyar()[k] ?? '—'} → ${v ?? '—'}`, () => { YY[k] = v; S.D.planTL = YY; }, 'plan.kilitle') || ok; }
          return ok; },
        bitti: () => 'İşçilik ücretleri kaydedildi' },
      ...((D.fasoncular || []).length ? [{ id: 'fason', ad: 'Fason fiyatı', simge: 'truck', ne: 'Dışarıda yaptırılan işin fiyatı ve taşıması.', yetki: sdmPara,
        alanlar: () => { const f = (S.D.fasoncular || []).find(z => z.id === sec().fas); const tal = f && f.id === A().fasonTalas;
          return [
            { k: 'fas', ad: 'Fasoncu', tur: 'secim', zorunlu: 1, secenek: () => (S.D.fasoncular || []).map(z => [z.id, `${z.ad} · ${z.id === A().fasonTalas ? (z.saatFiyat == null ? 'fiyat yok' : sayi(z.saatFiyat, 0) + ' TL/sa') : (z.fiyat == null ? 'fiyat yok' : sayi(z.fiyat, 2) + ' TL/adet')}`]) },
            { k: 'fiyat', ad: tal ? 'Saat fiyatı (TL/sa)' : 'Fiyat (TL/adet)', tur: 'sayi', min: 0, ipucu: tal ? 'Talaşlı fason tezgâh saatiyle fiyatlanır' : '' },
            { k: 'tasima', ad: 'Taşıma (TL/adet)', tur: 'sayi', min: 0, ipucu: 'Boş: yok' },
          ]; },
        adimlar: [{ ad: 'Hangi fasoncu', k: ['fas'] }, { ad: 'Fiyat ve taşıma', ne: 'Şimdiki değerler dolu geldi.', k: ['fiyat', 'tasima'] }],
        ileri: (d, i) => { if (i !== 0) return; const f = (S.D.fasoncular || []).find(z => z.id === d.fas); if (f) { const v = f.id === A().fasonTalas ? f.saatFiyat : f.fiyat; d.fiyat = v == null ? '' : String(v); d.tasima = f.tasima == null ? '' : String(f.tasima); } },
        kontrol: (x, i, d) => { if (i !== 1 && i !== -1) return null; const f = (S.D.fasoncular || []).find(z => z.id === (x.fas || d.fas)); if (!f) return null; const fk = f.id === A().fasonTalas ? 'saatFiyat' : 'fiyat';
          return !sdmDegisti(f[fk], x.fiyat) && !sdmDegisti(f.tasima, x.tasima) ? 'Hiçbir şey değişmedi.' : null; },
        sonuc: 'fason önerileri ve maliyet yeni fiyatla hesaplanır.',
        kaydet: x => { const f = (S.D.fasoncular || []).find(z => z.id === x.fas); if (!f) return false; let ok = false; const fk = f.id === A().fasonTalas ? 'saatFiyat' : 'fiyat';
          for (const [k, v] of [[fk, x.fiyat], ['tasima', x.tasima]]) { if (!sdmDegisti(f[k], v)) continue;
            ok = degistir('Fason fiyatı değişti', `${f.ad} ${k}: ${f[k] ?? '—'} → ${v ?? '—'}`, () => { if (v == null) delete f[k]; else f[k] = v; }, 'plan.kilitle') || ok; }
          return ok; },
        bitti: x => { const f = (S.D.fasoncular || []).find(z => z.id === x.fas); return `${f ? f.ad : x.fas} fiyatı güncellendi`; } }] : []),
    ];
  },
};

/* ---------- Genel gider ve amortisman ---------- */
const sdgEksikAmort = () => S.D.tezgahlar.filter(t => { const x = msSis().tez[t.id] || {}; return !(x.bedel > 0 && x.omur > 0); });
const sdgMsDegis = (id, k, v) => msDeg('Tezgâh maliyet bilgisi', `${id} ${k}: ${msSis().tez[id][k] ?? '—'} → ${v ?? '—'}`, () => { msSis().tez[id][k] = v; });
const sdgTezSecenek = f => sdmTezSecenek(t => f(msSis().tez[t.id] || {}));
const sdgOner = (tur) => ({ kira: 'alan', dogalgaz: 'alan', enerji: 'kw', su: 'kisi', isg: 'kisi' })[tur] || 'saat';
SADE.giderler = {
  ad: 'Genel gider ve amortisman', simge: 'layers',
  ne: () => agFiyatGorur() ? 'Kira, enerji, dolaylı personel ve tezgâh amortismanı burada girilir; tezgâh başına saatlik genel gider bundan çıkar.' : 'Kira, enerji ve amortisman gibi giderlerin girildiği sayfa. Tutarları müdür ve yönetici görür.',
  durum() {
    if (!agFiyatGorur()) return [sdmKilitKutu(), { simge: 'layers', ad: 'Genel gider', deger: 'Müdürde', not: 'ürün maliyetine ve teklife girer, plana girmez' }];
    const M = msSis(); const v = msHesap();
    if (!v) return [{ simge: 'alert', ad: 'Genel gider', deger: null, not: 'plan verisi derlenemedi', ton: 'hata' }];
    const ea = sdgEksikAmort().length; const dol = v.kap ? Math.min(100, v.mesgul / v.kap * 100) : null;
    return [
      { simge: 'layers', ad: 'Aylık genel gider', deger: agTL(v.aylik), not: `${M.kalemler.length} kalem + amortisman ${agTL(v.amort)}` },
      { simge: 'lira', ad: 'Tezgâh saatine düşen', deger: v.ort == null ? null : agTLs(v.ort), not: M.kip === 'kalem' ? 'ortalama, maliyette kullanılıyor' : `kullanılan tek oran ${agTLs(+ymAyar().genelGider || 0)}` },
      { simge: 'gauge', ad: 'Önümüzdeki 30 gün doluluk', deger: dol == null ? null : '%' + sayi(dol, 0), not: `${sayi(v.mesgul, 0)} / ${sayi(v.kap, 0)} sa planlı` },
      { simge: 'alert', ad: 'Boş kapasitenin gideri', deger: agTL(v.atil), not: 'ürüne yüklenmez, dönem gideri', ton: v.atil > v.aylik * 0.3 ? 'uyari' : '' },
      { simge: 'cpu', ad: 'Amortisman bilgisi eksik tezgâh', deger: sayi(ea, 0), not: `${S.D.tezgahlar.length} tezgâhtan`, ton: ea ? 'uyari' : 'tamam' },
    ];
  },
  yapilacak() {
    const l = [];
    if (!agFiyatGorur()) { l.push(sdmKilitIs()); return l; }
    const M = msSis(); const v = msHesap(); const yaz = yetkili('plan.kilitle');
    if (M.kip !== 'kalem') l.push({ simge: 'layers', ton: 'uyari', metin: 'Genel gider tek orandan hesaplanıyor', neden: 'Kalemlerden hesaplanınca her tezgâh kendi kira, enerji ve amortisman payını taşır.', act: yaz ? 'ms-kip' : null, v: 'kalem', dugme: 'Kalemlerden hesapla', dsimge: 'check', birincil: true });
    const ea = sdgEksikAmort();
    if (ea.length) l.push({ simge: 'cpu', ton: 'uyari', metin: `${ea.length} tezgâhın alış bedeli ya da ömrü yok`, neden: `${ea.slice(0, 3).map(t => t.id).join(', ')}. Amortismanı hesaplanamaz.`, act: yaz ? 'sd-form' : null, v: 'giderler:amort', dugme: 'Amortisman gir', dsimge: 'edit' });
    const ek = S.D.tezgahlar.filter(t => !((M.tez[t.id] || {}).kw > 0));
    if (ek.length) l.push({ simge: 'gauge', ton: 'uyari', metin: `${ek.length} tezgâhın kurulu gücü yok`, neden: 'Enerji gideri ve önerilen saat ücreti eksik kalır.', act: yaz ? 'sd-form' : null, v: 'giderler:tezbilgi', dugme: 'Bilgi gir', dsimge: 'edit' });
    if (v) { const fk = v.tez.filter(z => z.t.ucret == null || Math.abs(z.dogTop - +z.t.ucret) >= 1);
      if (fk.length) l.push({ simge: 'lira', metin: `${fk.length} tezgâhın saat ücreti hesaplanan değerden farklı`, neden: 'Hesaplanan değer: enerji + takım ve sarf + bakım + operatör. Yazarsanız Maliyetler sayfasındaki saat ücreti bununla değişir.', act: yaz ? 'ms-tez-yaz' : null, v: '*', dugme: 'Hepsine yaz', dsimge: 'check' }); }
    if (v && v.atil > v.aylik * 0.3) l.push({ simge: 'alert', metin: `Boş kapasitenin gideri yüksek: ${agTL(v.atil)}`, neden: 'Önümüzdeki 30 günde tezgâhların çoğu boş. Fiyatı artırmak yerine iş almak ya da vardiya azaltmak düşünülebilir.', act: 'sd-sek', v: 'giderler:tum', dugme: 'Gruplara bak', dsimge: 'chart' });
    return l;
  },
  nasil: [
    'Her gider kalemi aylık tutardır ve seçilen ölçüye göre tezgâhlara paylaştırılır: kira alanla, enerji kurulu güçle, su ve yemek kişi sayısıyla, diğerleri makine saatiyle.',
    'Amortisman tezgâhın kendisine yazılır: (alış bedeli − hurda değeri) ÷ (ömür yıl × 12).',
    'Tezgâhın saatlik genel gideri = (payı + amortismanı) ÷ önümüzdeki 30 günün çalışabilir saati × verim.',
    'Boş kalan saatin gideri ürüne yüklenmez; ayrı "boş kapasite gideri" olarak görünür.',
    'Genel gider planın kararlarını değiştirmez; ürün maliyetinde ve teklifte kullanılır.',
  ],
  formlar() {
    if (!sdmPara()) return [];
    const M = () => msSis(); const sec = () => (U.sdForm && U.sdForm.deg) || {};
    const grup = () => [['*', 'Bütün atölye'], ...[...new Set(S.D.tezgahlar.map(t => t.grup))].map(g => [g, g])];
    return [
      { id: 'kalemyeni', ad: 'Gider kalemi ekle', simge: 'plus', ne: 'Kira, enerji, sigorta gibi aylık bir gider.', yetki: sdmPara,
        alanlar: () => [
          { k: 'ad', ad: 'Kalem adı', tur: 'metin', zorunlu: 1, ipucu: 'Örnek: Kompresör bakımı' },
          { k: 'tur', ad: 'Tür', tur: 'secim', zorunlu: 1, secenek: () => MS_TUR },
          { k: 'aylik', ad: 'Aylık tutar (TL)', tur: 'sayi', min: 0, zorunlu: 1 },
          { k: 'anahtar', ad: 'Tezgâhlara neye göre paylaşılsın', tur: 'secim', zorunlu: 1, secenek: () => MS_ANAHTAR, ipucu: 'Türüne göre önerildi; kira alanla, enerji kurulu güçle, su ve yemek kişiyle' },
        ],
        adimlar: [{ ad: 'Ne gideri', k: ['ad', 'tur'] }, { ad: 'Ne kadar', ne: 'Bir aylık tutarı yazın.', k: ['aylik'] }, { ad: 'Nasıl paylaşılsın', k: ['anahtar'] }],
        ilk: () => ({ tur: 'diger' }),
        ileri: (d, i) => { if (i === 0 && !d.anahtar) d.anahtar = sdgOner(d.tur); },
        sonuc: 'kalem eklenir ve tezgâhların saatlik genel gideri yeniden hesaplanır.',
        kaydet: x => { const MM = M(); const id = 'K' + (Math.max(0, ...MM.kalemler.map(z => +String(z.id).replace(/\D/g, '') || 0)) + 1);
          return msDeg('Gider kalemi eklendi', `${x.ad}: ${agTL(x.aylik)}`, () => { MM.kalemler = [...MM.kalemler, { id, ad: x.ad, tur: x.tur, aylik: x.aylik, anahtar: x.anahtar, kapsam: '' }]; }); },
        bitti: x => `${x.ad} eklendi: ayda ${agTL(x.aylik)}` },
      { id: 'kalemdegis', ad: 'Gider kalemini değiştir', simge: 'edit', ne: 'Tutar, paylaşım ölçüsü ya da hangi tezgâhlara yazıldığı.', yetki: sdmPara,
        alanlar: () => { const k = M().kalemler.find(z => z.id === sec().kal); const hes = k && k.tur === 'personel' && k.aylik == null;
          return [
            { k: 'kal', ad: 'Kalem', tur: 'secim', zorunlu: 1, secenek: () => M().kalemler.map(z => [z.id, `${z.ad} · ${agTL(msKalemTL(z))}/ay`]) },
            { k: 'ad', ad: 'Kalem adı', tur: 'metin', zorunlu: 1 },
            ...(hes ? [] : [{ k: 'aylik', ad: 'Aylık tutar (TL)', tur: 'sayi', min: 0, ipucu: 'Boş: tutar yok' }]),
            { k: 'anahtar', ad: 'Paylaşım ölçüsü', tur: 'secim', zorunlu: 1, secenek: () => MS_ANAHTAR },
            { k: 'kapsam', ad: 'Hangi tezgâhlara', tur: 'secim', zorunlu: 1, secenek: grup, ipucu: 'Bir grubun kendi gideri yalnız o gruba yazılır' },
          ]; },
        adimlar: [{ ad: 'Hangi kalem', k: ['kal'] }, { ad: 'Ad ve tutar', ne: 'Dolaylı personel kaleminin tutarı kişilerden hesaplanır.', k: ['ad', 'aylik'] }, { ad: 'Paylaşım', k: ['anahtar', 'kapsam'] }],
        ilk: () => ({ kal: (M().kalemler[0] || {}).id }),
        ileri: (d, i) => { if (i !== 0) return; const k = M().kalemler.find(z => z.id === d.kal); if (k) { d.ad = k.ad; d.aylik = k.aylik == null ? '' : String(k.aylik); d.anahtar = k.anahtar; d.kapsam = k.kapsam || '*'; } },
        kontrol: (x, i) => { if (i !== -1) return null; const k = M().kalemler.find(z => z.id === x.kal); if (!k) return null;
          const hes = k.tur === 'personel' && k.aylik == null; const kap = x.kapsam === '*' ? '' : x.kapsam;
          return k.ad === x.ad && (hes || !sdmDegisti(k.aylik, x.aylik)) && k.anahtar === x.anahtar && (k.kapsam || '') === kap ? 'Hiçbir şey değişmedi.' : null; },
        sonuc: 'tezgâhların saatlik genel gideri yeniden hesaplanır.',
        kaydet: x => { const kal = M().kalemler.find(z => z.id === x.kal); if (!kal) return false; let ok = false; const hes = kal.tur === 'personel' && kal.aylik == null;
          const ad = String(x.ad || '').trim(); const kap = x.kapsam === '*' ? '' : x.kapsam;
          if (ad && ad !== kal.ad) ok = msDeg('Gider kalemi adı', `${kal.ad} → ${ad}`, () => { kal.ad = ad; }) || ok;
          if (!hes && sdmDegisti(kal.aylik, x.aylik)) ok = msDeg('Gider tutarı', `${kal.ad}: ${agTL(kal.aylik)} → ${agTL(x.aylik)}`, () => { kal.aylik = x.aylik; }) || ok;
          if (x.anahtar !== kal.anahtar) ok = msDeg('Dağıtım anahtarı', `${kal.ad}: ${(MS_ANAHTAR.find(z => z[0] === x.anahtar) || [, x.anahtar])[1]}`, () => { kal.anahtar = x.anahtar; }) || ok;
          if (kap !== (kal.kapsam || '')) ok = msDeg('Gider kapsamı', `${kal.ad}: ${kap || 'bütün atölye'}`, () => { kal.kapsam = kap; }) || ok;
          return ok; },
        bitti: x => `${String(x.ad || '').trim()} güncellendi` },
      { id: 'amort', ad: 'Tezgâh amortismanı', simge: 'cpu', ne: 'Alış bedeli, kaç yıl kullanılacağı ve hurda değeri.', yetki: sdmPara,
        alanlar: () => [
          { k: 'tez', ad: 'Tezgâh', tur: 'secim', zorunlu: 1, secenek: sdgTezSecenek(x => x.bedel > 0 && x.omur > 0 ? `${agTL(x.bedel)}, ${sayi(x.omur, 0)} yıl` : 'bilgi eksik') },
          { k: 'bedel', ad: 'Alış bedeli (TL)', tur: 'sayi', min: 0, zorunlu: 1 },
          { k: 'omur', ad: 'Kullanım ömrü (yıl)', tur: 'sayi', min: 1, max: 50, zorunlu: 1 },
          { k: 'hurda', ad: 'Hurda değeri (alış bedelinin %)', tur: 'sayi', min: 0, max: 100, ipucu: 'Ömür sonunda satılırsa getireceği' },
        ],
        adimlar: [{ ad: 'Hangi tezgâh', k: ['tez'] }, { ad: 'Bedel ve ömür', ne: 'Şimdiki değerler dolu geldi.', k: ['bedel', 'omur', 'hurda'] }],
        ilk: () => { const t = sdgEksikAmort()[0]; return t ? { tez: t.id } : {}; },
        ileri: (d, i) => { if (i !== 0) return; const x = M().tez[d.tez]; if (x) for (const k of ['bedel', 'omur', 'hurda']) d[k] = x[k] == null ? '' : String(x[k]); },
        kontrol: (x, i, d) => { if (i !== 1 && i !== -1) return null; const z = M().tez[x.tez || d.tez]; if (!z) return 'Bu tezgâhın maliyet kaydı yok.';
          return ['bedel', 'omur', 'hurda'].every(k => !sdmDegisti(z[k], x[k])) ? 'Hiçbir şey değişmedi.' : null; },
        sonuc: 'tezgâhın aylık amortismanı ve saatlik genel gideri yeniden hesaplanır.',
        kaydet: x => { const z = M().tez[x.tez]; if (!z) return false; let ok = false;
          for (const k of ['bedel', 'omur', 'hurda']) if (sdmDegisti(z[k], x[k])) ok = sdgMsDegis(x.tez, k, x[k]) || ok;
          return ok; },
        bitti: x => `${x.tez} amortismanı ayda ${agTL(+x.bedel * (1 - (+x.hurda || 0) / 100) / (+x.omur * 12))}` },
      { id: 'tezbilgi', ad: 'Tezgâh enerji, alan, takım ve bakım', simge: 'gauge', ne: 'Saat ücreti önerisi ve gider paylaşımı için.', yetki: sdmPara,
        alanlar: () => [
          { k: 'tez', ad: 'Tezgâh', tur: 'secim', zorunlu: 1, secenek: sdgTezSecenek(x => x.kw > 0 ? `${sayi(x.kw, 1)} kW` : 'güç yok') },
          { k: 'kw', ad: 'Kurulu güç (kW)', tur: 'sayi', min: 0 },
          { k: 'yuk', ad: 'Ortalama yük oranı', tur: 'sayi', min: 0, max: 1, ipucu: '0 ile 1 arası; 0,6: gücün %60’ını çeker' },
          { k: 'alan', ad: 'Kapladığı alan (m²)', tur: 'sayi', min: 0 },
          { k: 'sarf', ad: 'Takım ve sarf (TL/sa)', tur: 'sayi', min: 0 },
          { k: 'bakim', ad: 'Bakım (TL/sa)', tur: 'sayi', min: 0 },
        ],
        adimlar: [{ ad: 'Hangi tezgâh', k: ['tez'] }, { ad: 'Enerji ve alan', ne: 'Şimdiki değerler dolu geldi.', k: ['kw', 'yuk', 'alan'] }, { ad: 'Saatlik gider', k: ['sarf', 'bakim'] }],
        ilk: () => { const t = S.D.tezgahlar.find(z => !((M().tez[z.id] || {}).kw > 0)); return t ? { tez: t.id } : {}; },
        ileri: (d, i) => { if (i !== 0) return; const x = M().tez[d.tez]; if (x) for (const k of ['kw', 'yuk', 'alan', 'sarf', 'bakim']) d[k] = x[k] == null ? '' : String(x[k]); },
        kontrol: (x, i, d) => { if (i !== -1) return null; const z = M().tez[x.tez || d.tez]; if (!z) return 'Bu tezgâhın maliyet kaydı yok.';
          return ['kw', 'yuk', 'alan', 'sarf', 'bakim'].every(k => !sdmDegisti(z[k], x[k])) ? 'Hiçbir şey değişmedi.' : null; },
        sonuc: 'enerji gideri, gider paylaşımı ve önerilen saat ücreti yeniden hesaplanır.',
        kaydet: x => { const z = M().tez[x.tez]; if (!z) return false; let ok = false;
          for (const k of ['kw', 'yuk', 'alan', 'sarf', 'bakim']) if (sdmDegisti(z[k], x[k])) ok = sdgMsDegis(x.tez, k, x[k]) || ok;
          return ok; },
        bitti: x => `${x.tez} bilgileri kaydedildi` },
      { id: 'dolayli', ad: 'Dolaylı personel ekle', simge: 'user', ne: 'Üretimde doğrudan çalışmayan bir görev (kalite, depo, idari).', yetki: sdmPara,
        alanlar: () => [
          { k: 'gorev', ad: 'Görev', tur: 'metin', zorunlu: 1, ipucu: 'Örnek: Kalite kontrol' },
          { k: 'brut', ad: 'Brüt aylık ücret (TL)', tur: 'sayi', min: 0, zorunlu: 1, ipucu: `İşverene maliyet SGK ve yan haklarla hesaplanır (×${sayi(msSgkKat(), 3)})` },
        ],
        adimlar: [{ ad: 'Görev ve ücret', k: ['gorev', 'brut'] }],
        kontrol: (x, i) => (i === 0 || i === -1) && x.brut != null && !(x.brut > 0) ? 'Brüt ücret sıfırdan büyük olmalı.' : null,
        sonuc: 'görev dolaylı personel kalemine eklenir.',
        kaydet: x => { const MM = M(); const id = 'G' + (Math.max(0, ...MM.dolayli.map(z => +String(z.id).replace(/\D/g, '') || 0)) + 1);
          return msDeg('Dolaylı personel eklendi', `${x.gorev}: ${agTL(x.brut)}`, () => { MM.dolayli = [...MM.dolayli, { id, gorev: x.gorev, brut: x.brut }]; }); },
        bitti: x => `${x.gorev} eklendi: işverene ayda ${agTL(x.brut * msSgkKat())}` },
      { id: 'genel', ad: 'Verim ve elektrik fiyatı', simge: 'gear', ne: 'Çalışabilir saatin ne kadarı verimli ve kWh fiyatı.', yetki: sdmPara,
        alanlar: () => [
          { k: 'verim', ad: 'Verim (%)', tur: 'sayi', min: 10, max: 100, zorunlu: 1, ipucu: 'Açık saatlerin ne kadarı gerçekten üretime gider' },
          { k: 'kwh', ad: 'Elektrik fiyatı (TL/kWh)', tur: 'sayi', min: 0, max: 100, zorunlu: 1 },
        ],
        adimlar: [{ ad: 'Değerler', ne: 'Şimdiki değerler dolu geldi.', k: ['verim', 'kwh'] }],
        ilk: () => ({ verim: String(M().verim ?? ''), kwh: String(M().kwh ?? '') }),
        kontrol: (x, i) => (i === 0 || i === -1) && !sdmDegisti(M().verim, x.verim) && !sdmDegisti(M().kwh, x.kwh) ? 'Hiçbir şey değişmedi.' : null,
        sonuc: 'kapasite ve enerji gideri yeniden hesaplanır.',
        kaydet: x => { const MM = M(); let ok = false;
          if (sdmDegisti(MM.verim, x.verim)) ok = msDeg('Kapasite verimi', `%${MM.verim} → %${x.verim}`, () => { MM.verim = x.verim; }) || ok;
          if (sdmDegisti(MM.kwh, x.kwh)) ok = msDeg('Elektrik birim fiyatı', `${MM.kwh} → ${x.kwh} TL/kWh`, () => { MM.kwh = x.kwh; }) || ok;
          return ok; },
        bitti: () => 'Verim ve elektrik fiyatı kaydedildi' },
    ];
  },
};

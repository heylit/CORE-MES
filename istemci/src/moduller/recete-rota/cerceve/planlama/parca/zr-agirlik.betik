/* ---------- Gecikmenin bedeli (TL/saat) ----------
   Kararlar 177-181 a: bedel = (ceza + finansman) × müşteri çarpanı × elle çarpan; ceza bilinmiyorsa plan ayarındaki taban, uyarıyla;
   ceza tavanı dolunca da bedel aynı oranla sürer (kullanıcı 16:50, 2 b; 179 a'nın yerine): gecikmiş müşterinin işi daha da geciktirilmez; elle çarpan planlamacıda 0,5-2, müdürde 0,5-3, gerekçe zorunlu.
   Motor dosyası değişmeden bağlanır: her siparişe kendi ağırlık anahtarı verilir (PW sözlüğüne yazılır), motor ağırlığı oradan okur.
   Motor amacı doğrusal kalır; tavan yalnız TL karşılığında sayılır. Fiyatı yalnız müdür ve yönetici görür (180 cevaplanmadı, öneri a varsayıldı).
   İkinci tur (kullanıcı 19.10 09:30, "öncelik ağırlıktan belirlensin"): kâr riski bileşeni (katkı payı × günlük kayıp riski) ve
   ağırlıktan otomatik öncelik sınıfı; ikisi de onaylı karar değil, denemede açılıp kapatılabilir. */
/* Bedel hesabı (AG0, agHazirla, agAyar, agKatki, agBedel, agOncYaz) ve motor bağlantısı motor/durum.betik'tedir (sunucu da aynı st'yi kurar). */
const AG_BIL = [['ceza', 'Sözleşme cezası'], ['fin', 'Finansman'], ['kar', 'Kâr riski'], ['sinif', 'Müşteri sınıfı'], ['elle', 'Elle çarpan']];
const agFiyatGorur = () => ['mudur', 'yonetici'].includes(kim().rol);
const agElleSinir = () => kim().rol === 'planlamaci' ? 2 : ['mudur', 'yonetici'].includes(kim().rol) ? 3 : 0;
/* gecikmenin TL karşılığı: tavana kadar tam bedel, sonra taban bedel (179 a) */
function agGecTL(x, T) {
  if (!(T > 0.05)) return 0;
  if (x.ceza == null || x.tavanTL == null || x.ceza <= 0) return T * x.b;
  const h = x.tavanTL / x.ceza; return T <= h ? T * x.b : h * x.b + (T - h) * x.sonra;
}
const agTL = x => x == null || !isFinite(x) ? '—' : sayi(Math.round(x), 0) + ' TL';
const agTLs = x => x == null || !isFinite(x) ? '—' : sayi(x, x < 10 ? 1 : 0) + ' TL/sa';
function agToplamTL(p) {
  if (!p || !p.J) return null; let t = 0;
  for (const s of S.D.siparisler) { const J = p.J[s.id]; if (J && J.T > 0.05) t += agGecTL(agBedel(S.D, s), J.T); }
  return t;
}

/* ---------- Siparişler sayfası: ağırlık tablosu, müşteriler, ağırlık ayarı ---------- */
function agTablo() {
  const D = S.D, p = S.plan, J = p ? p.J : {}; agHazirla(D); const A = agAyar(); const fg = agFiyatGorur(); const es = agElleSinir(); const B = A.bil;
  const tum = D.siparisler.filter(s => !s.havuz).map(s => { const x = agBedel(D, s, A); const T = J[s.id] ? J[s.id].T : null; return { s, x, T, tl: agGecTL(x, T) }; }).sort((a, b) => b.x.b - a.x.b);
  const SUZ = [['hepsi', 'Hepsi', () => true], ['gec', 'Geç', r => r.T > 0.05], ['eksik', 'Eksik veri', r => r.x.eksik.length > 0], ['elle', 'Elle', r => r.s.elle != null && r.s.elle !== 1]];
  const suz = SUZ.find(x => x[0] === U.agSuz) || SUZ[0]; const l = tum.filter(suz[2]);
  const top = tum.reduce((t, r) => t + r.tl, 0); const gec = tum.filter(r => r.T > 0.05).length;
  const h = agOncHesap(D, A);
  const rows = l.map(({ s, x, T, tl }) => {
    const mu = x.mu; const uy = x.eksik.length ? `<span class="pm-ag-uyari" title="${esc(x.eksik.join(', '))} yok">${ic('alert', 'k')}${esc(x.eksik.join(', '))} yok${x.taban ? ', taban' : ''}</span>` : '';
    const par = [B.ceza ? `${x.ceza == null ? 'taban' : 'ceza'} ${sayi(x.temel, 1)}` : '', B.fin ? `fin. ${sayi(x.fin, 1)}` : '', B.kar ? `kâr ${x.kr == null ? '—' : sayi(x.kr, 1)}` : ''].filter(Boolean).join(' + ');
    const kir = `(${par || 'taban ' + sayi(A.taban, 1)})${B.sinif ? ` × ${esc(x.sinif || '—')} ${sayi(x.sc, 2)}` : ''}${B.elle ? ` × elle ${sayi(x.el, 2)}` : ''}`;
    const elle = es ? `<details class="pm-ag-elle"><summary class="mono" title="Elle çarpanı değiştir">×${sayi(x.el, 2)}</summary><form class="pm-dik" data-form="ag-elle" novalidate><input type="hidden" name="j" value="${esc(s.id)}">
        <label class="tc-alan"><span class="tc-alan-etiket">Elle çarpan (0,5-${es})</span><input class="tc-alan-kutu" type="number" name="v" min="0.5" max="${es}" step="0.1" value="${agElle(s)}" required></label>
        <label class="tc-alan"><span class="tc-alan-etiket">Gerekçe</span><input class="tc-alan-kutu" type="text" name="g" maxlength="120" value="" placeholder="Neden" required></label>
        <button type="submit" class="tc-dugme tc-dugme-kucuk tc-dugme-birincil">${ic('check', 'k')}Kaydet</button></form></details>` : `<span class="mono">×${sayi(agElle(s), 2)}</span>`;
    const elleNot = s.elle != null && s.elleGerekce ? `<small class="pm-ag-not">${esc(s.elleKim || '')}: ${esc(s.elleGerekce)}</small>` : '';
    const sayiAl = (k, v, ad, adim) => fg ? `<input class="pm-mz-sec pm-ag-sayi" type="number" min="0" step="${adim}" value="${v ?? ''}" placeholder="${k === 'cezaOran' && mu && mu.cezaOran != null ? sayi(mu.cezaOran, 2) : k === 'cezaTavan' ? sayi(x.tavanO, 0) : '—'}" data-chg="ag-sip" data-k="${k}" data-v="${esc(s.id)}" aria-label="${esc(s.id)} ${ad}">` : `<span class="mono">${v == null ? '—' : sayi(v, 2)}</span>`;
    const onc = A.kip === 'bedel' ? h.sinif(x.b) : s.oncelik;
    return `<tr>${td('Sipariş', `<b class="mono">${esc(s.id)}</b><small class="pm-ag-not">${esc(urunAd(s.urun))}</small>`)}${td('Öncelik', oncelikRozet(onc))}${td('Müşteri', mu ? `<span class="pm-ag-mu">${esc(mu.ad)}</span> <span class="pm-ag-sinif" data-s="${esc(mu.sinif)}">${esc(mu.sinif)}</span>` : '—')}
      ${fg ? td('Tutar', sayiAl('gelir', s.gelir, 'tutar', 100), 'pm-num') + td('Ceza %/gün', sayiAl('cezaOran', s.cezaOran, 'ceza oranı', 0.05), 'pm-num') + td('Tavan %', sayiAl('cezaTavan', s.cezaTavan, 'ceza tavanı', 1), 'pm-num') + td('Katkı payı', x.kat == null ? '—' : `<span class="mono">${agTL(x.kat)}</span>`, 'pm-num') : ''}
      ${td('Elle', elle + elleNot)}${td('1 saat gecikme', `<b class="mono">${agTLs(x.b)}</b><small class="pm-ag-not">${kir}</small>${uy}`, 'pm-ag-bedel')}
      ${td('Gecikme', T == null ? '—' : T > 0.05 ? `<span class="pm-ag-gec">${esc(saat(T))}</span>` : 'yok', 'pm-num')}${td('TL karşılığı', tl ? `<b class="mono">${agTL(tl)}</b>` : '—', 'pm-num')}</tr>`;
  }).join('');
  const bas = `<th>Sipariş</th><th>Öncelik</th><th>Müşteri</th>${fg ? '<th class="pm-num">Tutar</th><th class="pm-num">Ceza %/gün</th><th class="pm-num">Tavan %</th><th class="pm-num">Katkı payı</th>' : ''}<th>Elle</th><th>1 saat gecikme</th><th class="pm-num">Gecikme</th><th class="pm-num">TL karşılığı</th>`;
  const say = k => tum.filter(SUZ.find(x => x[0] === k)[2]).length;
  const seg = `<div class="pm-seg" role="group" aria-label="Süzgeç">${SUZ.map(([k, ad]) => `<button type="button" data-act="ag-suz" data-v="${k}" aria-pressed="${suz[0] === k}">${ad}${k === 'hepsi' ? '' : ` <span class="mono">${say(k)}</span>`}</button>`).join('')}</div>`;
  const dag = [1, 2, 3].map(k => `${ONCELIK[k]} ${tum.filter(r => (A.kip === 'bedel' ? h.sinif(r.x.b) : r.s.oncelik) === k).length}`).join(' · ');
  const ozet = `<div class="pm-ag-ozet"><span>${ic('lira', 'k')}Gecikmenin TL karşılığı <b class="mono">${agTL(top)}</b></span><span>${gec} sipariş geç</span><span>Ortanca bedel <b class="mono">${agTLs(h.ort)}</b></span><span>${A.kip === 'bedel' ? 'Otomatik öncelik' : 'Öncelik'}: ${dag}</span></div>`;
  const not = `<p class="pm-kucuk">${A.kip === 'bedel' ? `Öncelik bedelden çıkar: ortancanın ${sayi(A.esik.y, 1)} katı ve üstü Yüksek, ${sayi(A.esik.d, 1)} katı ve altı Düşük. Yüksek / Normal / Düşük seçmek elle çarpanı ayarlar ve gerekçe olarak kaydeder. Plan gecikme saatini bu bedelle çarparak toplar ve toplamı en aza indirir.` : 'Ağırlık şimdi öncelik sınıfından geliyor (Yüksek ×4, Normal ×2, Düşük ×1); bedel yalnız gösteriliyor.'} ${fg ? '' : 'Tutar, ceza oranı ve katkı payı bu rolde gizli; yalnız saatlik bedel görünür.'} Değişiklik sonrası plan "Planı iyileştir" ile yeniden dizilir.</p>`;
  return kart(`${ic('lira', 'k')} Gecikmenin bedeli <span class="pm-kucuk">${tum.length} sipariş, bedele göre</span>`, `${ozet}<div class="pm-sira">${seg}</div><div class="tc-tablo-kap"${kip()}><table class="tc-tablo pm-ag-tablo"><thead><tr>${bas}</tr></thead><tbody>${rows || `<tr><td colspan="12" class="pm-kucuk">Bu süzgeçte sipariş yok.</td></tr>`}</tbody></table></div>${not}`);
}
function agMusteriler() {
  const D = S.D; agHazirla(D); const fg = agFiyatGorur(); const A = agAyar();
  const rows = D.musteriler.map(m => `<tr>${td('Müşteri', esc(m.ad))}${td('Sınıf', fg ? `<select class="pm-mz-sec" data-chg="ag-mu" data-k="sinif" data-v="${esc(m.id)}" aria-label="${esc(m.ad)} sınıfı">${Object.keys(A.sinif).map(k => `<option value="${k}" ${m.sinif === k ? 'selected' : ''}>${k} · ×${sayi(A.sinif[k], 2)}</option>`).join('')}</select>` : `<span class="pm-ag-sinif" data-s="${esc(m.sinif)}">${esc(m.sinif)}</span>`)}
    ${fg ? td('Varsayılan ceza %/gün', `<input class="pm-mz-sec pm-ag-sayi" type="number" min="0" step="0.05" value="${m.cezaOran ?? ''}" placeholder="yok" data-chg="ag-mu" data-k="cezaOran" data-v="${esc(m.id)}" aria-label="${esc(m.ad)} ceza oranı">`, 'pm-num') + td('Tavan %', `<input class="pm-mz-sec pm-ag-sayi" type="number" min="0" step="1" value="${m.cezaTavan ?? ''}" placeholder="${sayi(A.tavan, 0)}" data-chg="ag-mu" data-k="cezaTavan" data-v="${esc(m.id)}" aria-label="${esc(m.ad)} ceza tavanı">`, 'pm-num') : ''}
    ${td('Sipariş', String(D.siparisler.filter(s => s.musteri === m.id).length), 'pm-num')}</tr>`).join('');
  return kart(`${ic('user', 'k')} Müşteri sınıfı <span class="pm-kucuk">örnek; uygulamada Müşteri ve Tedarikçi modülünde</span>`, `<div class="tc-tablo-kap"${kip()}><table class="tc-tablo"><thead><tr><th>Müşteri</th><th>Sınıf</th>${fg ? '<th class="pm-num">Varsayılan ceza %/gün</th><th class="pm-num">Tavan %</th>' : ''}<th class="pm-num">Sipariş</th></tr></thead><tbody>${rows}</tbody></table></div><p class="pm-kucuk">Sınıf ilişkiyi ve tekrar iş riskini taşır. Siparişte ceza oranı boşsa müşterinin varsayılanı kullanılır; o da boşsa taban.</p>`);
}
function agAyarKart() {
  const A = agAyar(); const yaz = agFiyatGorur();
  const al = (k, ad, birim, adim, v) => `<label class="tc-alan"><span class="tc-alan-etiket">${ad} <small>${birim}</small></span><input class="tc-alan-kutu" type="number" min="0" step="${adim}" value="${v}" data-chg="ag-ayar" data-k="${k}" ${yaz ? '' : 'disabled'}></label>`;
  const kipSeg = `<div class="pm-seg" role="group" aria-label="Ağırlık">${[['bedel', 'Gecikme bedeli'], ['sinif', 'Elle öncelik sınıfı']].map(([k, ad]) => `<button type="button" data-act="ag-kip" data-v="${k}" aria-pressed="${A.kip === k}" ${yaz ? '' : 'disabled'}>${ad}</button>`).join('')}</div>`;
  const bil = `<fieldset class="pm-ag-bil"><legend class="tc-alan-etiket">Bedele girenler</legend>${AG_BIL.map(([k, ad]) => `<label class="tc-isaret"><input type="checkbox" data-chg="ag-bil" data-k="${k}" ${A.bil[k] ? 'checked' : ''} ${yaz && A.kip === 'bedel' ? '' : 'disabled'}> ${ad}</label>`).join('')}</fieldset>`;
  const govde = `<div class="pm-dik">${kipSeg}${bil}<div class="pm-ag-ayar">${al('taban', 'Taban', 'TL/sa', 1, A.taban)}${al('fin', 'Finansman', '%/gün', 0.01, A.fin)}${al('kar', 'Kâr riski', '%/gün', 0.05, A.kar)}${al('tavan', 'Varsayılan tavan', '%', 1, A.tavan)}${Object.keys(A.sinif).map(k => al('sinif.' + k, 'Sınıf ' + k, 'çarpan', 0.1, A.sinif[k])).join('')}${al('esik.y', 'Yüksek eşiği', '× ortanca', 0.1, A.esik.y)}${al('esik.d', 'Düşük eşiği', '× ortanca', 0.1, A.esik.d)}</div>
    <ul class="pm-ag-acik">
      <li><b>Sözleşme cezası:</b> tutar × ceza oranı. Bilinmiyorsa taban kullanılır. Tavan dolsa da bedel aynı oranla sürer: gecikmiş müşterinin işi daha da geciktirilmez.</li>
      <li><b>Finansman:</b> tutar × günlük oran. Teslim gecikince tahsilat da gecikir.</li>
      <li><b>Kâr riski:</b> katkı payı (tutar − malzeme − işleme − ayar − fason) × günlük kayıp riski. Geç kalan sipariş müşteriyi ve tekrar işi riske atar; kaybedilen ciro değil katkı payıdır.</li>
      <li><b>Termin</b> bedele girmez. Motor termine ne kadar kaldığına sıralarken zaten bakıyor; bedele de girerse iki kez sayılır.</li>
      <li><b>Maliyet</b> (ayar, fazla mesai, fason, erken üretim) sıra değişince değişir. Bedele değil, planın amacına ayrı kalem olarak girer.</li>
    </ul>
    <p class="pm-kucuk">${yaz ? '' : 'Bu ayarı müdür ya da yönetici değiştirir. '}"Elle öncelik sınıfı" eski ağırlığa döner (Yüksek ×4, Normal ×2, Düşük ×1).</p></div>`;
  return kart(`${ic('gear', 'k')} Ağırlık ayarı <span class="pm-kucuk">plan ayarı</span>`, govde);
}
/* ---------- plana etkisi: aynı veriyle üç ağırlık, aynı TL ölçüsüyle karşılaştırılır ---------- */
let AG_KIYAS_MS = 700;
const AG_KIYAS = [
  ['eski', 'Elle öncelik sınıfı (eski)', { kip: 'sinif' }],
  ['ceza', 'Yalnız ceza ve finansman', { kip: 'bedel', bil: { ceza: 1, fin: 1, kar: 0, sinif: 0, elle: 1 } }],
  ['simdi', 'Şimdiki ayar', {}],
];
function agKiyasKos() {
  if (calisan || U.agKiyas === 'calisiyor') return; U.agKiyas = 'calisiyor'; render();
  const ana = S.D.planAgirlik; const sonuc = []; let i = 0; let onceki = null;
  const bir = () => {
    const [id, ad, deg] = AG_KIYAS[i];
    try {
      S.D.planAgirlik = { ...(ana || {}), ...deg, bil: { ...((ana || {}).bil || {}), ...(deg.bil || {}) } }; U.agKiyasEski = deg.kip === 'sinif';
      /* iki başlangıç: kendi ağırlığıyla kural tabanlı plan ve bir önceki satırın planı; arama sezgisel olduğundan tek başlangıç ağırlığın etkisini gürültüye boğar */
      const st = stOf(); const cx = compile(st); const bas = [schedule(st, 'dagit', null, { cx })]; if (onceki) bas.push(lnsDecode(st, { ops: onceki.ops, fail: [] }, [], cx, true));
      let L = null; for (const p0 of bas) { const x = lns(st, p0, null, { ms: AG_KIYAS_MS / bas.length, seed: 17, free: true }); if (!L || cmpEv(x.e, L.e) > 0) L = x; }
      onceki = L.plan;
      S.D.planAgirlik = ana; U.agKiyasEski = false;
      const A = agAyar(); let tl = 0, sa = 0, dog = 0; const gecL = [];
      for (const s of S.D.siparisler) { const J = L.e.J[s.id]; if (J && J.T > 0.05) { const x = agBedel(S.D, s, A); const v = agGecTL(x, J.T); tl += v; sa += J.T; dog += J.T * x.b; gecL.push([s.id, J.T, v]); } }
      sonuc.push({ id, ad, tl, sa, dog, late: gecL.length, gec: gecL.sort((a, b) => b[2] - a[2]).slice(0, 3) });
    } catch (e) { S.D.planAgirlik = ana; U.agKiyasEski = false; sonuc.push({ id, ad, hata: String(e.message || e) }); }
    if (ana === undefined) delete S.D.planAgirlik;
    agOncYaz(S.D); i++;
    if (i < AG_KIYAS.length) setTimeout(bir, 30); else { U.agKiyas = sonuc; render(); }
  };
  setTimeout(bir, 30);
}
function agEtkiKart() {
  const r = U.agKiyas; const en = Array.isArray(r) ? Math.min(...r.filter(x => !x.hata).map(x => x.tl)) : null;
  const govde = r === 'calisiyor' ? `<p class="pm-kucuk">${ic('clock', 'k')} Üç ağırlıkla plan kuruluyor…</p>`
    : Array.isArray(r) ? `<div class="tc-tablo-kap"${kip()}><table class="tc-tablo"><thead><tr><th>Ağırlık</th><th class="pm-num">Geç sipariş</th><th class="pm-num">Gecikme</th><th class="pm-num">TL karşılığı</th><th>En pahalı gecikenler</th></tr></thead><tbody>${r.map(x => x.hata ? `<tr><td>${esc(x.ad)}</td><td colspan="4">${esc(x.hata)}</td></tr>` : `<tr ${x.tl === en ? 'data-ton="tamam"' : ''}>${td('Ağırlık', `${x.tl === en ? ic('check', 'k') : ''}${esc(x.ad)}`)}${td('Geç sipariş', String(x.late), 'pm-num')}${td('Gecikme', esc(saat(x.sa)), 'pm-num')}${td('TL karşılığı', `<b class="mono">${agTL(x.tl)}</b>`, 'pm-num')}${td('En pahalı gecikenler', x.gec.map(([j, T, v]) => `<span class="mono">${esc(j)}</span> ${esc(saat(T))}`).join(', ') || '—')}</tr>`).join('')}</tbody></table></div><p class="pm-kucuk">Üçü de aynı veriyle, aynı motorla ve aynı sürede kuruldu; her satır kendi kural tabanlı planından ve bir üst satırın planından başlar, iyisini alır. TL karşılığı her satırda şimdiki bedel tanımıyla ölçülür. Çizelgedeki plan değişmez.</p>`
    : `<p class="pm-kucuk">Aynı veriyle eski öncelik sınıfını, yalnız ceza ve finansmanı ve şimdiki ayarı ayrı ayrı planlar; geç sipariş, gecikme saati ve TL karşılığını yan yana gösterir.</p>`;
  return kart(`${ic('chart', 'k')} Plana etkisi`, govde, dugme(Array.isArray(r) ? 'Yeniden hesapla' : 'Hesapla', 'ag-kiyas', { kucuk: true, birincil: !Array.isArray(r), simge: 'play', ipucu: 'Üç ağırlıkla planı ayrı ayrı kur' }));
}
const agSipEski = sSiparisler;
sSiparisler = function () {
  agHazirla(S.D); let h = agSipEski();
  h = h.replace('<p class="pm-kucuk">Öncelik gecikmenin ağırlığıdır: yüksek önceliğin bir saati normalin iki, düşüğün dört saati sayılır. Bir satıra tıklayınca düzenleme açılır.</p>', '<p class="pm-kucuk">Bir satıra tıklayınca düzenleme açılır. Öncelik aşağıdaki gecikme bedelinden çıkar.</p>');
  return h + kart(`${ic('flag', 'k')} Öncelik`, `<p class="pm-kucuk">Öncelik her siparişin gecikme bedelinden kendiliğinden çıkar. Bedelin ayarı, elle çarpan ve plana etkisi ayrı sayfada.</p>`, dugme('Öncelik ve ağırlık', 'git', { kucuk: true, simge: 'flag', veri: 'data-v="oncelik"' }));
};
GORUNUM.siparisler = sSiparisler;
/* Öncelik ve ağırlık: motorun neye baktığı, bedel tablosu, ayar ve kıyas tek sayfada */
function agNasil() {
  const A = agAyar(); const bedel = A.kip === 'bedel';
  const l = [
    ['lock', 'Önce elle verilenler', 'Sabitlenen işler ve elle verilen sıra yerinde kalır; motor yalnız gerisini dizer.'],
    ['sort', 'Sonra sıralama kuralı', `Boşalan her tezgâh, bekleyen işler içinden <b>ağırlık ÷ işlem süresi × termine kalan payın cezası</b> en büyük olanı alır (ATCS kuralı). Termini yaklaşan ve ağırlığı büyük iş öne geçer. Ağırlık ${bedel ? 'siparişin gecikme bedelidir (1 saat gecikmenin TL karşılığı; ortanca bedele göre ölçeklenir)' : 'öncelik sınıfıdır: Yüksek 4, Normal 2, Düşük 1'}.`],
    ['target', 'Sonra iyileştirme', 'Kurulan plan aramayla iyileştirilir. İki plandan hangisinin iyi olduğuna sırayla bakılır: 1) ağırlıklı gecikme (bedel × geç saat), 2) termin tamponuna girme, 3) önceki plana göre değişen iş sayısı, 4) ayar süresi, 5) maliyet ve mesai TL. Bir adım eşitse sonrakine geçilir.'],
    ['gauge', 'Kısıtlar hep geçerli', 'Tezgâh takvimi, rota sırası, operatör ve ayarcı sayısı, aparat, NC programı, ilk parça, fason süreleri ve ayar matrisine her durumda uyulur; öncelik bunları aşamaz. Malzeme eksikse iş uyarıyla başlar. Tam liste Kısıtlar sayfasında.'],
  ];
  return kart(`${ic('help', 'k')} Plan nasıl önceliklendiriyor`, `<ol class="pm-ag-nasil">${l.map(([sm, b, m]) => `<li>${ic(sm, 'k')}<span><b>${b}.</b> ${m}</span></li>`).join('')}</ol>
    <p class="pm-kucuk">Ağırlığın bileşenleri: ceza, finansman, kâr riski, müşteri sınıfı ve elle çarpan (aşağıdaki ayarda açılıp kapanır). Termin ağırlığa girmez; sıralama kuralı onu zaten kullanır.</p>`);
}
function sOncelik() { agHazirla(S.D); return agNasil() + agTablo() + agEtkiKart() + `<div class="pm-iki">${agMusteriler()}${agAyarKart()}</div>`; }
GORUNUM.oncelik = sOncelik;
{ const v = EKRANLAR.find(e => e[0] === 'veri'); if (v && !v[3].some(x => x[0] === 'oncelik')) v[3].splice(1, 0, ['oncelik', 'Öncelik ve ağırlık', 'flag']); SAYFA_AD.oncelik = 'Öncelik ve ağırlık'; EKRAN_OF.oncelik = 'veri'; }

/* ---------- değişiklikler ---------- */
document.addEventListener('change', e => {
  const el = e.target; const c = el.dataset && el.dataset.chg; if (!c || !c.startsWith('ag-')) return;
  const k = el.dataset.k; const v = c === 'ag-bil' || el.value === '' ? null : +el.value; if (v != null && !(v >= 0)) { bildir('Geçerli bir sayı girin.', 'hata'); render(); return; }
  if (!agFiyatGorur()) { bildir('Bu alanı müdür ya da yönetici değiştirir.', 'hata'); render(); return; }
  if (c === 'ag-sip') { const s = S.D.siparisler.find(x => x.id === el.dataset.v); if (!s) return; const ad = { gelir: 'tutar', cezaOran: 'ceza oranı', cezaTavan: 'ceza tavanı' }[k];
    degistir('Gecikme bedeli verisi değişti', `${s.id} ${ad}: ${s[k] ?? '—'} → ${v ?? '—'}`, () => { s[k] = v; }, 'plan.kilitle'); return; }
  if (c === 'ag-mu') { const m = (S.D.musteriler || []).find(x => x.id === el.dataset.v); if (!m) return; const yeni = k === 'sinif' ? el.value : v;
    degistir('Müşteri bilgisi değişti', `${m.ad} ${k === 'sinif' ? 'sınıfı' : k === 'cezaOran' ? 'ceza oranı' : 'tavanı'}: ${m[k] ?? '—'} → ${yeni ?? '—'}`, () => { m[k] = yeni; }, 'plan.kilitle'); return; }
  if (c === 'ag-bil') { const A = { ...(S.D.planAgirlik || {}) }; const ad = (AG_BIL.find(x => x[0] === k) || [k, k])[1];
    degistir('Ağırlık bileşeni değişti', `${ad} ${el.checked ? 'açıldı' : 'kapandı'}`, () => { A.bil = { ...AG0.bil, ...(A.bil || {}), [k]: el.checked ? 1 : 0 }; S.D.planAgirlik = A; U.agKiyas = null; }, 'plan.kilitle'); return; }
  if (c === 'ag-ayar') { if (v == null) { render(); return; } const A = { ...(S.D.planAgirlik || {}) }; const [k1, k2] = k.split('.');
    degistir('Ağırlık ayarı değişti', `${k}: ${v}`, () => { if (k2) A[k1] = { ...AG0[k1], ...(A[k1] || {}), [k2]: v }; else A[k] = v; S.D.planAgirlik = A; U.agKiyas = null; }, 'plan.kilitle'); }
});
document.addEventListener('submit', e => {
  const f = e.target.closest && e.target.closest('[data-form="ag-elle"]'); if (!f) return; e.preventDefault();
  const s = S.D.siparisler.find(x => x.id === f.elements.j.value); const es = agElleSinir(); if (!s || !es) return;
  const v = +f.elements.v.value; const g = f.elements.g.value.trim();
  if (!(v >= 0.5 && v <= es)) { bildir(`Elle çarpan 0,5 ile ${sayi(es, 0)} arasında olmalı.`, 'hata'); return; }
  if (g.length < 3) { bildir('Gerekçe yazın.', 'hata'); f.elements.g.focus(); return; }
  const once = agElle(s);
  degistir('Elle çarpan değişti', `${s.id}: ×${sayi(once, 2)} → ×${sayi(v, 2)} · ${g}`, () => { s.elle = v; s.elleGerekce = g; s.elleKim = kim().ad; U.agKiyas = null; }, 'plan.kilitle');
});
const agTekEski = tekEylem;
tekEylem = function (act, v, el, e) {
  if (act === 'ag-kip') { if (!agFiyatGorur()) { bildir('Bu ayarı müdür ya da yönetici değiştirir.', 'hata'); return true; }
    degistir('Ağırlık türü değişti', v === 'bedel' ? 'Gecikme bedeli' : 'Öncelik sınıfı', () => {
      /* sınıfa dönünce elle seçilmiş eski sınıf geri gelir; bedele geçerken o anki sınıf saklanır */
      for (const s of S.D.siparisler) { if (v === 'sinif') { if (s.onc0 != null) s.oncelik = s.onc0; } else s.onc0 = s.oncelik; }
      S.D.planAgirlik = { ...(S.D.planAgirlik || {}), kip: v }; }, 'plan.kilitle'); return true; }
  if (act === 'ag-suz') { U.agSuz = v; render(); return true; }
  if (act === 'ag-kiyas') { agKiyasKos(); return true; }
  return agTekEski(act, v, el, e);
};
/* öncelik seçimi bedel kipinde elle çarpana çevrilir: istenen sınıfa düşecek çarpan hesaplanır, gerekçesi kaydedilir */
function agOncElle(j, v, g) {
  const s = S.D.siparisler.find(x => x.id === j); const es = agElleSinir(); if (!s) return;
  if (!es) { bildir('Bu rolde öncelik değiştirilemez.', 'hata'); render(); return; }
  const A = agAyar(); const h = agOncHesap(S.D, A); const b0 = agBedel(S.D, s, A).b / (A.bil.elle ? agElle(s) : 1);
  const f = Math.round((v === 1 ? A.esik.y * h.ort / b0 * 1.05 : v === 3 ? A.esik.d * h.ort / b0 * 0.95 : h.ort / b0) * 10) / 10;
  const f2 = Math.min(es, Math.max(0.5, f));
  if (f2 !== f) bildir(`${ONCELIK[v]} için ×${sayi(f, 1)} gerekiyordu; bu rolde sınır ×${sayi(f2, 1)}.`, 'hata');
  degistir('Öncelik elle değişti', `${s.id}: ${ONCELIK[s.oncelik]} → ${ONCELIK[v]} (elle ×${sayi(f2, 1)})`, () => { s.elle = f2; s.elleGerekce = g || `Öncelik elle: ${ONCELIK[v]}`; s.elleKim = kim().ad; U.agKiyas = null; }, 'plan.kilitle');
}
const agKmOncEski = kmOncelik;
kmOncelik = function (j, v) { if (agAyar().kip !== 'bedel') return agKmOncEski(j, v); agOncElle(j, +v); };
window.addEventListener('change', e => {
  const el = e.target; if (!el.dataset || el.dataset.chg !== 'oncelik' || agAyar().kip !== 'bedel') return;
  e.stopImmediatePropagation(); agOncElle(el.dataset.v, +el.value);
}, true);

/* ---------- yan panel ve plan nabzı ---------- */
const agKmEski = kmSiparis;
kmSiparis = function (j) {
  const h = agKmEski(j); const s = S.D.siparisler.find(x => x.id === j); if (!s) return h; agHazirla(S.D);
  const x = agBedel(S.D, s); const J = S.plan && S.plan.J[j]; const T = J ? J.T : null;
  const blok = kmBolum('Gecikmenin bedeli', `<p class="pm-ag-km"><b class="mono">1 saat = ${sayi(x.b, x.b < 10 ? 1 : 0)} TL</b>${T > 0.05 ? ` · şimdiki gecikme <b class="mono">${agTL(agGecTL(x, T))}</b>` : ''}</p>
    <p class="pm-kucuk">${x.ceza == null ? 'Taban ' + agTLs(x.temel) : 'Ceza ' + agTLs(x.ceza)} + finansman ${agTLs(x.fin)}${x.kr != null ? ` + kâr riski ${agTLs(x.kr)}` : ''}, müşteri ${esc(x.sinif || '—')} ×${sayi(x.sc, 2)}, elle ×${sayi(x.el, 2)}.${x.tavanTL != null && agFiyatGorur() ? ` Sözleşme ceza tavanı ${agTL(x.tavanTL)}; plan tavandan sonra da aynı bedeli sayar.` : ''}${agAyar().kip === 'bedel' ? ` Öncelik bedelden: <b>${esc(ONCELIK[s.oncelik] || '')}</b>.` : ''}</p>
    ${x.eksik.length ? `<p class="pm-ag-uyari">${ic('alert', 'k')}${esc(x.eksik.join(', '))} yok${x.taban ? '; taban kullanılıyor' : ''}.</p>` : ''}
    <div class="pm-dugmeler">${dugme('Bedeli düzenle', 'git', { kucuk: true, hayalet: true, simge: 'lira', veri: 'data-v="oncelik"' })}</div>`, 'lira');
  const i = h.indexOf('pm-km-durum'); const k = i < 0 ? -1 : h.indexOf('</p>', i);
  return k < 0 ? h + blok : h.slice(0, k + 4) + blok + h.slice(k + 4);
};
NB_GOSTERGE[2] = ['tl', 'Gecikme', 'lira', v => v == null ? '—' : agTL(v), true, 'oncelik', 'Gecikmenin TL karşılığı: gecikme saati × siparişin saatlik bedeli (tavandan sonra da aynı oran).'];
NB_FARK_ESIK.tl = 50;
const agNbOlcEski = nbOlc;
nbOlc = function (p) { const o = agNbOlcEski(p); if (o) o.tl = agToplamTL(p); return o; };
const agNbFarkEski = nbFark;
nbFark = function (id, a, b, kucukIyi) {
  const r = agNbFarkEski(id, a, b, kucukIyi); if (id === 'tl' && r.m !== 'aynı') r.m = `${a > b ? '+' : '−'}${agTL(Math.abs(a - b))}`; return r;
};

/* üst çubuktaki kısa nabız da TL gösterir */
const agKisa = x => x == null || !isFinite(x) ? '—' : x >= 1e6 ? sayi(x / 1e6, 1) + ' mn ₺' : x >= 1e5 ? sayi(x / 1e3, 0) + ' bin ₺' : sayi(Math.round(x), 0) + ' ₺';
sdNabiz = function () {
  if (!S.plan || typeof nbOlc !== 'function') return '';
  const R = nbRef(); const onz = U.hamle && !U.taslak ? U.hamle.plan : null; const v = nbOlc(onz || S.plan); const kar = onz ? nbOlc(S.plan) : R.o;
  const l = [['late', v.late == null ? '—' : String(v.late), `geciken · ${olDonemEtiket()}`, true], agAyar().kip === 'bedel' ? ['tl', agKisa(v.tl), 'gecikme', true, 1] : ['wT', saat(v.wT), 'gecikme', true, 1], ['dar', v.dar == null ? '—' : `%${Math.round(v.dar)}`, 'darboğaz', true, 1]];
  return `<div class="pm-sb-nb" role="group" aria-label="Plan nabzı">${l.map(([id, d, ad, kucukIyi, ikincil]) => { const f = kar ? nbFark(id, v[id], kar[id], kucukIyi) : { ton: '', m: '' };
    return `<button type="button" class="pm-sb-nb-k" ${ikincil ? 'data-ikincil' : ''} data-act="br-odak" data-v="ozet" data-ton="${f.ton}" title="${esc(ad)}: ${onz ? 'önizlemede, plana göre' : esc(R.ad) + ' referansına göre'} ${esc(f.m || 'aynı')}. Göstergelere git."><b class="mono">${esc(d)}</b><span>${ad}</span>${f.ton ? `<small>${f.ton === 'iyi' ? '▼' : '▲'}</small>` : ''}</button>`; }).join('')}</div>`;
};

/* ---------- kısıt kataloğu: 157 b ve yeni ağırlık ---------- */
if (KATALOG_DUZ.bolme) Object.assign(KATALOG_DUZ.bolme, { durum: 'tam', not: 'Yalnız elle: iş panelinde "Partiyi böl". Plan partiyi kendiliğinden bölmez (karar 157 b).' });
if (KATALOG_DUZ.termin) KATALOG_DUZ.termin.not = 'Amaç gecikme saati × siparişin saatlik bedeli (ceza, finansman ve kâr riski; müşteri ve elle çarpanla). Öncelik bedelden çıkar. Ayarı Veri > Öncelik ve ağırlık sayfasında.';

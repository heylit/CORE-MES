      } else { U.psNeden = ''; iz('Stüdyo benzetimi: çakışma', `onunki alındı, benimki geri alındı`); bildir(`Canlı sürüm ${c.n1} alındı; senin değişikliğin geri alındı.`, 'tamam'); }

    case 'ps-kaydir': { const ids = (U.psSec || []).filter(id => S.plan.ops[id]); if (!ids.length) return true; psKaydir(ids, +v, `${ids.length === 1 ? ids[0] : ids.length + ' iş'} ${psSure(Math.abs(+v))} ${+v < 0 ? 'öne alındı' : 'sonraya atıldı'}`); return true; }

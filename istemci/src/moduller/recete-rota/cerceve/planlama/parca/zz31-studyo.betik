    case 'ps-kapat': U.sayfa = 'tahta'; U.psCak = null; U.psCak3 = null; U.studyo = null; render(); return true;
    case 'ps-zum': { const i = (U.psZ ?? (innerWidth < 700 ? 0 : 1)) + (+v); U.psZ = Math.max(0, Math.min(PS.k.length - 1, i)); render(); return true; }
    case 'ps-kat': (U.psKat = U.psKat || {})[v] = !(U.psKat || {})[v]; render(); return true;
    case 'ps-toplu': U.psToplu = !U.psToplu; render(); return true;
    case 'ps-ben': U.psBen = !U.psBen; U.psBenSec = null; U.psBenCoz = {}; U.psCak = null; U.psCak3 = null; U.psBenA = false; U.psTabanB = S.canliSurum; U.psCanliB = S.canliSurum; iz('Stüdyo: benzetim ' + (U.psBen ? 'açıldı' : 'kapandı'), ''); render(); return true;
    case 'ps-sec': {
      if (Date.now() - PS.sonDrag < 350) return true;
      const coklu = e && (e.shiftKey || e.ctrlKey || e.metaKey); const l = (U.psSec || []).slice(); const i = l.indexOf(v);
      if (coklu) { if (i >= 0) l.splice(i, 1); else l.push(v); U.psSec = l; } else U.psSec = i >= 0 && l.length === 1 ? [] : [v];

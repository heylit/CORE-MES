/* ---------- Planlama stüdyosu: bütün kaynaklar tek zaman ekseninde, her hamlenin etkisi anında ----------
   Planlama motoru sayfasının bir görünümüdür; motor, önizleme (U.hamle), uygulama ve senaryolar aynıdır. Stüdyo yalnız
   kaynak şeritlerini, etki şeridini, ihlal işaretlerini, günlüğü ve karşılaştırmayı ekler. Çok kullanıcılı kısım yalnız
   benzetimdir: ağ yok, kişiler ve hareketleri örnektir. */
const PS = { k: [2.5, 5, 10], drag: null, kutu: null, sonDrag: 0, ihOn: new WeakMap() };
const PS_IH = { termin: ['flag', 'Termin aşımı'], malzeme: ['box', 'Malzeme yok'], ayarci: ['wrench', 'Ayarcı çakışması'], vardiya: ['moon', 'Vardiya dışı'], oncul: ['next', 'Öncül bitmemiş'] };
const PS_GUN = { bugun: 0, 'bugün': 0, yarin: 1, 'yarın': 1, pzt: 'pzt', pazartesi: 'pzt', sal: 'sal', 'salı': 'sal', sali: 'sal', car: 'car', 'çar': 'car', 'çarşamba': 'car', carsamba: 'car', per: 'per', 'perşembe': 'per', persembe: 'per', cum: 'cum', cuma: 'cum', cmt: 'cmt', cumartesi: 'cmt', paz: 'paz', pazar: 'paz' };

/* Stüdyo kendi sayfasıdır (studyo); plan sekmesi şeritlerdir, öteki sekmeler eski stüdyolar ve onay. */
const psSayfa = () => U.sayfa === 'studyo';
const psPlanSek = () => psSayfa() && (U.psSek || 'plan') === 'plan';
const psNow = () => { const cx = cxAl(); return cx ? cx.st.now : 7; };
const psT0 = () => Math.floor(psNow() / 24) * 24;
const psK = () => PS.k[U.psZ ?? (innerWidth < 700 ? 0 : 1)];
const psX = t => (t - psT0()) * psK();
/* sürüklerken saat ızgaraya oturur: uzakta 1 saat, ortada yarım saat, yakında çeyrek */
const psAdim = () => ({ 2.5: 1, 5: 0.5, 10: 0.25 })[psK()] || 0.25;
function psUfuk(p) {
  let mx = psNow() + 24 * 7;
  for (const r of Object.values(p.ops)) if (isFinite(r.C) && r.C > mx) mx = r.C;
  return Math.min(Math.ceil(mx / 24) * 24 + 24, psT0() + 24 * 35);
}
const psGelir = () => S.D.siparisler.filter(s => !s.havuz).reduce((a, s) => a + (+s.gelir || 0), 0);
function psDsig() { const s = JSON.stringify(S.D); let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return h; }
const psImza = p => p ? `${p.zaman || 0}|${sayi(p.ozet.wT, 3)}|${p.ozet.late}|${Object.keys(p.ops).length}` : '';
function psVardiya(t) {
  const h = ((t % 24) + 24) % 24;
  return (S.D.vardiyalar || []).find(v => { const a = hm(v.bas), b = hm(v.bit); return a < b ? h >= a && h < b : h >= a || h < b; }) || null;
}

/* ---------- ihlaller: motorun kendi planında da, elle sürüklenen hayalî yerde de aynı ölçü ---------- */
function psAyarYuk(p) {
  const ev = [];
  for (const r of Object.values(p.ops)) if (!r.fas && !r.done && r.su > 0 && isFinite(r.S)) { ev.push([r.S, 1, r.id]); ev.push([r.S + r.su, -1, r.id]); }
  ev.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
  const kap = t => { const v = psVardiya(t); return v ? S.D.personel.filter(x => x.ayar && x.vardiya === v.id).length : 0; };
  const asan = new Set(); const aktif = new Set(); const dilim = [];
  for (let i = 0; i < ev.length; i++) {
    const [t, d, id] = ev[i]; if (d > 0) aktif.add(id); else aktif.delete(id);
    const t2 = i + 1 < ev.length ? ev[i + 1][0] : t; if (t2 - t < 1e-3) continue;
    const c = aktif.size; dilim.push([t, t2, c]);
    if (c > kap(t)) for (const x of aktif) asan.add(x);
  }
  return { asan, dilim, kap };
}
function psIhlal(p) {
  if (PS.ihOn.has(p)) return PS.ihOn.get(p);
  const cx = cxAl(); const out = {}; const ekle = (id, k, m) => (out[id] = out[id] || []).push([k, m]);
  if (!cx || !p) return out;
  const son = {};
  for (const r of Object.values(p.ops)) if (isFinite(r.C) && (!son[r.job] || r.C > son[r.job].C)) son[r.job] = r;
  for (const j in p.J || {}) { const x = p.J[j]; if (x.T > 0.05 && son[j]) ekle(son[j].id, 'termin', `Termin ${saat(x.T)} aşılıyor`); }
  const ay = psAyarYuk(p);
  for (const r of Object.values(p.ops)) {
    if (!isFinite(r.S) || r.done) continue;
    if (r.why && r.why.t === 'malzeme') ekle(r.id, 'malzeme', 'Malzeme gelmeden başlayamıyor');
    if (ay.asan.has(r.id)) ekle(r.id, 'ayarci', 'Aynı anda ayarcıdan fazla ayar');
    const M = cx.M[r.m]; if (M && M.sw && M.sw.length && !r.fas && !M.sw.some(([a, b]) => r.S >= a - 0.02 && r.S < b)) ekle(r.id, 'vardiya', 'Başlangıç vardiya dışında');
    const o = cx.byId[r.id];
    if (o) for (const [pid, ty] of o.pr) { const q = p.ops[pid]; if (!q || !isFinite(q.C)) continue; const h = ty === 'o' && !q.fas ? q.lot1 : q.C; if (h > r.S + 0.05) { ekle(r.id, 'oncul', `${pid} bitmeden başlıyor`); break; } }
  }
  PS.ihOn.set(p, out); return out;
}
function psOlc(p) {
  if (!p || !p.ozet) return null;
  const ih = psIhlal(p); let n = 0; for (const k in ih) n += ih[k].length;
  return { wT: p.ozet.wT, late: p.ozet.late, n: p.ozet.n, kar: p.ozet.tl == null ? null : psGelir() - p.ozet.tl, ih: n };
}
/* Sürüklerken motor koşmaz: işin bitişi kayma kadar kayar, ceza siparişin günlük cezasıyla tahmin edilir. Bırakınca motor doğrular. */
function psYerel(id, m, t) {
  const p = S.plan, cx = cxAl(); const r = p.ops[id]; if (!r || !cx) return null;
  const dt = t - r.S; const J = p.J[r.job] || {}; const j = cx.jobs[r.job] || {};
  const C1 = J.C != null ? J.C + Math.max(dt, -(r.S - psNow())) : null; const T0 = J.T || 0;
  const T1 = j.due != null && C1 != null ? Math.max(0, C1 - j.due) : T0;
  const ih = []; const M = cx.M[m];
  if (M && M.sw && M.sw.length && m[0] !== '@' && !M.sw.some(([a, b]) => t >= a - 0.02 && t < b)) ih.push('vardiya');
  const o = cx.byId[id]; if (o) for (const [pid, ty] of o.pr) { const q = p.ops[pid]; if (q && isFinite(q.C) && (ty === 'o' && !q.fas ? q.lot1 : q.C) > t + 0.05) { ih.push('oncul'); break; } }
  if (T1 > 0.05) ih.push('termin');
  if (!o || !o.c.some(c => c.m === m)) ih.push('yasak');
  return { dT: T1 - T0, dLate: (T1 > 0.05 ? 1 : 0) - (T0 > 0.05 ? 1 : 0), dKar: j.cezaGun ? -(+j.cezaGun) * (T1 - T0) / 24 : null, ih, dt };
}

/* ---------- günlük: kim, ne, neden, ne zaman; her adımın planı saklanır, tek tıkla dönülür ---------- */
function psGunluk() { S.psGunluk = S.psGunluk || []; return S.psGunluk; }
function psKayit(ne, neden) {
  if (!S.plan) return; const l = psGunluk();
  l.unshift({ id: 'g' + Date.now().toString(36) + l.length, t: Date.now(), kim: kim().ad, ne, neden: neden || '', imza: psImza(S.plan), plan: { ...S.plan, warn: (S.plan.warn || []).slice(0, 30) }, locks: clone(S.locks), down: clone(S.down), ekMesai: clone(S.ekMesai), dsig: psDsig() });
  if (l.length > 12) l.length = 12;
}
function psBaslat() {
  if (!S.plan || PS.uyguluyor) return; const l = psGunluk();
  if (!l.length || l[0].imza !== psImza(S.plan)) { psKayit(l.length ? 'Plan stüdyo dışında değişti' : 'Başlangıç: stüdyo açıldı', ''); if (l.length === 1) l[0].kim = S.plan.kim || l[0].kim; }
}
/* Geri dönüş de bir değişikliktir: önce sonuç panelinde gösterilir, "Uygula" ile plana girer. */
function psDon(id) {
  const g = psGunluk().find(x => x.id === id); if (!g) return;
  if (!yetkili('plan.yaz')) { bildir('Yetkiniz yok (plan.yaz).', 'hata'); return; }
  if (g.dsig !== psDsig()) { bildir('Bu adımdan sonra veri değişti; o plana dönülemez. Planı yeniden çözün.', 'hata'); return; }
  U.hamle = { ad: `Adıma dön: ${g.ne}`, plan: g.plan, locks: g.locks, degisen: [], ms: 0, toparla: 0, hedef: null, dv: S.dataVer, ekMesai: null, kaynak: 'elle', psDon: g.id, ps: true };
  U.psCak = null; U.psCak3 = null; render();
}
function psDonUygula(id) {
  const g = psGunluk().find(x => x.id === id); if (!g) return;
  planGeri.push({ plan: S.plan, locks: S.locks, guncel: planGuncel(), ekMesai: S.ekMesai }); if (planGeri.length > 20) planGeri.shift();
  S.locks = clone(g.locks); S.down = clone(g.down); S.ekMesai = clone(g.ekMesai); S.dataVer++;
  S.plan = { ...clone(g.plan), dataVer: S.dataVer, kim: kim().ad, zaman: Date.now(), kaynak: 'elle' };
  U.hamle = null; iz('Stüdyo: önceki adıma dönüldü', g.ne);
  psKayit(`Adıma dönüldü: ${g.ne}`, ''); kaydet(); render();
  bildir(`"${g.ne}" adımındaki plana dönüldü.`, 'tamam', { metin: 'Geri al', act: 'plan-geri' });
}
{ const hu0 = hamleUygula; hamleUygula = function (sessiz) {
  const h = U.hamle; const once = S.plan;
  /* stüdyoda plan yalnız sonuç panelinden değişir; başka yoldan gelen uygulama isteği panele düşer */
  if (psSayfa() && !PS.panelOk) { if (h && !sessiz) render(); return; }
  PS.panelOk = false;
  if (h && h.psDon) { U.hamle = null; psDonUygula(h.psDon); return; }
  PS.uyguluyor = true; let x; try { x = hu0.apply(this, arguments); } finally { PS.uyguluyor = false; }
  if (h && S.plan && S.plan !== once && psSayfa()) { psKayit(h.ad, U.psNeden || ''); U.psNeden = ''; kaydet(); if (!sessiz) render(); }
  return x;
}; }
function psSurumKaydet(ad) {
  if (!S.plan || !planGuncel()) { bildir('Önce güncel veriyle çözün.', 'hata'); return; }
  const adli = !!(ad || '').trim(); ad = (ad || '').trim() || `Stüdyo sürümü ${S.senaryolar.filter(s => s.kaynak === 'studyo').length + 1}`;
  const s = { id: 's' + Date.now().toString(36), ad, durum: 'acik', yazar: kim().ad, zaman: Date.now(), tabanSurum: S.canliSurum, kaynak: 'studyo', D: clone(S.D), down: clone(S.down), ekMesai: clone(S.ekMesai), locks: clone(S.locks), pref: clone(S.pref), w: clone(S.w), plan: clone(S.plan), ozet: clone(S.plan.ozet), J: clone(S.plan.J), not: 'Planlama stüdyosunda kaydedildi' };
  if (adli) s.adli = true; S.senaryolar.push(s); senKirp(10, s);
  iz('Stüdyo: sürüm kaydedildi', ad); psKayit(`Sürüm kaydedildi: ${ad}`, ''); U.psKars = 's:' + s.id; kaydet(); render(); bildir(`"${ad}" kaydedildi; şimdiki planla karşılaştırılıyor.`, 'tamam');
}

/* ---------- hamleler: hepsi motorun önizlemesine gider, "Uygula" ile plana girer ---------- */
function psHesapla(mods, ad, kil, ek) {
  U.hamle = null;
  if (ek && ek.ariza) S.down.push(ek.ariza);
  try { hamleDene(mods, ad, kil || mods, [], { sessiz: true }); } finally { if (ek && ek.ariza) S.down.pop(); }
  if (U.hamle) { U.hamle.ps = true; U.hamle.psMods = { mods, ad, kil, ek }; if (ek && ek.ariza) U.hamle.ariza = ek.ariza; }
  return U.hamle;
}
function psOnizle(mods, ad, kil, ek) {
  if (!S.plan) return;
  U.psCak3 = null; psHesapla(mods, ad, kil, ek);
  render();
}
/* Kilit, işe ilk dokunanda kalır: öteki planlamacının kilitli işine dokunulamaz; kilitsiz işe ilk dokunan sen olursun. */
function psIste(mods, ad, kil, isler, ek) {
  const ben = psBen(); const coz = U.psBenCoz = U.psBenCoz || {};
  const k = ben.find(x => isler.includes(x.is) && x.kilit && !coz[x.is]);
  if (k) { U.psCak = { ad, kisi: k }; U.hamle = null; render(); return; }
  for (const x of ben) if (isler.includes(x.is) && !coz[x.is]) coz[x.is] = 'benim';
  U.psCak = null; psOnizle(mods, ad, kil, ek);
}
/* ---------- benzetim sürümleri: başladığın canlı sürüm ile şu anki canlı sürüm; ikisi ayrılınca rakamlar yeniden hesaplanır ---------- */
const psCanliNo = () => (U.psBen && U.psCanliB != null ? U.psCanliB : S.canliSurum);
const psTabanNo = () => (U.psBen && U.psTabanB != null ? U.psTabanB : S.canliSurum);
function psKaydirMods(ids, dh) {
  const now = psNow(); const p = S.plan;
  return ids.map(id => p.ops[id]).filter(r => r && isFinite(r.S) && !r.done && !r.act).sort((a, b) => a.S - b.S).map(r => [r.id, r.m, Math.max(now, Math.round((r.S + dh) * 4) / 4)]);
}
/* Öteki planlamacı senden önce uyguladı: onun değişikliği başladığın plan üstünde, seninki onun planının üstünde yeniden hesaplanır. */
function psCak3Kur() {
  const a = psBen()[0]; const benim = U.hamle; if (!a || !benim || !benim.psMods) return false;
  const p0 = S.plan, l0 = S.locks;
  const ids = Object.values(p0.ops).filter(r => r.job === a.is).map(r => r.id);
  const hA = psIsHamle(ids, a.dh); if (!hA) return false;
  const onun = psHesapla(hA.mods, `${a.ad}: ${a.ne}`, hA.kil, null);
  if (!onun) { U.hamle = benim; return false; }
  let ust = null;
  try {
    S.plan = { ...p0, ...onun.plan }; S.locks = Object.fromEntries(Object.entries(onun.locks).filter(([, l]) => !l.gecici));
    const m = benim.psMods; ust = psHesapla(m.mods, m.ad, m.kil, m.ek);
  } finally { S.plan = p0; S.locks = l0; }
  U.hamle = benim;
  if (!ust) return false;
  U.psCak3 = { kisi: a, onun, ust, n: psTabanNo(), n1: psCanliNo() };
  return true;
}
/* Tek iş sonraya atılınca yalnız yeri değişen ilk adım çakılır, sonraki adımları motor öncülden dizer: bütün adımları +dh konuma
   zorlamak boşalan yerleri kullanmayıp başka işleri de itiyordu. Öne almada bütün adımlar çakılır; ilk adım şimdiye dayalıysa
   tek adımı çakmak hiçbir şeyi öne getirmez. */
function psIsHamle(ids, dh) {
  const mods = psKaydirMods(ids, dh); if (!mods.length) return null;
  const isler = [...new Set(mods.map(([id]) => S.plan.ops[id].job))];
  if (isler.length > 1 || dh < 0) return { mods, kil: dh < 0 && isler.length === 1 ? [mods[0]] : mods, isler };
  const ilk = mods.find(([id, , t]) => Math.abs(t - S.plan.ops[id].S) > 0.01) || mods[0];
  return { mods: [ilk], kil: [ilk], isler };
}
function psKaydir(ids, dh, ad) {
  const h = psIsHamle(ids, dh);
  if (!h) { bildir('Kaydırılacak iş yok (bitmiş ya da başlamış).', 'hata'); return; }
  psIste(h.mods, ad, h.kil, h.isler);
}
function psIsKaydir(job, dh) {
  const ids = Object.values(S.plan.ops).filter(r => r.job === job).map(r => r.id);
  psKaydir(ids, dh, `${job} ${psSure(Math.abs(dh))} ${dh < 0 ? 'öne alındı' : 'sonraya atıldı'}`);
}
const psSure = h => (h % 24 === 0 ? `${h / 24} gün` : `${sayi(h, 1)} saat`);
function psKapat(m, d) {
  const cx = cxAl(); const p = S.plan; const a = d * 24, b = a + 24; const now = psNow();
  if (!cx || !cx.M[m]) { bildir(`${m} adlı tezgâh yok.`, 'hata'); return; }
  const l = Object.values(p.ops).filter(r => r.m === m && isFinite(r.S) && r.S < b && r.C > Math.max(a, now) && !r.done && !r.act);
  const mods = [];
  for (const r of l) { const o = cx.byId[r.id]; const al = o ? o.c.filter(c => c.m !== m && !c.fas) : []; if (al.length) { const c = al.reduce((x, y) => (y.run + y.su < x.run + x.su ? y : x)); mods.push([r.id, c.m, Math.max(now, r.S)]); } else mods.push([r.id, m, b]); }
  psIste(mods, `${m} ${fmtDT(S.D, a).split(' ').slice(0, 2).join(' ')} kapatıldı: ${l.length} iş yer değiştirdi`, mods, [...new Set(l.map(r => r.job))], { ariza: { m, from: Math.max(a, now), to: b } });
}
function psGunBul(g) {
  const d0 = Math.floor(psNow() / 24);
  if (typeof g === 'number') return d0 + g;
  for (let k = 0; k < 14; k++) if (wdOf(S.D, d0 + k) === g) return d0 + k;
  return null;
}
/* Komut satırı: yazılanı ayrıştırır, ne anladığını söyler, önce önizler. */
function psKomut(metin) {
  const s = String(metin || '').trim(); const k = s.toLocaleLowerCase('tr').replace(/\s+/g, ' ');
  const sipBul = x => S.D.siparisler.find(z => z.id.toLocaleLowerCase('tr') === x);
  const tezBul = x => S.D.tezgahlar.find(z => z.id.toLocaleLowerCase('tr') === x.replace(/['’].*$/, ''));
  let m;
  if (!k) return;
  if (k === 'geri al') { const l = psGunluk(); if (l.length > 1) { U.psKomutMsg = 'Anlaşılan: son adımı geri al.'; psDon(l[1].id); } else bildir('Geri dönülecek adım yok.'); return; }
  if ((m = k.match(/^(\S+) (\S+) (kapat|kapa)$/))) {
    const t = tezBul(m[1]); const g = PS_GUN[m[2]]; if (!t) return psKomutHata(`"${m[1]}" adlı tezgâh yok.`); if (g == null) return psKomutHata(`"${m[2]}" günü anlaşılmadı; bugün, yarın ya da pzt…paz yazın.`);
    const d = psGunBul(g); if (d == null) return psKomutHata('Gün bulunamadı.');
    U.psKomutMsg = `Anlaşılan: ${t.id} tezgâhını ${fmtDT(S.D, d * 24).split(' ').slice(0, 2).join(' ')} günü kapat; işleri başka tezgâha ya da ertesi güne taşı.`; psKapat(t.id, d); return;
  }
  if ((m = k.match(/^(sp-\d+)(\.\d+)? (\d+(?:[.,]\d+)?) ?(gün|gun|g|saat|sa|s) (öne|one|geri|ileri|sonra|sonraya)\b/))) {
    const sp = sipBul(m[1]); if (!sp) return psKomutHata(`"${m[1].toUpperCase()}" adlı sipariş yok.`);
    const n = +m[3].replace(',', '.'); const h = /^g/.test(m[4]) ? n * 24 : n; const dh = /^(öne|one)$/.test(m[5]) ? -h : h;
    if (m[2]) { const id = sp.id + m[2]; if (!S.plan.ops[id]) return psKomutHata(`${id} adımı planda yok.`); U.psKomutMsg = `Anlaşılan: ${id} adımını ${psSure(h)} ${dh < 0 ? 'öne al' : 'sonraya at'}.`; psKaydir([id], dh, `${id} ${psSure(h)} ${dh < 0 ? 'öne alındı' : 'sonraya atıldı'}`); return; }
    U.psKomutMsg = `Anlaşılan: ${sp.id} siparişinin bütün adımlarını ${psSure(h)} ${dh < 0 ? 'öne al' : 'sonraya at'}.`; psIsKaydir(sp.id, dh); return;
  }
  if ((m = k.match(/^(sp-\d+\.\d+) (\S+?) ?(al|taşı|tasi)$/))) {
    const id = Object.keys(S.plan.ops).find(x => x.toLocaleLowerCase('tr') === m[1]); const t = tezBul(m[2]);
    if (!id) return psKomutHata(`${m[1].toUpperCase()} adımı planda yok.`); if (!t) return psKomutHata(`"${m[2]}" adlı tezgâh yok.`);
    const o = cxAl().byId[id]; if (!o || !o.c.some(c => c.m === t.id)) return psKomutHata(`${t.id} bu adımı yapamaz; rotada uygun tezgâh değil.`);
    const r = S.plan.ops[id]; U.psKomutMsg = `Anlaşılan: ${id} adımını ${t.id} tezgâhına al.`;
    psIste([[id, t.id, r.S]], `${id} → ${t.id}`, [[id, t.id, r.S]], [r.job]); return;
  }
  psKomutHata('Anlaşılmadı. Örnekler: "SP-106 2 gün öne al", "SP-106.20 4 saat sonraya at", "SP-106.20 T3 al", "T3 cuma kapat", "geri al".');
}
function psKomutHata(m) { U.psKomutMsg = m; U.psKomutHata = true; render(); }

/* ---------- benzetim: iki örnek planlamacı; ağ yok ---------- */
function psBen() {
  if (!U.psBen || !S.plan) return [];
  if (!U.psBenSec) {
    const p = S.plan; const ben = kim().ad; const ad = ['Planlamacı A', 'Planlamacı B', 'Planlamacı C'].filter(a => a !== ben).slice(0, 2);
    const isler = Object.keys(p.J).filter(j => Object.values(p.ops).some(r => r.job === j && !r.done && !r.act)).sort();
    const gec = isler.filter(j => p.J[j].T > 0.05).sort((a, b) => p.J[b].T - p.J[a].T);
    const j1 = gec[0] || isler[0]; const j2 = isler.find(j => j !== j1 && !(p.J[j].T > 0.05)) || isler.find(j => j !== j1);
    U.psBenSec = [{ i: 1, ad: ad[0], is: j2, kilit: true, ne: `${j2} 4 saat sonraya at`, dh: 4 }, { i: 2, ad: ad[1], is: j1, kilit: false, ne: `${j1} 1 gün öne al`, dh: -24 }];
  }
  return U.psBenSec;
}

/* ---------- çizim ---------- */
function psFark(a, b, k, iyiKucuk, birim) {
  if (a == null || b == null || !isFinite(a) || !isFinite(b)) return '<span class="pm-ps-yok">—</span>';
  const d = a - b; if (Math.abs(d) < (k ? 0.05 : 0.5)) return '<span class="pm-ps-ayni">aynı</span>';
  return `<span class="${(d < 0) === iyiKucuk ? 'pm-fark-iyi' : 'pm-fark-kotu'}">${d > 0 ? '+' : '−'}${sayi(Math.abs(d), k)}${birim || ''}</span>`;
}
function psEtki() {
  const p = gosterilen(); const a = psOlc(p); if (!a) return '';
  const l = psGunluk(); const b = U.hamle ? psOlc(S.plan) : (l[1] ? psOlc(l[1].plan) : null);
  const c = canliSen(); const cc = c && c.plan && c.plan.ops ? psOlc(c.plan) : null;
  const olc = (id, ad, sm, v, x, y, k, iyiKucuk, birim, ton) => `<div class="pm-ps-olc" data-olc="${id}" ${ton ? `data-ton="${ton}"` : ''}><span class="pm-ps-olc-ad">${ic(sm, 'k')}${ad}</span><b class="mono" data-yer="deger">${v}</b><span class="pm-ps-olc-fark"><small>önceki</small> <span data-yer="once">${x}</span> · <small>canlı</small> ${y}</span><span class="pm-ps-olc-yerel mono" data-yer="yerel"></span></div>`;
  const kart = `<div class="pm-ps-olcler">
    ${olc('wT', 'Gecikme', 'clock', saat(a.wT), b ? psFark(a.wT, b.wT, 1, true, ' sa') : psFark(null), cc ? psFark(a.wT, cc.wT, 1, true, ' sa') : '<span class="pm-ps-yok">yok</span>', 1, true, ' sa', a.wT > 0.5 ? 'hata' : '')}
    ${olc('late', 'Geciken', 'flag', `${a.late}/${a.n}`, b ? psFark(a.late, b.late, 0, true) : psFark(null), cc ? psFark(a.late, cc.late, 0, true) : '<span class="pm-ps-yok">yok</span>', 0, true, '', a.late ? 'hata' : '')}
    ${olc('kar', 'Kâr', 'lira', a.kar == null ? '—' : sayi(a.kar, 0) + ' ₺', b ? psFark(a.kar, b.kar, 0, false, ' ₺') : psFark(null), cc ? psFark(a.kar, cc.kar, 0, false, ' ₺') : '<span class="pm-ps-yok">yok</span>', 0, false, ' ₺', '')}
    ${olc('ih', 'Kısıt ihlali', 'alert', String(a.ih), b ? psFark(a.ih, b.ih, 0, true) : psFark(null), cc ? psFark(a.ih, cc.ih, 0, true) : '<span class="pm-ps-yok">yok</span>', 0, true, '', a.ih ? 'uyari' : '')}</div>`;
  let durum;
  if (U.psCak) {
    const k = U.psCak.kisi;
    durum = `<div class="pm-ps-durum" data-ton="hata" role="alert" data-ps-kilit>${ic('lock', 'k')}<span><b>Kilitli (benzetim):</b> ${esc(k.is)} işine önce ${esc(k.ad)} dokundu; kilit onda. Senin değişikliğin (${esc(U.psCak.ad)}) hesaplanmadı. O uyguladıktan sonra yeniden deneyebilirsin.</span><span class="pm-ps-durum-dg">${dugme('Tamam', 'ps-kilit-tamam', { kucuk: true, simge: 'check' })}</span></div>`;
  } else if (U.hamle) {
    durum = `<div class="pm-ps-durum" data-ton="onizle">${ic('eye', 'k')}<span><b>Plan değişmedi.</b> Rakamlar önizlemenin; sonuç paneline bakıp "Uygula" ya da "Vazgeç" deyin.</span></div>`;
  } else durum = '';
  return `<section class="pm-ps-etki" aria-label="Etki şeridi" aria-live="polite">${kart}${durum}</section>`;
}
function psSonucListe(p, ref) {
  const D = S.D; const l = [];
  for (const r of Object.values(p.ops)) {
    const q = ref.ops[r.id]; if (!q || !isFinite(q.S) || !isFinite(r.S) || (q.m === r.m && Math.abs(q.S - r.S) <= 0.25)) continue;
    const a = ref.J && ref.J[r.job], b = p.J && p.J[r.job];
    const d = a && b && a.C != null && b.C != null ? b.C - a.C : null;
    const ter = !a || !b ? '' : (a.T > 0.05) && !(b.T > 0.05) ? 'zamanına girdi' : !(a.T > 0.05) && (b.T > 0.05) ? 'gecikmeye düştü' : b.T > 0.05 ? `termin ${saat(b.T)} geç` : 'terminde';
    l.push({ id: r.id, job: r.job, m0: q.m, m1: r.m, s0: q.S, s1: r.S, d, ter });
  }
  l.sort((x, y) => (y.m0 !== y.m1) - (x.m0 !== x.m1) || Math.abs(y.s1 - y.s0) - Math.abs(x.s1 - x.s0));
  const td = x => `<li><button type="button" data-act="ps-git" data-v="${esc(x.id)}"><span class="mono"><b>${esc(x.id)}</b></span><span>${esc(x.m0.replace('@', 'fason '))}${x.m0 !== x.m1 ? ` → <b>${esc(x.m1.replace('@', 'fason '))}</b>` : ''}</span><span class="mono">${esc(fmtDT(D, x.s0).slice(0, 15))} → ${esc(fmtDT(D, x.s1).slice(0, 15))}</span><span>${x.d == null || Math.abs(x.d) < 0.05 ? '<span class="pm-ps-ayni">bitiş aynı</span>' : `<span class="${x.d < 0 ? 'pm-fark-iyi' : 'pm-fark-kotu'}">bitiş ${x.d > 0 ? '+' : '−'}${saat(Math.abs(x.d))}</span>`}${x.ter ? ` <small>${esc(x.ter)}</small>` : ''}</span></button></li>`;
  return `<div class="pm-ps-sonuc-liste"><h4>${ic('next', 'k')}Değişen işler <small data-yer="n">${l.length}</small></h4>${l.length ? `<ul>${l.slice(0, 12).map(td).join('')}</ul>${l.length > 12 ? `<p class="pm-kucuk">${l.length - 12} iş daha.</p>` : ''}` : '<p class="pm-kucuk">Yeri değişen iş yok.</p>'}</div>`;
}
const PS_OLC = [['wT', 'Ağırlıklı gecikme', 'clock', 1, true, ' sa'], ['late', 'Geciken iş', 'flag', 0, true, ''], ['kar', 'Kâr', 'lira', 0, false, ' ₺'], ['ih', 'Kısıt ihlali', 'alert', 0, true, '']];
const psDeger = (o, k) => (!o || o[k] == null ? '—' : k === 'wT' ? saat(o[k]) : k === 'kar' ? sayi(o[k], 0) + ' ₺' : k === 'late' ? `${o.late}/${o.n}` : String(o[k]));
function psSonuc() {
  const h = U.hamle; if (!h || !S.plan) return '';
  const a = psOlc(S.plan), b = psOlc(h.plan); const c3 = U.psCak3; const gec = !!c3;
  const sat = PS_OLC.map(([k, ad, sm, kk, iyi, bi]) => `<tr data-olc="${k}"><th scope="row">${ic(sm, 'k')}${ad}</th><td class="mono">${psDeger(a, k)}</td><td class="mono" data-yer="sonra">${psDeger(b, k)}</td><td data-yer="fark">${psFark(b && b[k], a && a[k], kk, iyi, bi)}</td></tr>`).join('');
  const tablo = `<div class="pm-ps-tablo" ${gec ? 'data-gecersiz' : ''}><table class="pm-ps-sonuc-olc" ${gec ? 'data-gecersiz' : ''}><caption class="pm-gizli">Önce ve sonra</caption><thead><tr><th scope="col">Ölçü</th><th scope="col">Şimdi</th><th scope="col">Değişiklikten sonra</th><th scope="col">Fark</th></tr></thead><tbody>${sat}</tbody></table></div>`;
  const bas = `<header class="pm-ps-sonuc-bas">${ic(gec ? 'alert' : 'eye', 'k')}<b>Sonuç</b><span>${esc(h.ad)}</span>${gec ? '<span class="pm-ps-gecersiz" data-yer="gecersiz">geçersiz: canlı plan değişti</span>' : `<small class="pm-kucuk">Motor hesapladı · sürüm ${psTabanNo()} üstünde · plan henüz değişmedi</small>`}</header>`;
  if (gec) {
    const o0 = a, o1 = psOlc(c3.onun.plan), o2 = psOlc(c3.ust.plan);
    const sutun = (ad, alt, o, ton, ref) => `<section class="pm-ps-c3-sutun" ${ton ? `data-ton="${ton}"` : ''}><h4>${ad}</h4><small class="pm-kucuk">${alt}</small><dl>${PS_OLC.map(([k, ad2, sm, kk, iyi, bi]) => `<div data-olc="${k}"><dt>${ic(sm, 'k')}${ad2}</dt><dd class="mono">${psDeger(o, k)}${ref ? ` <span class="pm-ps-c3-fark">${psFark(o && o[k], ref[k], kk, iyi, bi)}</span>` : ''}</dd></div>`).join('')}</dl></section>`;
    return `<section class="pm-ps-sonuc" data-ps-sonuc data-cak3 aria-label="Çakışma: yeniden hesaplandı" role="region">${bas}
      <p class="pm-ps-c3-not" role="alert">${ic('user', 'k')}<span><b>${esc(c3.kisi.ad)}</b> senden önce uyguladı: "${esc(c3.kisi.ne)}". Canlı plan sürüm ${c3.n} → <b>sürüm ${c3.n1}</b>. Ekranındaki rakamlar sürüm ${c3.n} içindi; motor senin değişikliğini sürüm ${c3.n1} üstünde yeniden hesapladı. Referans canlı plandır; rakam yalnız motordan gelir.</span></p>
      ${tablo}
      <div class="pm-ps-c3">${sutun(`Başladığım plan (sürüm ${c3.n})`, 'senin baktığın taban', o0, '', null)}${sutun(`Canlı plan, onunki (sürüm ${c3.n1})`, `${esc(c3.kisi.ad)} uyguladı`, o1, 'canli', o0)}${sutun('Benim değişikliğim canlının üstünde (yeniden hesaplandı)', `${esc(h.ad)} · sürüm ${c3.n1} üstüne`, o2, 'benim', o1)}</div>
      ${psSonucListe(c3.ust.plan, c3.onun.plan)}
      <div class="pm-ps-sonuc-dg">${dugme('Vazgeç', 'ps-c3', { kucuk: true, hayalet: true, simge: 'x', veri: 'data-v="vazgec"' })}${dugme('Onunkini bırak, benimkini geri al', 'ps-c3', { kucuk: true, simge: 'user', veri: 'data-v="onun"' })}${dugme('Benimkini üstüne uygula', 'ps-c3', { kucuk: true, birincil: true, simge: 'check', veri: 'data-v="ust"' })}</div></section>`;
  }
  const k = psKarar(S.plan, h);
  const ayr = `<details class="pm-ps-ayrinti" ${U.psAyrinti ? 'open' : ''} data-ps-ayrinti><summary>${ic('list', 'k')}<span>Ayrıntılar: ölçüler ve yeri değişen işler</span></summary><div class="pm-ps-sonuc-govde">${tablo}${psSonucListe(h.plan, S.plan)}</div></details>`;
  return `<section class="pm-ps-sonuc" data-ps-sonuc data-oneri="${k.oneri}" aria-label="Sonuç" role="region">${bas}
    <p class="pm-ps-manset" data-yer="manset">${esc(k.manset)}</p>
    ${k.sonuclar.length ? `<ul class="pm-ps-sonuclar" data-yer="sonuclar">${k.sonuclar.map(x => `<li data-ton="${x[0]}">${ic(x[0] === 'kotu' ? 'alert' : x[0] === 'iyi' ? 'check' : 'next', 'k')}<span>${esc(x[1])}</span></li>`).join('')}</ul>` : ''}
    ${k.neden.length ? `<p class="pm-ps-yapamadi" role="note" data-yer="neden">${ic('help', 'k')}<span>${k.neden.map(esc).join(' ')}</span></p>` : ''}
    <p class="pm-ps-oneri" data-ton="${k.oneri}" data-yer="oneri">${ic(k.oneri === 'uygula' ? 'check' : k.oneri === 'vazgec' ? 'x' : 'help', 'k')}<span><b>Önerim: ${k.oneri === 'uygula' ? 'Uygula' : k.oneri === 'vazgec' ? 'Vazgeç' : 'Fark yok'}.</b> ${esc(k.gerekce)}</span></p>
    ${ayr}
    <form class="pm-ps-sonuc-dg" data-ps-uygula><label class="pm-ps-neden"><span class="pm-gizli">Gerekçe</span><input name="neden" type="text" maxlength="140" placeholder="Gerekçe (isteğe bağlı)" value="${esc(U.psNeden || '')}"></label>${dugme('Vazgeç', 'hamle-vazgec', { kucuk: true, simge: 'x', birincil: k.oneri === 'vazgec' })}<button type="submit" class="tc-dugme tc-dugme-kucuk ${k.oneri === 'vazgec' ? '' : 'tc-dugme-birincil'}">${ic('check', 'k')}<span>Uygula</span></button></form></section>`;
}
/* Sonucu bir kişinin okuyup karar verebileceği biçime getirir: manşet, en önemli üç sonuç, yapılamayanın nedeni ve öneri.
   Bütün rakamlar motorun önizlemesinden gelir; burada yalnız karşılaştırılır. */
function psKarar(ref, h) {
  const p = h.plan; const J0 = ref.J || {}, J1 = p.J || {}; let gec = 0, erk = 0; const l = [];
  for (const j in J1) {
    const a = J0[j], b = J1[j]; if (!a || !b || a.C == null || b.C == null) continue;
    const d = b.C - a.C; if (d > 0.05) gec++; else if (d < -0.05) erk++;
    const t0 = a.T > 0.05, t1 = b.T > 0.05;
    if (!t0 && t1) l.push([0, d, 'kotu', `${j} gecikmeye düşer: termini ${saat(b.T)} aşar.`]);
    else if (t0 && !t1) l.push([1, d, 'iyi', `${j} zamanına girer: ${saat(-d)} erken biter.`]);
    else if (Math.abs(d) > 0.05) l.push([2, d, d > 0 ? 'kotu' : 'iyi', `${j} ${saat(Math.abs(d))} ${d > 0 ? 'geç' : 'erken'} biter${t1 ? `; termini ${saat(b.T)} aşıyor` : ''}.`]);
  }
  l.sort((x, y) => x[0] - y[0] || Math.abs(y[1]) - Math.abs(x[1]));
  const oa = psOlc(ref), ob = psOlc(p);
  const dW = ob.wT - oa.wT, dL = ob.late - oa.late, dI = ob.ih - oa.ih, dK = oa.kar != null && ob.kar != null ? ob.kar - oa.kar : null;
  const sonuclar = l.slice(0, 3).map(x => [x[2], x[3]]);
  if (dI && sonuclar.length < 3) sonuclar.push([dI > 0 ? 'kotu' : 'iyi', `Kısıt ihlali ${oa.ih} → ${ob.ih}.`]);
  const tasinan = Object.values(p.ops).some(r => { const q = ref.ops[r.id]; return q && isFinite(q.S) && isFinite(r.S) && (q.m !== r.m || Math.abs(q.S - r.S) > 0.25); });
  const karM = dK == null ? 'kâr bilinmiyor' : Math.abs(dK) < 0.5 ? 'kâr aynı' : `kâr ${dK > 0 ? '+' : '−'}${sayi(Math.abs(dK), 0)} ₺`;
  const manset = !tasinan && !gec && !erk ? 'Bu değişiklik planı değiştirmiyor.' : `Bu değişiklik: ${gec} iş gecikir, ${erk} iş erken biter, ${karM}.`;
  const neden = psYapamadi(h);
  let oneri, gerekce;
  if (!tasinan && !gec && !erk) { oneri = 'notr'; gerekce = 'Uygulamanın bir etkisi olmaz.'; }
  else if (dW > 0.05 || dL > 0) { oneri = 'vazgec'; gerekce = `Ağırlıklı gecikme ${dW > 0.05 ? saat(dW) + ' artar' : 'aynı kalır'}${dL > 0 ? `, ${dL} iş daha gecikir` : ''}.`; }
  /* kısıt ihlali artan değişiklik önerilmez: gecikme kazancı ihlalin bedelini göstermez */
  else if (dI > 0) { oneri = 'vazgec'; gerekce = `${dI} kısıt ihlali eklenir${dW < -0.05 ? `; ağırlıklı gecikme ${saat(-dW)} azalsa da` : ''}.`; }
  else if (dW < -0.05) { oneri = 'uygula'; gerekce = `Ağırlıklı gecikme ${saat(-dW)} azalır${dL < 0 ? `, ${-dL} iş zamanına girer` : ''}${dK != null && dK < -0.5 ? `; kâr ${sayi(-dK, 0)} ₺ düşer` : ''}.`; }
  else if (dK != null && dK > 0.5) { oneri = 'uygula'; gerekce = `Gecikme aynı, kâr ${sayi(dK, 0)} ₺ artar.`; }
  else if (dI < 0) { oneri = 'uygula'; gerekce = `Gecikme aynı, ${-dI} kısıt ihlali kalkar.`; }
  else { oneri = 'notr'; gerekce = 'Gecikmede ve kârda belirgin fark yok; uygulamak zorunlu değil.'; }
  return { manset, sonuclar, neden, oneri, gerekce };
}
/* İstenen yer motorun planında yoksa nedenini söyler: öncül bitmemişse onu, değilse sıranın korunduğunu. */
function psYapamadi(h) {
  const mods = (h.psMods && h.psMods.mods) || h.modlar || []; const cx = cxAl(); const out = [];
  for (const [id, m, t] of mods.slice(0, 2)) {
    const r = h.plan.ops[id]; if (!r || !isFinite(r.S)) continue;
    if (r.m !== m) { out.push(`${id} ${m.replace('@', 'fason ')} tezgâhına alınamadı; motor ${r.m.replace('@', 'fason ')} üzerinde tuttu.`); continue; }
    /* istenen saatten sonra ama işten önce başlayan iş varsa sıra istenen gibi olmamıştır */
    const onde = Object.values(h.plan.ops).filter(q => q.m === m && q.id !== id && isFinite(q.S) && q.S >= t - 0.01 && q.S < r.S - 0.01).sort((x, y) => x.S - y.S)[0];
    if (!onde && Math.abs(r.S - t) <= 0.5) continue;
    if (onde && onde.why && (onde.why.t === 'kilit' || onde.why.t === 'simdi')) { out.push(`${id}, ${onde.id} önüne alınamadı: ${onde.id} sabit (kilitli ya da dondurma ufkunda, ilk ${sayi(+S.w.dondurma || 0, 1)} saat). Daha sonraki bir işin önüne taşıyın ya da kilidi kaldırın.`); continue; }
    const o = cx && cx.byId[id]; let hz = null, kimden = null;
    if (o) for (const [pid, ty] of o.pr) { const q = h.plan.ops[pid]; if (!q || !isFinite(q.C)) continue; const v = ty === 'o' && !q.fas ? q.lot1 : q.C; if (hz == null || v > hz) { hz = v; kimden = pid; } }
    if (hz != null && hz > t + 0.25) out.push(`${id} istenen saatte başlayamaz: önceki adımı ${kimden} ${fmtDT(S.D, hz)} bitiyor. Önce ${kimden} adımını ya da siparişin tamamını öne alın.`);
    else out.push(`${id} istenen yere (${fmtDT(S.D, t)}) konamadı; motor tezgâh boş beklemesin diye sırayı korudu, iş ${fmtDT(S.D, r.S)} başlıyor.`);
  }
  return out;
}
function psRef() {
  const v = U.psKars;
  if (v === 'canli') { const c = canliSen(); if (c && c.plan && c.plan.ops) return { p: c.plan, ad: 'Canlı plan' }; }
  else if (v && v.startsWith('s:')) { const s = S.senaryolar.find(x => x.id === v.slice(2)); if (s && s.plan && s.plan.ops) return { p: s.plan, ad: s.ad }; }
  else if (v && v.startsWith('g:')) { const g = psGunluk().find(x => x.id === v.slice(2)); if (g) return { p: g.plan, ad: `Günlük: ${g.ne}` }; }
  if (U.hamle) return { p: S.plan, ad: 'Önceki plan', oto: true };
  return null;
}
function psKutu(r, ih, ben, sec, salt) {
  const T0 = psT0(); const x = psX(Math.max(r.S, T0)); const w = Math.max(5, psX(r.C) - x);
  const l = ih[r.id] || []; const b = ben[r.job]; const o = (cxAl().byId[r.id] || {});
  const ttl = `${r.id} · ${o.ad || ''} · ${r.m.replace('@', 'fason ')} · ${fmtDT(S.D, r.S)} → ${fmtDT(S.D, r.C)}${l.length ? ' · ' + l.map(z => z[1]).join(', ') : ''}${b ? ` · ${b.ad} düzenliyor${b.kilit ? ' (kilitli)' : ''}` : ''}`;
  const etiket = l.length ? `<span class="pm-ps-ih">${l.map(([k, m]) => `<i data-k="${k}" title="${esc(m)}">${ic(PS_IH[k][0], 'k')}<span>${PS_IH[k][1]}</span></i>`).join('')}</span>` : '';
  const tas = !salt && !r.done && !r.act;
  return `<button type="button" class="pm-ps-is" ${salt ? 'data-salt' : `data-act="ps-sec" data-v="${esc(r.id)}"`} ${tas ? 'data-tasinir' : ''} ${sec.has(r.id) ? 'aria-pressed="true"' : ''} ${l.length ? 'data-ihlal' : ''} ${!salt && PS.yeni && PS.yeni.has(r.id) ? 'data-yeni' : ''} ${b ? `data-ben="${b.i}"` : ''} ${r.fas ? 'data-fason' : ''} ${r.adetN != null && o.adet ? `data-adet` : ''} ${!salt && typeof sapmaOf === 'function' && (sp => sp && Math.abs(sp.d) > sapmaEsik())(sapmaOf(r.id)) ? 'data-sapma' : ''} style="--x:${x.toFixed(1)}px;--w:${w.toFixed(1)}px;--renk:${durumRenk(r.job)}${r.adetN != null && o.adet ? `;--ilerleme:${Math.round(100 * r.adetN / Math.max(1, adetEtkin((S.gercek || {})[r.id] || { A: o.adet })))}%` : ''}" title="${esc(ttl)}">${etiket}${S.locks[r.id] || (b && b.kilit) ? ic('lock', 'k') : ''}<span class="pm-ps-is-ad mono">${esc(r.id.replace(/^SP-/, ''))}</span>${b && b.ilk === r.id ? `<span class="pm-ps-ben-ad">${esc(b.ad)}</span>` : ''}</button>`;
}
function psSeritler(p, ref, salt) {
  const cx = cxAl(); const D = S.D; const T0 = psT0(), TE = psUfuk(p); const W = Math.round(psX(TE)); const k = psK();
  const ih = psIhlal(p); const sec = new Set(salt ? [] : U.psSec || []); const kat = U.psKat || {};
  const ben = {}; if (!salt) for (const b of psBen()) if (!(U.psBenCoz || {})[b.is]) { const ilk = Object.values(p.ops).filter(r => r.job === b.is && isFinite(r.S)).sort((x, y) => x.S - y.S)[0]; ben[b.is] = { ...b, ilk: ilk && ilk.id }; }
  const opsM = {}; for (const r of Object.values(p.ops)) if (isFinite(r.S) && r.C > T0) (opsM[r.m] = opsM[r.m] || []).push(r);
  const refM = {}; PS.yeni = new Set(); if (ref && !salt) for (const r of Object.values(ref.ops)) { const a = p.ops[r.id]; if (isFinite(r.S) && r.C > T0 && (!a || a.m !== r.m || Math.abs(a.S - r.S) > 0.25)) { (refM[r.m] = refM[r.m] || []).push(r); if (a) PS.yeni.add(r.id); } }
  const hayalet = m => (refM[m] || []).map(r => { const x = psX(Math.max(r.S, T0)); return `<span class="pm-ps-hayalet" style="--x:${x.toFixed(1)}px;--w:${Math.max(5, psX(r.C) - x).toFixed(1)}px" title="${esc(`Karşılaştırılan planda ${r.id}: ${r.m.replace('@', 'fason ')} · ${fmtDT(D, r.S)}`)}"></span>`; }).join('');
  const satir = (m, ad, alt, ic2, icerik, tur) => `<div class="pm-ps-satir" ${tur ? `data-tur="${tur}"` : ''}><span class="pm-ps-ad" title="${esc(ad + (alt ? ' · ' + alt : ''))}"><b class="mono">${esc(ad)}</b>${alt ? `<small>${esc(alt)}</small>` : ''}</span><div class="pm-ps-serit" ${m && !salt ? `data-m="${esc(m)}"` : ''}>${ic2 || ''}${icerik}</div></div>`;
  const grup = (id, ad, sm, n, govde) => `<section class="pm-ps-grup" ${kat[id] ? 'data-kapali' : ''}><button type="button" class="pm-ps-grup-bas" data-act="ps-kat" data-v="${esc(id)}" aria-expanded="${!kat[id]}">${ic(kat[id] ? 'chev-right' : 'down', 'k')}${ic(sm, 'k')}<b>${esc(ad)}</b><small>${n}</small></button>${kat[id] ? '' : govde}</section>`;
  /* zaman ekseni */
  let eksen = '';
  for (let t = T0; t < TE; t += 24) { const g = wdOf(D, Math.floor(t / 24)); eksen += `<span class="pm-ps-gun" ${g === 'cmt' || g === 'paz' ? 'data-hs' : ''} style="--x:${psX(t).toFixed(1)}px;--w:${(24 * k).toFixed(1)}px">${esc(fmtDT(D, t).split(' ').slice(0, 2).join(' '))}</span>`; }
  const simdi = `<i class="pm-ps-simdi" style="--x:${psX(psNow()).toFixed(1)}px" aria-hidden="true"></i>`;
  let govde = '';
  /* tezgâhlar, gruplarına göre */
  const gruplar = {}; for (const m of D.tezgahlar) (gruplar[m.grup] = gruplar[m.grup] || []).push(m);
  for (const [g, ms] of Object.entries(gruplar)) {
    const n = ms.reduce((a, m) => a + (opsM[m.id] || []).length, 0);
    govde += grup('t:' + g, g[0].toLocaleUpperCase('tr') + g.slice(1), 'gear', `${ms.length} tezgâh · ${n} iş`, ms.map(m => satir(m.id, m.id, m.ad, hayalet(m.id), (opsM[m.id] || []).map(r => psKutu(r, ih, ben, sec, salt)).join(''), 'tez')).join(''));
  }
  if (!salt) {
    /* ayarcı ve personel yükü, vardiya dilimlerinde */
    const ay = psAyarYuk(p); const kovalar = [];
    for (let t = T0; t < TE; t += 8) {
      const a = t, b = t + 8; const v = psVardiya(a + 0.5); const kap = ay.kap(a + 0.5);
      let mx = 0; for (const [x, y, c] of ay.dilim) if (y > a && x < b && c > mx) mx = c;
      let run = 0; for (const r of Object.values(p.ops)) { if (r.fas || !isFinite(r.S)) continue; const o = Math.max(0, Math.min(b, r.C) - Math.max(a, r.S)); if (o > 0) run += o * (cx.M[r.m] && cx.M[r.m].opOran != null ? +cx.M[r.m].opOran : 1); }
      const per = v ? D.personel.filter(x => x.vardiya === v.id).length : 0;
      kovalar.push({ a, b, mx, kap, yuk: per ? run / (8 * per) : null, v });
    }
    const kova = (x, h, asim, metin, ttl) => `<i class="pm-ps-kova" ${asim ? 'data-asim' : ''} style="--x:${psX(x.a).toFixed(1)}px;--w:${(8 * k).toFixed(1)}px;--h:${Math.min(1, h).toFixed(3)}" title="${esc(ttl)}">${8 * k >= 28 ? `<span>${metin}</span>` : ''}</i>`;
    const ayS = kovalar.map(x => kova(x, x.kap ? x.mx / x.kap : (x.mx ? 1 : 0), x.mx > x.kap, `${x.mx}/${x.kap}`, `${fmtDT(D, x.a)} · ${x.v ? x.v.id : 'vardiya yok'} · aynı anda en çok ${x.mx} ayar, ayarcı ${x.kap}`)).join('');
    const peS = kovalar.map(x => kova(x, x.yuk || 0, x.yuk != null && x.yuk > 1, x.yuk == null ? '—' : `%${Math.round(x.yuk * 100)}`, `${fmtDT(D, x.a)} · operatör yükü ${x.yuk == null ? 'bilinmiyor (vardiyada kişi yok)' : '%' + Math.round(x.yuk * 100)}`)).join('');
    govde += grup('kaynak', 'Ayarcı ve personel', 'user', 'vardiya dilimleri', satir(null, 'Ayarcı', 'aynı anda ayar / ayarcı', '', ayS, 'yuk') + satir(null, 'Operatör', 'yük, vardiyadaki kişiye göre', '', peS, 'yuk'));
    /* aparatlar */
    const apar = (D.aparatlar || []).map(a => { const l = Object.values(p.ops).filter(r => isFinite(r.S) && r.C > T0 && [].concat((cx.byId[r.id] || {}).aparat || []).includes(a.id)); return satir(null, a.id, `${a.ad} · ${a.adet} adet`, '', l.map(r => { const x = psX(Math.max(r.S, T0)); return `<span class="pm-ps-is pm-ps-is-ince" style="--x:${x.toFixed(1)}px;--w:${Math.max(5, psX(r.C) - x).toFixed(1)}px;--renk:${durumRenk(r.job)}" title="${esc(`${a.id} · ${r.id} · ${r.m} · ${fmtDT(D, r.S)} → ${fmtDT(D, r.C)}`)}"><span class="pm-ps-is-ad mono">${esc(r.id.replace(/^SP-/, ''))}</span></span>`; }).join(''), 'apar'); }).join('');
    if (apar) govde += grup('aparat', 'Aparatlar', 'tool', `${(D.aparatlar || []).length} aparat`, apar);
    /* malzeme gelişleri */
    const mz = (D.satinalma || []).map(po => { const t = parseT(D, po.gelis); if (t == null || t < T0 || t > TE) return ''; return `<span class="pm-ps-imi" style="--x:${psX(t).toFixed(1)}px" title="${esc(`${po.kod} · ${sayi(po.miktar, 0)} · geliş ${fmtDT(D, t)}`)}">${ic('truck', 'k')}<small class="mono">${esc(po.kod)}</small></span>`; }).join('');
    const bek = Object.values(p.ops).filter(r => r.why && r.why.t === 'malzeme' && isFinite(r.S) && r.S >= T0).map(r => `<span class="pm-ps-imi" data-bek style="--x:${psX(r.S).toFixed(1)}px" title="${esc(`${r.id} malzeme bekliyor; ${fmtDT(D, r.S)} başlıyor`)}">${ic('box', 'k')}<small class="mono">${esc(r.id.replace(/^SP-/, ''))}</small></span>`).join('');
    govde += grup('malzeme', 'Malzeme gelişleri', 'truck', `${(D.satinalma || []).length} satın alma`, satir(null, 'Gelişler', 'açık satın almalar', '', mz, 'imi') + satir(null, 'Bekleyen', 'malzeme bekleyen adımlar', '', bek, 'imi'));
  }
  /* fason çıkış ve dönüş */
  const fas = (D.fasoncular || []).map(f => satir('@' + f.id, f.id, `${f.ad} · çıkış ${(f.cikisGunleri || []).map(g => GUN_AD[g] || g).join(', ')}`, hayalet('@' + f.id), (opsM['@' + f.id] || []).map(r => psKutu(r, ih, ben, sec, salt)).join(''), 'fas')).join('');
  if (fas) govde += grup('fason', 'Fason çıkış ve dönüş', 'upload', `${(D.fasoncular || []).length} fasoncu`, fas);
  return `<div class="pm-ps-ic" style="--genis:${W}px"><div class="pm-ps-satir pm-ps-eksen"><span class="pm-ps-ad"><b>${salt ? '' : 'Zaman'}</b></span><div class="pm-ps-serit">${eksen}</div></div>${govde}<div class="pm-ps-cizgi" aria-hidden="true">${simdi}</div></div>`;
}
function psFarkListe(p, ref) {
  const D = S.D; const j = [];
  for (const k in p.J) { const a = ref.J && ref.J[k], b = p.J[k]; if (a && b && a.C != null && b.C != null && Math.abs(b.C - a.C) > 0.25) j.push({ j: k, d: b.C - a.C, T0: a.T, T1: b.T }); }
  j.sort((x, y) => Math.abs(y.d) - Math.abs(x.d));
  const o = [];
  for (const r of Object.values(p.ops)) { const q = ref.ops[r.id]; if (!q || !isFinite(q.S) || !isFinite(r.S)) continue; if (q.m !== r.m || Math.abs(q.S - r.S) > 0.25) o.push({ id: r.id, m0: q.m, m1: r.m, s0: q.S, s1: r.S, d: r.S - q.S }); }
  o.sort((x, y) => (y.m0 !== y.m1) - (x.m0 !== x.m1) || Math.abs(y.d) - Math.abs(x.d));
  const sat = x => `<li><button type="button" data-act="ps-git" data-v="${esc(x.id)}"><span class="mono">${esc(x.id)}</span><span>${x.m0 !== x.m1 ? `${esc(x.m0.replace('@', ''))} → <b>${esc(x.m1.replace('@', ''))}</b> · ` : ''}${esc(fmtDT(D, x.s0).slice(0, 15))} → ${esc(fmtDT(D, x.s1).slice(0, 15))}</span></button></li>`;
  return `<div class="pm-ps-farklar"><h4>${ic('flag', 'k')}Siparişlerin bitişi <small>${j.length}</small></h4>${j.length ? `<ul>${j.slice(0, 10).map(x => `<li><span class="mono">${esc(x.j)}</span><span class="${x.d < 0 ? 'pm-fark-iyi' : 'pm-fark-kotu'}">${x.d > 0 ? '+' : '−'}${saat(Math.abs(x.d))}</span>${(x.T0 > 0.05) !== (x.T1 > 0.05) ? `<small>${x.T1 > 0.05 ? 'gecikmeye düştü' : 'zamanına girdi'}</small>` : ''}</li>`).join('')}</ul>` : '<p class="pm-kucuk">Bitişi değişen sipariş yok.</p>'}
    <h4>${ic('next', 'k')}Yeri değişen adımlar <small>${o.length}</small></h4>${o.length ? `<ul>${o.slice(0, 14).map(sat).join('')}</ul>${o.length > 14 ? `<p class="pm-kucuk">${o.length - 14} adım daha.</p>` : ''}` : '<p class="pm-kucuk">Yeri değişen adım yok.</p>'}</div>`;
}
function psYan() {
  const l = psGunluk(); const c = canliSen(); const yaz = yetkili('plan.yaz');
  const ccOlc = c && c.plan && c.plan.ops ? psOlc(c.plan) : null;
  const gun = l.map((g, i) => { const o = g.plan && g.plan.ozet; return `<li ${i === 0 ? 'data-simdi' : ''}><div class="pm-ps-g-ust"><b>${esc(g.ne)}</b>${i === 0 ? '<small class="pm-ps-simdi-et">şimdi</small>' : yaz ? dugme('Bu adıma dön', 'ps-don', { kucuk: true, hayalet: true, simge: 'rotate', veri: `data-v="${esc(g.id)}"` }) : ''}</div>
    <div class="pm-ps-g-alt">${ic('user', 'k')}<span>${esc(g.kim)}</span>${ic('clock', 'k')}<span class="mono">${new Date(g.t).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit', second: '2-digit' })}</span><span class="mono">gecikme ${saat(o && o.wT)}</span>${ccOlc && o ? `<span>canlıya göre ${psFark(o.wT, ccOlc.wT, 1, true, ' sa')}</span>` : ''}</div>${g.neden ? `<p class="pm-ps-g-neden">${ic('edit', 'k')}${esc(g.neden)}</p>` : ''}</li>`; }).join('');
  const ref = psRef(); const sen = S.senaryolar.filter(s => s.plan && s.plan.ops);
  const secenek = `<option value="">Karşılaştırma yok</option>${c && c.plan ? `<option value="canli" ${U.psKars === 'canli' ? 'selected' : ''}>Canlı plan</option>` : ''}${sen.map(s => `<option value="s:${esc(s.id)}" ${U.psKars === 's:' + s.id ? 'selected' : ''}>${esc(s.ad)}${s.kaynak === 'studyo' ? ' (stüdyo)' : ''}</option>`).join('')}${l.slice(1).map(g => `<option value="g:${esc(g.id)}" ${U.psKars === 'g:' + g.id ? 'selected' : ''}>Günlük: ${esc(g.ne.slice(0, 40))}</option>`).join('')}`;
  const kars = `<section class="pm-ps-kutu" aria-label="Karşılaştırma"><h3>${ic('layers', 'k')}Karşılaştır</h3>
    <label class="tc-alan"><span class="tc-alan-etiket">Şimdiki planı şununla</span><select class="tc-alan-kutu" data-ps-chg="kars">${secenek}</select></label>
    ${U.psKars && ref ? `<div class="pm-seg" role="group" aria-label="Karşılaştırma biçimi">${[['ust', 'Üst üste', 'layers'], ['yan', 'Yan yana', 'grid']].map(([v, ad, sm]) => `<button type="button" data-act="ps-kip" data-v="${v}" aria-pressed="${(U.psKip || 'ust') === v}">${ic(sm, 'k')}<span>${ad}</span></button>`).join('')}</div>${psFarkListe(S.plan, ref.p)}` : `<p class="pm-kucuk">Bir sürüm, senaryo ya da günlük adımı seçin: eski yerler şeritlerde kesik çizgili hayalet kutu olarak görünür.</p>`}</section>`;
  const surum = `<section class="pm-ps-kutu" aria-label="Sürümler"><h3>${ic('flag', 'k')}Sürüm kaydet</h3><form class="pm-ps-satirform" data-ps-surum><label class="pm-ps-neden"><span class="pm-gizli">Sürüm adı</span><input name="ad" type="text" maxlength="60" placeholder="Ör. cuma kapatmalı"></label><button type="submit" class="tc-dugme tc-dugme-kucuk" ${yaz ? '' : 'disabled'}>${ic('check', 'k')}<span>Kaydet</span></button></form>
    ${sen.filter(s => s.kaynak === 'studyo').length ? `<ul class="pm-ps-surumler">${sen.filter(s => s.kaynak === 'studyo').map(s => `<li><span><b>${esc(s.ad)}</b><small>${esc(s.yazar || '')} · gecikme ${saat(s.ozet && s.ozet.wT)}</small></span>${dugme('', 'ps-kars-sec', { kucuk: true, hayalet: true, simge: 'layers', ad: 'Karşılaştır', veri: `data-v="s:${esc(s.id)}"` })}</li>`).join('')}</ul>` : ''}</section>`;
  const gp = paGecmisPlanlar();
  const gecmis = `<section class="pm-ps-kutu" aria-label="Geçmiş planlar"><h3>${ic('rotate', 'k')}Geçmiş planlar <small>${gp.length}</small></h3>${gp.length ? `<ul class="pm-ps-surumler" data-yer="gecmis">${gp.map(s => `<li><span><b>Sürüm ${s.surum ?? '—'} · ${esc(s.ad)}</b><small>${s.id === S.canli ? 'canlı' : 'önceki canlı'} · ${esc(s.canliKim || s.yazar || '')} · gecikme ${saat(s.ozet && s.ozet.wT)}</small></span>${s.plan && s.plan.ops && s.id !== S.canli ? dugme('', 'ps-kars-sec', { kucuk: true, hayalet: true, simge: 'layers', ad: 'Karşılaştır', veri: `data-v="s:${esc(s.id)}"` }) : ''}</li>`).join('')}</ul>` : '<p class="pm-kucuk">Henüz canlıya alınmış plan yok.</p>'}<p class="pm-kucuk">${ic('lock', 'k')} Canlıya alınmış planlar silinmez.</p></section>`;
  const SEK = [['gunluk', 'book', 'Günlük', l.length], ['surum', 'flag', 'Sürümler', sen.filter(s => s.kaynak === 'studyo').length], ['kars', 'layers', 'Karşılaştır', U.psKars ? '•' : ''], ['gecmis', 'rotate', 'Geçmiş', gp.length]];
  const sek = U.psYanSek && SEK.some(x => x[0] === U.psYanSek) ? U.psYanSek : (U.psKars ? 'kars' : 'gunluk');
  const govde = { gunluk: `<section class="pm-ps-kutu" aria-label="Değişiklik günlüğü"><h3>${ic('book', 'k')}Değişiklik günlüğü <small>${l.length}</small></h3><p class="pm-kucuk">Her adım saklanır; "Bu adıma dön" önce Sonuç'ta gösterilir.</p><ol class="pm-ps-gunluk">${gun}</ol></section>`, surum, kars, gecmis }[sek];
  return `<aside class="pm-ps-yan" aria-label="Bağlam paneli"><div class="pm-ps-yan-sek" role="tablist" aria-label="Bağlam">${SEK.map(([k, sm, ad, n]) => `<button type="button" role="tab" aria-selected="${sek === k}" data-act="ps-yan" data-v="${k}">${ic(sm, 'k')}<span>${ad}</span>${n ? `<small>${n}</small>` : ''}</button>`).join('')}</div>${govde}</aside>`;
}
function psSecim() {
  const sec = (U.psSec || []).filter(id => S.plan.ops[id]); if (!sec.length) return '';
  const cx = cxAl(); const tek = sec.length === 1 ? S.plan.ops[sec[0]] : null;
  const tez = tek ? (cx.byId[tek.id] || { c: [] }).c.filter(c => c.m !== tek.m) : [];
  const k = (dh, ad) => dugme(ad, 'ps-kaydir', { kucuk: true, veri: `data-v="${dh}"` });
  return `<div class="pm-ps-secim" role="toolbar" aria-label="Seçili işler"><b>${ic('check', 'k')}${sec.length} iş seçili</b>${k(-24, '−1 g')}${k(-4, '−4 sa')}${k(4, '+4 sa')}${k(24, '+1 g')}
    ${tez.length ? `<label class="pm-ps-tez"><span class="pm-gizli">Tezgâha al</span><select data-ps-chg="tez">${`<option value="">Tezgâha al…</option>` + tez.map(c => `<option value="${esc(c.m)}">${esc(c.m.replace('@', 'fason '))}</option>`).join('')}</select></label>` : ''}
    ${dugme('', 'ps-sec-temiz', { kucuk: true, hayalet: true, simge: 'x', ad: 'Seçimi temizle' })}</div>`;
}
function psToplu() {
  if (!U.psToplu) return '';
  const d0 = Math.floor(psNow() / 24);
  const gun = Array.from({ length: 10 }, (_, i) => `<option value="${d0 + i}">${esc(fmtDT(S.D, (d0 + i) * 24).split(' ').slice(0, 2).join(' '))}</option>`).join('');
  return `<form class="pm-ps-toplu" data-ps-kapat aria-label="Tezgâh ya da gün kapat">${ic('stop', 'k')}<b>Kapat</b>
    <label class="tc-alan"><span class="pm-gizli">Tezgâh</span><select class="tc-alan-kutu" name="m">${S.D.tezgahlar.map(m => `<option value="${esc(m.id)}">${esc(m.id)} · ${esc(m.ad)}</option>`).join('')}</select></label>
    <label class="tc-alan"><span class="pm-gizli">Gün</span><select class="tc-alan-kutu" name="d">${gun}</select></label>
    <button type="submit" class="tc-dugme tc-dugme-kucuk">${ic('eye', 'k')}<span>Önizle</span></button><small class="pm-kucuk">İşler başka tezgâha, olmazsa ertesi güne geçer; uygulanınca bakım kaydı da eklenir.</small></form>`;
}
function sPlanStudyo() {
  if (!S.plan) return bosPlan();
  psBaslat();
  const p = gosterilen(); const ref = psRef(); const yaz = yetkili('plan.yaz');
  const ben = psBen(); const coz = U.psBenCoz || {};
  const kisiler = U.psBen ? `<div class="pm-ps-kisiler" aria-label="Çevrimiçi (benzetim)"><span class="pm-ps-kisi" data-ben="0"><i aria-hidden="true"></i>Sen · ${esc(kim().ad)}</span>${ben.map(b => `<span class="pm-ps-kisi" data-ben="${b.i}"><i aria-hidden="true"></i>${esc(b.ad)}<small>${coz[b.is] === 'uyguladi' ? `${esc(b.is)}: uyguladı, canlı sürüm ${psCanliNo()}` : coz[b.is] === 'benim' ? `${esc(b.is)}: kilit sende` : `${esc(b.is)} düzenliyor${b.kilit ? ' · kilit onda' : ''}`}</small></span>`).join('')}</div>` : '';
  const ust = `<header class="pm-ps-ust">
    <form class="pm-ps-komut" data-ps-komut role="search"><label><span class="pm-gizli">Komut</span>${ic('edit', 'k')}<input name="k" type="text" autocomplete="off" placeholder='Komut: "SP-106 2 gün öne al", "T3 cuma kapat"' ${yaz ? '' : 'disabled'}></label><button type="submit" class="tc-dugme tc-dugme-kucuk" ${yaz ? '' : 'disabled'}>${ic('eye', 'k')}<span>Önizle</span></button></form>
    <div class="pm-ps-araclar">
      <div class="pm-seg" role="group" aria-label="Yakınlık">${dugme('Uzaklaş', 'ps-zum', { simge: 'minus', kucuk: true, veri: 'data-v="-1"' })}<span class="pm-ps-zum-et mono" title="Izgara: sürüklerken saat bu adımla kayar">${psAdim() >= 1 ? psAdim() + ' sa' : psAdim() * 60 + ' dk'}</span>${dugme('Yakınlaş', 'ps-zum', { simge: 'plus', kucuk: true, veri: 'data-v="1"' })}</div>
      <button type="button" class="tc-dugme tc-dugme-kucuk" data-act="ps-toplu" aria-pressed="${!!U.psToplu}" title="Bir tezgâhı ya da günü kapat; işler başka yere geçer">${ic('stop', 'k')}<span>Tezgâh/gün kapat</span><span class="pm-ps-kisa">Kapat</span></button>
      <button type="button" class="tc-dugme tc-dugme-kucuk" data-act="ps-ben" aria-pressed="${!!U.psBen}" title="Çok kullanıcılı çalışmanın benzetimi; gerçek ağ yok">${ic('user', 'k')}<span>Benzetim</span><span class="pm-ps-kisa">Benzetim</span></button>
    </div></header>`;
  const msg = U.psKomutMsg ? `<p class="pm-ps-komut-msg" ${U.psKomutHata ? 'data-ton="hata"' : ''} role="status">${ic(U.psKomutHata ? 'alert' : 'check', 'k')}${esc(U.psKomutMsg)}</p>` : '';
  const benNot = U.psBen ? `<p class="pm-ps-ben-not" role="note">${ic('alert', 'k')}<span><b>Benzetim:</b> gerçek ağ yok; öteki planlamacılar ve hareketleri örnektir. Kilit işe ilk dokunanda kalır; ${esc((psBen()[0] || {}).ad || '')} kilitli işini değiştiremezsin. İlk "Uygula"da ${esc((psBen()[0] || {}).ad || '')} senden önce uygulamış olur: canlı sürüm artar, motor seninkini yeniden hesaplar.</span></p>` : '';
  const yan = ref && !ref.oto && (U.psKip || 'ust') === 'yan';
  const alan = yan ? `<div class="pm-ps-yanyana"><section><h3>${ic('eye', 'k')}Şimdiki plan</h3><div class="pm-ps-alan" data-ps-alan>${psSeritler(p, null, false)}</div></section><section><h3>${ic('layers', 'k')}${esc(ref.ad)}</h3><div class="pm-ps-alan" data-ps-alan="ref">${psSeritler(ref.p, null, true)}</div></section></div>`
    : `<div class="pm-ps-alan" data-ps-alan ${ref ? 'data-kars' : ''}>${psSeritler(p, ref && ref.p, false)}</div>`;
  const lejant = `<div class="pm-ps-lejant" aria-label="İşaretler">${Object.entries(PS_IH).map(([k, [sm, ad]]) => `<span data-k="${k}">${ic(sm, 'k')}${ad}</span>`).join('')}${ref ? `<span data-k="hayalet"><i aria-hidden="true"></i>${esc(ref.ad)}: eski yer</span>` : ''}</div>`;
  return `<div class="pm-ps" id="ps">${ust}${kisiler}${benNot}${msg}${psEtki()}${psToplu()}${psSecim()}<div class="pm-ps-govde"><div class="pm-ps-ana">${alan}${lejant}</div>${psYan()}</div></div>`;
}

/* ---------- bağlantılar ---------- */
/* Sepet açıkken tahta her önizlemeyi kendiliğinden plana yazar; stüdyoda önce önizlenir, "Uygula" ile yazılır. */
{ const tk0 = taslakIsle; taslakIsle = function () { return psSayfa() ? false : tk0.apply(this, arguments); }; }
{ const r0 = render; render = function () {
  const a = document.querySelector('[data-ps-alan]:not([data-ps-alan="ref"])'); const k = a ? [a.scrollLeft, a.scrollTop] : null;
  const x = r0.apply(this, arguments);
  if (k) { const b = document.querySelector('[data-ps-alan]:not([data-ps-alan="ref"])'); if (b) { b.scrollLeft = k[0]; b.scrollTop = k[1]; } }
  else if (psPlanSek()) { const b = document.querySelector('[data-ps-alan]'); if (b && !b.dataset.ilk) { b.dataset.ilk = '1'; b.scrollLeft = Math.max(0, psX(psNow()) - 40); } }

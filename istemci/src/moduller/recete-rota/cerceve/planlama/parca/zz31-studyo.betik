document.addEventListener('submit', e => {
  const f = e.target.closest && e.target.closest('form[data-ps-komut], form[data-ps-uygula], form[data-ps-surum], form[data-ps-kapat]'); if (!f) return;
  e.preventDefault(); e.stopImmediatePropagation();
  if (f.dataset.psKomut != null) { U.psKomutHata = false; const v = f.k.value; psKomut(v); return; }
  if (f.dataset.psUygula != null) {
    U.psNeden = f.neden.value.trim();
    if (U.psBen && U.hamle && !U.hamle.psDon) {
      if (!U.psBenA) { U.psBenA = true; U.psCanliB = psCanliNo() + 1; }
      if (psTabanNo() < psCanliNo() && psCak3Kur()) { render(); return; }
    }
    PS.panelOk = true; hamleUygula(); return;
  }
  if (f.dataset.psSurum != null) { psSurumKaydet(f.ad.value); return; }
  if (f.dataset.psKapat != null) { U.psKomutMsg = ''; psKapat(f.m.value, +f.d.value); }
}, true);
document.addEventListener('change', e => {
  const el = e.target.closest && e.target.closest('[data-ps-chg]'); if (!el) return;
  e.stopImmediatePropagation();
  if (el.dataset.psChg === 'kars') { U.psKars = el.value || null; render(); return; }
  if (el.dataset.psChg === 'tez') { const id = (U.psSec || [])[0]; const r = id && S.plan.ops[id]; if (r && el.value) psIste([[id, el.value, r.S]], `${id} → ${el.value.replace('@', 'fason ')}`, [[id, el.value, r.S]], [r.job]); }
}, true);
document.addEventListener('input', e => { if (e.target.closest && e.target.closest('form[data-ps-uygula]') && e.target.name === 'neden') U.psNeden = e.target.value; }, true);

/* ---------- sürükleme: işi tut, zaman ve tezgâh boyunca taşı; etki yerelde anında, bırakınca motor ---------- */
function psEtkiYerel(y) {
  const z = (id, txt) => { const el = document.querySelector(`.pm-ps-olc[data-olc="${id}"] [data-yer="yerel"]`); if (el) el.innerHTML = txt; };
  if (!y) { ['wT', 'late', 'kar', 'ih'].forEach(id => z(id, '')); return; }
  const sg = (d, k, iyiKucuk, b) => Math.abs(d) < (k ? 0.05 : 0.5) ? '<span class="pm-ps-ayni">aynı</span>' : `<span class="${(d < 0) === iyiKucuk ? 'pm-fark-iyi' : 'pm-fark-kotu'}">${d > 0 ? '+' : '−'}${sayi(Math.abs(d), k)}${b}</span>`;
  z('wT', `tahmini ${sg(y.dT, 1, true, ' sa')}`); z('late', `tahmini ${sg(y.dLate, 0, true, '')}`); z('kar', y.dKar == null ? 'tahmini —' : `tahmini ${sg(y.dKar, 0, false, ' ₺')}`);
  z('ih', y.ih.length ? `<span class="pm-fark-kotu">${y.ih.filter(k => PS_IH[k]).map(k => PS_IH[k][1]).join(', ') || 'yasak tezgâh'}</span>` : 'ihlal yok');
  const d = document.querySelector('.pm-ps-durum[data-yer="durum"] span'); if (d) d.innerHTML = `<b>Sürükleniyor:</b> etki yerelde tahmin ediliyor; bırakınca motor doğrular.${y.ih.includes('yasak') ? ' Bu tezgâh bu adımı yapamaz.' : ''}`;
}
document.addEventListener('pointerdown', e => {
  if (!psPlanSek() || !e.target.closest) return;
  const alan = e.target.closest('[data-ps-alan]'); if (!alan) return;
  e.stopPropagation(); /* tahtanın kaydırma tutamağı stüdyoda devreye girmesin */
  if (e.button !== 0 || calisan || !yetkili('plan.yaz')) return;
  const b = e.target.closest('.pm-ps-is[data-tasinir][data-v]');
  if (b && e.pointerType !== 'touch') {
    const r = S.plan.ops[b.dataset.v]; const o = cxAl().byId[b.dataset.v]; if (!r || !o) return;
    PS.drag = { id: r.id, r, el: b, alan, x0: e.clientX, y0: e.clientY, sx0: alan.scrollLeft, aktif: false, izin: new Set(o.c.map(c => c.m)), m: r.m, t: r.S, pid: e.pointerId, son: e };
    return;
  }
  if (!b && e.shiftKey && e.target.closest('.pm-ps-serit')) {
    const ic2 = alan.querySelector('.pm-ps-ic'); const R = ic2.getBoundingClientRect();
    const k = document.createElement('div'); k.className = 'pm-ps-kutusec'; ic2.appendChild(k);
    PS.kutu = { alan, ic: ic2, el: k, x0: e.clientX - R.left, y0: e.clientY - R.top }; e.preventDefault();
  }
}, true);
/* Sürükleme tek karede bir kez işlenir; kutu ızgaraya oturmuş saate göre kayar, hedef şerit ve saat kılavuzu gösterilir,
   kenara yaklaşınca alan kendiliğinden kayar. Tahta yeniden çizilmez; yalnız sürüklenen kutu ve kılavuz değişir. */
function psSurukKare() {
  const d = PS.drag; PS.kare = 0; if (!d || !d.aktif) return;
  const e = d.son; const A = d.alan.getBoundingClientRect(); const kenar = 36; let kay = 0, kayY = 0;
  if (e.clientX > A.right - kenar) kay = 14; else if (e.clientX < A.left + 150 + kenar && d.alan.scrollLeft > 0) kay = -14;
  if (e.clientY > A.bottom - kenar) kayY = 12; else if (e.clientY < A.top + kenar && d.alan.scrollTop > 0) kayY = -12;
  if (kay) d.alan.scrollLeft += kay; if (kayY) d.alan.scrollTop += kayY;
  const k = psK(), adim = psAdim();
  const ham = d.r.S + (e.clientX - d.x0 + d.alan.scrollLeft - d.sx0) / k;
  const t = Math.max(psNow(), Math.round(ham / adim) * adim);
  const h = document.elementFromPoint(Math.min(Math.max(e.clientX, A.left + 151), A.right - 2), Math.min(Math.max(e.clientY, A.top + 2), A.bottom - 2));
  const ser = h && h.closest('.pm-ps-serit[data-m]');
  const m = ser ? ser.dataset.m : d.m; const dy = ser ? ser.getBoundingClientRect().top - d.el.parentElement.getBoundingClientRect().top : d.dy || 0;
  d.dy = dy; d.el.style.transform = `translate(${((t - d.r.S) * k).toFixed(1)}px, ${dy.toFixed(1)}px)`; d.t = t; d.m = m;
  if (ser !== d.ser) { if (d.ser) d.ser.removeAttribute('data-hedef'); d.ser = ser; }
  const izin = d.izin.has(m); if (ser) ser.setAttribute('data-hedef', izin ? 'izin' : 'yasak');
  const y = psYerel(d.id, m, t);
  const uyari = !izin ? 'Bu tezgâh bu adımı yapamaz' : y && y.ih.includes('oncul') ? 'Öncül bitmeden; motor sonraya kaydırır' : y && y.ih.includes('vardiya') ? 'Vardiya dışı' : '';
  let kl = PS.kilavuz; if (!kl) { kl = PS.kilavuz = document.createElement('i'); kl.className = 'pm-ps-kilavuz'; kl.setAttribute('aria-hidden', 'true'); }
  if (ser) { if (kl.parentElement !== ser) ser.appendChild(kl); kl.style.setProperty('--x', psX(t).toFixed(1) + 'px'); kl.dataset.ton = !izin ? 'yasak' : uyari ? 'uyari' : 'izin'; kl.dataset.metin = `${m.replace('@', 'fason ')} · ${fmtDT(S.D, t)}${uyari ? ' · ' + uyari : ''}`; }
  const et = d.el.querySelector('.pm-ps-is-saat'); if (et) et.textContent = `${fmtDT(S.D, t)}${y && Math.abs(y.dT) > 0.05 ? ` · gecikme ${y.dT > 0 ? '+' : '−'}${sayi(Math.abs(y.dT), 1)} sa` : ''}`;
  d.el.toggleAttribute('data-yasak', !izin); psEtkiYerel(y);
  if (kay || kayY) PS.kare = requestAnimationFrame(psSurukKare);
}
document.addEventListener('pointermove', e => {
  const k = PS.kutu;
  if (k) { const R = k.ic.getBoundingClientRect(); const x = e.clientX - R.left, y = e.clientY - R.top; Object.assign(k.el.style, { left: Math.min(x, k.x0) + 'px', top: Math.min(y, k.y0) + 'px', width: Math.abs(x - k.x0) + 'px', height: Math.abs(y - k.y0) + 'px' }); return; }
  const d = PS.drag; if (!d) return;
  d.son = e;
  if (!d.aktif) { if (Math.hypot(e.clientX - d.x0, e.clientY - d.y0) < 6) return; d.aktif = true; d.el.dataset.surukleniyor = ''; document.body.classList.add('pm-suruk'); d.el.insertAdjacentHTML('beforeend', '<em class="pm-ps-is-saat mono"></em>'); try { d.el.setPointerCapture(d.pid); } catch (x) { /* yakalama desteklenmeyebilir */ } }
  if (!PS.kare) PS.kare = requestAnimationFrame(psSurukKare);
});
function psSurukBitir() {
  const d = PS.drag; PS.drag = null; if (PS.kare) cancelAnimationFrame(PS.kare); PS.kare = 0;
  if (PS.kilavuz) { PS.kilavuz.remove(); PS.kilavuz = null; }
  document.body.classList.remove('pm-suruk'); document.querySelectorAll('.pm-ps-serit[data-hedef]').forEach(x => x.removeAttribute('data-hedef'));
  return d;
}
document.addEventListener('pointerup', e => {
  const k = PS.kutu;
  if (k) {
    PS.kutu = null; const r = k.el.getBoundingClientRect(); k.el.remove();
    if (r.width > 4 && r.height > 4) { const l = [...k.ic.querySelectorAll('.pm-ps-is[data-v]')].filter(b => { const q = b.getBoundingClientRect(); return q.right > r.left && q.left < r.right && q.bottom > r.top && q.top < r.bottom; }).map(b => b.dataset.v); U.psSec = [...new Set([...(U.psSec || []), ...l])]; PS.sonDrag = Date.now(); render(); }
    return;
  }
  if (!PS.drag) return;
  if (PS.drag.aktif) { PS.drag.son = e; psSurukKare(); }
  const d = psSurukBitir(); if (!d || !d.aktif) return;
  PS.sonDrag = Date.now();
  if (!d.izin.has(d.m)) { render(); bildir(`${d.m.replace('@', '')} bu adımı yapamaz; rotada uygun tezgâh değil.`, 'hata'); return; }
  if (d.m === d.r.m && Math.abs(d.t - d.r.S) < 0.25) { render(); return; }
  psIste([[d.id, d.m, d.t]], `${d.id} → ${d.m.replace('@', 'fason ')}, ${fmtDT(S.D, d.t)}`, [[d.id, d.m, d.t]], [d.r.job]);
});
document.addEventListener('pointercancel', () => { if (PS.drag) { psSurukBitir(); render(); } if (PS.kutu) { PS.kutu.el.remove(); PS.kutu = null; } });
document.addEventListener('keydown', e => {
  if (!psPlanSek() || e.key !== 'Escape' || e.defaultPrevented) return;
  if (PS.drag) { psSurukBitir(); e.preventDefault(); render(); return; }
  if (U.psCak) { U.psCak = null; e.preventDefault(); render(); return; }
  if (U.psCak3) { U.psCak3 = null; U.hamle = null; e.preventDefault(); render(); return; }
  if ((U.psSec || []).length && !U.hamle) { U.psSec = []; e.preventDefault(); render(); }
}, true);

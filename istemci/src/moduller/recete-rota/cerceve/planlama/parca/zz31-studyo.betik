    case 'ps-kilit-tamam': U.psCak = null; render(); return true;
    case 'ps-c3': {
      const c = U.psCak3; const benim = U.hamle; U.psCak3 = null;
      if (!c || !benim || v === 'vazgec') { U.hamle = null; U.psNeden = ''; render(); if (c) bildir(`Hiçbir şey uygulanmadı. Canlı sürüm ${c.n1}; senin planın hâlâ sürüm ${c.n} üstünde.`); return true; }
      const neden = U.psNeden; const a = c.kisi;
      U.psNeden = 'Benzetim: öteki planlamacının uyguladığı değişiklik';
      U.hamle = c.onun; c.onun.dv = S.dataVer; PS.panelOk = true; hamleUygula(true);
      const l = psGunluk(); if (l[0]) { l[0].kim = a.ad; l[0].ne = `${a.ne} · canlı sürüm ${c.n1} (benzetim)`; }
      (U.psBenCoz = U.psBenCoz || {})[a.is] = 'uyguladi'; U.psTabanB = c.n1;
      if (v === 'ust') {
        U.psNeden = neden; U.hamle = c.ust; c.ust.dv = S.dataVer; PS.panelOk = true; hamleUygula(true);
        const l2 = psGunluk(); if (l2[0]) l2[0].ne = `${benim.ad} · sürüm ${c.n1} üstüne yeniden hesaplandı`;

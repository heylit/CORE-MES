/* ---------- Plan onayı sunucuda (H2) ----------
   Canlı plana tek kapı: stüdyonun denemeleri ve çalışma planı bu sayfada kalır; "Onaya gönder" planı plan modülünde kişiye açılan taslağa yazar
   ve taslağı onaya gönderir, "Onayla, canlıya al" o taslağı plan modülünün canlıya alma ucuyla alır, "Geri gönder" gerekçeyle geri çevirir.
   Onay durumu, kimin onaylayabileceği (dört göz) ve sürüm denetimi sunucudadır; bu sayfadaki onay listesi yalnız ortak çalışma kaydının
   görünüşüdür. Sunucuya gönderilmemiş eski onay kaydı canlıya alınmaz, yeniden onaya gönderilir.
   Emirler, ürünler ve rotalar sunucunun kaynak okumasından kaydın üstüne konur (motor/emirler.betik sunucuKaydi): kayıtta bağlanmadan
   önceki yerel emirler kalır, taslağa yazılan iş sunucunun iş emri olmalıdır. Sunucu çözücüsü aynı çeviriyle kurar (ADR 0018). */
if (TMI_ICINDE) {
  const SO = { yaziyor: false };
  /* Siparişin sayfada değiştirilen motor ayarı (gelir, ceza, öncelik) aynı kimlikte korunur: çeviri kaydın plan alt nesnesinden okur. */
  const sunucuyla = (st, durum, D0) => {
    if (!durum) return st;
    const k = sunucuKaydi(st, durum, D0);
    const eski = id => ((D0 && D0.siparisler) || []).find(x => String(x.id) === String(id));
    for (const o of k.orders || []) if (!o.plan && eski(o.id)) o.plan = rrKopya(eski(o.id));
    return k;
  };
  const cevir0 = tmiCevir;
  tmiCevir = function (st, kaynak, D0, bugun) { return cevir0(sunucuyla(st, kaynak && kaynak.durum, D0), kaynak, D0, bugun); };
  const calisan0 = tmiCalisanlar;
  tmiCalisanlar = function (durum, st, D, now) { return calisan0(durum, sunucuyla(st, durum, D), D, now); };
  /* kaynak okuması geldiğinde açık çalışmanın siparişleri de sunucununkiyle değişir (yeni ve kapanan emir) */
  if (!TMI_KAYNAK_ALANLARI.includes('siparisler')) TMI_KAYNAK_ALANLARI.push('siparisler');

  /* Motor saatleri başlangıç gününe göre duvar saatidir; sayfa yerel saat okur, an yerel saatten kurulur. */
  const duvarIso = (D, t) => {
    const u = new Date(baseMs(D) + t * 3600000);
    return new Date(u.getUTCFullYear(), u.getUTCMonth(), u.getUTCDate(), u.getUTCHours(), u.getUTCMinutes(), u.getUTCSeconds()).toISOString();
  };
  /* Planın tezgâh kuyrukları plan modülünün diliyle (anahtar "emir no|OP no", makine kimliği). Fason, kişi ve sunucuda karşılığı olmayan
     iş yazılmaz, sayılır; bitmiş iş yazılmaz. İşin yeri ve sırası planlamacının kararıdır (elle, elleKaynak); saat önizlemedir, son söz
     sunucunun çözücüsündedir. */
  function soKuyruklari(a) {
    const durum = TMI_KAYNAK.durum || {};
    const st = sunucuyla(rrOku() || TMI_BOS_KAYIT, durum, a.D);
    const anahtar = {};
    for (const [k, id] of Object.entries(tmiIslemler(st, a.D))) anahtar[id] = k;
    const C = durum.planCanli;
    const planlanacak = C && Array.isArray(C.planlanacak) ? new Set(C.planlanacak) : null;
    const gruplar = new Map(), yazilamaz = new Set();
    for (const [id, r] of Object.entries(a.plan.ops || {})) {
      if (!r || r.done || !isFinite(r.S) || !isFinite(r.C)) continue;
      const k = anahtar[id], m = String(r.m || '');
      if (!/^\d+$/.test(m)) { if (!m.startsWith('@')) yazilamaz.add(k || id); continue; }
      if (!k || (planlanacak && !planlanacak.has(k))) { yazilamaz.add(k || id); continue; }
      const l = gruplar.get(m) || []; l.push({ k, r }); gruplar.set(m, l);
    }
    const simdi = Date.now();
    const kuyruklar = [...gruplar].map(([m, l]) => {
      l.sort((p, q) => p.r.S - q.r.S);
      return { kaynak: { tur: 'makine', id: Number(m) }, baslangic: new Date(Math.max(simdi, Date.parse(duvarIso(a.D, l[0].r.S)))).toISOString(),
        isler: l.map(({ k, r }) => {
          const i = k.lastIndexOf('|');
          return { emirNo: k.slice(0, i), opNo: Number(k.slice(i + 1)), dondurulmus: false, elle: true, elleKaynak: true,
            onizleme: { baslangic: duvarIso(a.D, r.S), bitis: duvarIso(a.D, r.C) } };
        }) };
    });
    return { kuyruklar, yazilamaz: [...yazilamaz] };
  }
  const komut = (ad, govde) => window.tmi.komut(ad, govde);
  const senaryoBul = (r, f) => ((r && r.sonuc && r.sonuc.senaryolar) || []).filter(f).sort((p, q) => q.id - p.id)[0] || null;
  /* Plan kişiye yeni taslakta yazılır ve onaya gider. Yarıda kalırsa açılan taslaktan vazgeçilir (onaya gitmemiş taslak). */
  async function soGonder(a, not) {
    const { kuyruklar, yazilamaz } = soKuyruklari(a);
    if (!kuyruklar.length) throw new Error('Plana yazılacak iş yok: sunucuda iş emri ve makinesi olan, bitmemiş iş gerekir.');
    const t = senaryoBul(await komut('plan-senaryo-ac', { ad: a.ad }), x => x.benim && x.durum === 'acik' && x.ad === a.ad);
    if (!t) throw new Error('Plan sunucuda açılamadı.');
    try {
      const y = ((await komut('plan-senaryo-yaz', { taslak: t.id, kuyruklar })) || {}).sonuc || {};
      await komut('plan-senaryo-onaya-gonder', { taslak: t.id, not: not || null });
      return { taslak: t.id, yazilan: y.yazilan || 0, atlanan: y.atlanan || 0, yazilamaz };
    } catch (h) { komut('plan-senaryo-vazgec', { taslak: t.id }).catch(() => {}); throw h; }
  }
  /* Yerini yeni taslak alan eski taslak kapanır (geri gönderilmiş ya da onaydan çekilecek); kapanamazsa plan modülünde açık kalır. */
  const taslakKapat = async (t, onayda) => {
    try { if (onayda) await komut('plan-senaryo-onaydan-cek', { taslak: t }); await komut('plan-senaryo-vazgec', { taslak: t }); } catch (h) { console.error(h); }
  };
  const hataMetni = (h, yedek) => (h && (h.message || h.hata)) || yedek;
  const isle = async (is) => {
    if (SO.yaziyor) { bildir('Önceki istek sürüyor.', 'uyari'); return; }
    SO.yaziyor = true;
    try { await is(); } catch (h) { console.error(h); bildir('İşlem tamamlanamadı; sayfayı yenileyip yeniden deneyin.', 'hata'); } finally { SO.yaziyor = false; render(); }
  };
  const gonderOzeti = g => `${g.yazilan} iş taslağa yazıldı${g.atlanan ? `, ${g.atlanan} iş yerinde kaldı (başlamış, kilitli ya da dondurulmuş)` : ''}`
    + `${g.yazilamaz.length ? `; ${g.yazilamaz.length} iş sunucuda karşılığı olmadığı için yazılmadı (${g.yazilamaz.slice(0, 3).join(', ')}${g.yazilamaz.length > 3 ? '…' : ''})` : ''}.`;

  paOnayaGonder = function (id) {
    if (!yetkili('plan.yaz')) { bildir('Onaya göndermek için plan yazma yetkisi gerekir.', 'hata'); return; }
    const mevcut = id && id !== 'calisma' ? paAl(id) : null;
    if (id && id !== 'calisma' && !mevcut) return;
    const a = mevcut || paCalisma();
    if (!a) { bildir('Önce planı kurun.', 'hata'); U.sayfa = 'studyo'; U.psSek = 'onay'; render(); return; }
    if (!a.plan) { bildir('Bu planda yerleşim yok; çalışmaya açıp yeniden kurun.', 'hata'); return; }
    if (paRedVar(paKontrol(a))) { U.paSec = a.id; U.sayfa = 'studyo'; U.psSek = 'onay'; render(); bildir('Plan kontrolden geçmedi; Onay sekmesindeki kırmızı maddeleri giderin.', 'hata'); return; }
    const not = paNot(a.id);
    const s = mevcut || paSnap(`Onay ${fmtDT(S.D, cxAl().st.now).slice(0, 9)} · ${kim().ad}`, 'onay');
    isle(async () => {
      let g;
      try { g = await soGonder(s, not); } catch (h) { bildir(`Plan onaya gönderilemedi: ${(hataMetni(h, 'sunucuya ulaşılamadı'))}`, 'hata'); return; }
      if (!mevcut) paEkle(s);
      if (s.taslak && s.taslak !== g.taslak) taslakKapat(s.taslak, s.durum === 'onay');
      s.durum = 'onay'; s.taslak = g.taslak; paKararYaz(s, 'onaya', not); if (U.paNot) delete U.paNot[a.id];
      iz('Plan onaya gönderildi', `${s.ad} · taslak ${g.taslak}`); U.paSec = s.id; kaydet(); U.sayfa = 'studyo'; U.psSek = 'onay'; render();
      bildir(`Plan onaya gönderildi: ${gonderOzeti(g)} Canlıya onaylayan alır.`, 'tamam');
    });
  };

  paYayinla = function (id) {
    if (!yetkili('plan.canliya-al')) { bildir('Canlıya almak için müdür ya da yönetici yetkisi gerekir.', 'hata'); return; }
    const a = paAl(id); if (!a || !a.plan) return;
    if (id !== 'calisma' && (a.durum !== 'onay' || !a.taslak)) { bildir('Bu plan sunucuda onay beklemiyor; önce onaya gönderin.', 'hata'); return; }
    const K = paKontrol(a); if (paRedVar(K)) { bildir('Plan kontrolden geçmedi; kırmızı maddeler giderilmeden canlıya alınmaz.', 'hata'); return; }
    const uy = K.filter(k => k[0] === 'uyari').map(k => k[1]);
    /* Çalışma planı önce onaya gider, sonra aynı kişi onaylar: dört göz açıksa sunucu reddeder, plan onayda kalır. */
    const al = () => isle(async () => {
      const cal = id === 'calisma';
      const s = cal ? paSnap(`Sürüm ${S.canliSurum + 1} · ${fmtDT(S.D, cxAl().st.now).slice(0, 9)}`, 'onay') : a;
      const not = paNot(id);
      if (cal) {
        try { s.taslak = (await soGonder(s, not)).taslak; } catch (h) { bildir(`Plan onaya gönderilemedi: ${(hataMetni(h, 'sunucuya ulaşılamadı'))}`, 'hata'); return; }
        paEkle(s); paKararYaz(s, 'onaya', not); kaydet();
      }
      try { await komut('plan-senaryo-canliya-al', { taslak: s.taslak }); }
      catch (h) { if (cal) { U.paSec = s.id; render(); } bildir(`Plan canlıya alınamadı${cal ? ', onayda bekliyor' : ''}: ${(hataMetni(h, 'sunucuya ulaşılamadı'))}`, 'hata'); return; }
      for (const x of S.senaryolar) if (x.id !== s.id && x.durum === 'canli') x.durum = 'arsiv';
      S.canliSurum++; S.canli = s.id; Object.assign(s, { durum: 'canli', surum: S.canliSurum, canliKim: kim().ad, canliZaman: Date.now() });
      paKararYaz(s, 'canli', not); if (U.paNot) delete U.paNot[id];
      (S.paGecmis = S.paGecmis || []).unshift({ surum: S.canliSurum, id: s.id, ad: s.ad, yazar: s.yazar, kim: kim().ad, zaman: Date.now(), ozet: clone(s.ozet) });
      if (cal) { S.tabanSurum = S.canliSurum; if (U.taslak) U.taslak = { adimlar: [], bas: Date.now() }; }
      iz('Plan canlıya alındı', `${s.ad} · taslak ${s.taslak}`); U.paSec = 'calisma'; kaydet(); render();
      bildir('Plan canlıda. Tezgâh kuyrukları, Arkon ve Üretim Terminali bu planı gösterir.', 'tamam');
    });
    onayla(uy.length ? 'Uyarılarla canlıya alınsın mı?' : 'Canlıya alınsın mı?', uy.length ? `${a.ad}: ${uy.join('; ')}.` : `"${a.ad}" canlı plan olacak; tezgâh kuyrukları bu plana göre görünür.`, al, { evet: uy.length ? 'Yine de canlıya al' : 'Onayla ve canlıya al' });
  };

  paGeri = function (id) {
    if (!yetkili('plan.canliya-al')) return; const s = paAl(id); if (!s || s.durum !== 'onay') return;
    const neden = paNot(id);
    if (!neden) { bildir('Geri gönderme nedenini Not alanına yazın.', 'hata'); return; }
    if (!s.taslak) { s.durum = 'acik'; paKararYaz(s, 'geri', neden); kaydet(); render(); return; }
    isle(async () => {
      try { await komut('plan-senaryo-geri-gonder', { taslak: s.taslak, neden }); }
      catch (h) { bildir(`Plan geri gönderilemedi: ${(hataMetni(h, 'sunucuya ulaşılamadı'))}`, 'hata'); return; }
      s.durum = 'acik'; paKararYaz(s, 'geri', neden); if (U.paNot) delete U.paNot[id];
      iz('Plan geri gönderildi', s.ad + ' · ' + neden); kaydet(); render(); bildir(`"${s.ad}" planlamacıya geri gönderildi.`, 'tamam');
    });
  };

  /* Sunucudaki taslak da kapanır; onaydaki taslak önce onaydan çekilir. */
  const vazgec0 = paVazgec;
  paVazgec = function (id) {
    const s = paAl(id); if (!s || !yetkili('plan.yaz') || s.id === S.canli) return;
    if (!s.taslak || s.durum === 'canli' || s.durum === 'arsiv') { vazgec0(id); return; }
    isle(async () => {
      try {
        if (s.durum === 'onay') await komut('plan-senaryo-onaydan-cek', { taslak: s.taslak });
        await komut('plan-senaryo-vazgec', { taslak: s.taslak });
      } catch (h) { bildir(`Plandan vazgeçilemedi: ${(hataMetni(h, 'sunucuya ulaşılamadı'))}`, 'hata'); return; }
      vazgec0(id);
    });
  };

  /* Onay listesi sunucudaki senaryo durumuyla eşitlenir: ortak kayıt açılışta bir kez okunur ve plan yazmayan kişi kayda yazamaz; onayın
     durumu sunucudadır. Kayıtta onayda görünen planın taslağı sunucuda artık onayda değilse sayfada sunucunun durumu görünür (canlıya
     alındı, geri gönderildi ya da onaydan çekildi, vazgeçildi). Sunucuda onayda olup kayıtta karşılığı olmayan plan varsa (sayfa o plan
     gönderilmeden önce açıldı) yenilemesi söylenir. Eşitleme kayda yazmaz; yazabilen kişinin sonraki kaydıyla kayda geçer. */
  const SE = { okunuyor: false, bildirilen: '', yer: '' };
  function senaryoEsitle(liste) {
    const sun = new Map(liste.map(x => [x.id, x]));
    let degisti = false;
    for (const s of S.senaryolar) {
      if (!s.taslak || s.durum !== 'onay') continue;
      const x = sun.get(s.taslak); if (!x || x.durum === 'onayda') continue;
      degisti = true;
      if (x.durum === 'canliya_alindi') {
        for (const y of S.senaryolar) if (y.id !== s.id && y.durum === 'canli') y.durum = 'arsiv';
        S.canliSurum++; S.canli = s.id; Object.assign(s, { durum: 'canli', surum: S.canliSurum, canliKim: null, canliZaman: null });
        (S.paGecmis = S.paGecmis || []).unshift({ surum: S.canliSurum, id: s.id, ad: s.ad, yazar: s.yazar, kim: null, zaman: null, ozet: clone(s.ozet) });
      } else if (x.durum === 'acik') {
        s.durum = 'acik';
        const o = x.onay;
        if (o && o.geriGonderme) (s.kararlar = s.kararlar || []).push({ karar: 'geri', kim: o.geriGonderen || '', rol: '', zaman: Date.parse(o.geriGonderme), not: o.geriNeden || '' });
      } else s.durum = 'vazgecildi';
    }
    const eksik = liste.filter(x => x.durum === 'onayda' && !S.senaryolar.some(s => s.taslak === x.id));
    const imza = eksik.map(x => x.id).join(',');
    if (eksik.length && imza !== SE.bildirilen) {
      const ad = eksik.map(x => `${x.ad}${x.onay && x.onay.gonderen ? ` (gönderen ${x.onay.gonderen})` : ''}`).join(', ');
      bildir(`Sunucuda onay bekleyen plan var: ${ad}. Bu sayfa plan gönderilmeden önce açıldı; görmek için yenileyin.`, 'uyari', { metin: 'Yenile', act: 'pa-yenile' });
    }
    SE.bildirilen = imza;
    return degisti;
  }
  const senaryolariOku = () => {
    if (!S || SE.okunuyor || typeof window.tmi.planSenaryolari !== 'function') return;
    SE.okunuyor = true;
    window.tmi.planSenaryolari().then(r => {
      if (S && r && Array.isArray(r.senaryolar) && senaryoEsitle(r.senaryolar)) render();
    }, h => console.error(h)).finally(() => { SE.okunuyor = false; });
  };
  /* açılışta, Onay sekmesine her girişte ve sayfaya dönüşte okunur */
  const r0 = render;
  render = function () {
    const x = r0.apply(this, arguments);
    const yer = S ? (U.sayfa === 'studyo' && U.psSek === 'onay' ? 'onay' : 'baska') : '';
    if (yer && yer !== SE.yer && (SE.yer === '' || yer === 'onay')) senaryolariOku();
    SE.yer = yer;
    return x;
  };
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') senaryolariOku(); });
  const paEylem0 = paEylem;
  paEylem = function (act, v) {
    if (act === 'pa-yenile') { if (typeof window.tmi.yenile === 'function') window.tmi.yenile(); return true; }
    return paEylem0(act, v);
  };
}

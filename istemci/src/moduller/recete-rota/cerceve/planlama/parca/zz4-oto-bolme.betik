/* ---------- Otomatik bölme ve bölme çeşitleri (kullanıcı 19.10 17:46) ----------
   Kullanıcı otomatik bölme istedi; 157 b ("plan partiyi kendiliğinden bölmez") bu denemede kipe bağlandı. Kip "Otomatik"te her
   çözümün ardından en çok geciken siparişlerde açık çeşitler denenir; TL toplamını eşikten çok düşüren bölme seçilir, sonra yeni
   planda sıradaki sipariş denenir. Sonuç tek bir önizlemedir: planlamacı uygular ya da bırakır, sepette tek adımdır.
   Çeşitler:
   - yari: iki eşit parti, aynı tezgâhlar; ikinci parti rotada birincinin arkasından akar (aktarma partisi gibi).
   - paralel: iki eşit parti, ikinci parti darboğaz adımında başka tezgâhta.
   - oran: üçte bir ile üçte iki, küçük parti darboğazda başka tezgâhta.
   - uc: üç eşit parti, ikinci ve üçüncü parti darboğazda başka tezgâhlarda.
   - termin: termine yetişecek kadarı birinci parti, kalanı sonra (kısmi sevk; müşteri kabulü gerekir).
   Her parti ayrı ayar yapar; ayar süresi ve bedeli motorda zaten sayılır, bu yüzden küçük partide bölme kendiliğinden elenir.
   Bir sipariş bu denemede en çok bir kez bölünür (bölünmüş partinin adı "/" taşır). */
const BOLME_CESIT = [
  ['yari', 'Eşit iki parti, aynı tezgâhlar'], ['paralel', 'Eşit iki parti, ikincisi başka tezgâhta'],
  ['oran', 'Üçte bir ve üçte iki'], ['uc', 'Üç eşit parti'], ['termin', 'Termine yetişen kadarı önce'],
];
const BC_ANAHTAR = { yari: 'bcYari', paralel: 'bcParalel', oran: 'bcOran', uc: 'bcUc', termin: 'bcTermin' };
const bolmeAcik = c => (S.param || {})[BC_ANAHTAR[c]] !== 'kapali';
const bolmeKip = () => (S.param || {}).bolmeKip || 'otomatik';
const bolmeMin = () => Math.max(1, +(S.param || {}).bolmeMin || 5);

function bolmeHamleN(jid, opId, parcalar, ad, ms) {
  const s = S.D.siparisler.find(x => x.id === jid); if (!s) return null;
  if (parcalar.length < 2 || parcalar.some(x => !(x.n >= 1)) || parcalar.reduce((t, x) => t + x.n, 0) !== s.adet) return null;
  const k = opId.slice(opId.lastIndexOf('.') + 1);
  const parca = (n, ek) => ({ ...clone(s), id: `${jid}/${ek}`, adet: n, gelir: s.gelir == null ? null : Math.round(s.gelir * n / s.adet), malzeme: (s.malzeme || []).map(x => ({ ...x })) });
  const yeni = parcalar.map((x, i) => parca(x.n, i + 1)); const eski = S.D.siparisler; const once = U.hamle;
  try {
    S.D.siparisler = eski.flatMap(x => x.id === jid ? yeni : [x]);
    let st; try { st = stOf(); } finally { S.D.siparisler = eski; }
    const ops = {}; const pref = jid + '.';
    for (const [id, r] of Object.entries(S.plan.ops)) {
      if (!id.startsWith(pref)) { ops[id] = r; continue; }
      const kk = id.slice(pref.length);
      parcalar.forEach((x, i) => { const j = `${jid}/${i + 1}`; ops[`${j}.${kk}`] = { ...r, id: `${j}.${kk}`, job: j, S: r.S + i * 1e-3, m: x.m && kk === k ? x.m : r.m }; });
    }
    for (const id of Object.keys(st.locks)) if (id.startsWith(pref)) { const kk = id.slice(pref.length), l = st.locks[id]; delete st.locks[id]; parcalar.forEach((x, i) => { st.locks[`${jid}/${i + 1}.${kk}`] = { ...l }; }); }
    const r0 = S.plan.ops[opId];
    parcalar.forEach((x, i) => { if (x.m) st.locks[`${jid}/${i + 1}.${k}`] = { m: x.m, S: r0 ? r0.S : st.now }; });
    const cx = compile(st);
    const p0 = lnsDecode(st, { ops, fail: S.plan.fail || [] }, [], cx, true);
    const p = kisaArama(st, cx, p0, ms || 400);
    hamleKur(p, st, ad, { kaynak: 'elle' });
    const h = U.hamle; h.bolme = { eski: jid, yeni }; h.hedef = null; h.ham = p; h.hamSt = st;
    let T = 0, C = -1e9; for (const y of yeni) { const J = h.plan.J[y.id] || {}; T = Math.max(T, J.T || 0); C = Math.max(C, J.C ?? 1e9); }
    h.bolmeT = T; h.bolmeC = C; h.bolmeTL = tlToplam(evaluate(p, st, null, true));
    return h;
  } catch (e) { return null; } finally { U.hamle = once; }
}
/* eski çağrılar (iş panelindeki "Partiyi böl" dışındaki öneri yolu) iki partili biçimi kullanır */
bolmeHamle = function (jid, opId, a, altM) {
  const s = S.D.siparisler.find(x => x.id === jid); if (!s || !(a >= 1 && a < s.adet)) return null;
  const k = opId.slice(opId.lastIndexOf('.') + 1);
  return bolmeHamleN(jid, opId, [{ n: a }, { n: s.adet - a, m: altM || null }], `${jid} ikiye bölündü: ${a} + ${s.adet - a}${altM ? ` · ikinci parti ${k} adımı ${altM}` : ', aynı tezgâhlarda'}`);
};
function darbogazAdimi(jid) {
  const cx = cxAl(); if (!cx || !cx.jobs[jid]) return null;
  const BEK = new Set(['tezgah', 'personel', 'yetkin', 'ayarci', 'aparat']);
  let dar = null, enW = -1;
  for (const o of cx.jobs[jid].ops) { const r = S.plan.ops[o.id]; if (!r || r.fas || r.done || r.act) continue;
    let hazir = r.S; if (r.why && BEK.has(r.why.t)) { let cp = -Infinity; for (const [p] of o.pr) { const q = S.plan.ops[p]; if (q) cp = Math.max(cp, q.C); } hazir = isFinite(cp) ? cp : cx.st.now; }
    const w = r.S - hazir + r.run * 0.01; if (w > enW) { enW = w; dar = { o, r }; } }
  if (!dar) return null;
  const alt = dar.o.c.filter(c => !c.fas && !c.opt && c.m !== dar.r.m).sort((x, y) => (x.run + x.su) - (y.run + y.su)).map(c => c.m);
  return { ...dar, alt, cx };
}
/* Çeşit başına parti listesi; en küçük parti sınırının altında kalan çeşit denenmez. */
function bolmeCesitleri(jid) {
  const s = S.D.siparisler.find(x => x.id === jid); if (!s || !S.plan) return [];
  const d = darbogazAdimi(jid); if (!d) return [];
  const n = s.adet, mn = bolmeMin(), k = d.o.id.slice(d.o.id.lastIndexOf('.') + 1), a1 = d.alt[0] || null, a2 = d.alt[1] || a1;
  const l = [];
  const ekle = (c, parcalar, ad) => { if (!bolmeAcik(c) || parcalar.some(x => x.n < mn)) return; l.push({ c, parcalar, ad: `${jid} ${ad}`, op: d.o.id }); };
  const y = Math.floor(n / 2);
  ekle('yari', [{ n: y }, { n: n - y }], `iki eşit partiye bölündü (${y} + ${n - y}), aynı tezgâhlarda`);
  if (a1) ekle('paralel', [{ n: y }, { n: n - y, m: a1 }], `iki eşit partiye bölündü (${y} + ${n - y}), ikinci parti ${k} adımı ${a1}`);
  if (a1) { const u = Math.max(1, Math.round(n / 3)); ekle('oran', [{ n: u, m: a1 }, { n: n - u }], `üçte birle bölündü (${u} + ${n - u}), küçük parti ${k} adımı ${a1}`); }
  { const u = Math.floor(n / 3), v = Math.floor((n - u) / 2); ekle('uc', [{ n: u }, { n: v, m: a1 }, { n: n - u - v, m: a2 }], `üç partiye bölündü (${u} + ${v} + ${n - u - v})${a1 ? `, ${k} adımı ${a1 === a2 ? a1 : a1 + ' ve ' + a2}` : ', aynı tezgâhlarda'}`); }
  const J = S.plan.J[jid];
  if (J && J.T > 0.01 && J.C != null && s.termin != null) {
    const ops = Object.values(S.plan.ops).filter(r => r.job === jid && isFinite(r.S)); const S0 = Math.min(...ops.map(r => r.S));
    const ter = J.C - J.T; const f = (ter - S0) / Math.max(1e-6, J.C - S0);
    if (f > 0.05 && f < 0.95) { const a = Math.floor(n * f * 0.9); ekle('termin', [{ n: a }, { n: n - a }], `termine yetişecek ${a} adet önce, kalan ${n - a} sonra`); }
  }
  return l;
}
bolmeAdaylari = function (jid, ms) {
  const s = S.D.siparisler.find(x => x.id === jid); if (!s || s.adet < 2 || !S.plan || basladiMi(jid) || bolmeKip() === 'kapali') return [];
  const c0 = S.plan.J[jid] ? (S.plan.J[jid].C ?? 1e9) : 1e9;
  return bolmeCesitleri(jid).map(x => { const h = bolmeHamleN(jid, x.op, x.parcalar, x.ad, ms); if (h) h.bolmeCesit = x.c; return h; }).filter(Boolean)
    .map(h => ({ c: h.bolmeC, h, iyi: h.bolmeC < c0 - 0.05, bolme: true, cesit: h.bolmeCesit }));
};

/* ---------- otomatik geçiş ----------
   S geçici olarak bölünmüş duruma alınır, her adımın arasında geri konur: ekran adımlar arasında hiçbir zaman yarım durumu çizmez. */
let otoBolmeSurer = null;
function otoBolme(elle) {
  if (otoBolmeSurer || calisan || !S.plan || !yetkili('plan.yaz')) return;
  if (!elle && (bolmeKip() !== 'otomatik' || U.hamle)) return;
  const asil = { sip: S.D.siparisler, plan: S.plan, locks: S.locks, dv: S.dataVer };
  const kum = { sip: asil.sip, plan: asil.plan, locks: asil.locks, dv: asil.dv };
  const maks = Math.max(0, Math.round(+(S.param.bolmeMaks ?? 3))), esik = Math.max(0, +(S.param.bolmeEsik ?? 1000));
  const kabul = []; const denendi = new Set(); let son = null, tl0 = null, tur = 0, adaylar = [];
  const gir = () => { S.D.siparisler = kum.sip; S.plan = kum.plan; S.locks = kum.locks; S.dataVer = kum.dv; };
  const cik = () => { kum.sip = S.D.siparisler; kum.plan = S.plan; kum.locks = S.locks; kum.dv = S.dataVer; S.D.siparisler = asil.sip; S.plan = asil.plan; S.locks = asil.locks; S.dataVer = asil.dv; };
  const bozuldu = () => S.plan !== asil.plan || S.dataVer !== asil.dv || calisan;
  const temelTL = () => { const st = stOf(); const cx = compile(st); const p0 = lnsDecode(st, { ops: S.plan.ops, fail: S.plan.fail || [] }, [], cx, true); return tlToplam(evaluate(kisaArama(st, cx, p0, 300), st, null, true)); };
  const geciken = () => Object.entries(S.plan.J).filter(([j, J]) => J.T > 0.01 && !j.includes('/') && !denendi.has(j) && !basladiMi(j))
    .map(([j, J]) => { const s = S.D.siparisler.find(x => x.id === j); return { j, w: J.T * (s ? (PW[s.oncelik] || 1) : 1), s }; })
    .filter(x => x.s && x.s.adet >= 2 * bolmeMin() && !x.s.havuz).sort((a, b) => b.w - a.w).slice(0, 6).map(x => x.j);
  otoBolmeSurer = { n: 0 };
  const bitir = () => {
    otoBolmeSurer = null;
    if (!kabul.length) { if (elle) bildir('Bölme TL toplamını eşikten çok düşürmedi; plan bölünmedi.', 'bilgi'); return; }
    /* yazılan kazanç iki planın kendi girdileriyle (plana bağlı vade ve malzeme günü dahil) aramasız değerlendirilmiş farkıdır */
    const tlSimdi = () => tlToplam(evaluate({ ops: S.plan.ops, fail: S.plan.fail || [] }, stOf(), null, true));
    let gercek = null; try { const a = tlSimdi(); gir(); try { gercek = a - tlSimdi(); } finally { cik(); } } catch (e) { gercek = null; }
    if (gercek != null && gercek < esik) { if (elle) bildir('Bölme arama sonrası kazanç bıraktı ama bugünkü plana göre eşiği geçmedi; plan bölünmedi.', 'bilgi'); return; }
    hamleKur(son.ham, son.hamSt, `Otomatik bölme: ${kabul.map(x => x.ad).join('; ')}${gercek != null ? ` · TL ${tlKisa(-gercek)}` : ''}`, { kaynak: 'oneri' });
    U.hamle.bolme = null; U.hamle.bolmeListe = kabul.map(x => x.bolme); U.hamle.otoBolme = kabul.map(({ ad, kazanc, cesit }) => ({ ad, kazanc, cesit }));
    render(); if (!U.taslak) bildir(`Otomatik bölme ${kabul.length} sipariş önerdi; önizlemeyi uygulayın ya da bırakın.`, 'tamam');
  };
  const adim = () => {
    if (bozuldu()) { otoBolmeSurer = null; return; }
    gir();
    try {
      if (tl0 == null) { tl0 = temelTL(); adaylar = geciken(); }
      if (!adaylar.length) { cik(); bitir(); return; }
      const j = adaylar.shift(); denendi.add(j); otoBolmeSurer.n++;
      const c0 = S.plan.J[j].C;
      const l = bolmeAdaylari(j, 300).filter(x => x.h.bolmeC < c0 - 0.05);
      let en = null; for (const x of l) if (!en || x.h.bolmeTL < en.h.bolmeTL) en = x;
      const g = en ? tl0 - en.h.bolmeTL : 0;
      if (en && g >= esik) {
        const h = en.h;
        S.D.siparisler = S.D.siparisler.flatMap(x => x.id === h.bolme.eski ? h.bolme.yeni.map(clone) : [x]);
        S.plan = { ...h.plan }; S.locks = Object.fromEntries(Object.entries(h.locks).filter(([, l]) => !l.gecici)); S.dataVer += 1e-3;
        kabul.push({ ad: h.ad, kazanc: g, cesit: h.bolmeCesit, bolme: h.bolme }); son = h; tl0 = h.bolmeTL; tur++;
        adaylar = tur < maks ? geciken() : [];
      }
      cik();
    } catch (e) { cik(); otoBolmeSurer = null; return; }
    setTimeout(adim, 0);
  };
  if (maks < 1) { otoBolmeSurer = null; return; }
  setTimeout(adim, 0);
}
function tlKisa(v) { return (v < 0 ? '−' : '+') + sayi(Math.abs(Math.round(v)), 0); }
/* önizlemede birden çok bölme olabilir: uygularken siparişler sırayla bölünür */
{ const hu0 = hamleUygula; hamleUygula = function (sessiz) {
  const h = U.hamle; const sip = S.D.siparisler; const gecerli = h && h.dv === S.dataVer && (h.bolme || h.bolmeListe);
  if (gecerli && h.bolmeListe) for (const b of h.bolmeListe) S.D.siparisler = S.D.siparisler.flatMap(x => x.id === b.eski ? b.yeni.map(clone) : [x]);
  const r = hu0.apply(this, arguments);
  if (gecerli && U.hamle !== h) { const x = planGeri[planGeri.length - 1]; if (x) x.sip = sip; }
  return r; }; }
/* "Planı geri al" bölmeyi de geri alır: geri alınan planın sipariş listesi döner */
planGeri.pop = function () { const x = Array.prototype.pop.call(this); if (x && x.sip) S.D.siparisler = x.sip; return x; };
/* çözüm bitince otomatik geçiş */
{ const coz0 = coz; coz = function (kip) {
  const p0 = S.plan; const r = coz0.apply(this, arguments);
  const w = calisan; if (!w || kip === 'ekip') return r;
  const om = w.onmessage;
  w.onmessage = e => { const t = e.data && e.data.t; om(e); if (t === 'bitti' && S.plan !== p0) setTimeout(() => { if (!calisan) otoBolme(false); }, 80); };
  return r; }; }
document.addEventListener('click', e => {
  const el = e.target.closest && e.target.closest('[data-oto-bolme]'); if (!el) return;
  if (!yetkili('plan.yaz')) { bildir('Yetkiniz yok (plan.yaz).', 'hata'); return; }
  if (calisan || otoBolmeSurer) { bildir('Önce süren hesap bitsin.', 'bilgi'); return; }
  bildir('Bölme çeşitleri geciken siparişlerde deneniyor.', 'bilgi'); otoBolme(true);
});
{ const kb = KATALOG_DUZ.bolme; if (kb) Object.assign(kb, { durum: 'karar', ad: 'Parti bölme',
  not: 'Kullanıcı 17:46: otomatik bölme. "Otomatik"te her çözümden sonra en çok geciken altı sipariş açık çeşitlerle denenir; TL toplamını eşikten çok düşüren bölme önizlemeye girer, planlamacı uygular. "Yalnız öneri"de çeşitler Öneriler ve "Hedefe yetiştir"de görünür. Her parti ayrı ayar yapar; ayar bedeli hesapta. Başlamış sipariş ve bölünmüş parti yeniden bölünmez. "Termine yetişen kadarı" kısmi sevktir, müşteri kabulü gerekir.',
  p: [['param', 'bolmeKip', 'Kip', 'sec', [['otomatik', 'Otomatik'], ['oneri', 'Yalnız öneri'], ['kapali', 'Kapalı']]],
    ['param', 'bolmeMin', 'En küçük parti', 'adet', 1, 10000, 1], ['param', 'bolmeMaks', 'Bir çözümde en çok bölünen', 'sipariş', 0, 20, 1], ['param', 'bolmeEsik', 'En az kazanç', 'TL', 0, 1000000, 100],
    ...BOLME_CESIT.map(([c, ad]) => ['param', BC_ANAHTAR[c], ad, 'sec', [['acik', 'Denenir'], ['kapali', 'Denenmez']]])] }); }
/* eksik varsayılan yalnız bellekte tamamlanır, ilk kayıtla yazılır (açılışta yazılmaz) */
setTimeout(() => { if (!S.param) return; for (const [k, v] of [['bolmeKip', 'otomatik'], ['bolmeMin', 5], ['bolmeMaks', 3], ['bolmeEsik', 1000]]) if (S.param[k] == null) S.param[k] = v; }, 0);
/* öne alma adayları önizleme alanını kullanır; bekleyen önizleme (otomatik bölme) aday hesabından sonra yerinde kalır */
{ const oa1 = oneAlAdaylari; oneAlAdaylari = function () { const h = U.hamle, s = U.secili; try { return oa1.apply(this, arguments); } finally { U.hamle = h; U.secili = s; } }; }

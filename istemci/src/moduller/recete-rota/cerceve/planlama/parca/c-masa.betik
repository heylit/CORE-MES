/* ---------- ortak plan yardımcıları ---------- */
const urunAd = id => { const u = S.D.urunler.find(x => x.id === id); return u ? u.ad : (id || '—'); };
const oncelikRozet = o => rozet(ONCELIK[o] || '—', o === 1 ? 'hata' : o === 3 ? 'pasif' : '');
const tezgahAd = (cx, m) => m && m[0] === '@' ? 'Fason: ' + (((cx && cx.FS[m.slice(1)]) || {}).ad || m.slice(1)) : `${m} · ${((cx && cx.M[m]) || {}).ad || ''}`;
function nedenMetni(r) {
  const why = r.why || {};
  let neden = NEDEN[why.t] || 'Bilinmiyor.';
  if (why.t === 'rota') neden = why.o === 2 ? `Son parti kuralı: önceki adım ${why.r} bitmeden son partiyi bitiremezdi.` : why.o === 1 ? `Önceki adım ${why.r} ilk partisini bitirince örtüşmeli başladı.` : `Önceki adım ${why.r} bitince başladı (taşıma payı dahil).`;
  if (why.t === 'tezgah') neden = `Tezgâhta önceki iş ${why.r} bitince başladı.`;
  if (why.t === 'kilit') neden = 'Kilitli: planlamacının verdiği en erken saatte başladı.';
  if (why.t === 'oneri') neden = 'Çözücü önerisindeki saatte başladı; motor kısıtları yeniden uyguladı.';
  return neden;
}
function uyarilar(p) {
  const w = p.warn || [];
  if (!w.length && !(p.fail || []).length) return '';
  const tip = { malzeme: ['box', 'uyari', 'Malzeme'], program: ['tool', 'bilgi', 'NC programı'], plan: ['alert', 'hata', 'Planlanamadı'] };
  const grup = {};
  for (const x of w) (grup[x.t] = grup[x.t] || []).push(x);
  return `<ul class="pm-olaylar">${Object.entries(grup).map(([t, l]) => { const [s, ton, ad] = tip[t] || ['alert', 'uyari', t]; return l.slice(0, 5).map(x => `<li class="pm-olay" data-ton="${ton}">${ic(s, 'k')}<span class="pm-olay-metin"><b>${ad}.</b> ${esc(x.txt)}</span></li>`).join('') + (l.length > 5 ? `<li class="pm-kucuk">${ad}: ${l.length - 5} uyarı daha</li>` : ''); }).join('')}</ul>`;
}
function sayiKart(baslik, deger, ton, simge, alt) {
  return `<div class="tc-sayi-karti"${ton ? ` data-ton="${ton}"` : ''}><span class="tc-sayi-simge">${ic(simge)}</span><span class="tc-sayi-govde"><span class="tc-sayi-baslik">${baslik}</span><span class="tc-sayi-deger mono">${deger}</span>${alt ? `<span class="tc-sayi-alt">${alt}</span>` : ''}</span></div>`;
}
const fark = (a, b, k = 1, iyiKucuk = true) => (a == null || b == null || !isFinite(a) || !isFinite(b) || Math.abs(a - b) < (k ? 0.05 : 0.5)) ? '' : `<span class="${(a < b) === iyiKucuk ? 'pm-fark-iyi' : 'pm-fark-kotu'}">${a > b ? '+' : '−'}${sayi(Math.abs(a - b), k)}</span>`;
const panel = (baslik, govde, sag = '') => `<section class="pm-panel"><div class="pm-panel-ust"><h2>${baslik}</h2>${sag}</div>${govde}</section>`;

/* ---------- Plan masası ---------- */
function sMasa() {
  const cx = cxAl(); const D = S.D;
  if (!S.plan) {
    return `<div class="pm-bos">${ic('gantt', 'b')}<strong>Henüz plan yok</strong><span>${esc(D.meta.ad)}: ${D.tezgahlar.length} tezgâh, ${D.siparisler.length} sipariş, ${cx ? cx.ops.length : '—'} işlem, ${D.personel.length} personel. Kısıtları ve veriyi gözden geçirip motoru çalıştırın.</span><div class="pm-dugmeler">${dugme('Çöz', 'coz', { birincil: true, simge: 'play', yetki: 'plan.yaz', veri: 'data-v="sifir"' })}${dugme('Kısıtlar', 'git', { simge: 'target', veri: 'data-v="kisitlar"' })}${dugme('Veri denetimi', 'git', { simge: 'scan', veri: 'data-v="denetim"' })}</div></div>`;
  }
  const p = gosterilen();
  return `${kpiSerit(p)}<div class="pm-masa">
    <aside class="pm-masa-sol" aria-label="Siparişler">${siparisListesi(p)}</aside>
    <section class="pm-masa-orta" aria-label="Çizelge">${masaAraclari()}${gantt(p)}${lejant()}</section>
    <aside class="pm-masa-sag" id="denetci" aria-label="Seçilen iş">${denetci()}</aside></div>`;
}
function kpiSerit(p) {
  const o = p.ozet, on = U.hamle ? S.plan.ozet : (S.plan.oncekiOzet || null), D = S.D;
  const k = (b, d, f, s, ipucu, ton) => `<div class="pm-kpi"${ton ? ` data-ton="${ton}"` : ''} title="${esc(ipucu)}"><span class="pm-kpi-ad">${ic(s, 'k')}${b}</span><span class="pm-kpi-deger mono">${d}</span><span class="pm-kpi-fark">${f}</span></div>`;
  const kaynak = U.hamle ? 'Önizleme; farklar mevcut plana göre.' : on ? `Farklar bir önceki plana göre · ${S.plan.kaynak === 'elle' ? 'elle değişti' : esc(KIP_AD[S.plan.kaynak] || 'motor')} · ${esc(S.plan.kim)} ${zamanYaz(S.plan.zaman)}` : `${esc(KIP_AD[S.plan.kaynak] || 'Motor')} · ${esc(S.plan.kim)} ${zamanYaz(S.plan.zaman)}`;
  return `<div class="pm-kpiler">${[
    k('Ağırlıklı gecikme', saat(o.wT), fark(o.wT, on && on.wT), 'clock', 'Gecikme saatleri öncelik ağırlığıyla toplanır (yüksek ×4, normal ×2, düşük ×1).', o.wT > 0.5 ? 'hata' : ''),
    k('Geciken sipariş', `${o.late}/${o.n}`, fark(o.late, on && on.late, 0), 'flag', 'Termininden sonra biten ya da planlanamayan sipariş.', o.late ? 'uyari' : ''),
    k('Alt sınır', saat(altSinir(p)), '', 'target', 'Kapasite yokken bile kaçınılamayan ağırlıklı gecikme. Plan ile arasındaki fark kaynak çakışmasından gelir.'),
    k('Toplam ayar', saat(o.suH), fark(o.suH, on && on.suH), 'wrench', `${o.suN} ayar, ${o.famN} aynı aile geçişi`),
    k('Son bitiş', esc(fmtDT(D, o.Cmax)), fark(o.Cmax, on && on.Cmax), 'check', 'Plandaki en son biten iş'),
    k('Canlıya göre değişen', o.chg == null ? '—' : `${o.chg} iş`, fark(o.chg, on && on.chg, 0), 'rotate', 'Tezgâhı, tezgâhtaki sırası ya da 8 saatten çok yeri değişen iş. Canlı plan yoksa ölçülmez.'),
  ].join('')}<span class="pm-kpi-not">${kaynak}</span></div>`;
}
function siparisListesi(p) {
  const D = S.D;
  const l = D.siparisler.map(s => { const j = p.J[s.id]; const w = !j ? -2 : j.T == null ? 1e9 : j.T * (PW[s.oncelik] || 1); return { s, j, w }; })
    .sort((a, b) => b.w - a.w || (parseT(D, a.s.termin) ?? 1e9) - (parseT(D, b.s.termin) ?? 1e9));
  const gec = l.filter(x => x.j && (x.j.T == null || x.j.T > 0.01)).length;
  const satir = ({ s, j }) => {
    const durum = !j ? rozet('Planda yok', 'pasif') : j.T == null ? rozet('Planlanmadı', 'hata') : j.T > 0.01 ? rozet(saat(j.T) + ' geç', 'hata') : rozet('Zamanında', 'tamam');
    const deg = U.hamle && U.hamle.degisen.find(x => x.j === s.id);
    return `<button type="button" class="pm-sip" data-act="sec-is" data-v="${esc(s.id)}" aria-current="${U.secJob === s.id}" data-ara="${esc((s.id + ' ' + s.urun + ' ' + urunAd(s.urun)).toLowerCase())}" style="--c:${durumRenk(s.id)}">
      <span class="pm-sip-ust"><b class="mono">${esc(s.id)}</b>${durum}</span>
      <span class="pm-sip-alt">${esc(urunAd(s.urun))} · ${s.adet} ad · ${ONCELIK[s.oncelik] || ''}</span>
      <span class="pm-sip-alt mono">termin ${esc((s.termin || '—').slice(5))} · bitiş ${j && j.C != null ? esc(fmtDT(D, j.C).slice(0, 15)) : '—'}${deg ? ` <span class="${deg.d < 0 ? 'pm-fark-iyi' : 'pm-fark-kotu'}">${deg.d > 0 ? '+' : '−'}${sayi(Math.abs(deg.d), 1)} sa</span>` : ''}</span></button>`;
  };
  return panel(`Siparişler <span class="pm-kucuk">${gec} geciken</span>`, `<input class="tc-alan-kutu" type="search" placeholder="Sipariş ya da ürün ara" data-inp="ara-satir" aria-label="Sipariş ara"><div class="pm-sip-liste">${l.map(satir).join('')}</div>`, U.secJob ? dugme('', 'secim-temizle', { simge: 'x', hayalet: true, kucuk: true, ad: 'Seçimi kaldır' }) : '');
}
function masaAraclari() {
  const D = S.D; const gruplar = [...new Set(D.tezgahlar.map(m => m.grup))]; const canli = canliSen();
  const grupSec = `<select class="tc-alan-kutu pm-oto" data-chg="grup" aria-label="Tezgâh grubu"><option value="">Bütün gruplar</option>${gruplar.map(g => `<option${U.grup === g ? ' selected' : ''}>${esc(g)}</option>`).join('')}${(D.fasoncular || []).length ? `<option value="@fason"${U.grup === '@fason' ? ' selected' : ''}>fason</option>` : ''}</select>`;
  const anahtar = (chg, on, metin, kapali) => `<label class="tc-isaret"${kapali ? ' aria-disabled="true"' : ''}><input type="checkbox" data-chg="${chg}" ${on ? 'checked' : ''} ${kapali ? 'disabled' : ''}> ${metin}</label>`;
  return `<div class="pm-sira pm-arac"><div class="pm-seg" role="group" aria-label="Ölçek">${[[3, '4 hafta'], [10, 'Hafta'], [40, 'Gün']].map(([z, ad]) => `<button type="button" data-act="zoom" data-v="${z}" aria-pressed="${U.zoom === z}">${ad}</button>`).join('')}</div>${grupSec}
  ${anahtar('yalniz-gec', U.yalnizGec, 'Yalnız gecikenler')}${anahtar('yuk', U.yuk, 'Kaynak yükü')}${anahtar('canli-goster', U.canliGoster, 'Canlı planı göster', !(canli && canli.plan))}
  <span class="pm-sira-ara"></span>${dugme('', 'simdiye', { simge: 'target', ad: 'Plan başına git', hayalet: true })}${dugme('Planı geri al', 'plan-geri', { simge: 'back', kucuk: true, yetki: 'plan.yaz', cls: planGeri.length ? '' : 'pm-pasif' })}</div>`;
}
function lejant() {
  return `<div class="pm-lejant"><span><i class="pm-l-ayar"></i>Ayar</span><span><i class="pm-l-gec"></i>Geciken sipariş</span><span><i class="pm-l-kapali"></i>Tezgâh kapalı</span><span><i class="pm-l-ariza"></i>Arıza, bakım</span><span>${ic('lock', 'k')}Kilitli</span>${U.hamle ? '<span><i class="pm-l-degisti"></i>Önizlemede yeri değişen</span>' : ''}${U.canliGoster ? '<span><i class="pm-l-canli"></i>Canlı plandaki yeri</span>' : ''}${U.yuk ? '<span><i class="pm-l-asim"></i>Kapasite aşımı</span>' : ''}
  <span>${yetkili('plan.yaz') && !dar() ? 'Bir işi sürükleyip başka tezgâha ya da saate bırakın; motor sonucu hesaplar, siz onaylarsınız.' : 'Bir işe dokunun: ayrıntı ve hamleler sağda.'}</span></div>`;
}
function gantt(p) {
  const cx = cxAl(); const D = S.D; const px = U.zoom;
  const ops = Object.values(p.ops);
  const Cmax = Math.max(p.ozet.Cmax || 24, ...ops.map(r => r.C).filter(isFinite));
  const gunN = Math.min(HDAYS, Math.ceil(Cmax / 24) + 1);
  const W = gunN * 24 * px;
  const gruplar = {};
  for (const m of D.tezgahlar) (gruplar[m.grup] = gruplar[m.grup] || []).push(m);
  const fasonlar = (D.fasoncular || []).filter(f => ops.some(r => r.m === '@' + f.id) || cx && cx.ops.some(o => o.c.some(c => c.m === '@' + f.id)));
  const gecJ = new Set(Object.entries(p.J).filter(([, x]) => x.T == null || x.T > 0.01).map(([j]) => j));
  const secOp = U.secili && p.ops[U.secili];
  const secJob = U.secJob || (secOp ? secOp.job : null);
  const eski = U.hamle ? S.plan.ops : null;
  const canli = U.canliGoster && canliSen();
  const byM = {}, canliM = {};
  for (const r of ops) (byM[r.m] = byM[r.m] || []).push(r);
  if (canli && canli.plan) for (const r of Object.values(canli.plan.ops)) (canliM[r.m] = canliM[r.m] || []).push(r);
  const kisa = id => id.slice(id.lastIndexOf('.') + 1);
  const bar = r => {
    if (!isFinite(r.C)) return '';
    if (U.yalnizGec && !gecJ.has(r.job)) return '';
    const L = r.S * px, Wd = Math.max(3, (r.C - r.S) * px);
    const a = r.C > r.S ? Math.max(0, Math.min(100, ((r.Su - r.S) / (r.C - r.S)) * 100)) : 0;
    const kilit = (U.hamle ? U.hamle.locks : S.locks)[r.id];
    const e = eski && eski[r.id]; const degisti = eski && (!e || e.m !== r.m || Math.abs(e.S - r.S) > 0.25);
    const etiket = Wd > 56 ? `<span>${esc(r.job)}·${esc(kisa(r.id))}</span>` : '';
    return `<button type="button" class="pm-is" data-act="op" data-v="${esc(r.id)}" data-job="${esc(r.job)}" style="left:${L}px;width:${Wd}px;--c:${durumRenk(r.job)};--a:${a}%" ${gecJ.has(r.job) ? 'data-gec' : ''} ${secJob && r.job !== secJob ? 'data-soluk' : ''} ${U.secili === r.id ? 'data-secili' : ''} ${degisti ? 'data-degisti' : ''} title="${esc(r.id)} · ${esc(fmtDT(D, r.S))} → ${esc(fmtDT(D, r.C))}${gecJ.has(r.job) ? ' · gecikiyor' : ''}${kilit ? ' · kilitli' : ''}"><i class="pm-is-ayar" aria-hidden="true"></i>${kilit ? ic('lock', 'k') : ''}${etiket}</button>`;
  };
  const hayalet = m => (canliM[m] || []).filter(r => isFinite(r.C) && (!secJob || r.job === secJob)).map(r => `<i class="pm-is-canli" style="left:${r.S * px}px;width:${Math.max(3, (r.C - r.S) * px)}px" title="Canlı planda ${esc(r.id)} ${esc(fmtDT(D, r.S))}"></i>`).join('');
  const kapali = m => {
    const M = cx && cx.M[m]; if (!M) return '';
    let out = '', t = 0; const son = gunN * 24;
    for (const [a, b] of M.rw) { if (a > son) break; if (a > t) out += `<i class="pm-g-kapali" style="left:${t * px}px;width:${(Math.min(a, son) - t) * px}px"></i>`; t = Math.max(t, b); }
    if (t < son) out += `<i class="pm-g-kapali" style="left:${t * px}px;width:${(son - t) * px}px"></i>`;
    for (const d of S.down.filter(x => x.m === m)) out += `<i class="pm-g-ariza" style="left:${d.from * px}px;width:${(d.to - d.from) * px}px" title="Arıza/bakım ${esc(fmtDT(D, d.from))} → ${esc(fmtDT(D, d.to))}"></i>`;
    return out;
  };
  const termin = secJob ? (() => { const s = D.siparisler.find(z => z.id === secJob); const t = s && parseT(D, s.termin); return t != null ? `<i class="pm-g-termin" style="left:${t * px}px" title="Termin ${esc(s.termin)}"></i>` : ''; })() : '';
  const gunCizgi = Array.from({ length: gunN }, (_, d) => `<i class="pm-g-gunc" style="left:${d * 24 * px}px"></i>`).join('');
  const satir = (id, ad, alt) => {
    const u = p.util && p.util[id];
    return `<div class="pm-g-satir"><div class="pm-g-etiket"><b>${esc(id[0] === '@' ? id.slice(1) : id)}</b><span title="${esc(ad)}">${esc(ad)}${u && !dar() ? ` · ${yuzde(u.u)}` : ''}</span></div><div class="pm-g-serit" data-m="${esc(id)}" style="width:${W}px">${alt}${gunCizgi}<i class="pm-g-simdi" style="left:${7 * px}px"></i>${termin}${hayalet(id)}${(byM[id] || []).map(bar).join('')}</div></div>`;
  };
  let govde = '';
  for (const g of Object.keys(gruplar)) {
    if (U.grup && U.grup !== g) continue;
    const katli = (U.katli || []).includes(g);
    const gU = grupDoluluk(p).find(x => x.ad === g);
    govde += `<button type="button" class="pm-g-grup" data-act="g-katla" data-v="${esc(g)}" aria-expanded="${!katli}">${ic(katli ? 'chev-right' : 'down', 'k')}${esc(g)} <span class="pm-kucuk">${gruplar[g].length} tezgâh${gU ? ' · %' + Math.round(gU.u * 100) + ' dolu' : ''}</span></button>` + (katli ? '' : gruplar[g].map(m => satir(m.id, m.ad, kapali(m.id))).join(''));
  }
  if (fasonlar.length && (!U.grup || U.grup === '@fason')) govde += `<div class="pm-g-grup">fason</div>` + fasonlar.map(f => satir('@' + f.id, f.ad, '')).join('');
  if (U.yuk) govde += yukSatirlari(p, gunN, px, W);
  const gunler = Array.from({ length: gunN }, (_, d) => {
    const dy = cx && cx.days[d];
    const saatler = px >= 20 ? [6, 12, 18].map(h => `<span class="pm-g-saat" style="left:${h * px}px">${String(h).padStart(2, '0')}</span>`).join('') : '';
    return `<div class="pm-g-gun" style="left:${d * 24 * px}px;width:${24 * px}px" ${dy && dy.tatil ? 'data-tatil' : ''}>${px >= 4 ? esc(fmtDT(D, d * 24).slice(0, 9)) : esc(gunTarih(d).slice(8))}${dy && dy.tatil ? ' · tatil' : ''}${saatler}</div>`;
  }).join('');
  return `<div class="pm-gantt" tabindex="0" aria-label="Plan çizelgesi" data-px="${px}"><div class="pm-g-ic" style="width:calc(var(--pm-etiket) + ${W}px)"><div class="pm-g-ust"><div class="pm-g-kose">Tezgâh</div><div class="pm-g-zaman" style="width:${W}px">${gunler}</div></div>${govde}</div></div>`;
}

/* ---------- kaynak yükü ---------- */
function yukSerileri(p, gunN) {
  const cx = cxGercek(); if (!cx) return [];
  const u = newUse(cx); const fasL = {};
  for (const r of Object.values(p.ops)) {
    if (!isFinite(r.C)) continue;
    if (r.fas) { (fasL[r.m.slice(1)] = fasL[r.m.slice(1)] || []).push(r); continue; }
    const M = cx.M[r.m], o = cx.byId[r.id]; if (!M || !o) continue;
    addUse(cx, u, M, r, o.aparat);
  }
  const H = gunN * 24, out = [];
  const saatlik = (use, cap, ad, ipucu) => {
    const us = new Float32Array(H), cs = new Float32Array(H), as = new Uint8Array(H); let tepe = 0, asim = 0, kul = 0, kap = 0;
    for (let h = 0; h < H; h++) { let mu = 0, mc = 0, a = 0; for (let q = 0; q < 4; q++) { const k = h * 4 + q; const x = use(k), c = cap(k); if (x > mu) mu = x; if (c > mc) mc = c; if (x > c + 1e-6) a = 1; kul += x * SL; kap += c * SL; } us[h] = mu; cs[h] = mc; as[h] = a; if (mu > tepe) tepe = mu; asim += a; }
    out.push({ ad, ipucu, us, cs, as, tepe, asim, kul, kap });
  };
  saatlik(k => u.tot[k], k => cx.capTot[k], 'Operatör', 'Bütün operatörler: çalışan tezgâhların operatör oranı toplamı / vardiyadaki operatör');
  for (const g in cx.capG) saatlik(k => u.g[g][k], k => cx.capG[g][k], 'Yetkin · ' + g, `${g} grubunda yetkin operatör`);
  saatlik(k => u.ayar[k], k => cx.capAyar[k], 'Ayarcı', 'Aynı anda yapılan ayar / vardiyadaki ayarcı');
  for (const a in cx.AP) saatlik(k => u.ap[a][k], () => +cx.AP[a].adet || 1, 'Aparat · ' + a, cx.AP[a].ad);
  for (const f of cx.D.fasoncular || []) { const l = fasL[f.id] || []; if (!l.length) continue; saatlik(k => { const t = k * SL; return l.filter(r => r.S <= t && r.C > t).length; }, () => +f.kapasite || 1, 'Fason · ' + f.id, f.ad); }
  return out;
}
function yukSatirlari(p, gunN, px, W) {
  const sr = yukSerileri(p, gunN); if (!sr.length) return '';
  const Hs = 30;
  return `<div class="pm-g-grup">kaynak yükü</div>` + sr.map(s => {
    const mx = Math.max(1, s.tepe, ...s.cs);
    const y = v => (Hs - (v / mx) * (Hs - 3)).toFixed(1);
    let alan = `M0 ${Hs}`, cap = '', asim = '';
    for (let h = 0; h < s.us.length; h++) { alan += ` L${h * px} ${y(s.us[h])} L${(h + 1) * px} ${y(s.us[h])}`; cap += `${h ? ' L' : 'M'}${h * px} ${y(s.cs[h])} L${(h + 1) * px} ${y(s.cs[h])}`; if (s.as[h]) asim += `<rect x="${h * px}" y="0" width="${px}" height="${Hs}" class="pm-yuk-asim"/>`; }
    alan += ` L${s.us.length * px} ${Hs} Z`;
    const oran = s.kap > 0 ? s.kul / s.kap : 0;
    return `<div class="pm-g-satir pm-yuk-satir"><div class="pm-g-etiket" title="${esc(s.ipucu)}"><b>${esc(s.ad)}</b><span>${s.asim ? `<span class="pm-fark-kotu">${s.asim} sa aşım</span>` : `tepe ${sayi(s.tepe, 1)} · ${yuzde(oran)}`}</span></div><div class="pm-g-serit" style="width:${W}px"><svg class="pm-yuk" width="${W}" height="${Hs}" viewBox="0 0 ${W} ${Hs}" preserveAspectRatio="none" aria-label="${esc(s.ad)} yükü">${asim}<path class="pm-yuk-alan" d="${alan}"/><path class="pm-yuk-kap" d="${cap}"/></svg></div></div>`;
  }).join('');
}

/* ---------- denetçi: seçilen iş, sipariş ya da önizleme ---------- */
function denetci() {
  if (U.hamle) return hamlePaneli();
  const p = S.plan;
  if (U.secili && p.ops[U.secili]) return opDenetci(U.secili);
  if (U.secJob && S.D.siparisler.find(s => s.id === U.secJob)) return isDenetci(U.secJob);
  const yaz = yetkili('plan.yaz');
  const nasil = `<ul class="pm-olaylar">
    <li class="pm-olay" data-ton="bilgi">${ic('gantt', 'k')}<span class="pm-olay-metin"><b>Taşı.</b> ${yaz ? 'İşi sürükleyip başka tezgâha ya da saate bırakın. Dokunmatik ekranda işe dokunup "Uygun tezgâhlar"dan seçin.' : 'Taşıma planlamacının işidir.'}</span></li>
    <li class="pm-olay" data-ton="bilgi">${ic('sort', 'k')}<span class="pm-olay-metin"><b>Sırala.</b> Bir işi tezgâh kuyruğunda bir öne ya da bir arkaya alın; siparişi bütün adımlarıyla öne alın.</span></li>
    <li class="pm-olay" data-ton="bilgi">${ic('cpu', 'k')}<span class="pm-olay-metin"><b>Motor hakemdir.</b> Her hamle bütün kısıtlarla (vardiya, operatör, ayarcı, aparat, rota, fason) yeniden hesaplanır; sonucu önizlersiniz, siz uygularsınız.</span></li>
    <li class="pm-olay" data-ton="bilgi">${ic('lock', 'k')}<span class="pm-olay-metin"><b>Kilitle.</b> Taşınan iş kilitlenir; "İyileştir" çözümü kilitli işe dokunmaz.</span></li></ul>`;
  const uy = uyarilar(p);
  return panel('Seçim yok', `<p class="pm-alt">Bir iş ya da sipariş seçin.</p>${nasil}`) + (uy ? panel('Uyarılar', uy) : '');
}
function opDenetci(id) {
  const p = S.plan; const r = p.ops[id]; const cx = cxAl(); const D = S.D;
  const o = cx && cx.byId[id]; const s = D.siparisler.find(z => z.id === r.job) || {}; const j = p.J[r.job] || {};
  const yaz = yetkili('plan.yaz'); const kilit = S.locks[id];
  const q = Object.values(p.ops).filter(x => x.m === r.m && isFinite(x.C)).sort((a, b) => a.S - b.S); const i = q.findIndex(x => x.id === id);
  const komsu = q.slice(Math.max(0, i - 2), i + 3).map(x => `<li><button type="button" data-act="op" data-v="${esc(x.id)}" aria-current="${x.id === id}"><b class="mono">${q.indexOf(x) + 1}</b><span><span class="mono">${esc(x.job)}·${esc(x.id.slice(x.id.lastIndexOf('.') + 1))}</span><br><small class="pm-kucuk">${esc(fmtDT(D, x.S))}${x.su > 0 ? ' · ayar ' + saat(x.su) : ''}</small></span><span class="mono">${saat(x.C - x.S)}</span></button></li>`).join('');
  const alt = (o ? o.c : []).map(c => {
    const sure = c.fas ? 'fason' : saat(c.su + c.run);
    const simdi = r.m === c.m;
    return `<tr${simdi ? ' data-secili' : ''}>${td('Tezgâh', esc(tezgahAd(cx, c.m)))}${td('Süre', sure, 'pm-num')}${td('', simdi ? rozet('Planda', 'tamam') : dugme('Taşı', 'tasi', { kucuk: true, yetki: 'plan.yaz', veri: `data-v="${esc(id)}" data-m="${esc(c.m)}"`, ipucu: 'Önizle: motor bu tezgâhla yeniden hesaplar' }))}</tr>`;
  }).join('');
  const zincir = (cx && cx.jobs[r.job] ? cx.jobs[r.job].ops : []).map(x => { const z = p.ops[x.id]; return `<li><button type="button" data-act="op" data-v="${esc(x.id)}" aria-current="${x.id === id}"><b class="mono">${esc(x.k)}</b><span>${esc(x.ad)}<br><small class="pm-kucuk">${z ? esc(z.m.replace('@', 'fason ')) + ' · ' + esc(fmtDT(D, z.S)) : 'planlanmadı'}</small></span><span class="mono">${z ? saat(z.C - z.S) : '—'}</span></button></li>`; }).join('');
  const a = cx && ayristir(p, cx, r.job);
  const govde = `<dl class="pm-dl"><dt>Sipariş</dt><dd><b class="mono">${esc(r.job)}</b> · ${esc(urunAd(s.urun))} · ${s.adet} adet</dd><dt>Adım</dt><dd>${esc(o ? o.k + ' ' + o.ad : id)}</dd><dt>Tezgâh</dt><dd>${esc(tezgahAd(cx, r.m))}</dd><dt>Başla</dt><dd class="mono">${esc(fmtDT(D, r.S))}</dd>${r.su > 0 ? `<dt>Ayar biter</dt><dd class="mono">${esc(fmtDT(D, r.Su))} · ${saat(r.su)}${r.famHit ? ' · aynı aile' : ''}</dd>` : ''}<dt>Biter</dt><dd class="mono">${esc(fmtDT(D, r.C))}</dd><dt>Termin</dt><dd class="mono">${esc(s.termin || '—')} ${j.T > 0.01 ? rozet(saat(j.T) + ' gecikme', 'hata') : j.T != null ? rozet('Zamanında', 'tamam') : ''}</dd><dt>Bolluk</dt><dd>${r.sl == null ? '—' : r.sl <= 0.5 ? rozet('Kritik', 'hata') + ' kayarsa sipariş ya da sonraki iş gecikir' : saat(r.sl) + ' kayabilir'}</dd>${kilit ? `<dt>Kilit</dt><dd>${esc(kilit.m.replace('@', 'fason '))}${kilit.S > 7 ? ', en erken ' + esc(fmtDT(D, kilit.S)) : ', yalnız tezgâh'}</dd>` : ''}</dl>
    <div class="pm-neden">${ic('help', 'k')}<span><b>Neden bu saatte:</b> ${esc(nedenMetni(r))}</span></div>
    <div class="pm-dugmeler pm-hamleler">${kilit ? dugme('Kilidi aç', 'kilit-ac', { simge: 'lock', kucuk: true, yetki: 'plan.kilitle', veri: `data-v="${esc(id)}"` }) : dugme('Kilitle', 'kilitle', { simge: 'lock', kucuk: true, yetki: 'plan.kilitle', veri: `data-v="${esc(id)}"`, ipucu: 'Bu tezgâhta, bu saatten erken başlamasın' })}${dugme('Siparişi öne al', 'one-al', { simge: 'up', kucuk: true, yetki: 'plan.yaz', veri: `data-v="${esc(r.job)}"` })}</div>
    ${!r.fas ? `<div class="pm-bolum"><h3>Tezgâh kuyruğu · ${esc(r.m)}</h3><ul class="pm-zincir">${komsu}</ul><div class="pm-dugmeler">${dugme('Bir öne', 'sira', { simge: 'up', kucuk: true, yetki: 'plan.yaz', veri: `data-v="${esc(id)}" data-yon="-1"`, cls: i > 0 ? '' : 'pm-pasif' })}${dugme('Bir arkaya', 'sira', { simge: 'down', kucuk: true, yetki: 'plan.yaz', veri: `data-v="${esc(id)}" data-yon="1"`, cls: i < q.length - 1 ? '' : 'pm-pasif' })}</div></div>` : ''}
    ${alt ? `<div class="pm-bolum"><h3>Uygun tezgâhlar</h3><div class="tc-tablo-kap"><table class="tc-tablo"><tbody>${alt}</tbody></table></div></div>` : ''}
    ${a && a.tam ? `<div class="pm-bolum"><h3>Siparişin süresi nereye gitti</h3>${ayrisimCubugu(a, true)}</div>` : ''}
    <div class="pm-bolum"><h3>Siparişin adımları</h3><ul class="pm-zincir">${zincir}</ul></div>`;
  return panel(`<span class="mono">${esc(r.job)}</span> · adım ${esc(o ? o.k : '')}`, govde, dugme('', 'secim-temizle', { simge: 'x', hayalet: true, kucuk: true, ad: 'Kapat' }));
}
function isDenetci(jid) {
  const p = S.plan; const cx = cxAl(); const D = S.D; const s = D.siparisler.find(z => z.id === jid); const j = p.J[jid] || {};
  const a = cx && ayristir(p, cx, jid); const lbC = p.lbC && p.lbC[jid];
  const zincir = (cx && cx.jobs[jid] ? cx.jobs[jid].ops : []).map(x => { const z = p.ops[x.id]; return `<li><button type="button" data-act="op" data-v="${esc(x.id)}"><b class="mono">${esc(x.k)}</b><span>${esc(x.ad)}<br><small class="pm-kucuk">${z ? esc(z.m.replace('@', 'fason ')) + ' · ' + esc(fmtDT(D, z.S)) + (S.locks[x.id] ? ' · kilitli' : '') : 'planlanmadı'}</small></span><span class="mono">${z ? saat(z.C - z.S) : '—'}</span></button></li>`; }).join('');
  const onc = yetkili('veri.yaz') ? `<select class="tc-alan-kutu pm-oto" data-chg="oncelik" data-v="${esc(jid)}" aria-label="Öncelik">${[1, 2, 3].map(k => `<option value="${k}" ${s.oncelik === k ? 'selected' : ''}>${ONCELIK[k]}</option>`).join('')}</select>` : oncelikRozet(s.oncelik);
  const govde = `<dl class="pm-dl"><dt>Ürün</dt><dd>${esc(urunAd(s.urun))} · ${s.adet} adet</dd><dt>Öncelik</dt><dd>${onc}</dd><dt>Termin</dt><dd class="mono">${esc(s.termin || '—')}</dd><dt>Planlanan bitiş</dt><dd class="mono">${j.C != null ? esc(fmtDT(D, j.C)) : '—'} ${j.T > 0.01 ? rozet(saat(j.T) + ' gecikme', 'hata') : j.T != null ? rozet('Zamanında', 'tamam') : rozet('Planlanmadı', 'hata')}</dd><dt>Kapasitesiz en erken</dt><dd class="mono">${lbC != null && isFinite(lbC) ? esc(fmtDT(D, lbC)) : '—'}${lbC != null && j.C != null && isFinite(lbC) ? ` <span class="pm-kucuk">(plan ${saat(j.C - lbC)} sonra)</span>` : ''}</dd>${s.serbest ? `<dt>Serbest</dt><dd class="mono">${esc(s.serbest)}</dd>` : ''}</dl>
    <div class="pm-dugmeler pm-hamleler">${dugme('Siparişi öne al', 'one-al', { simge: 'up', kucuk: true, yetki: 'plan.yaz', veri: `data-v="${esc(jid)}"`, ipucu: 'Bütün adımlar en erken başlayabilecekleri anın önüne alınır; motor gerisini hesaplar' })}${dugme('Düzenle', 'duzenle', { simge: 'edit', kucuk: true, veri: `data-tur="siparis" data-v="${esc(jid)}"` })}</div>
    ${a && a.tam ? `<div class="pm-bolum"><h3>Süre nereye gitti</h3>${ayrisimCubugu(a, true)}<p class="pm-kucuk">Son biten adımdan geriye, onu bekleten öncüle doğru yürünür. Bekleme sebebi motorun kaydettiği nedendir.</p></div>` : ''}
    <div class="pm-bolum"><h3>Adımlar</h3><ul class="pm-zincir">${zincir}</ul></div>`;
  return panel(`<span class="mono">${esc(jid)}</span>`, govde, dugme('', 'secim-temizle', { simge: 'x', hayalet: true, kucuk: true, ad: 'Kapat' }));
}
function hamlePaneli() {
  const h = U.hamle; const o = h.plan.ozet, e = S.plan.ozet; const D = S.D;
  const satir = (ad, a, b, k = 1, fmt = x => sayi(x, k)) => `<tr><th scope="row">${ad}</th><td class="pm-num">${fmt(b)}</td><td class="pm-num">${fmt(a)}</td><td class="pm-num">${fark(a, b, k) || '<span class="pm-kucuk">aynı</span>'}</td></tr>`;
  const hedef = h.hedef && h.plan.ops[h.hedef];
  const yeniFail = (h.plan.fail || []).filter(x => !(S.plan.fail || []).includes(x));
  const deg = h.degisen.slice().sort((a, b) => Math.abs(b.d) - Math.abs(a.d));
  const govde = `<div class="tc-tablo-kap"><table class="tc-tablo pm-hamle-tablo"><thead><tr><th></th><th class="pm-num">Şimdi</th><th class="pm-num">Hamleyle</th><th class="pm-num">Fark</th></tr></thead><tbody>
    ${satir('Ağırlıklı gecikme (sa)', o.wT, e.wT)}${satir('Geciken sipariş', o.late, e.late, 0)}${satir('Toplam ayar (sa)', o.suH, e.suH)}${satir('Son bitiş (sa)', o.Cmax - 7, e.Cmax - 7)}${o.chg != null ? satir('Canlıya göre değişen', o.chg, e.chg, 0) : ''}</tbody></table></div>
    ${h.olayBekle ? `<div class="pm-olay-kiyas"><div><span class="pm-kucuk">${h.olay && h.olay.tip === 'acil' ? 'Sıranın sonuna eklenirse' : 'Sıra korunursa'}</span><b class="mono">${saat(h.olayBekle.wT)}</b><span class="pm-kucuk">${h.olayBekle.late} geciken</span></div><div data-ton="tamam"><span class="pm-kucuk">Motor toparlarsa</span><b class="mono">${saat(o.wT)}</b><span class="pm-kucuk">${o.late} geciken</span></div></div><p class="pm-kucuk">Önce işlerin sırası korunarak olay işlendi; sonra motor kısa süre toparladı. ${h.derin && !h.derin.ayni ? `Motor ${sayi(h.derin.sn, 1)} sn daha arayıp ${saat(h.derin.once)} olan sonucu ${saat(o.wT)}'e indirdi. ` : ''}Uygula toparlanmış planı yazar${h.olay && h.olay.tip !== 'ariza' && !h.yeniSip ? ' ve olayı kalıcı kaydeder' : ''}.</p>${h.olay && h.olay.tip === 'malzeme' && S.w.mat === 'uyari' ? `<div class="pm-serit" data-ton="uyari">${ic('box', 'k')}<span class="pm-serit-metin">Malzeme kipi <b>uyarı</b>: malzemesi gelmeyen iş planda yine başlar, saatler değişmez. Malzeme uyarısı ${(S.plan.warn || []).filter(w => w.t === 'malzeme').length} → ${(h.plan.warn || []).filter(w => w.t === 'malzeme').length}. İşin malzeme gelene kadar beklemesini isterseniz Kısıtlar'da malzemeyi sert yapın.</span></div>` : ''}` : ''}
    ${hedef ? `<div class="pm-neden">${ic('help', 'k')}<span><b class="mono">${esc(hedef.id)}</b> ${esc(tezgahAd(cxAl(), hedef.m))}, ${esc(fmtDT(D, hedef.S))} → ${esc(fmtDT(D, hedef.C))}. ${esc(nedenMetni(hedef))}</span></div>` : ''}
    ${h.hedefJob ? (() => { const a = S.plan.J[h.hedefJob] || {}, b = h.plan.J[h.hedefJob] || {}; const iyi = (b.C ?? 1e9) < (a.C ?? 1e9) - 0.05; return `<div class="pm-serit" data-ton="${iyi ? 'tamam' : 'uyari'}">${ic(iyi ? 'check' : 'alert', 'k')}<span class="pm-serit-metin"><b class="mono">${esc(h.hedefJob)}</b> bitişi ${a.C != null ? esc(fmtDT(D, a.C)) : '—'} → ${b.C != null ? esc(fmtDT(D, b.C)) : '—'}. ${iyi ? '' : 'Öne almak bu siparişi hızlandırmıyor; darboğazdaki sıra değişince başka işler önüne geçiyor.'}${h.plan.ozet.wT > S.plan.ozet.wT * 1.5 + 5 ? ' Toplam gecikme belirgin artıyor; uygularsanız kilitleri koruyarak Çöz → İyileştir ile toparlayın.' : ''}</span></div>`; })() : ''}
    ${yeniFail.length ? `<div class="pm-serit" data-ton="hata">${ic('alert', 'k')}<span class="pm-serit-metin">${yeniFail.length} işlem bu hamleyle yerleşemiyor: ${esc(yeniFail.slice(0, 4).join(', '))}</span></div>` : ''}
    <div class="pm-bolum"><h3>Bitişi değişen siparişler (${deg.length})</h3>${deg.length ? `<ul class="pm-degisen">${deg.slice(0, 14).map(x => `<li><b class="mono">${esc(x.j)}</b><span class="mono pm-kucuk">${x.once != null ? esc(fmtDT(D, x.once).slice(0, 15)) : '—'} → ${x.sonra != null ? esc(fmtDT(D, x.sonra).slice(0, 15)) : 'planlanmadı'}</span><span class="${x.d < 0 ? 'pm-fark-iyi' : 'pm-fark-kotu'} mono">${x.d > 0 ? '+' : '−'}${sayi(Math.abs(x.d), 1)} sa</span>${x.gec ? rozet(x.gec, x.gec === 'gecikmeye düştü' ? 'hata' : 'tamam') : ''}</li>`).join('')}</ul>${deg.length > 14 ? `<p class="pm-kucuk">${deg.length - 14} sipariş daha.</p>` : ''}` : '<p class="pm-alt">Hiçbir siparişin bitişi değişmedi.</p>'}</div>
    <p class="pm-kucuk">${h.kaynak === 'elle' ? `Motor ${sayi(h.ms, 0)} ms'de bütün kısıtlarla yeniden hesapladı.${h.toparla > 0.05 ? ` Taşınan işler yerinde tutulup çevredeki işler toparlandı (${saat(h.toparla)} kazanç).` : ''} Sürüklenen iş kilitlenir.` : `Motor bütün kısıtlarla yeniden hesapladı.${h.ekMesai ? ' Uygularsanız önerilen ek mesai de takvime yazılır.' : ''}`}</p>
    <div class="pm-dugmeler">${dugme('Vazgeç', 'hamle-vazgec')}${dugme('Uygula', 'hamle-uygula', { birincil: true, simge: 'check' })}</div>`;
  const ekip = h.ekip ? `<div class="pm-bolum"><h3>Ekip: kim ne kattı</h3>${ekipListe(h.ekip.adim)}</div>` : '';
  return panel('Hamle önizlemesi', `<p class="pm-alt"><b>${esc(h.ad)}</b></p>${govde}${ekip}`);
}

/* ---------- hamle: elle değişiklik, motorun hakemliği ---------- */
function opKaydi(r) { return { id: r.id, job: r.job, m: r.m, S: r.S, Su: r.Su, C: r.C, su: r.su, run: r.run, lot1: r.lot1, fas: r.fas ? 1 : 0, why: r.why || null, sl: r.sl, famHit: !!r.famHit, pin: r.pin ? 1 : 0, done: r.done ? 1 : 0, act: r.act ? 1 : 0 }; }
function planKaydi(p, st, ref) {
  const ef = evaluate(p, st, ref, false);
  const ops = {}; for (const id in p.ops) ops[id] = opKaydi(p.ops[id]);
  const J = {}; for (const k in ef.J) { const x = ef.J[k]; J[k] = { C: isFinite(x.C) ? x.C : null, T: x.T }; }
  const util = {}; for (const m in ef.util) util[m] = ef.util[m];
  return { ops, fail: p.fail || [], ozet: { wT: ef.wT, onT: ef.onT, late: ef.late, n: ef.n, suH: ef.suH, suN: ef.suN, famN: ef.famN, Cmax: ef.Cmax, tl: ef.tl, wB: ef.wB, chg: ref ? ef.chg : null }, J, util, warn: ef.warn.slice(0, 300) };
}
function hamleDene(mods, ad, kilitler = [], kaldir = [], ayar = {}) {
  if (!yetkili('plan.yaz')) { bildir('Yetkiniz yok (plan.yaz).', 'hata'); return; }
  if (!S.plan || calisan) return;
  const t0 = performance.now();
  const st = stOf();
  for (const [id] of mods) delete st.locks[id];
  for (const id of kaldir) delete st.locks[id];
  for (const [id, m, t] of kilitler) st.locks[id] = { m, S: t };
  let p;
  let toparla = 0;
  try {
    const cx = compile(st); p = lnsDecode(st, { ops: S.plan.ops, fail: S.plan.fail || [] }, mods, cx, true, true);
    /* Kod çözücü işleri anahtar sırasıyla işler; öncülü geç kalan iş kuyrukta öndekileri bekletebilir.
       Anahtarlar gerçek başlama saatleriyle yenilenip yeniden çözülür, iyileştikçe tekrarlanır. */
    const tas = +cx.A.tasimaSaat || 0, tasinan = new Set(mods.map(x => x[0]));
    for (let i = 0; i < 4; i++) {
      const yeni = [];
      for (const r of Object.values(p.ops)) {
        if (tasinan.has(r.id) || r.fas || !r.why || r.why.t !== 'tezgah') continue;
        const o = cx.byId[r.id]; let hazir = 7; const j = cx.jobs[r.job]; if (j.rel != null) hazir = Math.max(hazir, j.rel);
        for (const [pid, ty] of o.pr) { const q = p.ops[pid]; if (q) hazir = Math.max(hazir, (ty === 'o' && !q.fas ? q.lot1 : q.C) + (q.fas ? 0 : tas)); }
        if (hazir < r.S - 1) yeni.push([r.id, r.m, hazir]);
      }
      if (!yeni.length) break;
      const q = lnsDecode(st, p, yeni, cx, true, true);
      if (cmpEv(evaluate(q, st, null, true), evaluate(p, st, null, true)) > 0) p = q; else break;
    }
    slack(p, cx);
    /* Sıra sabit kod çözme, taşınan işin çevresinde gereksiz boşluk bırakabilir (ör. fason çıkışı kaçınca kuyruk bekler).
       Taşınan işler yerinde tutulup motor çevreyi kısa süre toparlar; yalnız daha iyiyse alınır. */
    if (mods.length) {
      const stR = { ...st, locks: { ...st.locks } };
      for (const [id] of mods) { const r = p.ops[id]; if (r) stR.locks[id] = { m: r.m, S: r.S }; }
      const cxR = compile(stR); const pR = lnsDecode(stR, p, [], cxR, true);
      const L = lns(stR, pR, null, { ms: 450, seed: 7, free: true });
      const e0 = evaluate(p, st, null, true);
      /* toparlama taşınan işin önüne başka iş koymuş olabilir: taşınan işler eski yerlerine anahtarlanıp yeniden çözülür */
      const geri = mods.map(([id]) => p.ops[id] && [id, p.ops[id].m, p.ops[id].S - 1e-3]).filter(Boolean);
      const p2 = lnsDecode(stR, L.plan, geri, cxR, true, true); slack(p2, cxR);
      const e1 = evaluate(p2, st, null, true);
      const yerinde = geri.every(([id]) => { const a = p.ops[id], b = p2.ops[id]; return a && b && b.S <= a.S + 0.25; });
      if (yerinde && cmpEv(e1, e0) > 0 && (p2.fail || []).length <= (p.fail || []).length) { toparla = e0.wT - e1.wT; p = p2; }
    }
  }
  catch (e) { bildir('Hamle hesaplanamadı: ' + e.message, 'hata'); return; }
  hamleKur(p, st, ad, { hedef: mods.length === 1 ? mods[0][0] : null, toparla, ms: performance.now() - t0 });
  if (ayar.birlestir) U.hamle.birlestir = ayar.birlestir;
  if (!ayar.sessiz) render();
}
/* Önizleme her kaynaktan aynı biçimde kurulur: elle hamle, ek mesai adayı, dış çözücü önerisi. */
function hamleKur(p, st, ad, o = {}) {
  const canli = canliSen();
  const k = planKaydi(p, st, canli && canli.plan ? { ops: canli.plan.ops } : null);
  const degisen = [];
  for (const j of Object.keys(k.J)) {
    const a = S.plan.J[j] ? S.plan.J[j].C : null, b = k.J[j].C;
    if (a == null && b == null) continue;
    const d = (b == null ? 1e4 : b) - (a == null ? 1e4 : a);
    if (Math.abs(d) < 0.05) continue;
    const ta = S.plan.J[j] ? S.plan.J[j].T : null, tb = k.J[j].T;
    const gec = !S.plan.J[j] ? 'yeni sipariş' : (ta == null || ta > 0.01) && tb != null && tb <= 0.01 ? 'zamanına girdi' : (ta != null && ta <= 0.01) && (tb == null || tb > 0.01) ? 'gecikmeye düştü' : '';
    degisen.push({ j, once: a, sonra: b, d, gec });
  }
  U.hamle = { ad, plan: { ...k, lb: S.plan.lb, lbC: S.plan.lbC, ilk: S.plan.ilk, gunluk: S.plan.gunluk }, locks: st.locks, degisen, ms: o.ms || 0, toparla: o.toparla || 0, hedef: o.hedef || null, dv: S.dataVer, ekMesai: o.ekMesai || null, kaynak: o.kaynak || 'elle' };
  U.secili = U.hamle.hedef; U.gKoru = true;
}
function hamleUygula(sessiz) {
  const h = U.hamle; if (!h) return;
  if (calisan && U.ilerleme && U.ilerleme.olay) calisan.bitir();
  if (h.dv !== S.dataVer) { U.hamle = null; render(); bildir('Veri değişti; hamleyi yeniden deneyin.', 'hata'); return; }
  planGeri.push({ plan: S.plan, locks: S.locks, guncel: planGuncel(), ekMesai: h.ekMesai ? S.ekMesai : null }); if (planGeri.length > 20) planGeri.shift();
  const once = S.plan.ozet;
  if (h.ekMesai) S.ekMesai = h.ekMesai;
  if (h.ariza) { S.down.push({ m: h.ariza.m, from: h.ariza.from, to: h.ariza.to }); S.down.sort((x, y) => x.from - y.from); }
  if (h.yeniSip) S.D.siparisler.push(h.yeniSip);
  else if (h.olay && h.olay.tip !== 'ariza') (S.olaylar = S.olaylar || []).push(h.olay);
  /* sipariş nesneleri kopyalanarak değişir: sepetteki eski anlık görüntüler bozulmasın */
  if (h.havuzdan) S.D.siparisler = S.D.siparisler.map(x => h.havuzdan.includes(x.id) ? { ...x, havuz: false } : x);
  if (h.havuza) S.D.siparisler = S.D.siparisler.map(x => h.havuza.includes(x.id) ? { ...x, havuz: true } : x);
  if (h.gercek) S.gercek = h.gercek;
  if (h.oncelik) S.D.siparisler = S.D.siparisler.map(x => x.id === h.oncelik.id ? { ...x, oncelik: h.oncelik.v } : x);
  if (h.bolme) S.D.siparisler = S.D.siparisler.flatMap(x => x.id === h.bolme.eski ? h.bolme.yeni.map(clone) : [x]);
  S.locks = Object.fromEntries(Object.entries(h.locks).filter(([, l]) => !l.gecici)); S.dataVer++;
  S.plan = { ...h.plan, dataVer: S.dataVer, kim: kim().ad, zaman: Date.now(), kaynak: h.kaynak === 'elle' ? 'elle' : h.kaynak === 'ekip' ? 'ekip' : 'oneri', oneriKaynak: h.kaynak, ekip: h.ekip || null, oncekiOzet: once, kapali: S.kapali.slice() };
  iz('Plan elle değişti', `${h.ad} · gecikme ${sayi(once.wT, 1)} → ${sayi(S.plan.ozet.wT, 1)} sa`);
  U.hamle = null; kaydet(); if (sessiz) return; render();
  bildir(`Uygulandı: gecikme ${saat(once.wT)} → ${saat(S.plan.ozet.wT)}.`, 'tamam', { metin: 'Geri al', act: 'plan-geri' });
}
function oneAlAdaylari(jid) {
  const cx = cxAl(); if (!cx || !cx.jobs[jid] || !yetkili('plan.yaz')) return [];
  const st = stOf(); const HT = lbHeadsTails(st, cx); const p = S.plan;
  const byM = {}; for (const r of Object.values(p.ops)) if (isFinite(r.C)) (byM[r.m] = byM[r.m] || []).push(r);
  for (const m in byM) byM[m].sort((a, b) => a.S - b.S);
  const BEKLEME = new Set(['tezgah', 'personel', 'yetkin', 'ayarci', 'aparat']);
  const modsOf = (hizli, yalnizBekleyen) => cx.jobs[jid].ops.map(o => {
    const r = p.ops[o.id]; if (!r || r.done || r.act || !isFinite(HT.head[o.id])) return null;
    if (yalnizBekleyen && !(r.why && BEKLEME.has(r.why.t))) return null;
    let m = r.m;
    if (hizli && !r.fas && !S.locks[o.id]) { const ms = o.c.filter(c => !c.fas && !c.opt); if (ms.length) m = ms.reduce((a, b) => (b.run + b.su < a.run + a.su ? b : a)).m; }
    const tgt = Math.max(7, HT.head[o.id]); const q = (byM[m] || []).filter(z => z.id !== o.id);
    let i = q.findIndex(z => z.S >= tgt - 1e-9); if (i < 0) i = q.length;
    while (i > 0 && S.locks[q[i - 1].id] && q[i - 1].S >= tgt) i--;
    const lo = i > 0 ? q[i - 1].S : 7, hi = i < q.length ? q[i].S : lo + 48;
    return [o.id, m, i < q.length ? Math.min(hi - 1e-3, Math.max(lo, tgt)) : Math.max(lo, tgt) + 1e-3];
  }).filter(Boolean);
  const c0 = S.plan.J[jid] ? (S.plan.J[jid].C ?? 1e9) : 1e9; const out = [];
  for (const [hizli, yb, ad] of [[false, true, 'yalnız kaynak bekleyen adımlar'], [false, false, 'bütün adımlar, aynı tezgâhlarda'], [true, false, 'bütün adımlar, en hızlı tezgâhlarda']]) {
    const mods = modsOf(hizli, yb); if (!mods.length) continue;
    U.hamle = null; hamleDene(mods, `${jid} öne alındı (${ad})`, [], [], { sessiz: true });
    const h = U.hamle; U.hamle = null; if (!h) continue;
    const c = h.plan.J[jid] ? (h.plan.J[jid].C ?? 1e9) : 1e9;
    h.hedef = null; h.hedefJob = jid; out.push({ c, h, iyi: c < c0 - 0.05 });
  }
  return out;
}
/* Siparişi öne al: lns'teki zincir hamlesinin aynısı; her adım kapasitesiz en erken başlama anının hemen önüne,
   aynı tezgâhta ya da en hızlı tezgâhta denenir; sipariş için iyi olan seçilir, önizlemede bedeli görünür. */
function oneAl(jid) {
  const l = oneAlAdaylari(jid).filter(x => !x.bolme);
  let en = null;
  for (const x of l) if (!en || (x.iyi && !en.iyi) || (x.iyi === en.iyi && x.h.plan.ozet.wT < en.h.plan.ozet.wT - 0.05)) en = x;
  if (!en) { U.hamle = null; render(); bildir('Öne alınacak adım yok.'); return; }
  U.hamle = en.h; U.secJob = jid; U.secili = null; render();
}

/* ---------- süre ayrıştırması: siparişin bitişini belirleyen zincir ---------- */
const KAT = {
  isleme: ['İşleme', 'var(--k-isleme)'], ayar: ['Ayar', 'var(--k-ayar)'], kapali: ['Tezgâh kapalı (vardiya dışı, tatil)', 'var(--k-kapali)'],
  tezgah: ['Tezgâh dolu bekledi', 'var(--k-tezgah)'], personel: ['Operatör bekledi', 'var(--k-personel)'], ayarci: ['Ayarcı bekledi', 'var(--k-ayarci)'],
  aparat: ['Aparat bekledi', 'var(--k-aparat)'], ariza: ['Arıza, bakım', 'var(--k-ariza)'], tasima: ['Taşıma', 'var(--k-tasima)'],
  fason: ['Fasonda', 'var(--k-fason)'], fasonBek: ['Fason çıkışı ya da kapasitesi bekledi', 'var(--k-fasonbek)'], rota: ['Son parti kuralı', 'var(--k-rota)'],
  baslangic: ['Başlangıç koşulu (serbest, malzeme, NC programı, kilit)', 'var(--k-bas)'],
};
const NEDEN_KAT = { tezgah: 'tezgah', personel: 'personel', yetkin: 'personel', ayarci: 'ayarci', aparat: 'aparat', ariza: 'ariza', 'fason-kap': 'fasonBek', 'fason-cikis': 'fasonBek', serbest: 'baslangic', malzeme: 'baslangic', program: 'baslangic', kilit: 'baslangic', oneri: 'baslangic' };
function ayristir(p, cx, jid) {
  const j = cx.jobs[jid]; if (!j || !j.ops.length) return null;
  const rs = j.ops.map(o => p.ops[o.id]);
  if (rs.some(r => !r || !isFinite(r.C))) return { tam: false };
  const tas = +cx.A.tasimaSaat || 0, now = 7;
  const seg = {}, kaynak = [];
  const ekle = (k, v) => { if (v > 1e-6) seg[k] = (seg[k] || 0) + v; };
  const bekle = (w, r, v) => {
    if (v <= 1e-6) return;
    let k = NEDEN_KAT[w.t];
    if (!k) k = w.t === 'rota' && w.o === 2 ? 'rota' : 'kapali';
    ekle(k, v);
    const M = cx.M[r.m]; const o = cx.byId[r.id];
    const ad = k === 'tezgah' ? r.m : k === 'personel' ? 'Operatör · ' + (M ? M.grup : '') : k === 'ayarci' ? 'Ayarcı' : k === 'aparat' ? 'Aparat · ' + (o && o.aparat) : k === 'fasonBek' ? 'Fason · ' + r.m.slice(1) : k === 'ariza' ? 'Arıza · ' + r.m : null;
    if (ad) kaynak.push([k, ad, v]);
  };
  let r = rs.reduce((a, b) => (b.C > a.C ? b : a)); const C = r.C; let son = C;
  for (let g = 0; r && g < 200; g++) {
    const o = cx.byId[r.id]; const bas = r.S, bit = Math.max(bas, son);
    if (r.fas) ekle('fason', bit - bas);
    else {
      const M = cx.M[r.m]; const suSon = Math.min(Math.max(r.Su, bas), bit);
      if (M) { const ay = workIn(M.sw, bas, suSon); ekle('ayar', ay); ekle('kapali', suSon - bas - ay); const is = workIn(M.rw, suSon, bit); ekle('isleme', is); ekle('kapali', bit - suSon - is); }
      else ekle('isleme', bit - bas);
    }
    let pr = null, prT = -Infinity, prSon = 0;
    for (const [pid, ty] of o.pr) { const q = p.ops[pid]; if (!q) continue; const e = ty === 'o' && !q.fas ? q.lot1 : q.C; const t = e + (q.fas ? 0 : tas); if (t > prT) { prT = t; pr = q; prSon = e; } }
    const w = r.why || {};
    if (pr) {
      const tp = Math.max(0, Math.min(prT - prSon, bas - prSon));
      ekle('tasima', tp);
      bekle(w, r, bas - prT);
      son = Math.min(prSon, bas);
      r = pr; continue;
    }
    const rel = j.rel != null && j.rel > now ? Math.min(j.rel, bas) : now;
    ekle('baslangic', rel - now);
    bekle(w.t === 'serbest' ? { t: 'simdi' } : w, r, bas - rel);
    break;
  }
  return { tam: true, seg, kaynak, C, toplam: C - now };
}
function ayrisimCubugu(a, lejantli, olcek) {
  const top = olcek || a.toplam || 1;
  const sira = Object.keys(KAT).filter(k => a.seg[k] > 0.01);
  const cubuk = `<div class="pm-ay-yol" role="img" aria-label="${esc(sira.map(k => KAT[k][0] + ' ' + sayi(a.seg[k], 1) + ' sa').join(', '))}">${sira.map(k => `<i style="width:${(a.seg[k] / top) * 100}%;--c:${KAT[k][1]}" title="${esc(KAT[k][0])}: ${sayi(a.seg[k], 1)} sa"></i>`).join('')}</div>`;
  if (!lejantli) return cubuk;
  return `${cubuk}<ul class="pm-ay-lejant">${sira.sort((x, y) => a.seg[y] - a.seg[x]).map(k => `<li><i style="--c:${KAT[k][1]}"></i><span>${esc(KAT[k][0])}</span><b class="mono">${saat(a.seg[k])}</b><span class="mono pm-kucuk">${yuzde(a.seg[k] / (a.toplam || 1))}</span></li>`).join('')}</ul>`;
}

/* ---------- Planın iç yüzü ---------- */
function sAnaliz() {
  if (!S.plan) return `<div class="pm-bos">${ic('chart', 'b')}<strong>İç yüz için plan gerekir</strong>${dugme('Çöz', 'coz', { birincil: true, simge: 'play', yetki: 'plan.yaz', veri: 'data-v="sifir"' })}</div>`;
  const cx = cxAl(); const p = S.plan; const D = S.D;
  if (!cx) return '<p class="pm-alt">Veri derlenemedi.</p>';
  const l = D.siparisler.map(s => ({ s, j: p.J[s.id] || {}, a: ayristir(p, cx, s.id) })).filter(x => x.a && x.a.tam)
    .sort((a, b) => ((b.j.T || 0) * (PW[b.s.oncelik] || 1)) - ((a.j.T || 0) * (PW[a.s.oncelik] || 1)) || b.a.C - a.a.C);
  const olcek = Math.max(24, ...l.map(x => Math.max(x.a.toplam, (parseT(D, x.s.termin) ?? 7) - 7)));
  const satirlar = l.map(x => {
    const t = parseT(D, x.s.termin); const lb = p.lbC && p.lbC[x.s.id];
    return `<div class="pm-ay-satir"><button type="button" class="pm-ay-ad" data-act="sec-is-masa" data-v="${esc(x.s.id)}"><b class="mono">${esc(x.s.id)}</b><span class="pm-kucuk">${esc(urunAd(x.s.urun))}</span></button>
      <div class="pm-ay-kap">${ayrisimCubugu(x.a, false, olcek)}${t != null ? `<b class="pm-ay-isaret pm-ay-termin" style="left:${((t - 7) / olcek) * 100}%" title="Termin ${esc(x.s.termin)}"></b>` : ''}${lb != null && isFinite(lb) ? `<b class="pm-ay-isaret pm-ay-lb" style="left:${((lb - 7) / olcek) * 100}%" title="Kapasitesiz en erken bitiş ${esc(fmtDT(D, lb))}"></b>` : ''}</div>
      <span class="pm-num mono">${x.j.T > 0.01 ? `<span class="pm-fark-kotu">${saat(x.j.T)}</span>` : '<span class="pm-kucuk">zamanında</span>'}</span></div>`;
  }).join('');
  const toplam = { seg: {}, toplam: 0 };
  const kaynak = {};
  for (const x of l) { for (const k in x.a.seg) toplam.seg[k] = (toplam.seg[k] || 0) + x.a.seg[k]; toplam.toplam += x.a.toplam; for (const [k, ad, v] of x.a.kaynak) { const z = (kaynak[ad] = kaynak[ad] || { k, ad, v: 0, sip: new Set(), gec: 0 }); z.v += v; z.sip.add(x.s.id); if (x.j.T > 0.01) z.gec += v; } }
  const bekleme = ['tezgah', 'personel', 'ayarci', 'aparat', 'ariza', 'fasonBek', 'rota'].reduce((a, k) => a + (toplam.seg[k] || 0), 0);
  const darbogaz = Object.values(kaynak).sort((a, b) => b.gec - a.gec || b.v - a.v).slice(0, 12);
  const ops = Object.values(p.ops);
  const tezgahlar = D.tezgahlar.map(m => { const u = (p.util || {})[m.id] || {}; const l2 = ops.filter(r => r.m === m.id); const z = kaynak[m.id]; return { m, u: u.u || 0, n: l2.length, su: l2.reduce((a, r) => a + r.su, 0), kritik: l2.filter(r => r.sl != null && r.sl <= 0.5).length, bek: z ? z.v : 0, gec: z ? z.gec : 0, sip: z ? z.sip.size : 0 }; }).sort((a, b) => b.gec - a.gec || b.bek - a.bek || b.u - a.u);
  const yuk = yukSerileri(p, Math.min(HDAYS, Math.ceil((p.ozet.Cmax || 24) / 24) + 1));
  const g = p.gunluk;
  const gunluk = g ? `<ol class="pm-gunluk"><li><span class="mono">0,0 sn</span><span><b>${esc(g.ilkAd)}</b></span><span class="mono">${saat(g.ilk.wT)}</span></li>${(g.adim || []).map(x => `<li><span class="mono">${sayi(x.sn, 1)} sn</span><span>${esc(gunlukMetni(x))}</span><span class="mono">${saat(x.wT)} ${x.dW > 0.05 ? `<span class="pm-fark-iyi">−${sayi(x.dW, 1)}</span>` : ''}</span></li>`).join('')}<li><span class="mono">${sayi(g.sn, 1)} sn</span><span><b>Son plan</b> · ${sayi(g.dec, 0)} aday plan denendi, ${(g.adim || []).length} kabul</span><span class="mono">${saat(p.ozet.wT)}</span></li></ol>` : '<p class="pm-alt">Bu plan elle değişti ya da günlük yok. Motorla çözünce burada adım adım görünür.</p>';
  const bedel = S.bedel && S.bedel.dataVer === S.dataVer ? S.bedel : null;
  const bedelL = bedel ? bedel.liste.filter(x => x.dW > bedelEsik(bedel)).sort((a, b) => b.dW - a.dW).slice(0, 8) : [];
  const enCok = bedelL.length ? bedelL[0].dW : 1;
  return `<div class="pm-sayilar">${sayiKart('Ortalama tedarik süresi', saat(l.length ? toplam.toplam / l.length : null), '', 'clock', 'plan başından sipariş bitişine')}${sayiKart('İşleme payı', yuzde(toplam.toplam ? (toplam.seg.isleme || 0) / toplam.toplam : null), '', 'cpu', 'sürenin tezgâhta talaş kaldırarak geçen kısmı')}${sayiKart('Kaynak beklemesi', yuzde(toplam.toplam ? bekleme / toplam.toplam : null), bekleme / (toplam.toplam || 1) > 0.25 ? 'uyari' : '', 'alert', 'tezgâh, operatör, ayarcı, aparat, fason beklemesi')}${sayiKart('Alt sınıra uzaklık', saat(p.ozet.wT - altSinir(p)), '', 'target', 'kaynak çakışmasından gelen ağırlıklı gecikme')}</div>
  ${kart('Siparişlerin süresi nereye gitti', `<div class="pm-ay-ust">${ayrisimCubugu(toplam, true)}</div><div class="pm-ay-liste">${satirlar}</div><p class="pm-kucuk">Her çubuk plan başından siparişin bitişine kadardır. Son biten adımdan geriye, onu bekleten öncüle doğru yürünür; bekleme sebebi motorun kaydettiği nedendir. Kırmızı çizgi termin, mavi çizgi kapasite olmasaydı en erken bitiş. Yaklaşık ayrıştırmadır.</p>`, '', `<span class="pm-lejant"><span><i class="pm-l-termin"></i>Termin</span><span><i class="pm-l-lb"></i>Kapasitesiz en erken</span></span>`)}
  <div class="pm-iki">${kart('Darboğaz: gecikmeyi kim yarattı', `<div class="tc-tablo-kap"${kip()}><table class="tc-tablo"><thead><tr><th>Kaynak</th><th class="pm-num">Geciken siparişlere bekleme</th><th class="pm-num">Toplam bekleme</th><th class="pm-num">Bekleyen sipariş</th></tr></thead><tbody>${darbogaz.map(z => `<tr>${td('Kaynak', `<i class="pm-nokta" style="--c:${KAT[z.k][1]}"></i> <b>${esc(z.ad)}</b><br><span class="pm-kucuk">${esc(KAT[z.k][0])}</span>`)}${td('Geciken siparişlere', saat(z.gec), 'pm-num')}${td('Toplam', saat(z.v), 'pm-num')}${td('Sipariş', z.sip.size, 'pm-num')}</tr>`).join('') || '<tr><td colspan="4" class="tc-tablo-yok">Bitişi belirleyen zincirlerde kaynak beklemesi yok.</td></tr>'}</tbody></table></div><p class="pm-kucuk">Yalnız siparişin bitişini belirleyen zincirdeki beklemeler sayılır. Bir saatlik bekleme bitişi bir saat geciktirmiştir.</p>`)}
    ${kart('Kaynak yükü', `<div class="tc-tablo-kap"${kip()}><table class="tc-tablo"><thead><tr><th>Kaynak</th><th class="pm-num">Kullanım</th><th class="pm-num">Tepe</th><th>Aşım</th></tr></thead><tbody>${yuk.map(s => `<tr>${td('Kaynak', `<b>${esc(s.ad)}</b>`)}${td('Kullanım', yuzde(s.kap ? s.kul / s.kap : 0), 'pm-num')}${td('Tepe', sayi(s.tepe, 1), 'pm-num')}${td('Aşım', s.asim ? rozet(s.asim + ' sa', 'hata') : rozet('yok', 'tamam'))}</tr>`).join('')}</tbody></table></div><p class="pm-kucuk">Kullanım: plan süresince kullanılan / açık kapasite. Aşım yalnız kapalı kısıtla kurulan planda olur. Saat saat görmek için Plan masasında "Kaynak yükü".</p>`, dugme('Masada göster', 'yuk-masa', { kucuk: true, simge: 'gantt' }))}</div>
  ${kart('Tezgâhlar', `<div class="tc-tablo-kap"${kip()}><table class="tc-tablo"><thead><tr><th>Tezgâh</th><th>Doluluk</th><th class="pm-num">İş</th><th class="pm-num">Ayar</th><th class="pm-num">Kritik iş</th><th class="pm-num">Yarattığı bekleme</th></tr></thead><tbody>${tezgahlar.map(x => `<tr>${td('Tezgâh', `<b class="mono">${esc(x.m.id)}</b> <span class="pm-kucuk">${esc(x.m.ad)}</span>`)}${td('Doluluk', `<div class="pm-cubuk" data-ton="${x.u > 0.85 ? 'uyari' : x.u < 0.15 ? 'bos' : ''}"><div class="pm-cubuk-yol"><div class="pm-cubuk-dolu" style="--o:${Math.round(x.u * 100)}%"></div></div><span class="mono">${yuzde(x.u)}</span></div>`)}${td('İş', x.n, 'pm-num')}${td('Ayar', saat(x.su), 'pm-num')}${td('Kritik', x.kritik, 'pm-num')}${td('Bekleme', x.bek ? saat(x.bek) + (x.gec ? ` <span class="pm-fark-kotu">(${saat(x.gec)} geciken)</span>` : '') : '—', 'pm-num')}</tr>`).join('')}</tbody></table></div><p class="pm-kucuk">Kritik iş: bolluğu yarım saatten az; kayarsa siparişi ya da sonraki işi geciktirir.</p>`)}
  <div class="pm-iki">${kart('Motor nasıl buldu', gunluk + '<p class="pm-kucuk">Motor önce kural tabanlı plan kurar (ATCS kuralı), sonra parça parça söküp yeniden kurar. Bir aday ancak sıralı amaçta daha iyiyse kabul edilir: önce ağırlıklı gecikme, sonra tampon ihlali, değişiklik, ayar, maliyet.</p>')}
    ${kart('Kısıtların bedeli', bedel ? (bedelL.length ? `<ul class="pm-bedel">${bedelL.map(x => `<li><span>${esc((KATALOG_DUZ[x.id] || {}).ad || x.id)}</span><span class="pm-bedel-yol"><i style="width:${(x.dW / enCok) * 100}%"></i></span><b class="mono">−${sayi(x.dW, 1)} sa</b></li>`).join('')}</ul><p class="pm-kucuk">Kısıt kapatılsaydı ağırlıklı gecikme bu kadar azalırdı (temel ${saat(bedel.temel.wT)}). En pahalı kısıt yatırım ya da karar adayıdır.</p>` : '<p class="pm-alt">Hiçbir kısıt tek başına gecikmeyi azaltmıyor.</p>') : `<p class="pm-alt">Her kısıt tek tek kapatılıp aynı motorla yeniden çözülür; gecikmeye katkısı ölçülür.</p>`, dugme(bedel ? 'Yeniden hesapla' : 'Hesapla', 'bedel', { kucuk: true, simge: 'target', yetki: 'plan.yaz' }))}</div>`;
}
const LEX_KISA = ['gecikme', 'tampon', 'değişiklik', 'ayar', 'maliyet'];
function gunlukMetni(x) {
  const t = String(x.tur || '');
  const ne = t.startsWith('zincir') ? `${t.slice(7)} siparişinin zinciri öne alındı` : t === 'öne al' ? `${x.id || ''} kritik işi öne alındı` : t.startsWith('pencere') ? `${t.slice(8)} tezgâhında sıra değişti` : t;
  return `${ne} · kazanç: ${LEX_KISA[x.by] || 'eşit'}${x.dSu > 0.05 ? `, ayar −${sayi(x.dSu, 1)} sa` : ''}`;
}

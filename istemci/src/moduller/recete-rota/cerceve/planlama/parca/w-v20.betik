  const son = L[L.length - 1]; const t0 = son ? son.t : 0;
  const deg = S.iz.filter(x => x.t > t0).slice(0, 8);
  const gec = p ? Object.entries(p.J).filter(([, x]) => x.T > 0.05).sort((a, b) => b[1].T - a[1].T) : [];
  const donuk = [...new Set(Object.values(S.locks).filter(l => l.gun != null).map(l => l.gun))];
  const elle = Object.values(S.locks).filter(l => l.gun == null).length;
  const now = cx ? cx.st.now : 7; const ariza = S.down.filter(d => d.to > now && d.from < now + 24);
  const onay = S.senaryolar.filter(s => s.durum === 'onay');
  const bek = U.taslak ? U.taslak.adimlar.length : 0;
  const yaz = yetkili('plan.yaz') || yetkili('plan.kilitle');
  const madde = (sm, ton, metin) => `<li ${ton ? `data-ton="${ton}"` : ''}>${ic(sm, 'k')}<span>${metin}</span></li>`;
  const durum = [
    madde('flag', gec.length ? 'hata' : 'tamam', gec.length ? `${gec.length} sipariş geç: <span class="mono">${esc(gec.slice(0, 4).map(([j, x]) => `${j} (${gecMetin(x.T)})`).join(', '))}</span>` : 'Geciken sipariş yok.'),
    madde('lock', '', `${donuk.length ? `Donuk gün: <span class="mono">${esc(donuk.map(d => fmtDT(S.D, d * 24).slice(0, 9)).join(', '))}</span> · ` : 'Donuk gün yok · '}elle sabit iş ${elle}`),
    madde('wrench', ariza.length ? 'uyari' : '', ariza.length ? `Önümüzdeki 24 saatte kapanış: <span class="mono">${esc(ariza.map(d => `${d.m} ${fmtDT(S.D, d.from)}`).join(', '))}</span>` : 'Önümüzdeki 24 saatte arıza ya da bakım yok.'),
    madde('check', onay.length ? 'uyari' : '', onay.length ? `Onay bekleyen plan: ${esc(onay.map(s => s.ad).join(', '))}` : 'Onay bekleyen plan yok.'),
    madde('layers', bek ? 'uyari' : '', bek ? `Yayınlanmamış ${bek} değişiklik sepette.` : 'Sepette yayınlanmamış değişiklik yok.'),
  ].join('');
  const gecmis = L.slice(-4).reverse().map((d, i) => { const k = L.length - 1 - i; const okudum = (d.okundu || []).includes(kim().ad);
    return `<li><span class="pm-v20-ic"><b>${esc(d.kim)} · <span class="mono">${esc(new Date(d.t).toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }))}</span></b><small>${d.not ? esc(d.not) : 'Not yazılmadı.'} · gecikme ${saat(d.ozet.wT)}, geciken ${d.ozet.late}</small><small>${d.okundu && d.okundu.length ? 'Okuyan: ' + esc(d.okundu.join(', ')) : 'Henüz okuyan yok.'}</small></span>${okudum || d.kim === kim().ad ? '' : dugme('Okudum', 'v20-devir-oku', { kucuk: true, simge: 'check', veri: `data-v="${k}"` })}</li>`; }).join('');
  return `<p class="pm-kucuk">${son ? `Son devir ${esc(son.kim)}, ${esc(new Date(son.t).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }))}. Aşağıdakiler o zamandan beri.` : 'İlk devir. Aşağıdakiler bu oturumun başından beri.'}</p>
    <h3 class="pm-v20-h">Açık konular</h3><ul class="pm-v20-madde">${durum}</ul>
    <h3 class="pm-v20-h">Değişiklikler</h3>${deg.length ? `<ul class="pm-v20-madde">${deg.map(x => madde('edit', '', `<b>${esc(x.ne)}</b> · ${esc(x.ayrinti)} <small class="mono">${esc(x.kim)}</small>`)).join('')}</ul>` : '<p class="pm-kucuk">Değişiklik yok.</p>'}
    ${yaz ? `<form data-form="v20-devir" class="pm-dik" novalidate><label class="tc-alan"><span class="tc-alan-etiket">Devralana not</span><textarea class="tc-alan-kutu" name="not" rows="3" maxlength="500" placeholder="Örnek: T3 bakımdan erken çıkarsa S-104'ü öne al."></textarea></label>
      <div class="pm-dugmeler"><button type="submit" class="tc-dugme tc-dugme-birincil tc-dugme-kucuk">${ic('check', 'k')}Devri kaydet</button></div></form>` : '<p class="pm-kucuk">Bu rolde devir yazılmaz; okunur.</p>'}
    ${gecmis ? `<h3 class="pm-v20-h">Önceki devirler</h3><ul class="pm-v20-liste">${gecmis}</ul>` : ''}
    <p class="pm-kucuk">Denemede devri planlamacı, müdür ve yönetici yazar (VARSAYIM; yetki sorusu açık).</p>`;
}
document.addEventListener('submit', e => {

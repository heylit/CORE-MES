  const adimlar = V20_TUR[rol].filter(([s]) => !s || document.querySelector(s)).map(([el, baslik, metin]) => ({ el, baslik, metin }));
  pmTur(adimlar, { bitince: turIsaretle });
};
function v20DevirGovde() {

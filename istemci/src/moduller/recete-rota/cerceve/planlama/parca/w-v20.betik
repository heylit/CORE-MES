    ['.pm-v20-arac [data-act="v20-istisna"]', 'İstisnalar', 'Yalnız dikkat isteyenler: geç siparişler, malzeme açığı, dolu tezgâhlar.'],
    ['.pm-v20-arac [data-act="v20-devir"]', 'Vardiya devri', 'Vardiya sonunda açık konular ve son değişiklikler tek sayfada; notunuzu yazıp devredersiniz.'],

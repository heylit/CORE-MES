/* ---------- v20: seçilen 11 parça denemede ----------
   Geri al ve yinele (Ctrl Z), sürüm listesi, komut paleti (Ctrl K, <dialog>), iş menüsü (Popover API ve CSS anchor),
   kayarak geçiş (Web Animations), sürüklerken etki önizlemesi, öneri listesi (kabul, ret, değiştir), istisna kutusu,
   kilit ve dondurma şeridi, değişim bütçesi karşılaştırması, tezgâh sırası (sürükleyerek), role göre tur ve vardiya devri.
   Hepsi var olan motoru ve sepeti kullanır; yeni bir plan kuralı eklemez. */
const V20 = { ileri: [], dvSon: null, yineliyor: false, oneri: null, ret: new Set(), butce: null, ist: 'hepsi', sira: null, ist0: null };
const V20_AZ = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
const v20Esik = (a, b) => !a || !b || a.m !== b.m || Math.abs(a.S - b.S) > 0.25;
function v20Degisen(p0, p1) { let n = 0; for (const id in p1.ops) if (p0.ops[id] && v20Esik(p0.ops[id], p1.ops[id]) && isFinite(p1.ops[id].S)) n++; return n; }
const v20Gun = t => Math.max(0, Math.floor(t / 24) - Math.floor(cxAl().st.now / 24));
const v20Tez = m => m && m[0] === '@' ? m.slice(1) : m;

/* ---------- 8. Geri al, yinele, sürüm listesi ---------- */
function v20GeriAl() {
  const t = U.taslak; if (!t || !t.adimlar.length) { bildir('Geri alınacak değişiklik yok.'); return; }
  const i = t.adimlar.length - 1; const adim = t.adimlar[i];
  V20.ileri.push({ adim, sonra: taslakAnlik(), n: i }); if (V20.ileri.length > 30) V20.ileri.shift();
  taslakDon(i); V20.dvSon = S.dataVer;
  bildir(`Geri alındı: ${adim.ad}`, 'tamam', { metin: 'Yinele', act: 'v20-yinele' });
}
function v20Yinele() {
  const t = U.taslak; const x = V20.ileri[V20.ileri.length - 1];
  if (!x || !t || t.adimlar.length !== x.n || S.dataVer !== V20.dvSon) { V20.ileri = []; bildir('Yinelenecek değişiklik yok.'); return; }
  V20.ileri.pop(); V20.yineliyor = true; taslakGeriYukle(x.sonra); t.adimlar.push(x.adim); render(); V20.yineliyor = false; V20.dvSon = S.dataVer;
  bildir(`Yinelendi: ${x.adim.ad}`, 'tamam');
}
function v20SurumGovde() {
  const t = U.taslak; const a = t ? t.adimlar : []; const c = canliSen();
  const sat = (no, ad, oz, zaman, btn) => `<li><span class="pm-v20-no mono">${no}</span><span class="pm-v20-ic"><b>${esc(ad)}</b><small class="mono">${zaman ? esc(new Date(zaman).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })) + ' · ' : ''}gecikme ${saat(oz.wT)} · geciken ${oz.late}</small></span>${btn}</li>`;
  const l = [];
  if (a.length) l.push(sat(0, 'Sepet açıldığında', a[0].o0, t.bas, dugme('Buna dön', 'v20-surume-don', { kucuk: true, simge: 'rotate', veri: 'data-v="0"', yetki: 'plan.yaz' })));
  a.forEach((x, i) => l.push(sat(i + 1, x.ad, x.o1, x.t, i === a.length - 1 ? '<span class="tc-rozet tc-rozet-tamam"><i></i>Şimdiki</span>' : dugme('Buna dön', 'v20-surume-don', { kucuk: true, simge: 'rotate', veri: `data-v="${i + 1}"`, yetki: 'plan.yaz' }))));
  return `<p class="pm-kucuk">Her değişiklik bir sürümdür. Bir sürüme dönünce ondan sonrakiler sepetten çıkar. Ctrl Z son değişikliği geri alır, Ctrl Shift Z yineler.</p>
    ${l.length ? `<ol class="pm-v20-liste">${l.reverse().join('')}</ol>` : '<p class="pm-bg-bos">Bu oturumda henüz değişiklik yok.</p>'}
    <div class="pm-dugmeler">${dugme('Geri al', 'v20-geri', { kucuk: true, simge: 'rotate', yetki: 'plan.yaz' })}${dugme('Yinele', 'v20-yinele', { kucuk: true, simge: 'next', yetki: 'plan.yaz' })}</div>
    <h3 class="pm-v20-h">Yayınlanan plan</h3>${c ? `<p class="pm-kucuk">${esc(c.ad)} · ${esc(c.yazar || '')}. Açınca çalışma o plana döner; sepetteki değişiklikler çıkar.</p><div class="pm-dugmeler">${dugme('Yayınlanan planı aç', 'sen-ac', { kucuk: true, simge: 'flag', veri: `data-v="${esc(c.id)}"`, yetki: 'plan.yaz' })}</div>` : '<p class="pm-kucuk">Henüz yayınlanmış plan yok.</p>'}`;
}

/* ---------- 5. Öneri: kabul, ret, değiştir ---------- */
function v20OneriHesapla() {
  if (!S.plan || !yetkili('plan.yaz')) { V20.oneri = { dv: S.dataVer, liste: [], bitti: true }; return; }
  const gec = Object.entries(S.plan.J).filter(([j, x]) => x.T > 0.05 && !V20.ret.has(j)).map(([j, x]) => { const s = S.D.siparisler.find(y => y.id === j); return { j, T: x.T, w: x.T * isAgirligi(s || { oncelik: 2 }) }; })
    .sort((a, b) => b.w - a.w).slice(0, 3);
  V20.oneri = { dv: S.dataVer, liste: gec.map(x => ({ ...x, adaylar: null, sec: 0 })), bitti: !gec.length };
  const sira = V20.oneri; let i = 0;
  const adim = () => {
    if (V20.oneri !== sira) return;
    const x = sira.liste[i]; if (!x) { sira.bitti = true; v20PencereYenile(); return; }
    const once = U.hamle; const l = oneAlAdaylari(x.j); U.hamle = once;
    const c0 = S.plan.J[x.j].C;
    x.adaylar = l.filter(a => a.iyi).map(a => ({ ...a, tasinan: v20Degisen(S.plan, a.h.plan), dusen: a.h.degisen.filter(d => d.gec === 'gecikmeye düştü').map(d => d.j), T1: a.h.plan.J[x.j] ? a.h.plan.J[x.j].T : null, wT1: a.h.plan.ozet.wT, c0 }));
    const en = x.adaylar.reduce((b, a, k) => (a.wT1 < x.adaylar[b].wT1 - 0.05 ? k : b), 0); x.sec = x.adaylar.length ? en : 0;
    i++; v20PencereYenile(); setTimeout(adim, 30);
  };
  setTimeout(adim, 30);
}
function v20OneriGovde() {
  if (!yetkili('plan.yaz')) return '<p class="pm-bg-bos">Bu rolde öneri kabul edilemez; öneriler planlamacıya gelir.</p>';
  if (!V20.oneri || V20.oneri.dv !== S.dataVer) v20OneriHesapla();
  const O = V20.oneri; const ret = [...V20.ret];
  const kart = x => {
    if (!x.adaylar) return `<li class="pm-v20-kart" data-bekliyor>${ic('clock', 'k')}<span><b class="mono">${esc(x.j)}</b> için seçenekler hesaplanıyor…</span></li>`;
    if (!x.adaylar.length) return `<li class="pm-v20-kart"><span><b class="mono">${esc(x.j)}</b>: öne almak bu siparişi hızlandırmıyor; darboğaz başka yerde (tezgâh kapasitesi, malzeme ya da fason). İstisnalar'a bakın.</span>${dugme('Gizle', 'v20-ret', { kucuk: true, hayalet: true, veri: `data-v="${esc(x.j)}"` })}</li>`;
    const a = x.adaylar[x.sec];
    const ad = a.h.ad.replace(/^.*\((.*)\)$/, '$1');
    const sec = x.adaylar.length > 1 && U.v20Degis === x.j ? `<fieldset class="pm-v20-sec"><legend class="pm-kucuk">Başka yol seçin</legend>${x.adaylar.map((b, k) => `<button type="button" class="tc-dugme tc-dugme-kucuk" data-act="v20-degistir" data-v="${esc(x.j)}|${k}" aria-pressed="${k === x.sec}">${esc(b.h.ad.replace(/^.*\((.*)\)$/, '$1'))} · <span class="mono">${saat(b.wT1)}</span></button>`).join('')}</fieldset>` : '';
    return `<li class="pm-v20-kart"><div class="pm-v20-kb">${ic('flag', 'k')}<b><span class="mono">${esc(x.j)}</span> siparişini öne al</b><span class="pm-kucuk">${esc(ad)}</span></div>
      <dl class="pm-v20-dl mono"><div><dt>Bu sipariş</dt><dd>${saat(x.T)} → <b>${saat(a.T1)}</b> geç</dd></div><div><dt>Toplam gecikme</dt><dd ${a.wT1 > S.plan.ozet.wT + 0.05 ? 'data-ton="hata"' : ''}>${saat(S.plan.ozet.wT)} → <b>${saat(a.wT1)}</b></dd></div><div><dt>Yeri değişen iş</dt><dd>${a.tasinan}</dd></div><div><dt>Gecikmeye düşen</dt><dd ${a.dusen.length ? 'data-ton="hata"' : ''}>${a.dusen.length ? esc(a.dusen.join(', ')) : 'yok'}</dd></div></dl>
      ${a.wT1 > S.plan.ozet.wT + 0.05 ? `<p class="pm-kucuk pm-v20-uyari">${ic('alert', 'k')}Bu siparişi hızlandırır ama başka siparişleri geciktirir; toplam gecikme ${saat(a.wT1 - S.plan.ozet.wT)} artar.</p>` : ''}${sec}<div class="pm-dugmeler">${dugme('Kabul', 'v20-kabul', { kucuk: true, birincil: true, simge: 'check', veri: `data-v="${esc(x.j)}"` })}${x.adaylar.length > 1 ? dugme('Değiştir', 'v20-degis-ac', { kucuk: true, simge: 'edit', veri: `data-v="${esc(x.j)}"` }) : ''}${dugme('Ret', 'v20-ret', { kucuk: true, hayalet: true, simge: 'x', veri: `data-v="${esc(x.j)}"` })}</div></li>`;
  };
  return `<p class="pm-kucuk">En çok geciken siparişler için motorun önerdiği öne alma. Kabul ederseniz sepete bir değişiklik olarak düşer; beğenmezseniz Ctrl Z ile geri alırsınız.</p>
    ${O.liste.length ? `<ul class="pm-v20-kartlar">${O.liste.map(kart).join('')}</ul>` : `<p class="pm-bg-bos">${O.bitti ? 'Önerilecek bir şey yok: geciken sipariş kalmadı ya da hepsi reddedildi.' : 'Hesaplanıyor…'}</p>`}
    ${ret.length ? `<p class="pm-kucuk">Reddedilen: <span class="mono">${esc(ret.join(', '))}</span> ${dugme('Geri getir', 'v20-ret-bos', { kucuk: true, hayalet: true, simge: 'rotate' })}</p>` : ''}`;
}
function v20Kabul(j) {
  const x = V20.oneri && V20.oneri.liste.find(y => y.j === j); const a = x && x.adaylar && x.adaylar[x.sec]; if (!a) return;
  if (a.h.dv !== S.dataVer) { V20.oneri = null; v20PencereYenile(); bildir('Plan değişti; öneriler yeniden hesaplandı.'); return; }
  U.hamle = a.h; U.secJob = j; U.secili = null; iz('Öneri kabul edildi', a.h.ad);
  if (U.taslak) render(); else hamleUygula();
  V20.oneri = null; v20PencereYenile();
  bildir(`Kabul edildi: ${j} öne alındı.`, 'tamam', { metin: 'Geri al', act: 'v20-geri' });
}

/* ---------- 3. İstisna kutusu ---------- */
function v20Istisnalar() {
  const p = S.plan; const cx = cxAl(); if (!p || !cx) return [];
  const now = cx.st.now; const l = [];
  const ilk = {}; for (const r of Object.values(p.ops)) if (isFinite(r.S) && !r.done && (!ilk[r.job] || r.S < ilk[r.job].S)) ilk[r.job] = r;
  for (const [j, x] of Object.entries(p.J)) {
    const s = S.D.siparisler.find(y => y.id === j); const pw = isAgirligi(s || { oncelik: 2 });
    if (x.T > 0.05) l.push({ tur: 'gec', w: x.T * pw, j, op: ilk[j] && ilk[j].id, t: ilk[j] && ilk[j].S, baslik: `${j} ${gecMetin(x.T)} geç`, neden: `${ONCELIK[s ? s.oncelik : 2] || 'Normal'} öncelik (×${pw}) · ${sayi(x.T, 1)} sa gecikme` });
  }
  for (const j in ilk) {
    const mr = cx.mat && cx.mat.res && cx.mat.res[j]; if (!mr || mr.ready == null || mr.ready <= now) continue;
    const r = ilk[j]; if (mr.ready <= r.S + 0.05) continue;
    const inf = !isFinite(mr.ready);
    l.push({ tur: 'malzeme', w: inf ? 40 : Math.min(40, (mr.ready - r.S) * 0.6), j, op: r.id, t: r.S, baslik: inf ? `${j} malzemesi eksik` : `${j} malzemesi işten sonra geliyor`, neden: inf ? 'Gelmesi beklenen malzeme yok; iş uyarıyla başlar (K3).' : `İş ${fmtDT(S.D, r.S)}, malzeme ${fmtDT(S.D, mr.ready)}` });
  }
  const d0 = Math.floor(now / 24) * 24;
  for (const m in cx.M) {
    const M = cx.M[m]; if (!M || m[0] === '@') continue;
    for (let g = 0; g < 7; g++) {
      const a = d0 + g * 24, b = a + 24; const acik = M.rw.reduce((s, [x, y]) => s + Math.max(0, Math.min(y, b) - Math.max(x, a)), 0); if (acik < 1) continue;
      let dolu = 0, op = null; for (const r of Object.values(p.ops)) if (r.m === m && isFinite(r.C) && r.C > a && r.S < b) { dolu += workIn(M.rw, Math.max(a, r.S), Math.min(b, r.C)); op = op || r; }
      const o = dolu / acik; if (o > 0.97) l.push({ tur: 'yuk', w: 4 + (o - 0.9) * 30, m, op: op && op.id, t: a, baslik: `${m} · ${fmtDT(S.D, a).slice(0, 9)} %${Math.round(o * 100)} dolu`, neden: `Açık ${sayi(acik, 1)} sa, iş ${sayi(dolu, 1)} sa; boşluk yok, bir aksama sonraki işleri kaydırır.` });
    }
  }
  for (const d of S.down) {
    if (d.to <= now) continue; const et = Object.values(p.ops).filter(r => r.m === d.m && isFinite(r.S) && r.S >= d.from - 0.01 && r.S < d.to + 8);
    l.push({ tur: 'ariza', w: 3 + et.length * 2, m: d.m, op: et[0] && et[0].id, t: d.from, baslik: `${d.m} kapalı: ${fmtDT(S.D, d.from)} → ${fmtDT(S.D, d.to)}`, neden: `${et.length} iş kapanışın hemen arkasında bekliyor.` });
  }
  return l.sort((a, b) => b.w - a.w);
}
const V20_IST = { gec: ['Geç', 'flag', 'hata'], malzeme: ['Malzeme', 'box', 'uyari'], yuk: ['Aşırı yük', 'gauge', 'uyari'], ariza: ['Kapalı', 'wrench', 'pasif'] };
function v20IstisnaGovde() {
  const l = v20Istisnalar(); const say = {}; for (const x of l) say[x.tur] = (say[x.tur] || 0) + 1;
  const f = l.filter(x => V20.ist === 'hepsi' || x.tur === V20.ist);
  const enb = l.length ? l[0].w : 1;
  const sek = [['hepsi', 'Hepsi', l.length], ...Object.entries(V20_IST).map(([k, [ad]]) => [k, ad, say[k] || 0])].map(([k, ad, n]) => `<button type="button" data-act="v20-ist-tur" data-v="${k}" aria-pressed="${V20.ist === k}">${esc(ad)} <span class="mono">${n}</span></button>`).join('');
  return `<p class="pm-kucuk">Planın normal akışı gizlidir; yalnız dikkat isteyenler, ağırlığa göre sıralı. Ağırlık: gecikme × öncelik, malzeme açığı, doluluk, kapanış.</p>
    <div class="pm-seg pm-v20-seg" role="group" aria-label="İstisna türü">${sek}</div>
    ${f.length ? `<ol class="pm-v20-ist">${f.slice(0, 30).map((x, i) => { const [ad, sm, ton] = V20_IST[x.tur]; return `<li><span class="pm-v20-agir" style="--o:${Math.max(0.08, x.w / enb).toFixed(3)}" title="Ağırlık ${sayi(x.w, 1)}"><i></i></span>
      <span class="pm-v20-ic"><b>${ic(sm, 'k')}${esc(x.baslik)}</b><small>${esc(x.neden)}</small></span><span class="tc-rozet tc-rozet-${ton}"><i></i>${esc(ad)}</span>${x.op ? dugme('Göster', 'v20-ist-git', { kucuk: true, simge: 'eye', veri: `data-v="${esc(x.op)}"` }) : ''}</li>`; }).join('')}</ol>` : '<p class="pm-bg-bos">Bu türde istisna yok.</p>'}`;
}
function v20Goster(id) {
  const r = S.plan && S.plan.ops[id]; if (!r) return;
  U.pencere = null; if (U.sayfa !== 'bugun' && mercekAl() !== 'gun') U.sayfa = 'bugun';
  U.agGun = v20Gun(r.S); U.gySec = id; U.gyCoklu = []; U.havuzSec = null; U.secJob = r.job; render();
  const el = document.querySelector(`.pm-gy-blok[data-v="${CSS.escape(id)}"]`); if (el) { el.scrollIntoView({ block: 'center', inline: 'center' }); el.focus({ preventScroll: true }); if (!V20_AZ()) el.animate([{ outlineColor: 'var(--sig)', outlineWidth: '3px' }, { outlineWidth: '0px' }], { duration: 900 }); }
}

/* ---------- 9. Değişim miktarını sınırla ---------- */
function v20ButceHesapla() {
  const sira = V20.butce = { dv: S.dataVer, satir: [5, 15, Infinity].map(k => ({ k, sonuc: null })) };
  let i = 0;
  const adim = () => {
    if (V20.butce !== sira || sira.dv !== S.dataVer) return;
    const x = sira.satir[i]; if (!x) return;
    try {
      const st = stOf(); const cx = compile(st); const ref = { ops: S.plan.ops };
      const bas = lnsDecode(st, { ops: S.plan.ops, fail: S.plan.fail || [] }, [], cx, false); slack(bas, cx);
      const L = lns(st, bas, ref, { ms: 900, seed: 29, free: false, maxChg: isFinite(x.k) ? x.k : null }); slack(L.plan, cx);
      const e = evaluate(L.plan, st, null, false);
      x.sonuc = { plan: L.plan, st, wT: e.wT, late: e.late, deg: v20Degisen(S.plan, L.plan) };
    } catch (err) { x.sonuc = { hata: String(err.message || err) }; }
    i++; v20PencereYenile(); setTimeout(adim, 30);
  };
  setTimeout(adim, 30);
}
function v20ButceGovde() {
  if (!S.plan) return '<p class="pm-bg-bos">Önce planı kurun.</p>';
  if (!V20.butce || V20.butce.dv !== S.dataVer) v20ButceHesapla();
  const o = S.plan.ozet;
  const sat = V20.butce.satir.map((x, i) => { const s = x.sonuc; const ad = isFinite(x.k) ? `En çok ${x.k} iş` : 'Sınırsız';
    if (!s) return `<tr><th scope="row">${ad}</th><td colspan="4" class="pm-kucuk">hesaplanıyor…</td></tr>`;
    if (s.hata) return `<tr><th scope="row">${ad}</th><td colspan="4" class="pm-kucuk">${esc(s.hata)}</td></tr>`;
    return `<tr><th scope="row">${ad}</th><td class="mono pm-num">${s.deg}</td><td class="mono pm-num">${saat(s.wT)} ${fark(s.wT, o.wT)}</td><td class="mono pm-num">${s.late}</td><td>${dugme('Dene', 'v20-butce-dene', { kucuk: true, simge: 'play', yetki: 'plan.yaz', veri: `data-v="${i}"` })}</td></tr>`; }).join('');
  return `<p class="pm-kucuk">Motor planı iyileştirirken atölyede yeri değişen iş sayısını sınırlar. Az değişiklik, operatörün ezberini bozmaz; çok değişiklik, gecikmeyi daha çok düşürebilir. Ayarlardaki bütçe şu an <b class="mono">${S.param.maxChg}</b> iş.</p>
    <div class="pm-v20-tablo"><table><thead><tr><th>Bütçe</th><th class="pm-num">Yeri değişen</th><th class="pm-num">Gecikme</th><th class="pm-num">Geciken</th><th><span class="tc-gizli-etiket">Dene</span></th></tr></thead>
    <tbody><tr><th scope="row">Şimdiki plan</th><td class="mono pm-num">0</td><td class="mono pm-num">${saat(o.wT)}</td><td class="mono pm-num">${o.late}</td><td></td></tr>${sat}</tbody></table></div>
    <p class="pm-kucuk">Dene, seçilen satırı sepete bir değişiklik olarak ekler.</p>`;
}
function v20ButceDene(i) {
  const x = V20.butce && V20.butce.satir[i]; const s = x && x.sonuc; if (!s || s.hata) return;
  if (V20.butce.dv !== S.dataVer) { V20.butce = null; v20PencereYenile(); return; }
  hamleKur(s.plan, s.st, `İyileştirme, ${isFinite(x.k) ? 'en çok ' + x.k + ' iş' : 'sınırsız'} değişiklik`, { kaynak: 'butce' });
  if (U.taslak) render(); else hamleUygula(); V20.butce = null; v20PencereYenile();
}

/* ---------- Tezgâh sırası ---------- */
function v20SiraKur(m) {
  const cx = cxAl(); if (!S.plan || !cx) return;
  const now = cx.st.now;
  const l = Object.values(S.plan.ops).filter(r => r.m === m && isFinite(r.S) && r.S >= now && !r.done && !r.act).sort((a, b) => a.S - b.S).slice(0, 15);
  V20.sira = { m, dv: S.dataVer, ids: l.map(r => r.id), ilk: l.map(r => r.id) };
}
function v20SiraGovde() {
  const cx = cxAl(); if (!S.plan || !cx) return '<p class="pm-bg-bos">Önce planı kurun.</p>';
  const tez = Object.keys(cx.M).filter(m => m[0] !== '@');
  if (!V20.sira || V20.sira.dv !== S.dataVer || !cx.M[V20.sira.m]) v20SiraKur(V20.sira && cx.M[V20.sira.m] ? V20.sira.m : tez[0]);
  const Q = V20.sira; const deg = Q.ids.some((id, i) => id !== Q.ilk[i]); const yaz = yetkili('plan.yaz');
  const li = Q.ids.map((id, i) => { const r = S.plan.ops[id]; const o = cx.byId[id] || {}; const kl = S.locks[id];
    return `<li data-id="${esc(id)}" ${kl ? 'data-sabit' : ''} ${id !== Q.ilk[i] ? 'data-yeni' : ''}><span class="pm-v20-tut" aria-hidden="true">${ic('more', 'k')}</span><span class="pm-v20-no mono">${i + 1}</span>
      <span class="pm-v20-ic"><b class="mono">${esc(id)}</b><small>${esc(o.ad || '')} · <span class="mono">${esc(fmtDT(S.D, r.S))}</span>${kl ? ' · sabit' : ''}</small></span>
      ${yaz ? `${dugme('', 'v20-sira-yon', { kucuk: true, hayalet: true, simge: 'up', ad: `${id} bir yukarı`, veri: `data-v="${esc(id)}" data-yon="-1"` })}${dugme('', 'v20-sira-yon', { kucuk: true, hayalet: true, simge: 'down', ad: `${id} bir aşağı`, veri: `data-v="${esc(id)}" data-yon="1"` })}` : ''}</li>`; }).join('');
  return `<label class="tc-alan"><span class="tc-alan-etiket">Tezgâh</span><select class="tc-alan-kutu" data-v20-chg="sira-tez">${tez.map(m => `<option value="${esc(m)}" ${m === Q.m ? 'selected' : ''}>${esc(m)}</option>`).join('')}</select></label>
    <p class="pm-kucuk">Sıradaki işleri tutup sürükleyin ya da oklarla taşıyın; sonra Uygula. Motor yeni sırayı korur, saatleri yeniden hesaplar. Sabit işin yeri değişmez.</p>
    ${Q.ids.length ? `<ol class="pm-v20-sira" id="pm-v20-sira" aria-label="${esc(Q.m)} kuyruğu">${li}</ol>` : '<p class="pm-bg-bos">Bu tezgâhta sırada iş yok.</p>'}
    <div class="pm-dugmeler">${deg ? dugme('Baştaki sıraya dön', 'v20-sira-sifirla', { kucuk: true, simge: 'rotate' }) : ''}${dugme('Uygula', 'v20-sira-uygula', { kucuk: true, birincil: true, simge: 'check', yetki: 'plan.yaz', cls: deg ? '' : 'pm-v20-pasif' })}</div>`;
}
function v20SiraBagla() {
  const el = document.getElementById('pm-v20-sira'); if (!el || el.dataset.bagli || !yetkili('plan.yaz')) return;
  el.dataset.bagli = '1';
  pmSirala(el, { animasyon: V20_AZ() ? 0 : 150, tutamac: '.pm-v20-tut', suzgec: '[data-sabit]', hayalet: 'pm-v20-hayalet', gecebilir: e => !e.related.hasAttribute('data-sabit'),
    bitince: () => { V20.sira.ids = [...el.children].map(x => x.dataset.id); v20PencereYenile(); } });
}
function v20SiraYon(id, yon) {
  const l = V20.sira && V20.sira.ids; if (!l) return; const i = l.indexOf(id), k = i + yon; if (i < 0 || k < 0 || k >= l.length) return;
  if (S.locks[id] || S.locks[l[k]]) { bildir('Sabit işin sırası değişmez.'); return; }

/* ---------- Popover API ve CSS anchor: iş menüsü ---------- */
const V20_ANCHOR = typeof CSS !== 'undefined' && CSS.supports && CSS.supports('anchor-name: --a');
function v20MenuEl() {
  let m = document.getElementById('pm-v20-menu');
  if (!m) { m = document.createElement('div'); m.id = 'pm-v20-menu'; m.className = 'pm-v20-menu'; m.setAttribute('popover', 'auto'); m.setAttribute('role', 'menu'); document.body.appendChild(m);
    m.addEventListener('keydown', e => { const l = [...m.querySelectorAll('[role="menuitem"]')]; const i = l.indexOf(document.activeElement);
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); const k = (i + (e.key === 'ArrowDown' ? 1 : -1) + l.length) % l.length; l[k].focus(); } });
    m.addEventListener('toggle', e => { if (e.newState === 'closed' && V20.menuRef && V20.menuRef.isConnected) { V20.menuRef.style.anchorName = ''; } }); }
  return m;
}
function v20MenuAc(ref, id) {
  const r = S.plan && S.plan.ops[id]; if (!r || typeof HTMLElement.prototype.showPopover !== 'function') return false;
  const m = v20MenuEl(); const kl = S.locks[id]; pmIpucuGizle();
  const it = (act, simge, ad, yetki, v = id) => (!yetki || yetkili(yetki)) ? `<button type="button" role="menuitem" data-act="${act}" data-v="${esc(v)}">${ic(simge, 'k')}<span>${ad}</span></button>` : '';
  m.innerHTML = `<div class="pm-v20-menu-bas">${isIpucu(id)}</div>
    ${it('v20-m-onal', 'flag', 'Siparişi öne al', 'plan.yaz')}${it('v20-m-ileri', 'chev-right', '1 saat sonraya', 'plan.yaz')}${it('v20-m-geri', 'chev-left', '1 saat önceye', 'plan.yaz')}
    ${it('v20-m-sabit', 'lock', kl ? 'Sabitliği kaldır' : 'Bu saate sabitle', 'plan.kilitle')}${it('v20-m-sira', 'sort', `${esc(v20Tez(r.m))} sırasını düzenle`, null, r.m)}${it('v20-m-goster', 'eye', 'Siparişin bütün işleri', null, r.job)}`;
  if (V20.menuRef && V20.menuRef !== ref) V20.menuRef.style.anchorName = '';
  V20.menuRef = ref;
  if (V20_ANCHOR) { ref.style.anchorName = '--pm-v20-menu'; m.dataset.anchor = ''; m.showPopover(); }
  else { delete m.dataset.anchor; m.showPopover(); pmKonumla(ref, m, { yer: 'bottom-start', aralik: 6, kenar: 8 }); }
  const ilk = m.querySelector('[role="menuitem"]'); if (ilk) ilk.focus();
  return true;
}
function v20MenuKapat() { const m = document.getElementById('pm-v20-menu'); if (m && m.matches(':popover-open')) m.hidePopover(); }
/* bazı sistemlerde sağ tık menüsü düğme basılıyken gelir; menü bırakınca açılır, yoksa bırakma onu dışarı tıklama sayıp kapatır */
let V20_SAG = false;
document.addEventListener('pointerdown', e => { V20_SAG = e.button === 2; }, true);
document.addEventListener('pointerup', () => { setTimeout(() => { V20_SAG = false; }); }, true);
document.addEventListener('contextmenu', e => {
  const b = e.target.closest && e.target.closest('.pm-gy-blok'); if (!b || GY_TAS || typeof HTMLElement.prototype.showPopover !== 'function') return;
  e.preventDefault(); const id = b.dataset.v;
  const ac = () => v20MenuAc(b.isConnected ? b : document.querySelector(`.pm-gy-blok[data-v="${CSS.escape(id)}"]`) || b, id);
  if (V20_SAG) document.addEventListener('pointerup', () => setTimeout(ac, 0), { once: true, capture: true }); else ac();
});
document.addEventListener('keydown', e => {

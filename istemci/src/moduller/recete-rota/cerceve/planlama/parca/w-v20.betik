  if (b && (e.key === 'ContextMenu' || (e.shiftKey && e.key === 'F10'))) { e.preventDefault(); v20MenuAc(b, b.dataset.v); }
});

/* ---------- 1. Bırakmadan önce etki: sürüklerken kayacak işler kesik çizgiyle ---------- */
const V20E = { key: null, z: null, son: null };
function v20EtkiPlanla(id, h) {
  if (!h || !h.ok) { V20E.key = null; clearTimeout(V20E.z); v20EtkiTemizle(); if (typeof rsOnizle === 'function') rsOnizle(null); return; }
  const key = `${id}|${h.m}|${h.t}`; if (key === V20E.key) return; V20E.key = key; clearTimeout(V20E.z); v20EtkiTemizle();
  V20E.z = setTimeout(() => {
    if (!GY_TAS || V20E.key !== key) return;
    try { V20E.son = { key, ...v20EtkiHesapla(id, h.m, h.t) }; } catch (err) { V20E.son = null; return; }
    v20EtkiCiz(V20E.son); if (typeof rsOnizle === 'function') rsOnizle(V20E.son.p); if (GY_TAS && GY_TAS.html) pmIpucuGoster(GY_TAS.el, GY_TAS.html + v20EtkiMetin());
  }, 140);
}
function v20EtkiHesapla(id, m, t) {
  const st = stOf(); st.locks[id] = { m, S: t };
  const cx = compile(st); const p = lnsDecode(st, { ops: S.plan.ops, fail: S.plan.fail || [] }, [[id, m, t]], cx, true, true); slack(p, cx);
  const ev = evaluate(p, st, null, false);
  const kayan = Object.values(p.ops).filter(r => r.id !== id && isFinite(r.S) && v20Esik(S.plan.ops[r.id], r));
  const gecMi = x => x && x.T > 0.05;
  const dusen = Object.keys(ev.J).filter(j => gecMi(ev.J[j]) && !gecMi(S.plan.J[j]));
  const kurtulan = Object.keys(S.plan.J).filter(j => gecMi(S.plan.J[j]) && ev.J[j] && !gecMi(ev.J[j]));
  return { kayan, wT: ev.wT, dusen, kurtulan, p };
}
function v20EtkiMetin() {
  const e = V20E.son; if (!e || e.key !== V20E.key) return '<span class="pm-kucuk">Etkisi hesaplanıyor…</span>';
  const o = S.plan.ozet;
  return `<span><b>${e.kayan.length}</b> iş kayar · gecikme <span class="mono">${saat(o.wT)} → ${saat(e.wT)}</span></span>${e.dusen.length ? `<span data-ton="hata">Gecikmeye düşer: ${esc(e.dusen.join(', '))}</span>` : ''}${e.kurtulan.length ? `<span data-ton="tamam">Zamanına girer: ${esc(e.kurtulan.join(', '))}</span>` : ''}${e.kayan.length ? '<span class="pm-kucuk">Kesik çizgi: kayacak işlerin yeni yeri (yaklaşık; bırakınca motor toparlar).</span>' : ''}`;
}
function v20EtkiCiz(e) {
  const y = GY_TAS && GY_TAS.y; if (!y) return; v20EtkiTemizle();
  const a = Math.floor(cxAl().st.now / 24) * 24 + gyGun() * 24, b = a + 24; const yz = t => ((t - a) / 24 * 100).toFixed(3) + '%';
  for (const r of e.kayan) {
    const eski = y.querySelector(`.pm-gy-blok[data-v="${CSS.escape(r.id)}"]`); if (eski) eski.dataset.kayacak = '';
    if (!(r.C > a && r.S < b)) continue;
    const c = y.querySelector(`.pm-gy-cizgi[data-m="${CSS.escape(r.m)}"]`); if (!c) continue;
    const i = document.createElement('i'); i.className = 'pm-v20-etki'; i.style.left = yz(Math.max(a, r.S)); i.style.width = yz(a + Math.min(b, r.C) - Math.max(a, r.S));
    i.innerHTML = `<span>${esc(r.id)}</span>`; c.appendChild(i);
  }
}
function v20EtkiTemizle() { document.querySelectorAll('.pm-v20-etki').forEach(x => x.remove()); document.querySelectorAll('[data-kayacak]').forEach(x => delete x.dataset.kayacak); }

/* ---------- Komut paleti: Ctrl K ---------- */
function v20Komutlar() {
  const yaz = yetkili('plan.yaz'), kil = yetkili('plan.kilitle'); const l = [];
  const ek = (ad, simge, kos, grup, ipucu = '') => l.push({ ad, simge, kos, grup, ipucu });
  for (const [, ead, , gl] of ekranlar()) for (const [id, ad, sm] of gl) ek(`${ead}: ${ad}`, sm, () => eylem('git', id), 'Git');
  if (S.plan && kim().rol !== 'operator') {
    if (yaz) ek('Öneriler', 'bolt', () => v20Ac('oneri'), 'Araç', 'kabul, ret, değiştir');
    ek('Bütün resim', 'expand', () => eylem('v20-resim'), 'Araç', 'bütün görünümler tek ekranda');
    ek('İstisnalar', 'alert', () => v20Ac('istisna'), 'Araç', 'geç, malzeme, yük, kapalı');
    ek('Tezgâh sırası', 'sort', () => v20Ac('sira'), 'Araç', 'sürükleyerek sırala');
    if (yaz) ek('Değişim bütçesi', 'gauge', () => v20Ac('butce'), 'Araç', '5, 15, sınırsız');
    ek('Sürümler', 'book', () => v20Ac('surum'), 'Araç', 'önceki plana dön');
    ek('Vardiya devri', 'user', () => v20Ac('devir'), 'Araç');
    if (yaz) { ek('Geri al', 'rotate', v20GeriAl, 'Plan', 'Ctrl Z'); ek('Yinele', 'next', v20Yinele, 'Plan', 'Ctrl Shift Z'); }
    if (kil) ek(gyDondu(gyGunNo(gyGun())) ? 'Bu günün dondurmasını kaldır' : 'Bu günü dondur', 'lock', () => gyDondur(gyGun()), 'Plan');
    for (const [j, x] of Object.entries(S.plan.J).filter(([, x]) => x.T > 0.05).sort((a, b) => b[1].T - a[1].T)) if (yaz) ek(`${j} siparişini öne al`, 'flag', () => { if (U.sayfa !== 'bugun') { U.sayfa = 'bugun'; render(); } eylem('bg-onal', j); }, 'Sipariş', `${gecMetin(x.T)} geç`);
    for (const s of S.D.siparisler.filter(s => !s.havuz)) ek(`${s.id} siparişini göster`, 'eye', () => { if (U.sayfa !== 'bugun') { U.sayfa = 'bugun'; render(); } eylem('bg-goster', s.id); }, 'Sipariş', s.ad || '');
  }
  ek('Turu başlat', 'help', () => turBaslat(), 'Yardım');
  return l;
}
function v20PaletEl() {
  let d = document.getElementById('pm-v20-palet'); if (d) return d;
  d = document.createElement('dialog'); d.id = 'pm-v20-palet'; d.className = 'pm-v20-palet'; d.setAttribute('aria-label', 'Komutlar');
  d.innerHTML = `<div class="pm-v20-palet-ara">${ic('search', 'k')}<input type="text" class="tc-alan-kutu" placeholder="Komut ya da sipariş yazın" aria-label="Komut ara" role="combobox" aria-expanded="true" aria-controls="pm-v20-palet-l" autocomplete="off"><kbd>Esc</kbd></div><ul id="pm-v20-palet-l" role="listbox"></ul>`;
  document.body.appendChild(d);
  const inp = d.querySelector('input'), ul = d.querySelector('ul');
  const ciz = () => {
    const q = inp.value.toLocaleLowerCase('tr-TR').trim(); const tum = d._l || [];
    const f = (q ? tum.filter(k => (k.ad + ' ' + k.ipucu + ' ' + k.grup).toLocaleLowerCase('tr-TR').includes(q)) : tum).slice(0, 40); d._f = f; d._i = Math.min(d._i || 0, Math.max(0, f.length - 1));
    ul.innerHTML = f.length ? f.map((k, i) => `<li role="option" id="pm-v20-k${i}" aria-selected="${i === d._i}" data-i="${i}">${ic(k.simge, 'k')}<span>${esc(k.ad)}</span><small>${esc(k.ipucu || k.grup)}</small></li>`).join('') : '<li class="pm-kucuk" aria-disabled="true">Eşleşen komut yok.</li>';
    inp.setAttribute('aria-activedescendant', f.length ? 'pm-v20-k' + d._i : '');
    const s = ul.querySelector('[aria-selected="true"]'); if (s) s.scrollIntoView({ block: 'nearest' });
  };
  const kos = i => { const k = d._f && d._f[i]; if (!k) return; d.close(); k.kos(); };
  inp.addEventListener('input', () => { d._i = 0; ciz(); });
  inp.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); const n = (d._f || []).length; if (n) d._i = (d._i + (e.key === 'ArrowDown' ? 1 : -1) + n) % n; ciz(); }
    else if (e.key === 'Enter') { e.preventDefault(); kos(d._i); }
  });
  d.addEventListener('keydown', e => { if (e.key === 'Escape') e.stopPropagation(); });
  ul.addEventListener('click', e => { const li = e.target.closest('[data-i]'); if (li) kos(+li.dataset.i); });
  d.addEventListener('click', e => { if (e.target === d) d.close(); });
  d._ciz = ciz;
  return d;
}
function v20PaletAc() {
  const d = v20PaletEl(); if (d.open) return; d._l = v20Komutlar(); d._i = 0;
  const inp = d.querySelector('input'); inp.value = ''; d._ciz(); d.showModal(); inp.focus();
}
document.addEventListener('keydown', e => {
  const mod = e.ctrlKey || e.metaKey; if (!mod) return;
  const k = e.key.toLowerCase();
  if (k === 'k') { e.preventDefault(); v20PaletAc(); return; }
  if (e.target.closest && e.target.closest('input, textarea, select, dialog')) return;
  if (!yetkili('plan.yaz') || !U.taslak) return;
  if (k === 'z' && !e.shiftKey) { e.preventDefault(); v20GeriAl(); }
  else if ((k === 'z' && e.shiftKey) || k === 'y') { e.preventDefault(); v20Yinele(); }
});

/* ---------- Eylemler ---------- */
const v20TekEski = tekEylem;
tekEylem = function (act, v, el, e) {
  if (act.startsWith('v20-m-')) v20MenuKapat();
  switch (act) {
    case 'v20-oneri': case 'v20-istisna': case 'v20-sira': case 'v20-butce': case 'v20-surum': case 'v20-devir': v20Ac(act.slice(4)); return true;
    case 'v20-palet': v20PaletAc(); return true;
    case 'v20-resim': U.sayfa = 'tahta'; U.pencere = null; mercekSec('resim'); return true;
    case 'v20-geri': v20GeriAl(); return true;
    case 'v20-yinele': v20Yinele(); return true;
    case 'v20-surume-don': { const i = +v; if (U.taslak && U.taslak.adimlar[i]) { taslakDon(i); V20.ileri = []; bildir(`${i}. sürüme dönüldü.`, 'tamam'); } v20PencereYenile(); return true; }
    case 'v20-kabul': v20Kabul(v); return true;
    case 'v20-ret': V20.ret.add(v); iz('Öneri reddedildi', v); V20.oneri = null; U.v20Degis = null; v20PencereYenile(); return true;
    case 'v20-ret-bos': V20.ret.clear(); V20.oneri = null; v20PencereYenile(); return true;
    case 'v20-degis-ac': U.v20Degis = U.v20Degis === v ? null : v; v20PencereYenile(); return true;
    case 'v20-degistir': { const [j, k] = v.split('|'); const x = V20.oneri && V20.oneri.liste.find(y => y.j === j); if (x) x.sec = +k; v20PencereYenile(); return true; }
    case 'v20-ist-tur': V20.ist = v; v20PencereYenile(); return true;
    case 'v20-ist-git': v20Goster(v); return true;
    case 'v20-butce-dene': v20ButceDene(+v); return true;
    case 'v20-sira-yon': v20SiraYon(v, +el.dataset.yon); return true;
    case 'v20-sira-sifirla': V20.sira.ids = V20.sira.ilk.slice(); v20PencereYenile(); return true;
    case 'v20-sira-uygula': v20SiraUygula(); return true;
    case 'v20-devir-oku': { const d = (S.devirler || [])[+v]; if (d) { d.okundu = [...new Set([...(d.okundu || []), kim().ad])]; iz('Devir okundu', d.kim); kaydet(); } v20PencereYenile(); return true; }
    case 'v20-kilit-vurgu': U.v20Kilit = !U.v20Kilit; render(); return true;
    case 'v20-m-onal': { const r = S.plan.ops[v]; if (r) { if (U.sayfa === 'bugun') eylem('bg-onal', r.job); else oneAl(r.job); } return true; }
    case 'v20-m-ileri': case 'v20-m-geri': { const r = S.plan.ops[v]; if (r) gyTasi(v, r.m, r.S + (act === 'v20-m-ileri' ? 1 : -1)); return true; }
    case 'v20-m-sabit': { const r = S.plan.ops[v]; if (!r) return true; const ac = !S.locks[v]; degistir(ac ? 'İş sabitlendi' : 'Sabitlik kaldırıldı', `${v} · ${fmtDT(S.D, r.S)}`, () => { if (ac) S.locks[v] = { m: r.m, S: r.S }; else delete S.locks[v]; }, 'plan.kilitle', { planKoru: true }); return true; }
    case 'v20-m-sira': V20.sira = null; v20SiraKur(v); v20Ac('sira'); return true;
    case 'v20-m-goster': if (U.sayfa === 'bugun') eylem('bg-goster', v); else { U.secJob = v; render(); } return true;
    case 'bg-adim': if (document.startViewTransition && !V20_AZ() && U.bAdim !== v) { document.startViewTransition(() => bgEylem('bg-adim', v)); return true; } return false;
  }
  return v20TekEski(act, v, el, e);
};
document.addEventListener('change', e => {
  const el = e.target.closest && e.target.closest('[data-v20-chg]'); if (!el) return;
  if (el.dataset.v20Chg === 'sira-tez') { v20SiraKur(el.value); v20PencereYenile(); }
});

/* ---------- Çizim sonrası: araç çubuğu, kilit şeridi, kayarak geçiş ---------- */
const v20RenderEski = render;
render = function () {
  const n0 = U.taslak ? U.taslak.adimlar.length : 0;
  const once = {}; const gun0 = `${U.sayfa}|${mercekAl()}|${gyGun()}`;
  if (!V20_AZ() && !GY_TAS) document.querySelectorAll('.pm-gy-blok[data-v]').forEach(el => { const r = el.getBoundingClientRect(); if (r.width) once[el.dataset.v] = r; });
  if (U.pencere && U.pencere.v20) U.pencere.govde = V20_PANEL[U.pencere.v20][1]();
  v20RenderEski();
  const n1 = U.taslak ? U.taslak.adimlar.length : 0;
  if (n1 > n0 && !V20.yineliyor) V20.ileri = [];
  const ust = document.querySelector('.pm-bg-ust'); if (ust && S.plan && !ust.querySelector('.pm-v20-arac')) ust.insertAdjacentHTML('beforeend', v20Arac());
  const gy = document.querySelector('.pm-gy'); const gu = gy && gy.querySelector('.pm-gy-ust');
  if (gu && !gy.querySelector('.pm-v20-kilit')) gu.insertAdjacentHTML('afterend', v20KilitSerit());
  if (gy) { gy.toggleAttribute('data-v20-kilit', !!U.v20Kilit); gy.querySelectorAll('.pm-gy-blok[data-v]').forEach(el => { const l = S.locks[el.dataset.v]; if (l) el.dataset.kilit = l.gun != null ? 'gun' : 'elle'; }); }
  v20SiraBagla();
  /* kayarak geçiş: aynı günde yeri değişen iş eski yerinden yenisine kayar */
  if (gun0 === `${U.sayfa}|${mercekAl()}|${gyGun()}` && Object.keys(once).length) {
    document.querySelectorAll('.pm-gy-blok[data-v]').forEach(el => {
      const a = once[el.dataset.v]; if (!a) return; const b = el.getBoundingClientRect(); const dx = a.left - b.left, dy = a.top - b.top;
      if (Math.abs(dx) < 2 && Math.abs(dy) < 2) return;
      el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], { duration: 320, easing: 'cubic-bezier(.2,.7,.2,1)' });
    });
  }
};

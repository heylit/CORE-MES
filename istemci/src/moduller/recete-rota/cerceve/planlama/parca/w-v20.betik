}

/* ---------- 10. Role göre tur ve vardiya devri ---------- */
const V20_TUR = {
  mudur: [
    ['.pm-bg-durum', 'Planın durumu', 'Kaç sipariş geç ve kaç karar bekliyor, tek cümlede.'],
    ['[data-act="bg-adim"][data-v="yayin"]', 'Onay', 'Planlamacı planı onaya gönderince burada farkı görürsünüz: hangi iş nereye gitti, gecikme nasıl değişti. Onaylar ya da geri gönderirsiniz.'],

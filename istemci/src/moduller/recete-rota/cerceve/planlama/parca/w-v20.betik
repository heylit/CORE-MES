    ['.tc-kabuk-ikinci, nav', 'Görünümler', 'Kuyruk listesi ya da zaman çizgisi; ikisi de aynı işleri gösterir.'],
    [null, 'Komutlar', 'Ctrl K ile sayfalar arasında hızlıca geçersiniz.'],
  ],
  yonetici: [
    ['.pm-bg-durum', 'Planın durumu', 'Planlamacının gördüğünün aynısı.'],
    ['.pm-v20-arac', 'Araçlar', 'Öneriler, istisnalar, tezgâh sırası, değişim bütçesi, sürümler ve vardiya devri.'],
    ['[data-act="bg-adim"][data-v="yayin"]', 'Yayınla', 'Yönetici hem onaylar hem yayınlar.'],
    [null, 'Veri ve kısıtlar', 'Tezgâh, takvim, rota ve kısıtlar üstteki Veri ve kısıtlar ekranında; değişiklik izi Geçmiş ekranında.'],
  ],
};
const v20TurEski = turBaslat;
turBaslat = function () {

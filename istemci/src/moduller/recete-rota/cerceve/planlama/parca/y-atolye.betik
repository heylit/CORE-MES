    g.lineWidth = vurgu ? 2.5 : 1; g.strokeStyle = vurgu ? (tut ? (tut.ok.has(a.m) ? R.done : R.stop) : R.ink) : atKarisim(R.edge2, 0.9);
    if (!vurgu && tut && tut.ok.has(a.m)) { g.strokeStyle = R.done; g.lineWidth = 2; g.setLineDash([5, 4]); } g.stroke(); g.setLineDash([]);

}
function atTetikle() { if (!AT.raf) { AT.son = 0; AT.raf = requestAnimationFrame(atDongu); } }
document.addEventListener('visibilitychange', () => { if (!document.hidden && AT.cv && AT.cv.isConnected) atTetikle(); });

/* ---------- HTML katmanı ---------- */
function atOzet() {
  const s = atSahne(); const t = rsT(); const o = olOzet(s.p); const d0 = rsD0(); const gT = olDilimNo(t);
  let dar = null; for (const m in s.dol) { const v = s.dol[m][gT]; if (v != null && (!dar || v > dar.v)) dar = { m, v }; }
  const cal = Object.keys(s.ist).filter(m => m[0] !== '@' && atDurum(s, m, t).cal).length, top = Object.keys(s.ist).filter(m => m[0] !== '@').length;
  return `<div class="pm-at-kpi"><small>Geciken</small><b class="mono" ${o.late ? 'data-ton="hata"' : ''}>${o.late ?? '—'}/${o.n ?? '—'}</b></div>
    <div class="pm-at-kpi"><small>Gecikme</small><b class="mono">${saat(o.wT)}</b></div>
    <div class="pm-at-kpi"><small>Darboğaz</small><b class="mono" ${dar && dar.v > 0.97 ? 'data-ton="hata"' : ''}>${dar ? esc(dar.m) + ' %' + Math.round(dar.v * 100) : '—'}</b></div>
    <div class="pm-at-kpi"><small>Çalışan</small><b class="mono">${cal}/${top}</b></div>
    <div class="pm-at-kpi"><small>Yolda parça</small><b class="mono" id="at-yolda">${AT.yolda ?? 0}</b></div>`;
}
function atIz() {
  /* sipariş bitişleri zaman şeridinde: termine yetişen yeşil, geç kalan kırmızı; termin ince çizgi. Üst üste binenler
     üç sıraya dağılır; yedi günün ötesinde bitenler sağ uçta tek sayı olarak durur. */
  const s = atSahne(); const now = rsSimdi(); const W = atPenB() - now; const sec = atSecJob();
  const l = S.D.siparisler.filter(x => !x.havuz && s.J[x.id] && s.J[x.id].C != null && isFinite(s.J[x.id].C)).map(x => ({ x, J: s.J[x.id], due: (cxAl().jobs[x.id] || {}).due ?? null })).sort((a, b) => a.J.C - b.J.C);
  const ote = l.filter(o => o.J.C > now + W); const ic0 = l.filter(o => o.J.C <= now + W);
  const sira = [-1e9, -1e9, -1e9]; let out = '';
  for (const o of ic0) { const p = Math.max(0, (o.J.C - now) / W * 100); let ln = sira.findIndex(v => p - v > 1.4); if (ln < 0) ln = sira.indexOf(Math.min(...sira)); sira[ln] = p;
    const gec = o.J.T > 0.05; const se = sec === o.x.id;
    out += `<button type="button" class="pm-at-bit" data-act="at-sip" data-v="${esc(o.x.id)}" style="left:${p.toFixed(2)}%;--ln:${ln}" ${gec ? 'data-gec' : ''} ${se ? 'data-secili' : ''} title="${esc(o.x.id)} bitiş ${esc(fmtDT(S.D, o.J.C))}${gec ? ' · ' + esc(gecMetin(o.J.T)) + ' geç' : ' · termine yetişiyor'}"><span class="tc-gizli-etiket">${esc(o.x.id)}</span></button>`;
    if (se && o.due != null && o.due > now && o.due < now + W) out += `<i class="pm-at-termin" style="left:${((o.due - now) / W * 100).toFixed(2)}%" data-secili></i>`; }
  if (ote.length) out += `<span class="pm-at-ote mono" title="${esc(ote.map(o => o.x.id).join(', '))} seçili dönemden sonra bitiyor">+${ote.length}</span>`;
  return out;
}
/* dikkat listesi: darboğaz, arıza, geciken sipariş; tıklayınca kamera oraya uçar ve seçer */
function atSorunlar() {
  const s = atSahne(); const t = rsT(); const d0 = rsD0(); const gT = olDilimNo(t); const out = [];
  for (const m in s.ist) { if (m[0] === '@') continue; if (atDurum(s, m, t).ariza) out.push({ simge: 'wrench', ton: 'hata', metin: `<b class="mono">${esc(m)}</b> arızada`, act: 'at-git-tez', v: m, p: 3 }); }
  for (const m in s.dol) { const v = s.dol[m][gT]; if (v != null && v > 0.97 && s.ist[m]) out.push({ simge: 'gauge', ton: 'hata', metin: `<b class="mono">${esc(m)}</b> ${esc(olDilimAd(gT, true))} dilimi tam dolu`, act: 'at-git-tez', v: m, p: 2 }); }
  S.D.siparisler.filter(x => !x.havuz && s.J[x.id] && s.J[x.id].T > 0.05).sort((a, b) => s.J[b.id].T - s.J[a.id].T).slice(0, 5).forEach(x => out.push({ simge: 'clock', ton: 'uyari', metin: `<b class="mono">${esc(x.id)}</b> ${esc(gecMetin(s.J[x.id].T))} geç`, act: 'at-sip', v: x.id, p: 1 }));
  return out.sort((a, b) => b.p - a.p);
}
function atSorunHtml() {
  const l = atSorunlar(); const acik = U.atSorun ?? innerWidth >= 1500;
  return `<aside class="pm-at-sorun" aria-label="Dikkat" ${acik ? 'data-acik' : ''}><button type="button" class="pm-at-sorun-bas" data-act="at-sorun" aria-expanded="${acik}">${ic('alert', 'k')}<b>Dikkat</b><span class="pm-at-sayi" ${l.length ? 'data-ton="hata"' : ''}>${l.length}</span>${ic(acik ? 'up' : 'down', 'k')}</button>
    ${acik ? `<ul>${l.map(o => `<li><button type="button" data-act="${o.act}" data-v="${esc(o.v)}" data-ton="${o.ton}">${ic(o.simge, 'k')}<span>${o.metin}</span></button></li>`).join('') || '<li class="pm-kucuk">Sorun yok.</li>'}</ul>` : ''}</aside>`;
}
const AT_KILAVUZ = [
  ['Durum', 'Üstteki renkli şerit ve etiket: yeşil çalışıyor, gri boşta, kırmızı arıza.'],
  ['Şu anki iş', 'Tezgâhta işlenen sipariş adımı, yüzde kaçı bittiği ve bitiş saati.'],
  ['İlerleme', 'Çubuk, işin sipariş renginde ne kadar ilerlediğini gösterir.'],
  ['7 gün', 'Her çubuk bir gün: yeşil rahat, sarı yoğun, kırmızı tam dolu. Altı çizili gün, zaman imlecinin olduğu gün.'],

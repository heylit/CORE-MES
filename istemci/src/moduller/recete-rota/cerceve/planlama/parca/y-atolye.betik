      <ol class="pm-at-yol pm-at-kilavuz">${AT_KILAVUZ.map(([b, m], i) => `<li><b class="mono">${i + 1}</b><span><b>${esc(b)}</b> ${esc(m)}</span></li>`).join('')}</ol>
      <div class="pm-dugmeler">${dugme('Anladım', 'at-kilavuz', { kucuk: true, birincil: true, simge: 'check' })}</div>`;
  if (sj && s.byJ[sj]) { const l = s.byJ[sj]; const J = s.J[sj] || {}; const sp = S.D.siparisler.find(x => x.id === sj) || {};
    return `<header><span class="pm-at-nokta" style="background:${esc(atIsRenk(sj))}"></span><b class="mono">${esc(sj)}</b><small>${esc(urunAd(sp.urun))}</small><span class="pm-sira-ara"></span>${dugme('', 'at-kapat', { kucuk: true, hayalet: true, simge: 'x', ad: 'Seçimi kaldır' })}</header>
      <p class="pm-kucuk" ${J.T > 0.05 ? 'data-ton="hata"' : ''}>${J.C != null ? `Bitiş <b class="mono">${esc(fmtDT(S.D, J.C))}</b> · ${J.T > 0.05 ? esc(gecMetin(J.T)) + ' geç' : 'termine yetişiyor'}` : 'Bitiş belirsiz'}</p>
      <ol class="pm-at-yol">${l.map((r, i) => `<li ${r.S <= t && r.C > t ? 'data-simdi' : r.C <= t ? 'data-bitti' : ''}><b class="mono">${i + 1}</b><span class="mono">${esc(r.m[0] === '@' ? r.m.slice(1) + ' (fason)' : r.m)}</span><small class="mono">${esc(fmtDT(S.D, r.S).slice(6))} → ${esc(fmtDT(S.D, r.C).slice(6))}</small></li>`).join('')}</ol>
      <div class="pm-dugmeler">${dugme('Öne al', 'at-onal', { kucuk: true, simge: 'flag', yetki: 'plan.yaz', veri: `data-v="${esc(sj)}"` })}${dugme('Gün planında', 'at-gun', { kucuk: true, simge: 'gantt', veri: `data-v="${esc(l[0].id)}"` })}</div>`; }
  if (U.rsTez && s.ist[U.rsTez]) { const m = U.rsTez; const st = atDurum(s, m, t); const d = s.dol[m] || []; const d0 = rsD0();
    return `<header><b class="mono">${esc(m)}</b><small>${esc(s.ist[m].ad || '')}</small><span class="pm-sira-ara"></span>${dugme('', 'at-kapat', { kucuk: true, hayalet: true, simge: 'x', ad: 'Seçimi kaldır' })}</header>
      <p class="pm-kucuk">${st.dur === 'ariza' ? 'Arıza ya da bakımda.' : st.cal ? `Şu an <b class="mono">${esc(st.cal.id)}</b>, ${esc(fmtDT(S.D, st.cal.C).slice(6))}'e kadar.` : 'Boşta.'}</p>

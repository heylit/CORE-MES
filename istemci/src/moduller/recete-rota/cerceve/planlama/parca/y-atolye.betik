function atKart() {
  const s = atSahne(); const t = rsT(); const sj = atSecJob();
  if (AT.kilavuz) return `<header>${ic('help', 'k')}<b>Nasıl okunur</b><span class="pm-sira-ara"></span>${dugme('', 'at-kilavuz', { kucuk: true, hayalet: true, simge: 'x', ad: 'Kılavuzu kapat' })}</header>

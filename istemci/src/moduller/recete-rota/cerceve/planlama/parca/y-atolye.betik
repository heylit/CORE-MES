      if (!orta && 8.5 * k >= 6.5) { g.fillStyle = atKarisim(dr, 0.16); atYuvarlak(g, ox(x0 + AT_KW - 10) - ew, oy(y0 + 12), ew, 15 * k, 7 * k); g.fill(); g.fillStyle = dr; g.textAlign = 'center'; g.fillText(et, ox(x0 + AT_KW - 10) - ew / 2, oy(y0 + 23)); g.textAlign = 'start'; }

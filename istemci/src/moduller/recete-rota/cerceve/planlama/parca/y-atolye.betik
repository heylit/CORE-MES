        if (!orta) yazi(st.cal.id, ox(x0 + 10), oy(y0 + 39), 10.5, R.ink, false); else { g.beginPath(); g.arc(ox(x0 + AT_KW - 16), oy(y0 + 24), 5 * k + 2, 0, Math.PI * 2); g.fillStyle = atIsRenk(st.cal.job); g.fill(); } if (!orta) yazi(`%${Math.round(u * 100)} · ${fmtDT(S.D, st.cal.C).slice(10)}`, ox(x0 + AT_KW - 10), oy(y0 + 39), 9.5, R.muted, false, 'right');
        g.fillStyle = atKarisim(R.edge2, 0.5); const pk = orta ? 7 : 4; atYuvarlak(g, ox(x0 + 10), oy(y0 + 44), (AT_KW - 20) * k, pk * k, 2 * k); g.fill(); g.fillStyle = atIsRenk(st.cal.job); atYuvarlak(g, ox(x0 + 10), oy(y0 + 44), Math.max(2, (AT_KW - 20) * k * u), pk * k, 2 * k); g.fill(); }
      else if (!orta) yazi(st.dur === 'ariza' ? 'arıza ya da bakımda' : fas ? 'dış tedarikçi' : 'iş yok', ox(x0 + 10), oy(y0 + 41), 10, R.muted, false);

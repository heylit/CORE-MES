    const rr = Math.max(9, 11 * k); const nx = x + (n - 1) * rr * 2.1, ny = y; g.beginPath(); g.arc(nx, ny, rr, 0, Math.PI * 2); g.fillStyle = R.done; g.fill(); g.lineWidth = 2; g.strokeStyle = R.panel; g.stroke();
    g.fillStyle = R.panel; g.font = `800 ${rr}px ${R.mono}`; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillText(String(i + 1), nx, ny + 0.5); g.textAlign = 'start'; g.textBaseline = 'alphabetic'; }); }

/* ---------- döngü: oynatırken zaman akar; nabız ve geçiş için çizim sürer ---------- */
function atDongu(ts) {
  AT.raf = null; if (!AT.cv || !AT.cv.isConnected) return;
  const dt = AT.son ? Math.min(0.1, (ts - AT.son) / 1000) : 0; AT.son = ts;
  if (AT.oynat) { const now = rsSimdi(); U.rsT = Math.min(atPenB(), rsT() + AT.hiz * dt); if (U.rsT >= atPenB()) { AT.oynat = false; atKatmanYenile(); } atZamanYaz(); }

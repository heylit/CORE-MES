    if (w > 120) { const aw = g.measureText(ad2).width; g.font = `500 ${fs * 0.78}px ${R.mono}`; g.fillStyle = ort != null && ort > 0.97 ? R.stop : R.muted; g.fillText(`${b.n} tezgâh${ort != null ? ` · ${atGunAd(gT)} %${Math.round(ort * 100)}` : ''}`, x + 12 * k + aw + 8, y + 14 + 14 * k); } }

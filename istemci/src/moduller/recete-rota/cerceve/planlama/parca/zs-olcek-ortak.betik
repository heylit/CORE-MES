/* ---------- Ortak dönem: gün, hafta, ay, yıl bütün görünümlerde ----------
   Ölçek tek ayardır (U.olcek, U.olKay). Üst çubuktaki düğme Özet, Harita ve Çizelge'yi birlikte geçirir; V her görünümde sırayla değiştirir.
   Harita'nın zaman şeridi ve Özet'in grafikleri seçili dönemi gösterir. Yılda gün sütunu yerine hafta sütunu kullanılır. */
U.olcek = 'hafta';
function atPenB() { const now = rsSimdi(); if (typeof olAralik !== 'function') return now + 168; return Math.max(now + 6, olAralik().b); }
function atPenEtiket() {
  const now = rsSimdi(); const B = atPenB(); const W = B - now; const d0 = Math.floor(now / 24) * 24; const t = [];
  const ad = x => fmtDT(S.D, x);
  if (U.olcek === 'gun') { for (let x = Math.ceil(now / 3) * 3; x < B; x += 3) t.push([x, ad(x).slice(10, 15)]); }
  else if (U.olcek === 'hafta') { for (let x = d0; x < B; x += 24) t.push([x, ad(x).slice(6, 9)]); }
  else if (U.olcek === 'ay') { for (let x = d0; x < B; x += 5 * 24) t.push([x, ad(x).slice(0, 5)]); }
  else { for (let x = d0; x < B; x += 24) { const g = ad(x); if (x === d0 || g.slice(0, 2) === '01') t.push([x, OL_AY[+g.slice(3, 5) - 1]]); } }
  return t.map(([x, e]) => `<span style="left:${(Math.max(0, x - now) / W * 100).toFixed(2)}%">${esc(e)}</span>`).join('');
}
function olAd() { return OLCEK.find(x => x[0] === U.olcek)[1].toLocaleLowerCase('tr-TR'); }
function olOrtak() {
  const { a, b } = olAralik(); const ad = olAd();
  const kay = (v, sm, ip) => `<button type="button" data-act="ol-kay" data-v="${v}" title="${esc(ip)}" aria-label="${esc(ip)}">${ic(sm, 'k')}</button>`;
  return `<div class="pm-sg-sec pm-ol-ortak" role="group" aria-label="Dönem (V)" title="Dönem: ${esc(olGunAd(a))} – ${esc(olGunAd(b - 24))}">${kay(-1, 'chev-left', 'Önceki ' + ad)}${OLCEK.map(([k, n]) => `<button type="button" data-act="ol-sec" data-v="${k}" aria-pressed="${U.olcek === k}">${n}</button>`).join('')}${kay(1, 'chev-right', 'Sonraki ' + ad)}</div>`;
}
/* Çizelge kendi düğmesini çizmez: aynı ayar üst çubukta */
olSeg = function () { return ''; };
const ooSgEski = sgHtml;
sgHtml = function () { return ooSgEski().replace('<button type="button" class="pm-sg-baska"', olOrtak() + '<button type="button" class="pm-sg-baska"'); };
const ooMasaEski = masaSecici;
masaSecici = function () { const h = ooMasaEski(); return h.slice(0, h.lastIndexOf('</div>')) + olOrtak() + '</div>'; };
/* dönem dışına düşen zaman imleci döneme çekilir */
const ooRsT = rsT;
rsT = function () { const t = ooRsT(); const B = atPenB(); if (t > B) U.rsT = B; return U.rsT; };
window.addEventListener('keydown', e => {
  if (e.ctrlKey || e.metaKey || e.altKey || (e.key !== 'v' && e.key !== 'V') || !U.tkTam || U.sayfa !== 'tahta') return;
  if (e.target.closest && e.target.closest('input, textarea, select, dialog, [contenteditable]')) return;
  e.preventDefault(); const i = OLCEK.findIndex(x => x[0] === U.olcek); olSec(OLCEK[(i + (e.shiftKey ? OLCEK.length - 1 : 1)) % OLCEK.length][0]);
}, true);
for (const k of KB_KISAYOL[0][1]) if (k[0] === 'V') k[1] = 'Dönem: gün, hafta, ay, yıl (bütün görünümler)';

/* Özet seçili dönemi gösterir; Keşfet ve Çizelge'nin bölüm listesi bütün planı görmeye devam eder */
const ooBrVeri = brVeri;
brVeri = function () {
  const v0 = ooBrVeri(); if (!v0 || !(ozAcik() || ksAcik())) return v0;
  const { a, b } = olAralik(); const anah = U.olcek + '|' + U.olKay;
  if (BR.vo && BR.vo.v0 === v0 && BR.vo.anah === anah) return BR.vo.v;
  const kova = U.olcek === 'yil' ? 7 : 1; const gun = Math.max(1, Math.round((b - a) / 24 / kova)); const cx = v0.cx;
  const yuk = v0.yuk.map(y => { const W = cx.M && cx.M[y.m] && cx.M[y.m].rw; const acikS = (x, z) => z <= x ? 0 : (W ? workIn(W, x, z) : z - x);
    const g = Array.from({ length: gun }, (_, d) => { const x = a + d * kova * 24, z = x + kova * 24; const acik = acikS(x, z); if (acik < 0.01) return null; let busy = 0; for (const r of v0.ops) if (r.m === y.m) busy += acikS(Math.max(x, r.S), Math.min(z, r.C)); return busy / acik; });
    return { ...y, g }; });
  const gunAd = Array.from({ length: gun }, (_, d) => { const g = fmtDT(S.D, a + d * kova * 24 + 1); return kova === 1 ? g.slice(6, 9) : (+g.slice(0, 2) <= 7 ? OL_AY[+g.slice(3, 5) - 1] : ''); });
  const sip = v0.sip.filter(s => s.S < b && Math.max(s.C ?? s.S, s.due ?? 0) > a);
  const v = { ...v0, T0: a, H1: b, gun, kova, gunAd, yuk, sip };
  BR.vo = { v0, anah, v };
  return v;
};
const ooTekEski = tekEylem;
tekEylem = function (act, v, el, e) {
  if (act === 'at-gunsec' && el && el.closest && el.closest('.pm-br-isi') && ozAcik()) { const w = brVeri(); if (w) { U.rsT = Math.max(rsSimdi(), w.T0 + (+v) * (w.kova || 1) * 24 + 8); render(); return true; } }
  return ooTekEski(act, v, el, e);
};

/* ---- Harita: tezgâh halkaları, tezgâh kartı ve uyarılar dönemi yedi dilimde gösterir (haftada dilim bir gün) ---- */
function olDilim() { const { a, b } = olAralik(); return { a, L: (b - a) / 7 }; }
function olDilimNo(t) { const { a, L } = olDilim(); return Math.max(0, Math.min(6, Math.floor((t - a) / L))); }
function olDilimAd(i, uzun) {
  const { a, L } = olDilim(); const x = a + i * L; const g = fmtDT(S.D, x);
  if (U.olcek === 'gun') return uzun ? `${g.slice(0, 9)} ${g.slice(10, 15)}–${fmtDT(S.D, x + L).slice(10, 15)}` : g.slice(10, 12);
  if (U.olcek === 'hafta') return uzun ? g.slice(0, 9) : g.slice(6, 8);
  if (U.olcek === 'ay') return uzun ? `${g.slice(0, 5)}–${fmtDT(S.D, x + L - 1).slice(0, 5)}` : g.slice(0, 5);
  return uzun ? `${g.slice(0, 5)}–${fmtDT(S.D, x + L - 1).slice(0, 5)}` : OL_AY[+g.slice(3, 5) - 1];
}
const olAnah = () => U.olcek + '|' + U.olKay;
const ooSahne = atSahne;
atSahne = function () { if (AT.sahne && AT.sahne.olk !== olAnah()) AT.sahne = null; const s = ooSahne(); s.olk = olAnah(); return s; };

/* ---- göstergeler: dönemde iş gören ya da termini dönemde olan siparişler ve dönemdeki tezgâh saatleri ---- */
function olKume(p) {
  const { a, b } = olAralik(); const cx = cxAl(); const ilk = {};
  for (const r of Object.values(p.ops || {})) if (isFinite(r.S) && (ilk[r.job] == null || r.S < ilk[r.job])) ilk[r.job] = r.S;
  const k = new Set();
  for (const s of S.D.siparisler) { if (s.havuz || !p.J || !p.J[s.id] || !cx.jobs[s.id]) continue; const C = p.J[s.id].C, due = cx.jobs[s.id].due;
    const bas = ilk[s.id] ?? C; const son = Math.max(isFinite(C) ? C : bas ?? 0, due ?? -Infinity);
    if ((bas == null || bas < b) && son > a) k.add(s.id); }
  return k;
}
/* ops: tam iş kaydı ya da kısa kayıt [tezgâh, başlangıç, bitiş, ayar] */
function olOlc(src, kume) {
  const { a, b } = olAralik(); const cx = cxAl(); const J = src.J || {};
  let n = 0, late = 0, wT = 0, tl = 0;
  for (const id of kume) { const x = J[id]; if (!x) continue; n++; const T = Array.isArray(x) ? x[1] : x.T; 
    if (T > 0.05) { late++; wT += T; const s = S.D.siparisler.find(z => z.id === id); if (s && typeof agBedel === 'function') tl += agGecTL(agBedel(S.D, s), T); } }
  const busy = {}; let suH = 0, tamOps = true;
  for (const r0 of Object.values(src.ops || {})) { const r = Array.isArray(r0) ? { m: r0[0], S: r0[1], C: r0[2], su: r0[3] } : r0;
    if (!isFinite(r.S)) continue; if (r.C == null) { tamOps = false; continue; } if (r.m[0] === '@' || r.C <= a || r.S >= b) continue;
    const M = cx.M[r.m]; busy[r.m] = (busy[r.m] || 0) + (M ? workIn(M.rw, Math.max(a, r.S), Math.min(b, r.C)) : Math.min(b, r.C) - Math.max(a, r.S));
    if (r.S >= a && r.su) suH += r.su; }
  const util = {}; for (const m in busy) { const M = cx.M[m]; const ac = M ? workIn(M.rw, a, b) : b - a; if (ac > 0.5) util[m] = busy[m] / ac; }
  const u = Object.values(util);
  return { n, late, wT, tl, zam: n ? (n - late) / n * 100 : null, dar: tamOps && u.length ? Math.max(...u) * 100 : null, suH: tamOps ? suH : null, util, cmax: src.ozet ? src.ozet.Cmax : null };
}
/* "Geciken" iki tanımla görünür: dönem göstergesi (nbOlc, olKume) ve planın özeti (tüm plan); etiket neyi saydığını söyler */
const OL_BU = { gun: 'bugün', hafta: 'bu hafta', ay: 'bu ay', yil: 'bu yıl' };
function olDonemEtiket() { const x = OLCEK.find(o => o[0] === U.olcek); return U.olKay ? `seçili ${x ? x[1].toLocaleLowerCase('tr-TR') : 'dönem'}` : OL_BU[U.olcek] || 'bu dönem'; }
let olTum = false;
const ooNbOlc = nbOlc;
nbOlc = function (p) {
  const o = ooNbOlc(p); if (!o || olTum || !p || !p.J) return o;
  const w = olOlc(p, olKume(gosterilen() || p)); return { ...o, ...w, util: undefined };
};
function olOzet(p) { const o = nbOlc(p) || {}; return { late: o.late, n: o.n, wT: o.wT }; }
function nbJKisa(J) { const o = {}; for (const id in J || {}) o[id] = [J[id].C, J[id].T]; return o; }
nbOpsKisa = function (ops) { const k = {}; for (const id in ops) { const r = ops[id]; if (isFinite(r.S)) k[id] = [r.m, Math.round(r.S * 4) / 4, Math.round(r.C * 4) / 4, r.su || 0]; } return k; };
const ooKaydet = nbKaydet;
nbKaydet = function () {
  olTum = true; try { ooKaydet(); } finally { olTum = false; }
  const l = S.nabiz || []; const son = l[l.length - 1]; if (son && !son.J && S.plan) son.J = nbJKisa(S.plan.J);
  for (let i = 0; i < l.length - 2; i++) delete l[i].J;
};
/* referans da aynı dönemle ölçülür; kaydında iş ayrıntısı yoksa fark gösterilmez */
const ooRef = nbRef;
nbRef = function () {
  const R = ooRef(); const k = olKume(gosterilen() || S.plan);
  if (R.tur === 'canli') return R;
  const kay = R.tur === 'sabit' ? S.nbSabit : (S.nabiz || [])[(S.nabiz || []).length - 2];
  return { ...R, o: kay && kay.J && kay.ops ? { ...R.o, ...olOlc(kay, k), util: undefined } : null };
};
/* sürüm eğrileri bütün planı ölçer; dönem bütün planı kapsamıyorsa çizilmez */
const ooEgri = nbEgri;
nbEgri = function (id, v) { return U.olcek === 'yil' && !U.olKay ? ooEgri(id, v) : ''; };

/* Özet ve Keşfet: tezgâh doluluğu ve ayar da dönemden */
const ooBrVeri2 = brVeri;
brVeri = function () {
  const v = ooBrVeri2(); if (!v || (!ozAcik() && !(typeof ksAcik === 'function' && ksAcik()))) return v;
  if (v.olOk) return v;
  const w = olOlc(v.p, new Set(v.sip.map(s => s.id)));
  v.u = Object.entries(w.util).map(([m, u]) => [m, { u, n: 1 }]);
  v.oz = { ...v.oz, suH: w.suH, suN: Object.values(v.p.ops).filter(r => isFinite(r.S) && r.su > 0 && r.S >= v.T0 && r.S < v.H1).length, famN: null };
  v.olOk = true; return v;
};
/* göstergelerin hangi dönemi ölçtüğü üstte yazar */
function olDonemAd() { const { a, b } = olAralik(); return U.olcek === 'gun' ? olGunAd(a) : `${olGunAd(a)} – ${olGunAd(b - 24)}`; }
const ooSdNabiz = sdNabiz;
sdNabiz = function () { return ooSdNabiz().replace(/Göstergelere git\./g, `Ölçülen dönem: ${esc(olDonemAd())}. Göstergelere git.`).replace('aria-label="Plan nabzı"', `aria-label="Plan nabzı, ${esc(olDonemAd())}"`); };
const ooNbHtml = nbHtml;
nbHtml = function () { return ooNbHtml().replace('<b>Plan nabzı</b>', `<b>Plan nabzı</b> <small class="mono">${esc(olDonemAd())}</small>`); };
/* dönem ölçüsünde gecikme ağırlıksız saattir: motorun ağırlıkları her planda yeniden ölçeklenir, dönemler arası kıyas bozulur */
{ const g = NB_GOSTERGE.find(x => x[0] === 'wT'); if (g) g[6] = 'Seçili dönemdeki siparişlerin toplam gecikmesi (saat).'; }

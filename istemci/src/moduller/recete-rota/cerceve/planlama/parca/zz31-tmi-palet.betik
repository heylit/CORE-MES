/* ---------- TMI içinde: tek palet (102 a) ----------
   Uygulamada palet kabuğundur. Çerçevenin kendi paleti (v20) açılmaz, onu açan düğmeler ("Ara", "Komutlar") görünmez (stil: .pm-tmi);
   Ctrl K'yi köprü kabuğa iletir. Pano açıkken komutları pano verir (zz36, paletBildir); öteki planlama sayfalarında v20 paletinin
   araçları gider. Ekranlar (Git) kabuğun menü aramasındadır, yinelenmez. Komut yalnız pencere açar ya da geri al ve yinele yapar (101 a):
   doğrudan planı değiştiren eski komutlar (günü dondur, siparişi öne al) gelmez, sipariş yalnız gösterilir. */
if (TMI_ICINDE) {
  v20PaletAc = function () {};
  document.documentElement.classList.add('pm-tmi');
  const tmiGenelKomutlar = () => {
    const L = [];
    if (!S || !S.plan || kim().rol === 'operator') return L;
    const yaz = yetkili('plan.yaz') && !calisan;
    const ek = (anahtar, baslik, simge, kos, aciklama) => L.push({ anahtar, baslik, simge, kos, ...(aciklama ? { aciklama: String(aciklama).slice(0, 120) } : {}) });
    if (yaz) ek('oneriler', 'Öneriler', 'bolt', () => v20Ac('oneri'), 'Kabul, ret, değiştir');
    ek('butun-resim', 'Bütün resim', 'expand', () => eylem('v20-resim'), 'Bütün görünümler tek ekranda');
    ek('istisnalar', 'İstisnalar', 'alert', () => v20Ac('istisna'), 'Geç, malzeme, yük, kapalı');
    ek('tezgah-sirasi', 'Tezgâh sırası', 'sort', () => v20Ac('sira'), 'Sürükleyerek sırala');
    if (yaz) ek('degisim-butcesi', 'Değişim bütçesi', 'gauge', () => v20Ac('butce'), '5, 15, sınırsız');
    ek('surumler', 'Sürümler', 'book', () => v20Ac('surum'), 'Önceki plana dön');
    ek('vardiya-devri', 'Vardiya devri', 'user', () => v20Ac('devir'));
    if (yaz && U.taslak && U.taslak.adimlar.length) ek('geri-al', 'Geri al', 'rotate', v20GeriAl, 'Ctrl Z');
    if (yaz && V20.ileri.length) ek('yinele', 'Yinele', 'next', v20Yinele, 'Ctrl Shift Z');
    /* en geç on sipariş: yalnız gösterilir (Bugün sayfasında seçilir) */
    const gec = Object.entries(S.plan.J || {}).filter(([, x]) => x.T > 0.05).sort((a, b) => b[1].T - a[1].T).slice(0, 10);
    for (const [j] of gec) {
      const anahtar = 'goster-' + String(j).toLocaleLowerCase('tr').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      if (!/^[a-z][a-z0-9-]*$/.test(anahtar) || anahtar.length > 64 || L.some(k => k.anahtar === anahtar)) continue;
      ek(anahtar, `${j} siparişini göster`, 'eye', () => { if (U.sayfa !== 'bugun') { U.sayfa = 'bugun'; render(); } eylem('bg-goster', j); }, 'Geç sipariş');
    }
    return L;
  };
  const tmiGenelBildir = () => {
    if (typeof window.tmiGorunum.komutlar !== 'function' || document.getElementById('tp-kok')) return;
    window.tmiGorunum.komutlar(tmiGenelKomutlar().map(({ kos, ...k }) => k), anahtar => {
      const k = tmiGenelKomutlar().find(x => x.anahtar === anahtar); if (k) k.kos();
    });
  };
  const r0 = render;
  render = function () { const x = r0.apply(this, arguments); tmiGenelBildir(); return x; };
}

/* ---------- Otomatik akış yeni sırayla (parti bölme planı adım 6) ----------
   Her çözümden sonra geciken iş emirleri (gecikme × öncelik, en çok 6) sırayla:
   1) örtüşebilir bağı varsa örtüşme denenir (ek ayar yok); iş emrinin bitişi öne gelir ve TL düşerse tutulur;
   2) hâlâ gecikiyorsa paralel bölme: 1-20 taraması aramasız bütün parti sayılarını ölçer, en iyi 3 aday kısa aramayla doğrulanır,
      en iyisi TL kazancı eşiği geçerse tutulur. Örtüşme tutulduysa bölme onun üstüne denenir.
   Bölme sayısı "Bir çözümde en çok bölünen" ile sınırlıdır. Sonunda bütün değişiklikler bugünkü plana göre yeniden ölçülür;
   eşiği geçmezse öneri yapılmaz. Sonuç önizlemedir, uygulamayı planlamacı yapar (karar 157 b). */
otoBolme = function (elle) {
  if (otoBolmeSurer || calisan || !S.plan || !yetkili('plan.yaz')) return;
  if (!elle && (bolmeKip() !== 'otomatik' || U.hamle)) return;
  const asil = { sip: S.D.siparisler, plan: S.plan, locks: S.locks, dv: S.dataVer };
  const kum = { ...asil };
  const maks = Math.max(0, Math.round(+(S.param.bolmeMaks ?? 3))), esik = Math.max(0, +(S.param.bolmeEsik ?? 1000));
  const kabul = []; const denendi = new Set(); let tl0 = null, nBol = 0, adaylar = [];
  const gir = () => { S.D.siparisler = kum.sip; S.plan = kum.plan; S.locks = kum.locks; S.dataVer = kum.dv; };
  const cik = () => { Object.assign(kum, { sip: S.D.siparisler, plan: S.plan, locks: S.locks, dv: S.dataVer }); S.D.siparisler = asil.sip; S.plan = asil.plan; S.locks = asil.locks; S.dataVer = asil.dv; };
  const bozuldu = () => S.plan !== asil.plan || S.dataVer !== asil.dv || calisan;
  const olc = ms => { const st = stOf(); const cx = compile(st); let p = lnsDecode(st, { ops: S.plan.ops, fail: S.plan.fail || [] }, [], cx, true); if (ms) p = kisaArama(st, cx, p, ms); const e = evaluate(p, st, null, true); return { st, p, e, tl: tlToplam(e) }; };
  const tut = (r, locks) => { S.plan = planKaydi(r.p, r.st, null); if (locks) S.locks = locks; S.dataVer += 1e-3; tl0 = r.tl; };
  const kok = j => j.split('/')[0];
  const geciken = () => Object.entries(S.plan.J).filter(([j, J]) => J.T > 0.01 && !denendi.has(j) && !basladiMi(j))
    .map(([j, J]) => { const s = S.D.siparisler.find(x => x.id === j); return { j, w: J.T * (s ? isAgirligi(s) : 1), s }; })
    .filter(x => x.s && !x.s.havuz).sort((a, b) => b.w - a.w).slice(0, 6).map(x => x.j);
  const ortusOlur = s => { if (s.ortus) return false; const u = S.D.urunler.find(z => z.id === s.urun); return !!u && u.rota.some((o, i) => i && o.ortusebilir && rtTur(u, i) === 'b'); };
  otoBolmeSurer = { n: 0 };
  const bitir = () => {
    otoBolmeSurer = null;
    if (!kabul.length) { if (elle) bildir('Örtüşme ve bölme TL toplamını eşikten çok düşürmedi; öneri yok.', 'bilgi'); return; }
    let son = null, gercek = null;
    try { const a = olc(500).tl; gir(); try { son = olc(500); gercek = a - son.tl; } finally { cik(); } } catch (e) { gercek = null; }
    if (!son || gercek == null || gercek < esik) { if (elle) bildir('Değişiklikler aramadan sonra yeniden ölçüldü, kazanç eşiği geçmedi; öneri yok.', 'bilgi'); return; }
    /* önizleme bölünmüş sipariş listesiyle kurulur, değişenler bugünkü plana göre sayılır; uygulama bugünkü veri sürümüne bağlanır */
    gir(); S.plan = asil.plan; try { hamleKur(son.p, son.st, `Otomatik: ${kabul.map(x => x.ad).join('; ')} · TL ${tlKisa(-gercek)}`, { kaynak: 'oneri' }); } finally { S.plan = kum.plan; cik(); }
    U.hamle.dv = asil.dv;
    U.hamle.bolme = null; U.hamle.bolmeListe = kabul.filter(x => x.bolme).map(x => x.bolme); U.hamle.ortusListe = kabul.filter(x => x.ortus).map(x => x.ortus);
    U.hamle.otoBolme = kabul.map(({ ad, kazanc, cesit }) => ({ ad, kazanc, cesit }));
    render(); if (!U.taslak) bildir(`Otomatik akış ${kabul.length} değişiklik önerdi; önizlemeyi uygulayın ya da bırakın.`, 'tamam');
  };
  const adim = () => {
    if (bozuldu()) { otoBolmeSurer = null; return; }
    gir();
    try {
      if (tl0 == null) { tl0 = olc(300).tl; adaylar = geciken(); }
      if (!adaylar.length) { cik(); bitir(); return; }
      const j = adaylar.shift(); denendi.add(j); otoBolmeSurer.n++;
      const s = S.D.siparisler.find(x => x.id === j); let C = S.plan.J[j].C, T = S.plan.J[j].T;
      /* 1) örtüşme */
      if (s && ortusOlur(s)) { const eski = S.D.siparisler; S.D.siparisler = eski.map(x => x.id === j ? { ...x, ortus: true } : x);
        const r = olc(300); const J = r.e.J[j] || {};
        if (r.tl < tl0 - 1e-6 && J.C != null && J.C < C - 0.05) { kabul.push({ ad: `${j} örtüşme`, kazanc: tl0 - r.tl, cesit: 'ortus', ortus: j }); tut(r); C = J.C; T = J.T; }
        else S.D.siparisler = eski; }
      /* 2) paralel bölme, örtüşmeli planın üstüne */
      if (T > 0.01 && nBol < maks && s && s.adet >= 2) {
        const o = btAdaylar(6).find(x => x.j === j);
        if (o && o.k) {
          const sec = o.l.map((x, i) => i).filter(i => o.l[i].n > 1);
          const hizli = sec.map(i => ({ i, r: btOlc([o], [i]) })).sort((a, b) => btIyi(a.r, b.r) ? -1 : btIyi(b.r, a.r) ? 1 : 0).slice(0, 3);
          let en = null; for (const h of hizli) { const k = btKur([o], [h.i], 300); const tl = tlToplam(k.e); const Jn = Object.keys(k.e.J).filter(x => x === j || x.startsWith(j + '/')).map(x => k.e.J[x].C).filter(x => x != null);
            if (Jn.length && Math.max(...Jn) < C - 0.05 && (!en || tl < en.tl)) en = { k, tl, i: h.i }; }
          if (en && tl0 - en.tl >= esik) { const g = tl0 - en.tl; const b = en.k.liste[0];
            S.D.siparisler = S.D.siparisler.flatMap(x => x.id === b.eski ? b.yeni.map(clone) : [x]);
            tut({ st: en.k.st, p: en.k.p, tl: en.tl }, Object.fromEntries(Object.entries(en.k.st.locks).filter(([, l]) => !l.gecici)));
            kabul.push({ ad: btSecAd(o, o.l[en.i]), kazanc: g, cesit: 'tarama', bolme: b }); nBol++; adaylar = geciken(); } }
      }
      cik();
    } catch (e) { cik(); otoBolmeSurer = null; return; }
    setTimeout(adim, 0);
  };
  setTimeout(adim, 0);
};
/* önizlemedeki örtüşmeler uygulanırken iş emri kaydına yazılır; geri alma eski listeyi getirir */
{ const hu1 = hamleUygula; hamleUygula = function (sessiz) {
  const h = U.hamle; const sip = S.D.siparisler; const ol = h && h.dv === S.dataVer && h.ortusListe && h.ortusListe.length ? h.ortusListe : null;
  if (ol) S.D.siparisler = S.D.siparisler.map(x => ol.includes(x.id) ? { ...x, ortus: true } : x);
  const r = hu1.apply(this, arguments);
  if (ol && U.hamle !== h) { const x = planGeri[planGeri.length - 1]; if (x) x.sip = sip; } else if (ol) S.D.siparisler = sip;
  return r; }; }

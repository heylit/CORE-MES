/* ---------- Kullanıcı 19.10 16:50 kararları: 1 a, 2 b, 3 b, 4 c, 5 b ----------
   1 a: bekleme maliyeti yalnız finansman kalır (212 a değişmedi).
   2 b: ceza tavanı dolunca bedel aynı oranla sürer (parca/zr-agirlik.js agBedel).
   3 b: ödeme vadesi terminde başlar: erken biten işin parası erken gelmez, termine kadar bekleyen mamulün finansmanı maliyettir.
   4 c: geliş tarihi belli olan malzeme sert kısıttır; tedariki olmayan ya da gelişi yalnız tahmin edilen malzemede iş başlar, uyarı verilir.
   5 b: genel gider batık maliyettir; plan amacına girmez, maliyet ve teklif raporunda kalır. */
/* eski kayıtlarda varsayılanlar bir kez yeni kararlara taşınır; durum yüklendikten sonra. Taşıma yalnız bellekte yapılır, işareti çalışmadadır
   ve ilk kayıtla yazılır: kayıt ortaktır, açılışta yazmak aynı anda açan ikinci kişiye çakışma (409) verir. */
setTimeout(() => {
  let k1650 = null; try { k1650 = localStorage.getItem(ANAHTAR + '-karar1650'); } catch (e) { /* yok */ }
  if (!k1650 && karar1650Goc(S)) render();
}, 0);
/* ana iş parçacığı ve işçi: belli olmayan gelişte malzeme hazır sayılır (iş başlar), uyarı motorun malzeme uyarısıyla aynı metinle verilir */
function matKarmaUygula() {
  const c0 = compile;
  compile = function (st, ...a) {
    const cx = c0(st, ...a);
    if (st && st.w && st.w.matKarma && cx && cx.mat) for (const j in cx.mat.res) { const r = cx.mat.res[j];
      const belli = r.det.every(d => !d.eksikQ && d.use.every(u => u.k !== 'sa' || !((st.D.satinalma || [])[u.i] || {}).tm));
      if (!belli && r.ready > st.now) { r.readyU = r.ready; r.ready = st.now; } }
    /* tezgâh seçimi TL ile: motorun puanı (1−α)·bitiş·1000 + α·maliyet + λ; α ve λ, bir saatin değeri siparişlerin ortanca gecikme bedeli (× denge katsayısı)
       ve tezgâh değiştirmenin bedeli ortanca ayar maliyeti olacak biçimde seçilir: puan ÷ α = saat değeri·bitiş + maliyet + değişim bedeli (TL) */
    if (st && st.w && !st.w.tezgahEski && st.tlAmac && st.tlAmac.ac && cx && cx.jobs) {
      const orta = l => { const a = l.filter(x => x > 0 && isFinite(x)).sort((x, y) => x - y); return a.length ? a[a.length >> 1] : null; };
      const bl = Object.values(cx.jobs).map(j => isAgirligi(j) * (st.tlAmac.birim || 5) * (st.tlAmac.kT || 1)); const V = bl.length ? bl.reduce((x, y) => x + y, 0) / bl.length : null;
      const ucr = orta(Object.values(cx.M).map(M => +M.ucret)); const ay = +(cx.A && cx.A.ayarciUcret) || 0;
      const su = orta(cx.ops.map(o => Math.min(...o.c.filter(c => !c.fas).map(c => c.su)))); 
      const chg = st.w.chgTezgah != null ? +st.w.chgTezgah : su != null && ucr != null ? su * (ucr + ay) : null;
      if (V != null) { st.w.alpha = 1000 / (1000 + V); if (chg != null) st.w.lam = chg * st.w.alpha; st.w.tezgahTL = { V, chg }; }
    }
    return cx;
  };
  const e0 = evaluate;
  evaluate = function (plan, st, ref, fast) {
    const e = e0(plan, st, ref, fast);
    if (fast || !st || !st.w || !st.w.matKarma || !e.warn) return e;
    const cx = plan.cx || compile(st); const ilk = {};
    for (const id in plan.ops) { const r = plan.ops[id], o = cx.byId[id]; if (!o || o.pr.length || r.pin) continue; if (ilk[r.job] == null || r.S < ilk[r.job]) ilk[r.job] = r.S; }
    for (const j in cx.mat.res) { const m = cx.mat.res[j]; if (m.readyU == null || ilk[j] == null || ilk[j] >= m.readyU - 1e-9) continue;
      e.warn.push({ t: 'malzeme', j, txt: isFinite(m.readyU) ? `${j}: malzeme tahminen ${fmtDT(cx.D, m.readyU)} geliyor, iş ${fmtDT(cx.D, ilk[j])} başlıyor` : `${j}: malzeme eksik (stok ve sipariş yetmiyor), iş ${fmtDT(cx.D, ilk[j])} başlıyor` }); }
    return e;
  };
}
matKarmaUygula();
/* Aynı girdi, aynı sonuç: motorun arama bütçesi saate bağlı; işçide saat her okunuşta sabit adım ilerler, böylece bütçe
   tur sayısına döner ve sonuç makinenin o anki hızından bağımsız olur. Adım bu makinede ölçülerek seçildi; ekrandaki süre tahmindir.
   SAAT_ADIM 0 ise gerçek saat kullanılır ve okunuş sayısı bildirilir (ölçüm için). */
var SAAT_ADIM = 1.6;
function saatSabitle() {
  const gercek = Date.now.bind(Date); let n = 0;
  if (SAAT_ADIM > 0) { let t = gercek(); Date.now = () => (t += SAAT_ADIM); }
  else Date.now = () => { n++; return gercek(); };
  const pm = self.postMessage.bind(self);
  self.postMessage = m => pm(m && m.t === 'bitti' ? { ...m, saatOkuma: n } : m);
}
{ const iA = isciAc; isciAc = function () {
  const src = document.getElementById('motor').textContent + '\n' + opKaydi.toString() + '\n' + planKaydi.toString() + '\n' + ISCI_KODU + '\n' + TL_ISCI() + `\nvar tmSureFas = ${tmSureFas};\n${terminUygula}\nterminUygula();\n${PD_ISCI}\n${matKarmaUygula}\nmatKarmaUygula();\nvar SAAT_ADIM = ${SAAT_ADIM};\n${saatSabitle}\nsaatSabitle();`;
  const url = URL.createObjectURL(new Blob([src], { type: 'text/javascript' }));
  let w; try { w = new Worker(url); } catch (e) { URL.revokeObjectURL(url); return iA(); }
  w.bitir = () => { w.terminate(); URL.revokeObjectURL(url); calisan = null; U.ilerleme = null; };
  w.onerror = e => { w.bitir(); U.pdIs = null; render(); bildir('Motor hatası: ' + (e.message || 'bilinmiyor'), 'hata'); };
  return w; }; }
